@if (TempData["Mensaje"] != null)
{
    <div id="toast-msg" style="position:fixed;bottom:24px;right:24px;background:#2ec4b6;color:#fff;padding:14px 22px;border-radius:10px;font-size:13px;font-weight:600;box-shadow:0 4px 16px rgba(0,0,0,.18);z-index:9999;">
        ✅ @TempData["Mensaje"]
    </div>
    <script>setTimeout(()=>document.getElementById('toast-msg')?.remove(),4000);</script>
}

<script>
document.getElementById('modalNuevo').addEventListener('click',function(e){
    if(e.target===this) this.classList.remove('open');
});
document.getElementById('modalEditar').addEventListener('click',function(e){
    if(e.target===this) this.classList.remove('open');
});

function abrirEditar(id) {
    fetch('@Url.Action("ObtenerEmpleado","Nomina")?id=' + id)
        .then(r => r.json())
        .then(d => {
            document.getElementById('edit_id').value       = d.id;
            document.getElementById('edit_ap').value       = d.apellidoPaterno;
            document.getElementById('edit_am').value       = d.apellidoMaterno;
            document.getElementById('edit_nom').value      = d.nombres;
            document.getElementById('edit_dni').value      = d.numeroDocumento;
            document.getElementById('edit_fnac').value     = d.fechaNacimiento;
            document.getElementById('edit_tel').value      = d.telefono || '';
            document.getElementById('edit_email').value    = d.email || '';
            document.getElementById('edit_dir').value      = d.direccion || '';
            document.getElementById('edit_cargo').value    = d.cargo;
            document.getElementById('edit_depto').value    = d.departamento;
            document.getElementById('edit_fing').value     = d.fechaIngreso;
            document.getElementById('edit_contrato').value = d.tipoContrato;
            document.getElementById('edit_regimen').value  = d.regimeLaboral;
            document.getElementById('edit_estado').value   = d.estado;
            document.getElementById('edit_sueldo').value   = d.sueldoBase;
            document.getElementById('edit_hijos').value    = d.tieneHijos.toString();
            document.getElementById('edit_afp').value      = d.sistemaPrevisional;
            document.getElementById('edit_cuspp').value    = d.cuspp || '';
            document.getElementById('edit_banco').value    = d.bancoPago;
            document.getElementById('edit_cuenta').value   = d.numeroCuenta || '';
            document.getElementById('edit_cci').value      = d.cci || '';
            document.getElementById('modalEditar').classList.add('open');
        })
        .catch(() => alert('Error al cargar datos del empleado.'));
}
</script>