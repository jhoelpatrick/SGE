@model SGE.Models.GratificacionesViewModel
@using SGE.Models
@{
    ViewData["Title"] = "Gratificaciones";
    Layout = "~/Views/Shared/_Layout.cshtml";
    int inicio = Model.TotalItems == 0 ? 0 : (Model.PaginaActual - 1) * 10 + 1;
    int fin    = Math.Min(Model.PaginaActual * 10, Model.TotalItems);

    string PagUrl(int p) =>
        $"?pagina={p}&buscar={Uri.EscapeDataString(Model.Buscar)}&tipo={Uri.EscapeDataString(Model.TipoFiltro)}&estado={Uri.EscapeDataString(Model.EstadoFiltro)}";

    string TipoBadge(TipoGratificacion t) => t switch {
        TipoGratificacion.Obligatoria => "badge-oblig",
        _                             => "badge-volunt"
    };
    string TipoLabel(TipoGratificacion t) => t switch {
        TipoGratificacion.Obligatoria => "Obligatoria",
        _                             => "Voluntaria"
    };
    string FrecuenciaLabel(FrecuenciaGratificacion f) => f switch {
        FrecuenciaGratificacion.Mensual   => "Mensual",
        FrecuenciaGratificacion.Semestral => "Semestral",
        FrecuenciaGratificacion.Anual     => "Anual",
        FrecuenciaGratificacion.Unica     => "Única",
        _                                 => "Variable"
    };
    string EstadoBadge(EstadoGratificacion e) => e switch {
        EstadoGratificacion.Activa     => "badge-activa",
        EstadoGratificacion.Pendiente  => "badge-pendiente",
        EstadoGratificacion.Programada => "badge-programada",
        EstadoGratificacion.Pagada     => "badge-pagada",
        _                              => "badge-borrador"
    };
    string EstadoLabel(EstadoGratificacion e) => e switch {
        EstadoGratificacion.Activa     => "Activa",
        EstadoGratificacion.Pendiente  => "Pendiente",
        EstadoGratificacion.Programada => "Programada",
        EstadoGratificacion.Pagada     => "Pagada",
        _                              => "Borrador"
    };
    string BaseLabel(BaseCalculo b) => b switch {
        BaseCalculo.RemuneracionBasica    => "Remuneración Básica",
        BaseCalculo.RemuneracionComputable=> "Remuneración Computable",
        BaseCalculo.SalarioNeto           => "Salario Neto",
        BaseCalculo.PorcentajeVariable    => "Porcentaje variable",
        _                                 => "Fija"
    };

    decimal montoTotalAnio = (decimal)(ViewBag.MontoTotalAnio ?? 0m);
}

<style>
:root{--primary:#4361ee;--success:#2ec4b6;--warning:#ff9f1c;--danger:#e63946;
      --text-main:#1a1a2e;--text-muted:#6b7280;--bg-page:#f0f2f8;
      --bg-card:#ffffff;--border:#e5e7eb;--radius:14px;--shadow:0 2px 16px rgba(67,97,238,.07);}
*{box-sizing:border-box;margin:0;padding:0;}
body{background:var(--bg-page);font-family:'Segoe UI',sans-serif;}

/* HEADER */
.nom-header{display:flex;align-items:center;justify-content:space-between;
            padding:14px 32px;background:var(--bg-card);border-bottom:1px solid var(--border);}
.nom-brand{display:flex;align-items:center;gap:12px;}
.nom-brand-icon{width:38px;height:38px;border-radius:10px;
                background:linear-gradient(135deg,#4361ee,#7b8cde);
                display:flex;align-items:center;justify-content:center;color:#fff;font-size:17px;}
.nom-brand-text h1{font-size:14px;font-weight:800;color:var(--text-main);}
.nom-brand-text p{font-size:11px;color:var(--text-muted);}

/* TABS */
.nom-tabs{display:flex;padding:0 32px;background:var(--bg-card);border-bottom:1px solid var(--border);overflow-x:auto;}
.nom-tab{padding:13px 18px;font-size:13px;font-weight:500;color:var(--text-muted);
         border-bottom:2px solid transparent;cursor:pointer;transition:.2s;
         text-decoration:none;white-space:nowrap;}
.nom-tab.active{color:var(--primary);border-bottom-color:var(--primary);}
.nom-tab:hover{color:var(--primary);}
.btn-nuevo{background:var(--primary);color:#fff;border:none;padding:9px 18px;
             border-radius:8px;font-size:13px;font-weight:600;cursor:pointer;
             display:flex;align-items:center;gap:6px;white-space:nowrap;}
.btn-nuevo:hover{background:#3451d1;}

/* BODY */
.nom-body{padding:22px 32px;}

/* KPI */
.kpi-row{display:grid;grid-template-columns:repeat(5,1fr);gap:14px;margin-bottom:22px;}
.kpi-card{background:var(--bg-card);border-radius:12px;padding:18px 20px;
          box-shadow:var(--shadow);display:flex;align-items:center;gap:16px;}
.kpi-ico{width:46px;height:46px;border-radius:11px;display:flex;align-items:center;
         justify-content:center;font-size:20px;flex-shrink:0;}
.kpi-ico.purple{background:#f0eeff;} .kpi-ico.green{background:#e6faf8;}
.kpi-ico.yellow{background:#fff8e1;} .kpi-ico.blue{background:#e8f4fd;}
.kpi-ico.orange{background:#fff5e6;}
.kpi-lbl{font-size:10px;font-weight:700;text-transform:uppercase;
          letter-spacing:.5px;color:var(--text-muted);display:block;margin-bottom:2px;}
.kpi-val{font-size:26px;font-weight:800;color:var(--text-main);line-height:1;}
.kpi-sub{font-size:11px;color:var(--text-muted);margin-top:3px;}

/* CARD */
.main-card{background:var(--bg-card);border-radius:var(--radius);box-shadow:var(--shadow);overflow:hidden;}
.card-head{display:flex;align-items:center;justify-content:space-between;padding:18px 20px;border-bottom:1px solid var(--border);}
.card-title{font-size:15px;font-weight:700;color:var(--text-main);}
.card-sub{font-size:12px;color:var(--text-muted);margin-top:2px;}

/* TOOLBAR */
.toolbar{display:flex;align-items:center;gap:10px;padding:14px 20px;
         border-bottom:1px solid var(--border);flex-wrap:wrap;}
.search-wrap{position:relative;flex:1;min-width:220px;}
.search-wrap input{width:100%;padding:9px 12px 9px 36px;border:1px solid var(--border);
                   border-radius:8px;font-size:13px;outline:none;color:var(--text-main);transition:.2s;}
.search-wrap input:focus{border-color:var(--primary);}
.search-ico{position:absolute;left:11px;top:50%;transform:translateY(-50%);
            color:var(--text-muted);font-size:14px;pointer-events:none;}
.filter-sel{padding:8px 12px;border:1px solid var(--border);border-radius:8px;
            font-size:13px;background:#fff;color:var(--text-main);outline:none;cursor:pointer;}
.filter-sel:focus{border-color:var(--primary);}
.btn-filtro{background:#fff;color:var(--text-main);border:1px solid var(--border);
            padding:8px 14px;border-radius:8px;font-size:13px;font-weight:500;
            cursor:pointer;display:flex;align-items:center;gap:6px;}
.btn-filtro:hover{border-color:var(--primary);color:var(--primary);}

/* TABLE */
.gra-table{width:100%;border-collapse:collapse;}
.gra-table th{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;
              color:var(--text-muted);padding:11px 14px;text-align:left;
              background:#fafbff;border-bottom:1px solid var(--border);}
.gra-table td{padding:12px 14px;border-bottom:1px solid #f3f4f6;font-size:13px;
              color:var(--text-main);vertical-align:middle;}
.gra-table tr:last-child td{border-bottom:none;}
.gra-table tr:hover td{background:#fafbff;}
.gra-table td:first-child{font-weight:600;color:var(--primary);font-size:12px;}

/* BADGES */
.badge{display:inline-block;padding:3px 10px;border-radius:20px;font-size:11px;font-weight:600;}
.badge-oblig   {background:#fef3c7;color:#92400e;}
.badge-volunt  {background:#e0e7ff;color:#3730a3;}
.badge-activa  {background:#e6faf8;color:#0d9488;}
.badge-pendiente{background:#fef2f2;color:#dc2626;}
.badge-programada{background:#ede9fe;color:#6d28d9;}
.badge-pagada  {background:#dcfce7;color:#166534;}
.badge-borrador{background:#f1f5f9;color:#475569;}

/* fecha / monto col */
.fecha-col{font-size:12px;color:var(--text-muted);}
.fecha-col span{display:block;font-size:13px;color:var(--text-main);font-weight:500;}
.monto-col{font-weight:600;}
.empleados-pill{background:#f0f2f8;border-radius:20px;padding:2px 10px;font-size:12px;color:var(--text-muted);}

/* ACCIONES */
.btn-accion{background:none;border:none;cursor:pointer;padding:5px 7px;border-radius:6px;
            font-size:15px;transition:background .15s;}
.btn-accion:hover{background:#f3f4f6;}
.btn-accion.edit:hover{background:#eff2ff;}
.btn-accion.del:hover{background:#fdecea;}

/* FOOTER */
.card-footer{display:flex;align-items:center;justify-content:space-between;
             padding:12px 20px;border-top:1px solid var(--border);font-size:12px;color:var(--text-muted);}
.pag-btns{display:flex;gap:6px;}
.pag-btn{width:30px;height:30px;border:1px solid var(--border);border-radius:7px;background:#fff;
         cursor:pointer;font-size:12px;font-weight:600;color:var(--text-muted);
         display:flex;align-items:center;justify-content:center;text-decoration:none;}
.pag-btn.active{background:var(--primary);color:#fff;border-color:var(--primary);}
.pag-btn:hover:not(.active):not(.disabled){border-color:var(--primary);color:var(--primary);}
.pag-btn.disabled{opacity:.4;pointer-events:none;}

/* ALERT */
.alert-ok{background:#e6faf8;border:1px solid #6ee7b7;border-radius:10px;
          padding:11px 18px;color:#065f46;font-size:13px;margin-bottom:16px;
          display:flex;align-items:center;gap:8px;}

/* MODAL */
.gra-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:1000;
          align-items:center;justify-content:center;}
.gra-overlay.open{display:flex;}
.gra-modal{background:#fff;border-radius:14px;width:600px;max-width:96vw;max-height:90vh;
           overflow-y:auto;
       box-shadow:0 8px 40px rgba(0,0,0,.18);}
.gra-modal-head{display:flex;align-items:center;justify-content:space-between;
            padding:18px 22px;border-bottom:1px solid var(--border);position:sticky;top:0;background:#fff;z-index:1;}
.gra-modal-head h3{font-size:15px;font-weight:700;color:var(--text-main);}
.gra-modal-close{background:none;border:none;font-size:20px;cursor:pointer;color:var(--text-muted);
             width:32px;height:32px;border-radius:6px;display:flex;align-items:center;justify-content:center;}
.gra-modal-close:hover{background:#f3f4f6;}
.gra-modal-body{padding:22px;display:grid;grid-template-columns:1fr 1fr;gap:16px;}
.gra-modal-body .full{grid-column:1/-1;}
.gra-modal-foot{padding:16px 22px;border-top:1px solid var(--border);
            display:flex;justify-content:flex-end;gap:10px;position:sticky;bottom:0;background:#fff;}
.f-label{font-size:11px;font-weight:700;text-transform:uppercase;
         letter-spacing:.5px;color:var(--text-muted);display:block;margin-bottom:5px;}
.f-input,.f-select{width:100%;border:1px solid var(--border);border-radius:8px;
                   padding:9px 12px;font-size:13px;outline:none;background:#fff;
                   box-sizing:border-box;color:var(--text-main);transition:border .2s;}
.f-input:focus,.f-select:focus{border-color:var(--primary);}
.btn-cancel{background:#fff;border:1px solid var(--border);border-radius:8px;
            padding:9px 20px;font-size:13px;font-weight:600;cursor:pointer;color:var(--text-main);}
.btn-cancel:hover{background:#f8f9fa;}
.btn-save{background:var(--primary);color:#fff;border:none;border-radius:8px;
          padding:9px 22px;font-size:13px;font-weight:600;cursor:pointer;}
.btn-save:hover{background:#3451d1;}
</style>

<!-- HEADER -->
<div class="nom-header">
  <div class="nom-brand">
    <div class="nom-brand-icon">🏢</div>
    <div class="nom-brand-text">
      <h1>NÓMINA / PLANILLA</h1>
      <p>Gestión de pagos y remuneraciones</p>
    </div>
  </div>
</div>

@{
    var urlDashboard      = Url.Action("Index",           "Nomina");
    var urlPlanillas      = Url.Action("Planillas",       "Nomina");
    var urlEmpleados      = Url.Action("Empleados",       "Nomina");
    var urlConceptos      = Url.Action("Conceptos",       "Nomina");
    var urlDescuentos     = Url.Action("Descuentos",      "Nomina");
    var urlBeneficios     = Url.Action("Beneficios",      "Nomina");
    var urlEsSalud        = Url.Action("EsSalud",        "Nomina");
    var urlGratificaciones= Url.Action("Gratificaciones", "Nomina");
    var urlUtilidades     = Url.Action("Utilidades",      "Nomina");
    var urlSunat          = Url.Action("SunatPdt",       "Nomina");
    var urlHistorial      = Url.Action("HistorialPagos",  "Nomina");
    var urlConfiguracion  = Url.Action("Configuracion",   "Nomina");
    var urlReportes       = Url.Action("Reportes",        "Nomina");
}
<div class="nom-tabs">
  <a class="nom-tab" href="@urlDashboard">📊 Dashboard</a>
  <a class="nom-tab" href="@urlPlanillas">📋 Planillas</a>
  <a class="nom-tab" href="@urlEmpleados">👤 Empleados</a>
  <a class="nom-tab" href="@urlConceptos">💡 Conceptos</a>
  <a class="nom-tab" href="@urlDescuentos">🏷️ Descuentos</a>
  <a class="nom-tab" href="@urlBeneficios">🎁 Beneficios</a>
  <a class="nom-tab" href="@urlEsSalud">🏥 EsSalud / SCTR</a>
  <a class="nom-tab" href="@urlGratificaciones">🎖️ Gratificaciones</a>
  <a class="nom-tab" href="@urlUtilidades">📊 Utilidades / Participación</a>
  <a class="nom-tab" href="@urlSunat">🏛️ SUNAT / PDT</a>
  <a class="nom-tab" href="@urlHistorial">📜 Historial de Pagos</a>
  <a class="nom-tab" href="@urlReportes">📈 Reportes</a>
  <a class="nom-tab" href="@urlConfiguracion">⚙️ Configuración</a>
</div>

<!-- BODY -->
<div class="nom-body">

  @if (TempData["MensajeGratificacion"] != null)
  {
    <div class="alert-ok">✅ @TempData["MensajeGratificacion"]</div>
  }

  <!-- KPI -->
  <div class="kpi-row">
    <div class="kpi-card">
      <div class="kpi-ico purple">🎖️</div>
      <div>
        <span class="kpi-lbl">Total Gratificaciones</span>
        <div class="kpi-val">@ViewBag.StatsTotal</div>
        <div class="kpi-sub">Todas las gratificaciones</div>
      </div>
    </div>
    <div class="kpi-card">
      <div class="kpi-ico green">✅</div>
      <div>
        <span class="kpi-lbl">Activas</span>
        <div class="kpi-val">@ViewBag.StatsActivas</div>
        <div class="kpi-sub">Gratificaciones activas</div>
      </div>
    </div>
    <div class="kpi-card">
      <div class="kpi-ico yellow">⏳</div>
      <div>
        <span class="kpi-lbl">Pendientes de Cálculo</span>
        <div class="kpi-val">@ViewBag.StatsPendientes</div>
        <div class="kpi-sub">Próximos períodos</div>
      </div>
    </div>
    <div class="kpi-card">
      <div class="kpi-ico blue">💳</div>
      <div>
        <span class="kpi-lbl">Pagadas Este Año</span>
        <div class="kpi-val">@ViewBag.StatsPagadas</div>
        <div class="kpi-sub">Gratificaciones pagadas</div>
      </div>
    </div>
    <div class="kpi-card">
      <div class="kpi-ico orange">💰</div>
      <div>
        <span class="kpi-lbl">Monto Total Este Año</span>
        <div class="kpi-val" style="font-size:18px;">S/ @montoTotalAnio.ToString("N2")</div>
        <div class="kpi-sub">Total de gratificaciones pagadas</div>
      </div>
    </div>
  </div>

  <!-- TABLA -->
  <div class="main-card">
    <div class="card-head">
      <div>
        <div class="card-title">Gratificaciones</div>
        <div class="card-sub">Administra las gratificaciones y bonos que se otorgan a los empleados.</div>
      </div>
      <button class="btn-nuevo" onclick="abrirModalGratificacion()">+ Nueva Gratificación</button>
    </div>

    <!-- TOOLBAR -->
    <form method="get" asp-action="Gratificaciones">
      <div class="toolbar">
        <div class="search-wrap">
          <span class="search-ico">🔍</span>
          <input type="text" name="buscar" value="@Model.Buscar"
                 placeholder="Buscar gratificación por nombre o código..." />
        </div>
        <select name="tipo" class="filter-sel" onchange="this.form.submit()">
          <option value="">Todos los tipos</option>
          @{ var tipos = new[] { ("Obligatoria","Obligatoria"), ("Voluntaria","Voluntaria") }; }
          @foreach (var (val, lbl) in tipos)
          {
            if (Model.TipoFiltro == val) { <option value="@val" selected>@lbl</option> }
            else { <option value="@val">@lbl</option> }
          }
        </select>
        <select name="estado" class="filter-sel" onchange="this.form.submit()">
          <option value="">Todos los estados</option>
          @{ var estados = new[] { ("Activa","Activa"),("Pendiente","Pendiente"),("Programada","Programada"),("Pagada","Pagada"),("Borrador","Borrador") }; }
          @foreach (var (val, lbl) in estados)
          {
            if (Model.EstadoFiltro == val) { <option value="@val" selected>@lbl</option> }
            else { <option value="@val">@lbl</option> }
          }
        </select>
        <button type="submit" class="btn-filtro">🔽 Filtros</button>
      </div>
    </form>

    <!-- TABLE -->
    <table class="gra-table">
      <thead>
        <tr>
          <th>CÓDIGO</th>
          <th>GRATIFICACIÓN</th>
          <th>TIPO</th>
          <th>PERÍODO</th>
          <th>FRECUENCIA</th>
          <th>% / MONTO</th>
          <th>BASE DE CÁLCULO</th>
          <th>FECHA ESTIMADA</th>
          <th>FECHA PAGO</th>
          <th>ESTADO</th>
          <th>EMPLEADOS APLICA</th>
          <th>CREADO POR</th>
          <th>ACCIONES</th>
        </tr>
      </thead>
      <tbody>
        @if (!Model.Gratificaciones.Any())
        {
          <tr><td colspan="13" style="text-align:center;padding:32px;color:var(--text-muted);">
            No se encontraron gratificaciones con los filtros aplicados.
          </td></tr>
        }
        @foreach (var g in Model.Gratificaciones)
        {
          <tr>
            <td>@g.Codigo</td>
            <td style="max-width:180px;font-weight:500;">@g.Nombre</td>
            <td><span class="badge @TipoBadge(g.Tipo)">@TipoLabel(g.Tipo)</span></td>
            <td>@g.Periodo</td>
            <td><span class="badge" style="background:#f0f2f8;color:#374151;">@FrecuenciaLabel(g.Frecuencia)</span></td>
            <td class="monto-col">@g.PorcentajeMonto</td>
            <td style="font-size:12px;color:var(--text-muted);">@BaseLabel(g.BaseDeCalculo)</td>
            <td class="fecha-col">
              @if (g.FechaEstimada.HasValue)
              {
                <span>📅 @g.FechaEstimada.Value.ToString("dd/MM/yyyy")</span>
              }
              else { <text>—</text> }
            </td>
            <td class="fecha-col">
              @if (g.FechaPago.HasValue)
              {
                <span>@g.FechaPago.Value.ToString("dd/MM/yyyy")</span>
              }
              else { <text>—</text> }
            </td>
            <td><span class="badge @EstadoBadge(g.Estado)">@EstadoLabel(g.Estado)</span></td>
            <td>
              <span class="empleados-pill">@g.EmpleadosAplica (@g.CantidadEmpleados)</span>
            </td>
            <td style="font-size:12px;color:var(--text-muted);">@g.CreadoPor</td>
            <td>
              <button class="btn-accion edit" title="Editar"
                      onclick="cargarEdicionGratificacion(@g.Id)">✏️</button>
              <form method="post" asp-action="EliminarGratificacion" style="display:inline"
                    onsubmit="return confirm('¿Eliminar @g.Nombre?')">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@g.Id" />
                <button type="submit" class="btn-accion del" title="Eliminar">🗑️</button>
              </form>
            </td>
          </tr>
        }
      </tbody>
    </table>

    <!-- FOOTER / PAGINACIÓN -->
    <div class="card-footer">
      <span>
        @if (Model.TotalItems == 0) { <text>Sin resultados</text> }
        else { <text>Mostrando @inicio a @fin de @Model.TotalItems gratificaci@(Model.TotalItems!=1?"ones":"ón")</text> }
      </span>
      <div class="pag-btns">
        <a class="pag-btn @(Model.PaginaActual<=1?"disabled":"")"
           href="@PagUrl(Model.PaginaActual-1)">‹</a>
        @for (int i = 1; i <= Model.TotalPaginas; i++)
        {
          <a class="pag-btn @(i==Model.PaginaActual?"active":"")"
             href="@PagUrl(i)">@i</a>
        }
        <a class="pag-btn @(Model.PaginaActual>=Model.TotalPaginas?"disabled":"")"
           href="@PagUrl(Model.PaginaActual+1)">›</a>
      </div>
    </div>
  </div>
</div>

<!-- MODAL CREAR / EDITAR -->
<div class="gra-overlay" id="graModalOverlay">
  <div class="gra-modal">
    <div class="gra-modal-head">
      <h3 id="modalTitulo">Nueva Gratificación</h3>
      <button class="gra-modal-close" onclick="cerrarModalGratificacion()">✕</button>
    </div>
    <form id="formGratificacion" method="post">
      @Html.AntiForgeryToken()
      <input type="hidden" id="graId" name="id" />
      <div class="gra-modal-body">
        <div class="full">
          <label class="f-label">NOMBRE DE LA GRATIFICACIÓN</label>
          <input id="fNombre" name="nombre" class="f-input" placeholder="Ej. Bono por productividad" required />
        </div>
        <div>
          <label class="f-label">TIPO</label>
          <select id="fTipo" name="tipoGrat" class="f-select">
            <option value="Obligatoria">Obligatoria</option>
            <option value="Voluntaria">Voluntaria</option>
          </select>
        </div>
        <div>
          <label class="f-label">PERÍODO</label>
          <input id="fPeriodo" name="periodo" class="f-input" placeholder="Ej. Julio 2025" required />
        </div>
        <div>
          <label class="f-label">FRECUENCIA</label>
          <select id="fFrecuencia" name="frecuencia" class="f-select">
            <option value="Mensual">Mensual</option>
            <option value="Semestral">Semestral</option>
            <option value="Anual">Anual</option>
            <option value="Unica">Única</option>
            <option value="Variable">Variable</option>
          </select>
        </div>
        <div>
          <label class="f-label">% / MONTO (DESCRIPCIÓN)</label>
          <input id="fPorcentajeMonto" name="porcentajeMonto" class="f-input" placeholder="Ej. 50% salario" required />
        </div>
        <div>
          <label class="f-label">BASE DE CÁLCULO</label>
          <select id="fBaseCalculo" name="baseCalculo" class="f-select">
            <option value="RemuneracionBasica">Remuneración Básica</option>
            <option value="RemuneracionComputable">Remuneración Computable</option>
            <option value="SalarioNeto">Salario Neto</option>
            <option value="Fijo">Fija</option>
            <option value="PorcentajeVariable">Porcentaje variable</option>
          </select>
        </div>
        <div>
          <label class="f-label">MONTO FIJO (S/) — opcional</label>
          <input id="fMontoFijo" name="montoFijo" type="number" step="0.01" min="0"
                 class="f-input" placeholder="Ej. 1000.00" />
        </div>
        <div>
          <label class="f-label">PORCENTAJE — opcional</label>
          <input id="fPorcentaje" name="porcentaje" type="number" step="0.01" min="0" max="100"
                 class="f-input" placeholder="Ej. 50" />
        </div>
        <div>
          <label class="f-label">FECHA ESTIMADA</label>
          <input id="fFechaEstimada" name="fechaEstimada" type="date" class="f-input" />
        </div>
        <div>
          <label class="f-label">ESTADO</label>
          <select id="fEstado" name="estadoGrat" class="f-select">
            <option value="Activa">Activa</option>
            <option value="Pendiente">Pendiente</option>
            <option value="Programada">Programada</option>
            <option value="Pagada">Pagada</option>
            <option value="Borrador">Borrador</option>
          </select>
        </div>
        <div>
          <label class="f-label">EMPLEADOS APLICA</label>
          <input id="fEmpleados" name="empleadosAplica" class="f-input" placeholder="Ej. Todos, Ventas, IT" />
        </div>
        <div>
          <label class="f-label">CANTIDAD DE EMPLEADOS</label>
          <input id="fCantidad" name="cantidadEmpleados" type="number" min="0"
                 class="f-input" placeholder="Ej. 120" />
        </div>
      </div>
      <div class="gra-modal-foot">
        <button type="button" class="btn-cancel" onclick="cerrarModalGratificacion()">Cancelar</button>
        <button type="submit" class="btn-save" id="btnGuardar">✔ Crear Gratificación</button>
      </div>
    </form>
  </div>
</div>

<script>
(function() {
  const overlay = document.getElementById('graModalOverlay');
  const form    = document.getElementById('formGratificacion');

  window.abrirModalGratificacion = function() {
    document.getElementById('modalTitulo').textContent = 'Nueva Gratificación';
    document.getElementById('btnGuardar').textContent  = '✔ Crear Gratificación';
    form.action = '/Nomina/CrearGratificacion';
    form.reset();
    document.getElementById('graId').value = '';
    overlay.classList.add('open');
  };

  window.cargarEdicionGratificacion = async function(id) {
    const r = await fetch(`/Nomina/ObtenerGratificacion?id=${id}`);
    if (!r.ok) return;
    const d = await r.json();
    document.getElementById('modalTitulo').textContent = 'Editar Gratificación';
    document.getElementById('btnGuardar').textContent  = '💾 Guardar Cambios';
    form.action = '/Nomina/EditarGratificacion';
    document.getElementById('graId').value              = d.id;
    document.getElementById('fNombre').value            = d.nombre;
    document.getElementById('fTipo').value              = d.tipo;
    document.getElementById('fPeriodo').value           = d.periodo;
    document.getElementById('fFrecuencia').value        = d.frecuencia;
    document.getElementById('fPorcentajeMonto').value   = d.porcentajeMonto;
    document.getElementById('fBaseCalculo').value       = d.baseCalculo;
    document.getElementById('fMontoFijo').value         = d.montoFijo ?? '';
    document.getElementById('fPorcentaje').value        = d.porcentaje ?? '';
    document.getElementById('fFechaEstimada').value     = d.fechaEstimada ?? '';
    document.getElementById('fEstado').value            = d.estado;
    document.getElementById('fEmpleados').value         = d.empleadosAplica;
    document.getElementById('fCantidad').value          = d.cantidadEmpleados;
    overlay.classList.add('open');
  };

  window.cerrarModalGratificacion = function() { overlay.classList.remove('open'); };
  overlay.addEventListener('click', e => { if (e.target === overlay) window.cerrarModalGratificacion(); });
})();
</script>
