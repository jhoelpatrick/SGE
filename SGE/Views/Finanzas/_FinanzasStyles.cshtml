<style>
    .fin-page {
        padding: 30px;
        background: #f3f6fb;
        color: #111827;
        font-family: "Segoe UI", Arial, sans-serif;
        min-height: 100%;
    }

    .fin-shell {
        max-width: 1320px;
        margin: 0 auto;
    }

    .fin-topbar,
    .fin-card,
    .fin-panel,
    .fin-tabs,
    .fin-formbar {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 18px;
        box-shadow: 0 12px 28px rgba(15, 23, 42, .06);
    }

    .fin-topbar {
        padding: 18px 22px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 26px;
    }

    .fin-breadcrumb {
        color: #64748b;
        font-size: 13px;
        font-weight: 700;
    }

    .fin-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 18px;
        margin-bottom: 24px;
    }

    .fin-title {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .fin-icon {
        width: 54px;
        height: 54px;
        border-radius: 16px;
        display: grid;
        place-items: center;
        background: #ccfbf1;
        color: #0f766e;
        font-size: 24px;
    }

    .fin-title h1 {
        margin: 0;
        color: #0f172a;
        font-size: 32px;
        font-weight: 900;
    }

    .fin-title p {
        margin: 5px 0 0;
        color: #64748b;
        font-size: 14px;
        font-weight: 600;
    }

    .fin-actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .fin-btn {
        border: 1px solid #e5e7eb;
        background: #fff;
        color: #334155;
        border-radius: 12px;
        padding: 11px 15px;
        font-weight: 800;
        font-size: 13px;
        cursor: pointer;
    }

    .fin-btn.primary {
        background: #14b8a6;
        border-color: #14b8a6;
        color: #fff;
    }

    .fin-kpis {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 16px;
        margin-bottom: 22px;
    }

    .fin-card {
        padding: 18px;
        min-height: 126px;
    }

    .fin-card-head {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
    }

    .fin-card small,
    .fin-muted {
        color: #64748b;
        font-size: 12px;
        font-weight: 700;
    }

    .fin-card strong {
        display: block;
        color: #0f172a;
        font-size: 20px;
        font-weight: 900;
        margin: 12px 0 10px;
    }

    .fin-tone {
        width: 40px;
        height: 40px;
        border-radius: 13px;
        display: grid;
        place-items: center;
        font-size: 18px;
        background: #e0e7ff;
        color: #4f46e5;
    }

    .fin-pill {
        display: inline-flex;
        align-items: center;
        width: fit-content;
        border-radius: 999px;
        padding: 7px 10px;
        font-size: 12px;
        font-weight: 900;
        background: #ecfeff;
        color: #0f766e;
    }

    .fin-tabs {
        padding: 8px;
        display: flex;
        gap: 8px;
        margin-bottom: 22px;
        overflow-x: auto;
    }

    .fin-tab {
        border: 0;
        background: transparent;
        color: #334155;
        padding: 11px 15px;
        border-radius: 12px;
        font-size: 13px;
        font-weight: 900;
        white-space: nowrap;
        cursor: pointer;
    }

    .fin-tab.active {
        background: #111827;
        color: #fff;
    }

    .fin-section {
        display: none;
    }

    .fin-section.active {
        display: block;
    }

    .fin-grid {
        display: grid;
        grid-template-columns: 1.25fr .75fr;
        gap: 18px;
    }

    .fin-panel {
        overflow: hidden;
        margin-bottom: 18px;
    }

    .fin-panel-header {
        padding: 18px 20px;
        border-bottom: 1px solid #e5e7eb;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
    }

    .fin-panel-header h2 {
        margin: 0;
        font-size: 18px;
        font-weight: 900;
        color: #111827;
    }

    .fin-panel-body {
        padding: 20px;
    }

    .fin-table-wrap {
        overflow-x: auto;
    }

    .fin-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 780px;
    }

    .fin-table th {
        background: #f8fafc;
        color: #64748b;
        font-size: 11px;
        letter-spacing: .4px;
        text-transform: uppercase;
        padding: 13px 14px;
        border-bottom: 1px solid #e5e7eb;
    }

    .fin-table td {
        padding: 14px;
        border-bottom: 1px solid #e5e7eb;
        color: #334155;
        font-size: 13px;
        vertical-align: middle;
    }

    .fin-code,
    .fin-money {
        color: #0f172a;
        font-weight: 900;
    }

    .fin-money.in {
        color: #0f766e;
    }

    .fin-money.out {
        color: #b45309;
    }

    .fin-form {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
    }

    .fin-form .full {
        grid-column: 1 / -1;
    }

    .fin-form label {
        display: block;
        color: #64748b;
        font-size: 11px;
        font-weight: 900;
        text-transform: uppercase;
        margin-bottom: 6px;
    }

    .fin-form input,
    .fin-form select {
        width: 100%;
        height: 42px;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        background: #f8fafc;
        color: #334155;
        padding: 0 12px;
        font: inherit;
        font-size: 13px;
        font-weight: 700;
    }

    .fin-alert {
        border-radius: 14px;
        padding: 13px 15px;
        margin-bottom: 18px;
        font-size: 13px;
        font-weight: 800;
    }

    .fin-alert.ok {
        background: #dcfce7;
        color: #15803d;
        border: 1px solid #bbf7d0;
    }

    .fin-alert.error {
        background: #fee2e2;
        color: #b91c1c;
        border: 1px solid #fecaca;
    }

    .fin-summary {
        background: #0f766e;
        color: #fff;
        border-radius: 16px;
        padding: 20px;
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 18px;
        margin-bottom: 18px;
    }

    .fin-summary small {
        display: block;
        opacity: .85;
        font-weight: 700;
        margin-bottom: 6px;
    }

    .fin-summary strong {
        font-size: 26px;
        font-weight: 900;
    }

    @@media (max-width: 1100px) {
        .fin-kpis {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .fin-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 720px) {
        .fin-page {
            padding: 18px;
        }

        .fin-header,
        .fin-topbar {
            align-items: flex-start;
            flex-direction: column;
        }

        .fin-kpis,
        .fin-form,
        .fin-summary {
            grid-template-columns: 1fr;
        }
    }
</style>
<script>
    function finShowTab(group, target) {
        document.querySelectorAll("[data-fin-group='" + group + "']").forEach(function (item) {
            item.classList.remove("active");
        });

        document.querySelectorAll("[data-fin-tab-group='" + group + "']").forEach(function (item) {
            item.classList.remove("active");
        });

        var tab = document.querySelector("[data-fin-tab-group='" + group + "'][data-fin-target='" + target + "']");
        var section = document.querySelector("[data-fin-group='" + group + "'][data-fin-section='" + target + "']");

        if (tab) tab.classList.add("active");
        if (section) section.classList.add("active");
    }
</script>
