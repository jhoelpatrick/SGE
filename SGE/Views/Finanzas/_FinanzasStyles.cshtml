<style>
    .fin-page {
        padding: 1rem 1.5rem;
        background: transparent;
        color: #111827;
        font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        min-height: 100%;
    }

    .fin-shell {
        max-width: none;
        margin: 0 auto;
    }

    .fin-card,
    .fin-panel,
    .fin-tabs,
    .fin-formbar {
        background: #fff;
        border: 0;
        border-radius: 16px;
        box-shadow: 0 .125rem .625rem rgba(0,0,0,.07);
    }

    .fin-topbar {
        display: none;
    }

    .fin-breadcrumb {
        color: #64748b;
        font-size: 13px;
        font-weight: 700;
    }

    .fin-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 18px;
        margin-bottom: 24px;
        margin-top: 8px;
    }

    .fin-title {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .fin-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: grid;
        place-items: center;
        background: rgba(13, 148, 136, .1);
        color: #0d9488;
        font-size: 24px;
    }

    .fin-title h1 {
        margin: 0;
        color: #0f172a;
        font-size: 32px;
        font-weight: 800;
    }

    .fin-title p {
        margin: 5px 0 0;
        color: #64748b;
        font-size: 14px;
        font-weight: 500;
    }

    .fin-actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .fin-btn {
        border: 1px solid #e5e7eb;
        background: #fff;
        color: #334155;
        border-radius: 10px;
        padding: 10px 15px;
        font-weight: 700;
        font-size: 13px;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        text-decoration: none;
        transition: all .15s;
    }

    .fin-btn.primary {
        background: linear-gradient(135deg, #0d9488 0%, #0f766e 100%);
        border-color: #0f766e;
        color: #fff;
    }

    .fin-btn:hover {
        border-color: #0d9488;
        color: #0f766e;
    }

    .fin-btn.primary:hover {
        color: #fff;
        filter: brightness(.96);
    }

    .fin-kpis {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 16px;
        margin-bottom: 24px;
    }

    .fin-card {
        padding: 18px 20px;
        min-height: 112px;
        transition: transform .2s, box-shadow .2s;
    }

    .fin-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 20px -6px rgba(0,0,0,.08);
    }

    .fin-card-head {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
    }

    .fin-card small,
    .fin-muted {
        color: #64748b;
        font-size: 12px;
        font-weight: 700;
    }

    .fin-card strong {
        display: block;
        color: #0f172a;
        font-size: 22px;
        font-weight: 900;
        margin: 12px 0 10px;
    }

    .fin-tone {
        width: 40px;
        height: 40px;
        border-radius: 13px;
        display: grid;
        place-items: center;
        font-size: 18px;
        background: #e0e7ff;
        color: #4f46e5;
    }

    .fin-pill {
        display: inline-flex;
        align-items: center;
        width: fit-content;
        border-radius: 999px;
        padding: 7px 10px;
        font-size: 12px;
        font-weight: 900;
        background: #ecfeff;
        color: #0f766e;
    }

    .fin-tabs {
        padding: 8px;
        display: flex;
        gap: 8px;
        margin-bottom: 24px;
        overflow-x: auto;
        max-width: fit-content;
    }

    .fin-tab {
        border: 0;
        background: transparent;
        color: #334155;
        padding: 11px 15px;
        border-radius: 10px;
        font-size: 13px;
        font-weight: 700;
        white-space: nowrap;
        cursor: pointer;
    }

    .fin-tab.active {
        background: #0f766e;
        color: #fff;
    }

    .fin-section {
        display: none;
    }

    .fin-section.active {
        display: block;
    }

    .fin-grid {
        display: grid;
        grid-template-columns: 1.25fr .75fr;
        gap: 18px;
    }

    .fin-panel {
        overflow: hidden;
        margin-bottom: 20px;
    }

    .fin-panel-header {
        padding: 16px 20px;
        border-bottom: 1px solid #f3f4f6;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
    }

    .fin-panel-header h2 {
        margin: 0;
        font-size: 18px;
        font-weight: 800;
        color: #111827;
    }

    .fin-panel-body {
        padding: 20px;
    }

    .fin-table-wrap {
        overflow-x: auto;
    }

    .fin-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 780px;
    }

    .fin-table th {
        background: #f8fafc;
        color: #64748b;
        font-size: 12px;
        letter-spacing: 0;
        text-transform: uppercase;
        padding: 13px 14px;
        border-bottom: 1px solid #e5e7eb;
    }

    .fin-table td {
        padding: 14px;
        border-bottom: 1px solid #e5e7eb;
        color: #334155;
        font-size: 13px;
        vertical-align: middle;
    }

    .fin-code,
    .fin-money {
        color: #0f172a;
        font-weight: 900;
    }

    .fin-money.in {
        color: #0f766e;
    }

    .fin-money.out {
        color: #b45309;
    }

    .fin-form {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
    }

    .fin-form .full {
        grid-column: 1 / -1;
    }

    .fin-form label {
        display: block;
        color: #64748b;
        font-size: 11px;
        font-weight: 900;
        text-transform: uppercase;
        margin-bottom: 6px;
    }

    .fin-form input,
    .fin-form select,
    .fin-table-input {
        width: 100%;
        height: 42px;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        background: #f8fafc;
        color: #334155;
        padding: 0 12px;
        font: inherit;
        font-size: 13px;
        font-weight: 700;
    }

    .fin-row-actions,
    .fin-inline-form {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .fin-icon-btn {
        width: 36px;
        height: 36px;
        border: 1px solid #d1d5db;
        border-radius: 10px;
        background: #fff;
        color: #0f766e;
        display: inline-grid;
        place-items: center;
        cursor: pointer;
        font-size: 16px;
    }

    .fin-icon-btn:hover {
        background: #ecfeff;
        border-color: #99f6e4;
    }

    .fin-btn.subtle {
        background: #f8fafc;
        color: #0f172a;
    }

    .fin-btn.danger {
        background: #fff7ed;
        border-color: #fed7aa;
        color: #c2410c;
    }

    .fin-modal {
        position: fixed;
        inset: 0;
        z-index: 9999;
        display: none;
        align-items: center;
        justify-content: center;
        padding: 24px;
        background: rgba(15, 23, 42, .45);
    }

    .fin-modal.open {
        display: flex;
    }

    .fin-section.fin-modal-section {
        position: fixed;
        inset: 0;
        width: 100vw;
        height: 100vh;
        z-index: 9999;
        display: none;
        align-items: center;
        justify-content: center;
        padding: 24px;
        background: rgba(15, 23, 42, .45);
    }

    .fin-section.fin-modal-section.open {
        display: flex;
    }

    body.fin-modal-lock {
        overflow: hidden;
    }

    .fin-section.fin-modal-section > .fin-panel,
    .fin-section.fin-modal-section > .fin-grid {
        width: min(720px, calc(100vw - 48px));
        max-height: calc(100vh - 48px);
        overflow: auto;
        margin: auto;
    }

    .fin-section.fin-modal-section > .fin-grid {
        display: block;
    }

    .fin-section.fin-modal-section > .fin-grid > .fin-panel {
        width: 100%;
        margin-bottom: 0;
    }

    .fin-section.fin-modal-section .fin-panel {
        box-shadow: 0 24px 70px rgba(15, 23, 42, .22);
    }

    .fin-section.fin-modal-section > .fin-grid > .fin-panel[style*="display: none"] {
        display: none !important;
    }

    .fin-modal-card {
        width: min(720px, calc(100vw - 48px));
        max-height: calc(100vh - 48px);
        overflow: auto;
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 18px;
        box-shadow: 0 24px 70px rgba(15, 23, 42, .22);
    }

    .fin-modal-header {
        padding: 18px 20px;
        border-bottom: 1px solid #e5e7eb;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }

    .fin-modal-header h2 {
        margin: 0;
        color: #111827;
        font-size: 18px;
        font-weight: 900;
    }

    .fin-modal-body {
        padding: 20px;
    }

    .fin-alert {
        border-radius: 10px;
        padding: 13px 15px;
        margin-bottom: 18px;
        font-size: 13px;
        font-weight: 800;
    }

    .fin-alert.ok {
        background: #dcfce7;
        color: #15803d;
        border: 1px solid #bbf7d0;
    }

    .fin-alert.error {
        background: #fee2e2;
        color: #b91c1c;
        border: 1px solid #fecaca;
    }

    .fin-summary {
        background: #0f766e;
        color: #fff;
        border-radius: 14px;
        padding: 20px;
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 18px;
        margin-bottom: 18px;
    }

    .fin-readonly-note {
        border: 1px solid #dbeafe;
        background: #eff6ff;
        color: #1e40af;
        border-radius: 10px;
        padding: 10px 14px;
        font-size: 13px;
        font-weight: 700;
        margin-bottom: 16px;
    }

    .fin-summary small {
        display: block;
        opacity: .85;
        font-weight: 700;
        margin-bottom: 6px;
    }

    .fin-summary strong {
        font-size: 26px;
        font-weight: 900;
    }

    @@media (max-width: 1100px) {
        .fin-kpis {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .fin-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 720px) {
        .fin-page {
            padding: 18px;
        }

        .fin-header,
        .fin-topbar {
            align-items: flex-start;
            flex-direction: column;
        }

        .fin-kpis,
        .fin-form,
        .fin-summary {
            grid-template-columns: 1fr;
        }
    }
</style>
<script>
    function finShowTab(group, target) {
        var section = document.querySelector("[data-fin-group='" + group + "'][data-fin-section='" + target + "']");

        if (section && section.classList.contains("fin-modal-section")) {
            section.querySelectorAll(".fin-panel").forEach(function (panel) {
                panel.style.display = "";
            });
            finOpenModal(section.id);
            return;
        }

        document.querySelectorAll("[data-fin-group='" + group + "']").forEach(function (item) {
            if (!item.classList.contains("fin-modal-section")) {
                item.classList.remove("active");
            }
            item.classList.remove("open");
        });

        document.querySelectorAll("[data-fin-tab-group='" + group + "']").forEach(function (item) {
            item.classList.remove("active");
        });

        var tab = document.querySelector("[data-fin-tab-group='" + group + "'][data-fin-target='" + target + "']");

        if (tab) tab.classList.add("active");
        if (section) section.classList.add("active");
    }

    document.addEventListener("click", function (event) {
        var opener = event.target.closest("[data-fin-open-modal]");
        if (opener) {
            finOpenModal(opener.dataset.finOpenModal);
            return;
        }

        var closer = event.target.closest("[data-fin-close-modal]");
        if (closer) {
            finCloseModal(closer.dataset.finCloseModal);
            return;
        }

        if (event.target.classList.contains("fin-modal-section")) {
            finCloseModal(event.target.id);
            return;
        }

        var button = event.target.closest("[data-fin-load-form]");
        if (!button) return;

        var form = document.getElementById(button.dataset.finLoadForm);
        if (!form) return;

        var modalSection = form.closest(".fin-modal-section");
        if (modalSection) {
            modalSection.querySelectorAll(".fin-panel").forEach(function (panel) {
                panel.style.display = panel.contains(form) ? "" : "none";
            });
        }

        Object.keys(button.dataset).forEach(function (key) {
            if (!key.startsWith("field")) return;

            var name = key.substring(5);
            name = name.charAt(0).toLowerCase() + name.slice(1);
            var field = form.elements[name];
            if (field) field.value = button.dataset[key] || "";
        });

        if (button.dataset.finModal) {
            finOpenModal(button.dataset.finModal);
        } else if (button.dataset.finGroup && button.dataset.finTarget) {
            finShowTab(button.dataset.finGroup, button.dataset.finTarget);
        }

        var focusable = form.querySelector("input:not([type='hidden']), select, textarea");
        if (focusable) focusable.focus();
    });

    function finOpenModal(id) {
        var modal = document.getElementById(id);
        if (!modal) return;

        modal.classList.add("open");
        document.body.classList.add("fin-modal-lock");

        modal.querySelectorAll(".fin-panel-header").forEach(function (header) {
            if (header.querySelector("[data-fin-auto-close]")) return;

            var button = document.createElement("button");
            button.type = "button";
            button.className = "fin-icon-btn";
            button.setAttribute("data-fin-close-modal", id);
            button.setAttribute("data-fin-auto-close", "true");
            button.setAttribute("aria-label", "Cerrar");
            button.innerHTML = '<i class="bi bi-x-lg"></i>';
            header.appendChild(button);
        });
    }

    function finCloseModal(id) {
        var modal = document.getElementById(id);
        if (modal) modal.classList.remove("open", "active");

        if (!document.querySelector(".fin-modal.open, .fin-modal-section.open")) {
            document.body.classList.remove("fin-modal-lock");
        }
    }

    document.addEventListener("keydown", function (event) {
        if (event.key !== "Escape") return;
        document.querySelectorAll(".fin-modal.open, .fin-modal-section.open").forEach(function (modal) {
            finCloseModal(modal.id);
        });
    });
</script>
