@model SGE.Models.ImpuestosViewModel
@using SGE.Services
@{
    Layout = null;
    var canWrite = (bool?)ViewBag.FinanzasCanWrite ?? true;
    var canReport = (bool?)ViewBag.FinanzasCanReport ?? true;
    var rolActual = (string?)ViewBag.RolActual ?? "Administrador";
}
<partial name="~/Views/Finanzas/_FinanzasStyles.cshtml" />
<section class="fin-page">
    <div class="fin-shell">
        <div class="fin-header">
            <div class="fin-title">
                <div class="fin-icon"><i class="bi bi-file-earmark-text"></i></div>
                <div>
                    <h1>Impuestos</h1>
                    <p>Catalogo fiscal controlado desde la tabla finanzas.impuestos.</p>
                </div>
            </div>
            <div class="fin-actions">
                @if (canReport)
                {
                    <a class="fin-btn" href="/Finanzas/ExportarImpuestos"><i class="bi bi-download"></i> Exportar Excel</a>
                }
                @if (canWrite)
                {
                    <button class="fin-btn primary" type="button" data-fin-open-modal="modal-nuevo-impuesto"><i class="bi bi-plus-lg"></i> Nuevo impuesto</button>
                }
            </div>
        </div>

        @if (!canWrite)
        {
            <div class="fin-readonly-note"><i class="bi bi-shield-lock"></i> Vista de solo consulta para el rol @rolActual. Las acciones de creacion y edicion estan ocultas.</div>
        }

        @if (TempData["Ok"] != null) { <div class="fin-alert ok">@TempData["Ok"]</div> }
        @if (TempData["Error"] != null) { <div class="fin-alert error">@TempData["Error"]</div> }

        <div class="fin-kpis">
            @foreach (var kpi in Model.Kpis)
            {
                <article class="fin-card">
                    <div class="fin-card-head"><small>@kpi.Titulo</small><span class="fin-tone"><i class="bi @kpi.Icono"></i></span></div>
                    <strong>@kpi.Valor</strong>
                    <span class="fin-pill">@kpi.Detalle</span>
                </article>
            }
        </div>

        <div class="fin-tabs">
            <button class="fin-tab active" data-fin-tab-group="imp" data-fin-target="resumen" onclick="finShowTab('imp','resumen')">Resumen</button>
            <button class="fin-tab" data-fin-tab-group="imp" data-fin-target="tabla" onclick="finShowTab('imp','tabla')">Catalogo</button>
            <button class="fin-tab" data-fin-tab-group="imp" data-fin-target="creditos" onclick="finShowTab('imp','creditos')">Creditos fiscales</button>
        </div>

        <div class="fin-section active" data-fin-group="imp" data-fin-section="resumen">
            <div class="fin-summary">
                <div><small>IGV neto del periodo</small><strong>@FinanzasFormat.Money(Model.IgvNeto)</strong></div>
                <div><small>Monto estimado a pagar a SUNAT</small><strong>@FinanzasFormat.Money(Model.MontoEstimadoSunat)</strong></div>
            </div>
            <div class="fin-panel">
                <div class="fin-panel-header"><h2>Liquidacion de IGV</h2><span class="fin-pill">Datos contables + catalogo fiscal</span></div>
                <div class="fin-panel-body">
                    <div class="fin-kpis" style="margin-bottom:0;">
                        <article class="fin-card"><small>IGV ventas cobrado</small><strong>@FinanzasFormat.Money(Model.DebitoFiscal)</strong><span class="fin-muted">Debito fiscal</span></article>
                        <article class="fin-card"><small>IGV compras pagadas</small><strong>@FinanzasFormat.Money(Model.CreditoFiscal)</strong><span class="fin-muted">Credito fiscal</span></article>
                        <article class="fin-card"><small>Retenciones</small><strong>@FinanzasFormat.Money(Model.Retenciones)</strong><span class="fin-muted">Credito a favor</span></article>
                        <article class="fin-card"><small>Percepciones</small><strong>@FinanzasFormat.Money(Model.Percepciones)</strong><span class="fin-muted">Credito a favor</span></article>
                    </div>
                </div>
            </div>
        </div>

        <div class="fin-section" data-fin-group="imp" data-fin-section="tabla">
            <div class="fin-panel">
                <div class="fin-panel-header"><h2>Catalogo de impuestos SUNAT</h2><span class="fin-muted">Tabla finanzas.impuestos</span></div>
                <div class="fin-table-wrap">
                    <table class="fin-table">
                        <thead><tr><th>ID</th><th>Codigo SUNAT</th><th>Nombre</th><th>Porcentaje</th><th>Estado</th>@if (canWrite) { <th>Acciones</th> }</tr></thead>
                        <tbody>
                        @foreach (var item in Model.Impuestos)
                        {
                            var stateFormId = $"imp-state-{item.ImpuestoId}";
                            <tr>
                                <td>@item.ImpuestoId</td>
                                <td class="fin-code">@item.CodigoImpuestoSunat</td>
                                <td>@item.NombreImpuesto</td>
                                <td class="fin-money">@item.Porcentaje.ToString("0.##")%</td>
                                <td><span class="fin-pill">@(item.Estado ? "Activo" : "Inactivo")</span></td>
                                @if (canWrite)
                                {
                                    <td>
                                        <form id="@stateFormId" class="fin-row-actions" method="post" action="/Finanzas/CambiarEstadoImpuesto">
                                            <input type="hidden" name="impuestoId" value="@item.ImpuestoId" />
                                            <input type="hidden" name="estado" value="@((!item.Estado).ToString().ToLowerInvariant())" />
                                            <button class="fin-btn subtle" type="button"
                                                    data-fin-load-form="form-editar-impuesto"
                                                    data-fin-modal="modal-editar-impuesto"
                                                    data-field-impuesto-id="@item.ImpuestoId"
                                                    data-field-codigo-impuesto-sunat="@item.CodigoImpuestoSunat"
                                                    data-field-nombre-impuesto="@item.NombreImpuesto"
                                                    data-field-porcentaje="@item.Porcentaje.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
                                                    data-field-estado="@item.Estado.ToString().ToLowerInvariant()">
                                                <i class="bi bi-pencil"></i> Editar
                                            </button>
                                            <button class="fin-btn @(item.Estado ? "danger" : "subtle")" type="submit">@(item.Estado ? "Desactivar" : "Activar")</button>
                                        </form>
                                    </td>
                                }
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="fin-section" data-fin-group="imp" data-fin-section="creditos">
            <div class="fin-panel">
                <div class="fin-panel-header"><h2>Creditos a favor</h2><span class="fin-muted">Retenciones y percepciones activas</span></div>
                <div class="fin-panel-body">
                    <div class="fin-summary">
                        <div><small>Retenciones acumuladas</small><strong>@FinanzasFormat.Money(Model.Retenciones)</strong></div>
                        <div><small>Percepciones acumuladas</small><strong>@FinanzasFormat.Money(Model.Percepciones)</strong></div>
                    </div>
                </div>
                <div class="fin-table-wrap">
                    <table class="fin-table">
                        <thead><tr><th>Tipo</th><th>Codigo SUNAT</th><th>Impuesto</th><th>Porcentaje</th><th>Estado</th><th>Uso operativo</th></tr></thead>
                        <tbody>
                        @foreach (var item in Model.Impuestos.Where(x => x.NombreImpuesto.Contains("Retencion", StringComparison.OrdinalIgnoreCase) || x.NombreImpuesto.Contains("Percepcion", StringComparison.OrdinalIgnoreCase)))
                        {
                            var tipo = item.NombreImpuesto.Contains("Retencion", StringComparison.OrdinalIgnoreCase) ? "Retencion" : "Percepcion";
                            <tr>
                                <td><span class="fin-pill">@tipo</span></td>
                                <td class="fin-code">@item.CodigoImpuestoSunat</td>
                                <td>@item.NombreImpuesto</td>
                                <td class="fin-money">@item.Porcentaje.ToString("0.##")%</td>
                                <td><span class="fin-pill">@(item.Estado ? "Activo" : "Inactivo")</span></td>
                                <td>@(tipo == "Retencion" ? "Credito contra pagos tributarios" : "Credito generado en compras sujetas a percepcion")</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="fin-panel">
                <div class="fin-panel-header"><h2>Control del catalogo tributario</h2><span class="fin-muted">Basado en finanzas.impuestos</span></div>
                <div class="fin-panel-body">
                    <div class="fin-kpis" style="margin-bottom:0;">
                        <article class="fin-card"><small>Activos</small><strong>@Model.Impuestos.Count(x => x.Estado)</strong><span class="fin-muted">Disponibles para operaciones</span></article>
                        <article class="fin-card"><small>Inactivos</small><strong>@Model.Impuestos.Count(x => !x.Estado)</strong><span class="fin-muted">Bloqueados para uso</span></article>
                        <article class="fin-card"><small>Retenciones</small><strong>@Model.Impuestos.Count(x => x.NombreImpuesto.Contains("Retencion", StringComparison.OrdinalIgnoreCase))</strong><span class="fin-muted">Catalogadas</span></article>
                        <article class="fin-card"><small>Percepciones</small><strong>@Model.Impuestos.Count(x => x.NombreImpuesto.Contains("Percepcion", StringComparison.OrdinalIgnoreCase))</strong><span class="fin-muted">Catalogadas</span></article>
                    </div>
                </div>
            </div>
        </div>

        @if (canWrite)
        {
            <div class="fin-modal" id="modal-editar-impuesto">
                <div class="fin-modal-card">
                    <div class="fin-modal-header"><h2>Editar impuesto</h2><button class="fin-icon-btn" type="button" data-fin-close-modal="modal-editar-impuesto"><i class="bi bi-x-lg"></i></button></div>
                    <div class="fin-modal-body">
                        <form id="form-editar-impuesto" class="fin-form" method="post" action="/Finanzas/ActualizarImpuesto">
                            <input type="hidden" name="impuestoId" />
                            <div><label>Codigo SUNAT</label><input name="codigoImpuestoSunat" maxlength="4" /></div>
                            <div><label>Porcentaje</label><input name="porcentaje" type="number" step="0.01" /></div>
                            <div><label>Estado</label><select name="estado"><option value="true">Activo</option><option value="false">Inactivo</option></select></div>
                            <div class="full"><label>Nombre impuesto</label><input name="nombreImpuesto" /></div>
                            <div class="full"><button class="fin-btn primary" type="submit">Guardar cambios</button></div>
                        </form>
                    </div>
                </div>
            </div>

            <div class="fin-modal" id="modal-nuevo-impuesto">
                <div class="fin-modal-card">
                    <div class="fin-modal-header"><h2>Nuevo impuesto</h2><button class="fin-icon-btn" type="button" data-fin-close-modal="modal-nuevo-impuesto"><i class="bi bi-x-lg"></i></button></div>
                    <div class="fin-modal-body">
                        <form id="form-impuesto" class="fin-form" method="post" action="/Finanzas/CrearImpuesto">
                            <div><label>Codigo SUNAT</label><input name="CodigoImpuestoSunat" maxlength="4" placeholder="1000" /></div>
                            <div><label>Porcentaje</label><input name="Porcentaje" type="number" step="0.01" value="18" /></div>
                            <div class="full"><label>Nombre impuesto</label><input name="NombreImpuesto" placeholder="IGV" /></div>
                            <div class="full"><button class="fin-btn primary" type="submit">Guardar en SQL Server</button></div>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
</section>




