@model SGE.Models.ActivosFijosViewModel
@using SGE.Services
@{
    Layout = null;
}
<partial name="~/Views/Finanzas/_FinanzasStyles.cshtml" />
<section class="fin-page">
    <div class="fin-shell">
        <div class="fin-topbar">
            <div class="fin-breadcrumb">Inicio / Finanzas / <strong>Activos Fijos</strong></div>
            <div class="fin-actions">
                <a class="fin-btn" href="/Finanzas/ExportarActivosFijos"><i class="bi bi-download"></i> Exportar Excel</a>
                <button class="fin-btn primary" type="button" data-fin-load-form="form-activo" data-fin-modal="modal-nuevo-activo"><i class="bi bi-plus-lg"></i> Nuevo activo</button>
            </div>
        </div>

        <div class="fin-header">
            <div class="fin-title">
                <div class="fin-icon"><i class="bi bi-building"></i></div>
                <div>
                    <h1>Activos Fijos</h1>
                    <p>Gestion de altas, depreciacion y bajas de activos empresariales.</p>
                </div>
            </div>
        </div>

        @if (TempData["Ok"] != null) { <div class="fin-alert ok">@TempData["Ok"]</div> }
        @if (TempData["Error"] != null) { <div class="fin-alert error">@TempData["Error"]</div> }

        <div class="fin-kpis">
            @foreach (var kpi in Model.Kpis)
            {
                <article class="fin-card">
                    <div class="fin-card-head"><small>@kpi.Titulo</small><span class="fin-tone"><i class="bi @kpi.Icono"></i></span></div>
                    <strong>@kpi.Valor</strong>
                    <span class="fin-pill">@kpi.Detalle</span>
                </article>
            }
        </div>

        <div class="fin-tabs">
            <button class="fin-tab active" data-fin-tab-group="act" data-fin-target="tabla" onclick="finShowTab('act','tabla')">Inventario</button>
            <button class="fin-tab" data-fin-tab-group="act" data-fin-target="depreciacion" onclick="finShowTab('act','depreciacion')">Depreciacion</button>
            <button class="fin-tab" data-fin-tab-group="act" data-fin-target="bajas" onclick="finShowTab('act','bajas')">Bajas</button>
        </div>

        <div class="fin-section active" data-fin-group="act" data-fin-section="tabla">
            <div class="fin-panel">
                <div class="fin-panel-header"><h2>Inventario de activos</h2><span class="fin-muted">Tabla finanzas.activosfijos</span></div>
                <div class="fin-table-wrap">
                    <table class="fin-table">
                        <thead><tr><th>ID</th><th>Codigo</th><th>Descripcion</th><th>Producto</th><th>Fecha</th><th>Valor inicial</th><th>Tasa</th><th>Depreciacion</th><th>Valor neto</th><th>Estado</th><th>Acciones</th></tr></thead>
                        <tbody>
                        @foreach (var a in Model.Activos)
                        {
                            <tr>
                                <td>@a.ActivoId</td>
                                <td class="fin-code">@a.CodigoActivo</td>
                                <td>@a.Descripcion</td>
                                <td>@(a.ProductoId?.ToString() ?? "-")</td>
                                <td>@a.FechaAdquisicion.ToString("yyyy-MM-dd")</td>
                                <td class="fin-money">@FinanzasFormat.Money(a.ValorInicial)</td>
                                <td>@a.TasaDepreciacionAnual.ToString("0.##")%</td>
                                <td class="fin-money out">@FinanzasFormat.Money(a.DepreciacionAcumulada)</td>
                                <td class="fin-money in">@FinanzasFormat.Money(a.ValorNetoLibros)</td>
                                <td><span class="fin-pill">@a.Estado</span></td>
                                <td>
                                    <div class="fin-row-actions">
                                        <button class="fin-btn subtle" type="button"
                                                data-fin-load-form="form-editar-activo"
                                                data-fin-modal="modal-mantenimiento-activo"
                                                data-field-activo-id="@a.ActivoId"
                                                data-field-codigo-activo="@a.CodigoActivo"
                                                data-field-descripcion="@a.Descripcion"
                                                data-field-fecha-adquisicion="@a.FechaAdquisicion.ToString("yyyy-MM-dd")"
                                                data-field-valor-inicial="@a.ValorInicial.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
                                                data-field-tasa-depreciacion-anual="@a.TasaDepreciacionAnual.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
                                                data-field-depreciacion-acumulada="@a.DepreciacionAcumulada.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
                                                data-field-estado="@a.Estado">
                                            <i class="bi bi-pencil"></i> Editar
                                        </button>
                                        <button class="fin-icon-btn" type="button"
                                                data-fin-load-form="form-depreciar-activo"
                                                data-fin-group="act"
                                                data-fin-target="depreciacion"
                                                data-field-activo-id="@a.ActivoId"
                                                title="Depreciar">
                                            <i class="bi bi-graph-down"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="fin-section" data-fin-group="act" data-fin-section="depreciacion">
            <div class="fin-summary">
                <div><small>Depreciacion acumulada</small><strong>@FinanzasFormat.Money(Model.DepreciacionTotal)</strong></div>
                <div><small>Valor neto total</small><strong>@FinanzasFormat.Money(Model.ValorNetoTotal)</strong></div>
            </div>
            <div class="fin-panel">
                <div class="fin-panel-header"><h2>Registrar depreciacion</h2><span class="fin-muted">Proceso mensual sobre depreciacionacumulada</span></div>
                <div class="fin-panel-body">
                    <form id="form-depreciar-activo" class="fin-form" method="post" action="/Finanzas/RegistrarDepreciacionActivo">
                        <div class="full"><label>Activo fijo</label><select name="activoId">@foreach (var a in Model.Activos.Where(x => x.Estado == "activo")) { <option value="@a.ActivoId">@a.CodigoActivo - @a.Descripcion</option> }</select></div>
                        <div><label>Monto depreciacion</label><input name="montoDepreciacion" type="number" step="0.01" value="100" /></div>
                        <div><label>Accion</label><button class="fin-btn primary" type="submit">Aplicar depreciacion</button></div>
                    </form>
                </div>
            </div>
        </div>

        <div class="fin-section" data-fin-group="act" data-fin-section="bajas">
            <div class="fin-panel">
                <div class="fin-panel-header"><h2>Bajas y retiros</h2><span class="fin-muted">Cambio controlado del estado del activo</span></div>
                <div class="fin-table-wrap">
                    <table class="fin-table">
                        <thead><tr><th>Codigo</th><th>Descripcion</th><th>Estado</th><th>Valor inicial</th><th>Valor neto</th><th>Accion</th></tr></thead>
                        <tbody>
                        @foreach (var a in Model.Activos)
                        {
                            var formId = $"act-state-{a.ActivoId}";
                            <tr>
                                <td class="fin-code">@a.CodigoActivo</td>
                                <td>@a.Descripcion</td>
                                <td>@a.Estado</td>
                                <td>@FinanzasFormat.Money(a.ValorInicial)</td>
                                <td>@FinanzasFormat.Money(a.ValorNetoLibros)</td>
                                <td>
                                    <form id="@formId" class="fin-row-actions" method="post" action="/Finanzas/CambiarEstadoActivo">
                                        <input type="hidden" name="activoId" value="@a.ActivoId" />
                                        <select name="estado">
                                            <option value="activo" selected="@(a.Estado == "activo")">activo</option>
                                            <option value="retirado" selected="@(a.Estado == "retirado")">retirado</option>
                                            <option value="vendido" selected="@(a.Estado == "vendido")">vendido</option>
                                            <option value="depreciado por completo" selected="@(a.Estado == "depreciado por completo")">depreciado</option>
                                        </select>
                                        <button class="fin-btn danger" type="submit">Actualizar estado</button>
                                    </form>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="fin-section fin-modal-section" id="modal-nuevo-activo" data-fin-group="act" data-fin-section="nuevo">
            <div class="fin-panel">
                <div class="fin-panel-header"><h2>Registrar activo fijo</h2><span class="fin-muted">Alta en finanzas.activosfijos</span></div>
                <div class="fin-panel-body">
                    <form id="form-activo" class="fin-form" method="post" action="/Finanzas/CrearActivo">
                        <div><label>Codigo activo</label><input name="CodigoActivo" placeholder="AF-2026-0006" /></div>
                        <div><label>Fecha adquisicion</label><input name="FechaAdquisicion" type="date" value="@DateTime.Today.ToString("yyyy-MM-dd")" /></div>
                        <div class="full"><label>Descripcion</label><input name="Descripcion" placeholder="Equipo, mobiliario, vehiculo..." /></div>
                        <div><label>Valor inicial</label><input name="ValorInicial" type="number" step="0.01" value="1000" /></div>
                        <div><label>Tasa anual %</label><input name="TasaDepreciacionAnual" type="number" step="0.01" value="10" /></div>
                        <div><label>Depreciacion acumulada</label><input name="DepreciacionAcumulada" type="number" step="0.01" value="0" /></div>
                        <div><label>Estado</label><select name="Estado"><option value="activo">Activo</option><option value="retirado">Retirado</option><option value="vendido">Vendido</option><option value="depreciado por completo">Depreciado por completo</option></select></div>
                        <div class="full"><button class="fin-btn primary" type="submit">Guardar activo</button></div>
                    </form>
                </div>
            </div>
        </div>

        <div class="fin-section fin-modal-section" id="modal-mantenimiento-activo" data-fin-group="act" data-fin-section="mantenimiento">
            <div class="fin-panel">
                <div class="fin-panel-header"><h2>Mantenimiento de activo</h2><span class="fin-muted">Selecciona un activo desde el inventario</span></div>
                <div class="fin-panel-body">
                    <form id="form-editar-activo" class="fin-form" method="post" action="/Finanzas/ActualizarActivo">
                        <input type="hidden" name="ActivoId" />
                        <div><label>Codigo activo</label><input name="CodigoActivo" /></div>
                        <div><label>Fecha adquisicion</label><input name="FechaAdquisicion" type="date" /></div>
                        <div class="full"><label>Descripcion</label><input name="Descripcion" /></div>
                        <div><label>Valor inicial</label><input name="ValorInicial" type="number" step="0.01" /></div>
                        <div><label>Tasa anual %</label><input name="TasaDepreciacionAnual" type="number" step="0.01" /></div>
                        <div><label>Depreciacion acumulada</label><input name="DepreciacionAcumulada" type="number" step="0.01" /></div>
                        <div><label>Estado</label><select name="Estado"><option value="activo">Activo</option><option value="retirado">Retirado</option><option value="vendido">Vendido</option><option value="depreciado por completo">Depreciado por completo</option></select></div>
                        <div class="full"><button class="fin-btn primary" type="submit">Actualizar activo</button></div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>





