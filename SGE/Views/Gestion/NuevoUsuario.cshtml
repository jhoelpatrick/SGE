@model SGE.Models.Usuario
@using SGE.Models

@{
    var esEdicion = Model.Id > 0;
    ViewData["Title"] = esEdicion ? "Editar Usuario" : "Nuevo Usuario";
    var matriz = (Dictionary<string, List<Permiso>>)ViewBag.Matriz;
    var roles  = (string[])ViewBag.Roles;
    bool estadoActivo = Model.Estado == EstadoUsuario.Activo;
}

<style>
/* ── Page header ── */
.nu-page-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 24px;
}
.nu-page-head h2 { font-size: 1.35rem; font-weight: 700; margin: 0 0 3px; letter-spacing: -.3px; }
.nu-page-head p  { color: #6b7280; font-size: .85rem; margin: 0; }

/* ── Layout ── */
.nu-layout { display: grid; grid-template-columns: 1fr 260px; gap: 20px; align-items: start; }

/* ── Main card ── */
.nu-card {
    background: #fff;
    border-radius: 14px;
    box-shadow: 0 2px 10px rgba(0,0,0,.07);
    overflow: hidden;
}

/* ── Tabs ── */
.nu-tabs {
    display: flex;
    border-bottom: 1px solid #f3f4f6;
    background: #fff;
    padding: 0 4px;
}
.nu-tab {
    padding: 14px 18px;
    cursor: pointer;
    font-size: .875rem;
    color: #9ca3af;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    display: flex; align-items: center; gap: 7px;
    font-weight: 500;
    transition: color .15s;
    user-select: none;
}
.nu-tab.active { color: #10b981; border-bottom-color: #10b981; font-weight: 600; }
.nu-tab:hover:not(.active) { color: #374151; }
.nu-tab i { font-size: 1rem; }

/* ── Tab panels ── */
.nu-panel       { display: none; padding: 28px; }
.nu-panel.active{ display: block; }

/* ── Section label ── */
.sec-label {
    font-size: .7rem; font-weight: 700; letter-spacing: .08em;
    color: #9ca3af; text-transform: uppercase;
    margin-bottom: 16px; margin-top: 4px;
}

/* ── Form controls ── */
.nu-label {
    font-size: .78rem; font-weight: 600; color: #374151;
    margin-bottom: 5px; display: block;
}
.nu-input {
    display: block; width: 100%;
    border: 1px solid #e5e7eb; border-radius: 8px;
    padding: 10px 13px; font-size: .9rem; line-height: 1.5;
    background: #f9fafb; color: #111827;
    transition: border-color .2s, box-shadow .2s, background .2s;
    outline: none; box-sizing: border-box;
}
.nu-input:focus {
    border-color: #10b981;
    box-shadow: 0 0 0 3px rgba(16,185,129,.12);
    background: #fff;
}
.nu-input[readonly] { background: #f3f4f6; color: #9ca3af; cursor: default; }
.nu-row   { display: grid; gap: 16px; margin-bottom: 18px; }
.col-2    { grid-template-columns: repeat(2, 1fr); }
.col-3    { grid-template-columns: repeat(3, 1fr); }

/* ── Toggle ── */
.toggle-wrap  { display: flex; align-items: center; gap: 10px; }
.toggle-input { display: none; }
.toggle-slider {
    position: relative; width: 44px; height: 24px;
    background: #e5e7eb; border-radius: 12px;
    cursor: pointer; transition: background .25s; flex-shrink: 0;
}
.toggle-slider::after {
    content: ''; position: absolute; top: 3px; left: 3px;
    width: 18px; height: 18px; background: #fff; border-radius: 50%;
    transition: transform .25s; box-shadow: 0 1px 3px rgba(0,0,0,.2);
}
.toggle-input:checked + .toggle-slider { background: #10b981; }
.toggle-input:checked + .toggle-slider::after { transform: translateX(20px); }
.toggle-label { font-size: .875rem; font-weight: 500; color: #374151; }

/* ── Policy box ── */
.policy-box {
    background: #f0fdf9; border: 1px solid #6ee7b7;
    border-radius: 10px; padding: 13px 16px; margin-bottom: 18px;
}
.policy-box strong { color: #0d9488; font-size: .85rem; display: block; margin-bottom: 3px; }
.policy-box span   { color: #374151; font-size: .82rem; }

/* ── Security score ── */
.sec-score { display: flex; align-items: center; gap: 14px; padding: 14px 0; border-top: 1px solid #f3f4f6; }
.sec-circle {
    width: 46px; height: 46px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: .7rem; font-weight: 700; color: #fff; flex-shrink: 0;
}
.sec-circle.low  { background: #ef4444; }
.sec-circle.med  { background: #f59e0b; }
.sec-circle.high { background: #10b981; }
.sec-text strong { font-size: .875rem; display: block; color: #111827; }
.sec-text span   { font-size: .78rem; color: #9ca3af; }

/* ── Auth row ── */
.auth-row {
    display: flex; align-items: center; justify-content: space-between;
    padding: 14px 0; border-bottom: 1px solid #f3f4f6;
}
.auth-info strong { font-size: .875rem; color: #111827; display: block; }
.auth-info span   { font-size: .78rem; color: #9ca3af; }

/* ── Roles grid ── */
.roles-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 22px; }
.role-card {
    border: 2px solid #e5e7eb; border-radius: 10px;
    padding: 13px 15px; cursor: pointer; transition: all .15s;
    display: flex; align-items: center; gap: 10px;
}
.role-card:hover    { border-color: #6ee7b7; background: #f9fafb; }
.role-card.selected { border-color: #10b981; background: #f0fdf9; }
.role-card-icon {
    width: 34px; height: 34px; border-radius: 8px;
    display: flex; align-items: center; justify-content: center;
    font-size: .9rem; flex-shrink: 0;
}
.role-card-icon.admin  { background: #fef3c7; color: #92400e; }
.role-card-icon.asesor { background: #dbeafe; color: #1e40af; }
.role-card-icon.rrhh   { background: #ede9fe; color: #5b21b6; }
.role-card-icon.cont   { background: #d1fae5; color: #065f46; }
.role-card strong { font-size: .85rem; color: #111827; display: block; margin-bottom: 1px; }
.role-card span   { font-size: .75rem; color: #9ca3af; }
.role-card.selected span { color: #10b981; }

/* ── Perm table ── */
.perm-table { width: 100%; border-collapse: collapse; }
.perm-table th {
    font-size: .72rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: .06em; color: #9ca3af; padding: 10px 12px;
    text-align: center; background: #fafafa; border-bottom: 1px solid #f3f4f6;
}
.perm-table th:first-child { text-align: left; }
.perm-table td {
    padding: 10px 12px; border-bottom: 1px solid #f9fafb;
    text-align: center; font-size: .875rem; color: #374151;
}
.perm-table td:first-child { text-align: left; font-weight: 500; }
.perm-table tr:last-child td { border-bottom: none; }
.perm-box {
    width: 22px; height: 22px; border-radius: 5px;
    display: inline-block; vertical-align: middle;
}
.perm-box.on  { background: #10b981; }
.perm-box.off { background: #e5e7eb; border: 1px solid #d1d5db; }

/* ── Sidebar card ── */
.side-card {
    background: #fff; border-radius: 14px;
    box-shadow: 0 2px 10px rgba(0,0,0,.07);
    padding: 24px; position: sticky; top: 20px;
}
.side-avatar {
    width: 72px; height: 72px; border-radius: 50%;
    background: #10b981; color: #fff;
    font-size: 1.4rem; font-weight: 700;
    display: flex; align-items: center; justify-content: center;
    margin: 0 auto 14px;
}
.side-name   { text-align: center; font-weight: 700; font-size: .95rem; color: #111827; }
.side-rol    { text-align: center; font-size: .82rem; color: #10b981; margin-bottom: 4px; }
.side-estado { text-align: center; margin-bottom: 20px; }
.badge-activo   { background: #dcfce7; color: #166534; padding: 3px 12px; border-radius: 20px; font-size: .75rem; font-weight: 700; }
.badge-inactivo { background: #fee2e2; color: #991b1b; padding: 3px 12px; border-radius: 20px; font-size: .75rem; font-weight: 700; }
.side-tips { background: #f9fafb; border-radius: 10px; padding: 14px; margin-top: 16px; }
.side-tip  { display: flex; gap: 8px; font-size: .78rem; color: #374151; margin-bottom: 10px; }
.side-tip:last-child { margin-bottom: 0; }
.side-tip i { color: #10b981; font-size: .85rem; flex-shrink: 0; margin-top: 1px; }
.side-tip strong { color: #10b981; }

/* ── Buttons ── */
.btn-erp {
    background: #10b981; color: #fff; border: none; border-radius: 8px;
    padding: 10px 22px; font-size: .875rem; font-weight: 600; cursor: pointer;
    display: inline-flex; align-items: center; gap: 7px; text-decoration: none;
    transition: background .15s;
}
.btn-erp:hover { background: #0d9488; color: #fff; }
.btn-erp-outline {
    background: #fff; color: #374151; border: 1px solid #d1d5db; border-radius: 8px;
    padding: 10px 22px; font-size: .875rem; font-weight: 600; cursor: pointer;
    text-decoration: none; display: inline-flex; align-items: center; gap: 7px; transition: all .15s;
}
.btn-erp-outline:hover { border-color: #10b981; color: #10b981; }

/* ── Alert ── */
.alert-erp {
    background: #f0fdf9; border: 1px solid #6ee7b7;
    border-radius: 10px; padding: 12px 18px; margin-bottom: 20px;
    color: #065f46; font-size: .875rem;
    display: flex; align-items: center; gap: 10px;
}
</style>

@if (TempData["Exito"] != null)
{
    <div class="alert-erp">
        <i class="bi bi-check-circle-fill"></i> @TempData["Exito"]
    </div>
}

<form asp-action="@(esEdicion ? "Editar" : "NuevoUsuario")" method="post" id="mainForm">
@Html.AntiForgeryToken()
<input type="hidden" asp-for="Id" />
<input type="hidden" asp-for="Rol" id="rolHidden" value="@(Model.Rol.Length > 0 ? Model.Rol : roles[0])" />
<input type="hidden" name="Estado" id="estadoHidden" value="@((int)Model.Estado)" />

<!-- PAGE HEADER -->
<div class="nu-page-head">
    <div>
        <h2>@ViewData["Title"]</h2>
        <p>@(esEdicion ? "Modifica los datos del usuario" : "Completa los datos para registrar un nuevo usuario en el sistema")</p>
    </div>
    <div style="display:flex;gap:10px;">
        <a asp-action="Index" class="btn-erp-outline">
            <i class="bi bi-arrow-left"></i> Cancelar
        </a>
        <button type="submit" class="btn-erp">
            <i class="bi bi-floppy-fill"></i>
            @(esEdicion ? "Guardar Cambios" : "Crear Usuario")
        </button>
    </div>
</div>

<!-- LAYOUT -->
<div class="nu-layout">

    <!-- MAIN CARD -->
    <div class="nu-card">

        <!-- TABS -->
        <div class="nu-tabs">
            <div class="nu-tab active" onclick="NuevoUsuarioView.switchTab(0)">
                <i class="bi bi-person-fill"></i> Datos Personales
            </div>
            <div class="nu-tab" onclick="NuevoUsuarioView.switchTab(1)">
                <i class="bi bi-key-fill"></i> Acceso
            </div>
            <div class="nu-tab" onclick="NuevoUsuarioView.switchTab(2)">
                <i class="bi bi-shield-fill-check"></i> Rol y Permisos
            </div>
        </div>

        <!-- TAB 1: Datos Personales -->
        <div class="nu-panel active" id="tab0">
            <p class="sec-label">Información Personal</p>

            <div class="nu-row col-2">
                <div>
                    <label class="nu-label">NOMBRE</label>
                    <input asp-for="Nombre" class="nu-input" placeholder="Ej. Juan"
                           oninput="NuevoUsuarioView.updatePreview()" />
                </div>
                <div>
                    <label class="nu-label">APELLIDO</label>
                    <input asp-for="Apellido" class="nu-input" placeholder="Ej. Pérez"
                           oninput="NuevoUsuarioView.updatePreview()" />
                </div>
            </div>

            <div class="nu-row" style="grid-template-columns:1fr">
                <div>
                    <label class="nu-label">EMAIL</label>
                    <input asp-for="Email" type="email" class="nu-input"
                           placeholder="correo@empresa.com" oninput="NuevoUsuarioView.updatePreview()" />
                </div>
            </div>

            <div class="nu-row col-2" style="align-items:end;">
                <div>
                    <label class="nu-label">TELÉFONO</label>
                    <input asp-for="Telefono" class="nu-input" placeholder="+51 999 000 000" />
                </div>
                <div class="toggle-wrap" style="padding-bottom:10px;">
                    <input type="checkbox" id="toggleEstado" class="toggle-input"
                           @(estadoActivo ? "checked" : "")
                           onchange="NuevoUsuarioView.onEstadoChange()" />
                    <label for="toggleEstado" class="toggle-slider"></label>
                    <span class="toggle-label" id="estadoLabel">
                        @(estadoActivo ? "Usuario Activo" : "Usuario Inactivo")
                    </span>
                </div>
            </div>
        </div>

        <!-- TAB 2: Acceso -->
        <div class="nu-panel" id="tab1">
            <p class="sec-label">Información de Acceso</p>

            <div class="nu-row col-2">
                <div>
                    <label class="nu-label">CONTRASEÑA</label>
                    <input asp-for="Contrasena" type="password" class="nu-input"
                           placeholder="••••••••" oninput="NuevoUsuarioView.calcSecurity()" />
                </div>
                <div>
                    <label class="nu-label">CONFIRMAR CONTRASEÑA</label>
                    <input type="password" class="nu-input" placeholder="••••••••" />
                </div>
            </div>

            <div class="nu-row col-2">
                <div>
                    <label class="nu-label">NOMBRE DE USUARIO</label>
                    <input type="text" class="nu-input" id="previewNombre" readonly />
                </div>
                <div>
                    <label class="nu-label">EMAIL DE ACCESO</label>
                    <input type="text" class="nu-input" id="previewEmail" readonly />
                </div>
            </div>

            <div class="policy-box">
                <strong><i class="bi bi-shield-check me-1"></i>Política de Seguridad v2.0</strong>
                <span>Requiere 8+ caracteres, mayúsculas, números y símbolo especial. Expiración cada 90 días.</span>
            </div>

            <p class="sec-label" style="margin-top:8px;">Métodos de Autenticación</p>

            <div class="auth-row">
                <div class="auth-info">
                    <strong id="mfaLabel">@(Model.MfaActivo ? "MFA: Activado" : "MFA: Desactivado")</strong>
                    <span>Autenticación de dos factores</span>
                </div>
                <div class="toggle-wrap">
                    <input type="checkbox" asp-for="MfaActivo" id="toggleMfa"
                           class="toggle-input"
                           onchange="NuevoUsuarioView.calcSecurity(); NuevoUsuarioView.updateMfaLabel();" />
                    <label for="toggleMfa" class="toggle-slider"></label>
                </div>
            </div>

            <div class="sec-score">
                <div class="sec-circle low" id="secCircle">Bajo</div>
                <div class="sec-text">
                    <strong id="secTitle">Punto de seguridad de cuenta</strong>
                    <span id="secDesc">Active MFA y agregue una contraseña fuerte para mejorar.</span>
                </div>
            </div>
        </div>

        <!-- TAB 3: Rol y Permisos -->
        <div class="nu-panel" id="tab2">
            <p class="sec-label">Seleccionar Rol</p>

            <div class="roles-grid">
                @{
                    var rolActual = Model.Rol.Length > 0 ? Model.Rol : roles[0];
                }
                <div class="role-card @(rolActual == "Administrador" ? "selected" : "")"
                     onclick="NuevoUsuarioView.selectRol('Administrador', this)">
                    <div class="role-card-icon admin"><i class="bi bi-shield-fill"></i></div>
                    <div>
                        <strong>Administrador</strong>
                        <span>Acceso total al sistema</span>
                    </div>
                </div>
                <div class="role-card @(rolActual == "Asesor Comercial" ? "selected" : "")"
                     onclick="NuevoUsuarioView.selectRol('Asesor Comercial', this)">
                    <div class="role-card-icon asesor"><i class="bi bi-bar-chart-fill"></i></div>
                    <div>
                        <strong>Asesor Comercial</strong>
                        <span>Ventas, clientes y reportes</span>
                    </div>
                </div>
                <div class="role-card @(rolActual == "Gerente RRHH" ? "selected" : "")"
                     onclick="NuevoUsuarioView.selectRol('Gerente RRHH', this)">
                    <div class="role-card-icon rrhh"><i class="bi bi-person-badge-fill"></i></div>
                    <div>
                        <strong>Gerente RRHH</strong>
                        <span>Personal, nóminas, asistencias</span>
                    </div>
                </div>
                <div class="role-card @(rolActual == "Contador" ? "selected" : "")"
                     onclick="NuevoUsuarioView.selectRol('Contador', this)">
                    <div class="role-card-icon cont"><i class="bi bi-calculator-fill"></i></div>
                    <div>
                        <strong>Contador</strong>
                        <span>Facturación, impuestos</span>
                    </div>
                </div>
            </div>

            <p class="sec-label" id="matrizTitle">
                Matriz de Permisos — @rolActual
            </p>
            <p style="font-size:.78rem;color:#9ca3af;margin-bottom:12px;">
                Permisos asignados al rol. Para modificarlos ve a
                <a asp-controller="Gestion" asp-action="RolesPermisos"
                   style="color:#10b981;font-weight:600;">Roles y Permisos</a>.
            </p>

            <table class="perm-table" id="permTable">
                <thead>
                    <tr>
                        <th>Módulo</th>
                        <th>Ver</th>
                        <th>Crear/Editar</th>
                        <th>Eliminar</th>
                        <th>Reportes</th>
                    </tr>
                </thead>
                <tbody id="permBody"></tbody>
            </table>
        </div>

    </div><!-- /nu-card -->

    <!-- SIDEBAR -->
    <div class="side-card">
        <div class="side-avatar" id="sideAvatar">@(Model.Id > 0 ? Model.Iniciales : "??")</div>
        <div class="side-name"   id="sideName">@(Model.Id > 0 ? Model.NombreCompleto : "Nuevo Usuario")</div>
        <div class="side-rol"    id="sideRol">@(Model.Rol.Length > 0 ? Model.Rol : roles[0])</div>
        <div class="side-estado">
            <span class="@(estadoActivo ? "badge-activo" : "badge-inactivo")" id="sideEstado">
                @(estadoActivo ? "● Activo" : "● Inactivo")
            </span>
        </div>
        <div class="side-tips">
            <div class="side-tip">
                <i class="bi bi-shield-check"></i>
                <span><strong>Contraseña segura:</strong> mínimo 8 caracteres, mayúsculas y números.</span>
            </div>
            <div class="side-tip">
                <i class="bi bi-person-lock"></i>
                <span><strong>Menor privilegio:</strong> asigna solo los permisos necesarios.</span>
            </div>
            <div class="side-tip">
                <i class="bi bi-phone-vibrate"></i>
                <span><strong>MFA recomendado:</strong> activa la autenticación en dos pasos.</span>
            </div>
        </div>
    </div>

</div><!-- /nu-layout -->
</form>

<script>
(function() {
    const PERMISOS = @(Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        ((Dictionary<string, List<SGE.Models.Permiso>>)ViewBag.Matriz).ToDictionary(
            kvp => kvp.Key,
            kvp => kvp.Value.Select(p => new {
                m     = p.Modulo,
                ver   = p.Ver,
                crear = p.CrearEditar,
                elim  = p.Eliminar,
                rep   = p.Reportes
            }).ToList()
        )
    )));

    const ESTADO_ACTIVO = @(estadoActivo ? "true" : "false");

    function switchTab(idx) {
        document.querySelectorAll('.nu-tab').forEach((t,i)   => t.classList.toggle('active', i===idx));
        document.querySelectorAll('.nu-panel').forEach((p,i) => p.classList.toggle('active', i===idx));
    }

    function onEstadoChange() {
        const activo = document.getElementById('toggleEstado').checked;
        document.getElementById('estadoHidden').value = activo ? '0' : '1';
        updatePreview();
    }

    function selectRol(rol, card) {
        document.querySelectorAll('.role-card').forEach(c => c.classList.remove('selected'));
        card.classList.add('selected');
        document.getElementById('rolHidden').value = rol;
        document.getElementById('sideRol').textContent = rol;
        document.getElementById('matrizTitle').textContent = 'Matriz de Permisos — ' + rol;
        renderPermisos(rol);
    }

    function renderPermisos(rol) {
        const rows  = PERMISOS[rol] || [];
        const tbody = document.getElementById('permBody');
        tbody.innerHTML = rows.map(r => `
            <tr>
                <td>${r.m}</td>
                <td><div class="perm-box ${r.ver   ? 'on' : 'off'}"></div></td>
                <td><div class="perm-box ${r.crear ? 'on' : 'off'}"></div></td>
                <td><div class="perm-box ${r.elim  ? 'on' : 'off'}"></div></td>
                <td><div class="perm-box ${r.rep   ? 'on' : 'off'}"></div></td>
            </tr>`).join('');
    }

    function updatePreview() {
        const n    = document.querySelector('[name="Nombre"]')?.value   || '';
        const a    = document.querySelector('[name="Apellido"]')?.value || '';
        const e    = document.querySelector('[name="Email"]')?.value    || '';
        const full = (n + ' ' + a).trim() || 'Nuevo Usuario';
        const ini  = ((n[0]||'') + (a[0]||'')).toUpperCase() || '??';

        document.getElementById('sideAvatar').textContent = ini;
        document.getElementById('sideName').textContent   = full;

        const pn = document.getElementById('previewNombre');
        const pe = document.getElementById('previewEmail');
        if (pn) pn.value = (a + ' ' + n).trim();
        if (pe) pe.value = e;

        const activo = document.getElementById('toggleEstado')?.checked;
        const badge  = document.getElementById('sideEstado');
        if (badge) {
            badge.className   = activo ? 'badge-activo' : 'badge-inactivo';
            badge.textContent = activo ? '● Activo' : '● Inactivo';
        }
        const lbl = document.getElementById('estadoLabel');
        if (lbl) lbl.textContent = activo ? 'Usuario Activo' : 'Usuario Inactivo';
    }

    function updateMfaLabel() {
        const mfa = document.getElementById('toggleMfa')?.checked;
        const lbl = document.getElementById('mfaLabel');
        if (lbl) lbl.textContent = mfa ? 'MFA: Activado' : 'MFA: Desactivado';
    }

    function calcSecurity() {
        const pwd  = document.querySelector('[name="Contrasena"]')?.value || '';
        const mfa  = document.getElementById('toggleMfa')?.checked;
        let score  = 0;
        if (pwd.length >= 8) score++;
        if (/[A-Z]/.test(pwd) && /[0-9]/.test(pwd)) score++;
        if (mfa) score += 2;

        const circ  = document.getElementById('secCircle');
        const title = document.getElementById('secTitle');
        const desc  = document.getElementById('secDesc');
        if (score >= 3)      { circ.className='sec-circle high'; circ.textContent='Alto'; title.textContent='Cuenta bien protegida'; desc.textContent='Seguridad alta. Buenas prácticas aplicadas.'; }
        else if (score >= 2) { circ.className='sec-circle med';  circ.textContent='Med';  title.textContent='Seguridad media'; desc.textContent='Active MFA para mejorar la protección.'; }
        else                 { circ.className='sec-circle low';  circ.textContent='Bajo'; title.textContent='Punto de seguridad de cuenta'; desc.textContent='Active MFA y agregue contraseña fuerte.'; }
    }

    // Expose functions globally under window.NuevoUsuarioView
    window.NuevoUsuarioView = {
        switchTab,
        onEstadoChange,
        selectRol,
        renderPermisos,
        updatePreview,
        updateMfaLabel,
        calcSecurity
    };

    $(document).ready(function() {
        document.getElementById('toggleEstado').checked = (ESTADO_ACTIVO === true || ESTADO_ACTIVO === 'true');
        const rolInicial = document.getElementById('rolHidden').value || '@roles[0]';
        renderPermisos(rolInicial);
        updatePreview();
        updateMfaLabel();
        calcSecurity();
    });
})();
</script>
