<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SGE</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SGE.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" integrity="sha512-SnH5WK+bZxgPHs44uWIX+LLJAJ9/2PkPKZ5QiAj6Ta86w+fsb2TkcmfRyVX3pBnMFcV7oQPJkl9QevSCWr3W6A==" crossorigin="anonymous" referrerpolicy="no-referrer" />
</head>
<body>

    <style>
            .aside-principal {
                width: 300px;
                height: 100vh;
                background-color: #0E8F63;
                color: white;
                font-family: 'Montserrat', sans-serif;
                padding: 20px 0 0 20px;
                position: fixed; 
                left: 0;
                top: 0;
            }

            .aside-titles h2 {
                font-weight: 700;
                margin-bottom: 2px;
            }

            .aside-titles p {
                font-size: 14px;
                font-weight: 400;
                opacity: 0.8;
                margin-bottom: 25px;
            }

            .list-group a {
                text-decoration: none;
                color: white;
                font-size: 18px; 
                font-weight: 500;
                display: inline-block; 
                transition: all 0.3s ease; 
            }

            .list-group li:hover a {
                color: #A3E2C9; 
                transform: translateX(8px);

            .list-group li:hover i {
                color: #A3E2C9;
                transform: scale(1.1); 
                transition: all 0.3s ease;
            }
            .list-group {
                list-style: none;
                padding: 0;
                margin: 0;
            }
            
                .list-group li {
                    display: flex;
                    align-items: center;
                    gap: 15px; 
                    margin-bottom: 20px;
                }

                .list-group i {
                    font-size: 24px;
                    width: 30px; 
                    text-align: center;
                }
                
                .list-group a {
                    text-decoration: none;
                    text-decoration-style: none;
                    color: white;
                    font-size: 18px;
                    font-weight: 500;
                    display: inline-block;
                    transition: all 0.3s ease; 
                }

               
                .list-group li:hover a {
                    color: #A3E2C9; 
                    transform: translateX(8px);
                }

                
                .list-group li:hover i {
                    color: #A3E2C9;
                    transform: scale(1.1); 
                    transition: all 0.3s ease;
                }
                
            .main-container {
                margin-left: 320px;
                padding-top: 20px;
            }
    </style>

    <aside class="aside-principal">
        <div class="aside-titles">
            <h2>Dashboard</h2>
            <p>Selección de Módulos</p>
        </div>

        <ul class="list-group">
            <li>
                <i class="fa-regular fa-newspaper"></i>
                <a asp-controller="Auditoria" asp-action="Index">Auditoría</a>
            </li>
            <li>
                <i class="fa-solid fa-chart-bar"></i>
                <a asp-controller="Reporte" asp-action="Index">Reportes</a>
            </li>
            <li>
                <i class="fa-solid fa-gear"></i>
                <a asp-controller="Configuracion" asp-action="Index">Configuración</a>
            </li>
        </ul>
    </aside>

    <div class="main-container container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>