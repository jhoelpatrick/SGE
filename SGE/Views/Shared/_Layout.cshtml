<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ERP SGE</title>
    <!-- Tailwind CSS (CDN for modern styling without build step) -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '#059669', // Emerald 600
                        sidebar: '#1e293b', // Slate 800
                    }
                }
            }
        }
    </script>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body class="bg-slate-50 text-slate-900 font-sans antialiased flex h-screen overflow-hidden">
    
    <!-- Sidebar -->
    <aside class="w-64 bg-sidebar text-white flex flex-col hidden md:flex">
        <div class="h-16 flex items-center px-6 border-b border-slate-700">
            <i data-lucide="blocks" class="w-6 h-6 text-emerald-400 mr-2"></i>
            <span class="text-xl font-bold tracking-tight">SGE<span class="text-emerald-400">.erp</span></span>
        </div>
        <nav class="flex-1 py-4 px-3 space-y-1 overflow-y-auto">
            <a asp-controller="Home" asp-action="Index" class="flex items-center px-3 py-2 text-sm font-medium rounded-md @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" ? "bg-slate-700 text-white" : "text-slate-300 hover:bg-slate-700 hover:text-white")">
                <i data-lucide="layout-dashboard" class="w-5 h-5 mr-3"></i> Dashboard
            </a>
            <div class="pt-4 pb-2">
                <p class="px-3 text-xs font-semibold text-slate-400 uppercase tracking-wider">Operaciones</p>
            </div>
            <a asp-controller="Ventas" asp-action="Index" class="flex items-center px-3 py-2 text-sm font-medium rounded-md @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Ventas" ? "bg-slate-700 text-white" : "text-slate-300 hover:bg-slate-700 hover:text-white")">
                <i data-lucide="shopping-cart" class="w-5 h-5 mr-3"></i> Ventas
            </a>
            <a asp-controller="Compras" asp-action="Index" class="flex items-center px-3 py-2 text-sm font-medium rounded-md @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Compras" ? "bg-slate-700 text-white" : "text-slate-300 hover:bg-slate-700 hover:text-white")">
                <i data-lucide="shopping-bag" class="w-5 h-5 mr-3"></i> Compras
            </a>
            <a asp-controller="Facturacion" asp-action="Index" class="flex items-center px-3 py-2 text-sm font-medium rounded-md @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Facturacion" ? "bg-slate-700 text-white" : "text-slate-300 hover:bg-slate-700 hover:text-white")">
                <i data-lucide="file-text" class="w-5 h-5 mr-3"></i> Facturación
            </a>
            <a asp-controller="Inventario" asp-action="Index" class="flex items-center px-3 py-2 text-sm font-medium rounded-md @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Inventario" ? "bg-slate-700 text-white" : "text-slate-300 hover:bg-slate-700 hover:text-white")">
                <i data-lucide="package" class="w-5 h-5 mr-3"></i> Inventario
            </a>
            <a asp-controller="Proyectos" asp-action="Index" class="flex items-center px-3 py-2 text-sm font-medium rounded-md @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Proyectos" ? "bg-slate-700 text-white" : "text-slate-300 hover:bg-slate-700 hover:text-white")">
                <i data-lucide="briefcase" class="w-5 h-5 mr-3"></i> Proyectos
            </a>
        </nav>
        <div class="p-4 border-t border-slate-700">
            <div class="flex items-center">
                <img class="h-8 w-8 rounded-full" src="https://ui-avatars.com/api/?name=Admin+User&background=0D8ABC&color=fff" alt="Avatar">
                <div class="ml-3">
                    <p class="text-sm font-medium text-white">Admin User</p>
                    <p class="text-xs font-medium text-slate-400">admin@sge.com</p>
                </div>
            </div>
        </div>
    </aside>

    <!-- Main Content -->
    <div class="flex-1 flex flex-col overflow-hidden">
        <!-- Top Navbar -->
        <header class="h-16 bg-white border-b border-slate-200 flex items-center justify-between px-6 shadow-sm z-10">
            <div class="flex items-center md:hidden">
                <button class="text-slate-500 hover:text-slate-700">
                    <i data-lucide="menu" class="w-6 h-6"></i>
                </button>
                <span class="ml-4 text-xl font-bold text-slate-800">SGE</span>
            </div>
            <div class="hidden md:flex items-center">
                <h1 class="text-lg font-semibold text-slate-800">@ViewData["Title"]</h1>
            </div>
            <div class="flex items-center space-x-4">
                <button class="text-slate-400 hover:text-slate-600 relative">
                    <i data-lucide="bell" class="w-5 h-5"></i>
                    <span class="absolute top-0 right-0 block h-2 w-2 rounded-full bg-red-400 ring-2 ring-white"></span>
                </button>
            </div>
        </header>

        <!-- Main Body Area -->
        <main class="flex-1 overflow-x-hidden overflow-y-auto bg-slate-50 p-6">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script>
        // Initialize Lucide Icons
        lucide.createIcons();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
