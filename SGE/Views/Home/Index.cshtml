@{
    ViewData["Title"] = "Dashboard Principal";
}

<div class="mb-6">
    <h2 class="text-2xl font-bold text-slate-800">Resumen Ejecutivo</h2>
    <p class="text-sm text-slate-500">Vista general de las operaciones de la empresa.</p>
</div>

<!-- KPI Cards -->
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
    <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm flex items-center">
        <div class="p-4 bg-emerald-100 text-emerald-600 rounded-xl mr-4">
            <i data-lucide="trending-up" class="w-6 h-6"></i>
        </div>
        <div>
            <p class="text-sm font-semibold text-slate-500 uppercase">Ventas (Mes)</p>
            <p class="text-2xl font-bold text-slate-800">$124,500</p>
        </div>
    </div>
    <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm flex items-center">
        <div class="p-4 bg-blue-100 text-blue-600 rounded-xl mr-4">
            <i data-lucide="shopping-bag" class="w-6 h-6"></i>
        </div>
        <div>
            <p class="text-sm font-semibold text-slate-500 uppercase">Compras (Mes)</p>
            <p class="text-2xl font-bold text-slate-800">$42,300</p>
        </div>
    </div>
    <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm flex items-center">
        <div class="p-4 bg-amber-100 text-amber-600 rounded-xl mr-4">
            <i data-lucide="alert-circle" class="w-6 h-6"></i>
        </div>
        <div>
            <p class="text-sm font-semibold text-slate-500 uppercase">Alertas Stock</p>
            <p class="text-2xl font-bold text-slate-800">14</p>
        </div>
    </div>
    <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm flex items-center">
        <div class="p-4 bg-purple-100 text-purple-600 rounded-xl mr-4">
            <i data-lucide="briefcase" class="w-6 h-6"></i>
        </div>
        <div>
            <p class="text-sm font-semibold text-slate-500 uppercase">Proyectos Activos</p>
            <p class="text-2xl font-bold text-slate-800">8</p>
        </div>
    </div>
</div>

<!-- Enlaces Rápidos a Módulos -->
<h3 class="text-lg font-bold text-slate-800 mb-4">Acceso Rápido a Módulos</h3>
<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <a asp-controller="Ventas" asp-action="Index" class="group bg-white p-6 rounded-xl border border-slate-200 shadow-sm hover:border-emerald-500 hover:shadow-md transition-all">
        <div class="flex items-center justify-between mb-4">
            <div class="p-3 bg-slate-50 text-slate-700 rounded-lg group-hover:bg-emerald-50 group-hover:text-emerald-600 transition-colors">
                <i data-lucide="shopping-cart" class="w-6 h-6"></i>
            </div>
            <i data-lucide="arrow-right" class="w-5 h-5 text-slate-300 group-hover:text-emerald-500 transition-colors"></i>
        </div>
        <h4 class="text-lg font-bold text-slate-800 mb-1">Ventas</h4>
        <p class="text-sm text-slate-500">Gestión de cotizaciones y pedidos.</p>
    </a>
    
    <a asp-controller="Facturacion" asp-action="Index" class="group bg-white p-6 rounded-xl border border-slate-200 shadow-sm hover:border-blue-500 hover:shadow-md transition-all">
        <div class="flex items-center justify-between mb-4">
            <div class="p-3 bg-slate-50 text-slate-700 rounded-lg group-hover:bg-blue-50 group-hover:text-blue-600 transition-colors">
                <i data-lucide="file-text" class="w-6 h-6"></i>
            </div>
            <i data-lucide="arrow-right" class="w-5 h-5 text-slate-300 group-hover:text-blue-500 transition-colors"></i>
        </div>
        <h4 class="text-lg font-bold text-slate-800 mb-1">Facturación</h4>
        <p class="text-sm text-slate-500">Emisión y control de facturas.</p>
    </a>
    
    <a asp-controller="Inventario" asp-action="Index" class="group bg-white p-6 rounded-xl border border-slate-200 shadow-sm hover:border-amber-500 hover:shadow-md transition-all">
        <div class="flex items-center justify-between mb-4">
            <div class="p-3 bg-slate-50 text-slate-700 rounded-lg group-hover:bg-amber-50 group-hover:text-amber-600 transition-colors">
                <i data-lucide="package" class="w-6 h-6"></i>
            </div>
            <i data-lucide="arrow-right" class="w-5 h-5 text-slate-300 group-hover:text-amber-500 transition-colors"></i>
        </div>
        <h4 class="text-lg font-bold text-slate-800 mb-1">Inventario</h4>
        <p class="text-sm text-slate-500">Control de stock y almacenes.</p>
    </a>
</div>
