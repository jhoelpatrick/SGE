@{
    ViewData["Title"] = "Sistema ERP Modular";
    Layout = null; 
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <!-- Bootstrap CSS & Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

<style>
    :root {
        --sidebar-bg: #111827; /* Dark slate */
        --sidebar-hover: #1f2937;
        --sidebar-active-bg: rgba(16, 185, 129, 0.15); /* Teal tint */
        --sidebar-active-color: #10b981; /* Teal */
        --sidebar-active-border: #10b981;
        --text-primary: #f3f4f6;
        --text-secondary: #9ca3af;
        --bg-main: #f3f4f6;
    }

    body {
        background-color: var(--bg-main);
        overflow-x: hidden;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .wrapper {
        display: flex;
        width: 100%;
        height: 100vh;
        margin: 0;
    }

    /* Sidebar Styles */
    .sidebar {
        width: 260px;
        background-color: var(--sidebar-bg);
        color: var(--text-primary);
        transition: all 0.3s;
        overflow-y: auto;
        flex-shrink: 0;
        border-right: 1px solid #1f2937;
    }

    .sidebar-header {
        padding: 24px 20px;
        border-bottom: 1px solid #1f2937;
        display: flex;
        align-items: center;
    }

    .logo-icon {
        width: 32px;
        height: 32px;
        background-color: #10b981;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 1.2rem;
        margin-right: 12px;
    }

    .nav-category {
        padding: 20px 20px 8px 20px;
        font-size: 0.65rem;
        text-transform: uppercase;
        letter-spacing: 1.2px;
        color: var(--text-secondary);
        font-weight: 700;
    }

    .sidebar .nav-link {
        color: var(--text-secondary);
        padding: 10px 20px;
        display: flex;
        align-items: center;
        transition: all 0.2s;
        font-size: 0.9rem;
        font-weight: 500;
        border-left: 3px solid transparent;
        cursor: pointer;
    }

    .sidebar .nav-link:hover {
        background-color: var(--sidebar-hover);
        color: var(--text-primary);
    }

    .sidebar .nav-link.active {
        background-color: var(--sidebar-active-bg);
        color: white;
        border-left-color: var(--sidebar-active-border);
    }

    .sidebar .nav-link i {
        margin-right: 12px;
        font-size: 1.1rem;
        width: 20px;
        text-align: center;
    }

    .sidebar .nav-link.active i {
        color: var(--sidebar-active-color);
    }

    /* Content Area Styles */
    .content-area {
        flex-grow: 1;
        overflow-y: auto;
        background-color: var(--bg-main);
        position: relative;
    }

    /* Loader */
    .loader-overlay {
        position: absolute;
        top: 0; left: 0; right: 0; bottom: 0;
        background: rgba(243, 244, 246, 0.8);
        display: none;
        justify-content: center;
        align-items: center;
        z-index: 10;
    }

    .spinner {
        width: 40px;
        height: 40px;
        border: 4px solid rgba(16, 185, 129, 0.2);
        border-left-color: #10b981;
        border-radius: 50%;
        animation: spin 1s linear infinite;
    }

    @@keyframes spin { 100% { transform: rotate(360deg); } }

    /* Custom Scrollbar */
    ::-webkit-scrollbar { width: 6px; height: 6px;}
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 3px; }
    ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
    .sidebar::-webkit-scrollbar-thumb { background: #374151; }
    .sidebar::-webkit-scrollbar-thumb:hover { background: #4b5563; }
</style>
</head>
<body>

<div class="wrapper">
    <!-- Sidebar -->
    <nav class="sidebar">
        <div class="sidebar-header">
            <div class="logo-icon"><i class="bi bi-hexagon-fill"></i></div>
            <div>
                <h5 class="mb-0 text-white fw-bold" style="line-height: 1;">Sistema</h5>
                <small style="color: #9ca3af; font-size: 0.7rem;">ERP Modular</small>
            </div>
        </div>

        <ul class="nav flex-column mb-5 mt-2">
            <!-- PRINCIPAL -->
            <li class="nav-category">Principal</li>
            <li class="nav-item">
                <a class="nav-link active ajax-link" data-url="/Principal/Index">
                    <i class="bi bi-layout-text-window-reverse"></i> Dashboard
                </a>
            </li>

            <!-- GESTIÓN -->
            <li class="nav-category">Gestión</li>
            <li class="nav-item"><a class="nav-link ajax-link" data-url="/Gestion/Index"><i class="bi bi-people"></i> Usuarios</a></li>
            <li class="nav-item"><a class="nav-link ajax-link" data-url="/Gestion/RolesPermisos"><i class="bi bi-shield-check"></i> Roles y Permisos</a></li>

            <!-- COMERCIAL -->
            <li class="nav-category">Comercial</li>
            <li class="nav-item"><a class="nav-link ajax-link" data-url="/Comercial/Clientes"><i class="bi bi-building"></i> Clientes</a></li>
            <li class="nav-item"><a class="nav-link ajax-link" data-url="/Comercial/Proveedores"><i class="bi bi-truck"></i> Proveedores</a></li>
            <li class="nav-item"><a class="nav-link ajax-link" data-url="/Comercial/Productos"><i class="bi bi-box-seam"></i> Productos</a></li>

            <!-- OPERACIONES -->
            <li class="nav-category">Operaciones</li>
            <li class="nav-item"><a class="nav-link ajax-link" data-url="/Operaciones/Ventas"><i class="bi bi-cart3"></i> Ventas</a></li>
            <li class="nav-item"><a class="nav-link ajax-link" data-url="/Operaciones/Compras"><i class="bi bi-bag"></i> Compras</a></li>
            <li class="nav-item"><a class="nav-link ajax-link" data-url="/Operaciones/Facturacion"><i class="bi bi-receipt"></i> Facturación</a></li>
            <li class="nav-item"><a class="nav-link ajax-link" data-url="/Operaciones/Inventario"><i class="bi bi-archive"></i> Inventario</a></li>
            <li class="nav-item"><a class="nav-link ajax-link" data-url="/Operaciones/Proyectos"><i class="bi bi-kanban"></i> Proyectos</a></li>

            <!-- FINANZAS -->
            <li class="nav-category">Finanzas</li>
            <li class="nav-item"><a class="nav-link ajax-link" data-url="/Finanzas/Impuestos"><i class="bi bi-file-earmark-text"></i> Impuestos</a></li>
            <li class="nav-item"><a class="nav-link ajax-link" data-url="/Finanzas/Contabilidad"><i class="bi bi-calculator"></i> Contabilidad</a></li>
            <li class="nav-item"><a class="nav-link ajax-link" data-url="/Finanzas/Caja_y_Bancos"><i class="bi bi-bank"></i> Caja y Bancos</a></li>
            <li class="nav-item"><a class="nav-link ajax-link" data-url="/Finanzas/ActivosFijos"><i class="bi bi-layers"></i> Activos Fijos</a></li>

            <!-- RECURSOS HUMANOS -->
            <li class="nav-category">Recursos Humanos</li>
            <li class="nav-item"><a class="nav-link ajax-link" data-url="/RRHH/Recursos"><i class="bi bi-person-badge"></i> Recursos Humanos</a></li>
            <li class="nav-item"><a class="nav-link ajax-link" data-url="/Nomina"><i class="bi bi-cash-coin"></i> Nómina</a></li>
        </ul>
    </nav>

    <!-- Main Content Area -->
    <main class="content-area position-relative">
        <div class="loader-overlay" id="content-loader">
            <div class="spinner"></div>
        </div>
        <div id="dynamic-content">
            <!-- Loaded via AJAX -->
        </div>
    </main>
</div>

<!-- Require jQuery for AJAX -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(document).ready(function () {
        // Expose loadContent globally
        window.loadContent = function (url) {
            // Find sidebar link with matching data-url
            $('.ajax-link').removeClass('active');
            $(`.ajax-link[data-url="${url}"]`).addClass('active');


            $('#content-loader').css('display', 'flex');
            $.ajax({
                url: url,
                type: 'GET',
                success: function (data) {
                    $('#dynamic-content').html(data);
                },
                error: function (xhr) {
                    console.error("AJAX Error:", xhr);
                    $('#dynamic-content').html(`
                        <div class="p-5">
                            <div class="alert alert-danger shadow-sm border-0" role="alert">
                                <h4 class="alert-heading"><i class="bi bi-exclamation-triangle-fill me-2"></i>Error al cargar</h4>
                                <p>No se pudo cargar el módulo desde <code>${url}</code>.</p>
                            </div>
                        </div>
                    `);
                },
                complete: function () {
                    setTimeout(() => { $('#content-loader').fadeOut(200); }, 300);
                }
            });
        };

        // Load default dashboard on start
        window.loadContent('/Principal/Index');

        $('.ajax-link').on('click', function (e) {
            e.preventDefault();
            window.loadContent($(this).data('url'));
        });

        // Intercept clicks on links inside dynamic content
        $(document).on('click', '#dynamic-content a', function (e) {
            var href = $(this).attr('href');
            if (href && href.startsWith('/') && !href.startsWith('//') && !$(this).hasClass('no-ajax')) {
                e.preventDefault();
                window.loadContent(href);
            }
        });

        // Intercept form submissions inside dynamic content
        $(document).on('submit', '#dynamic-content form', function (e) {
            if ($(this).hasClass('no-ajax')) return;
            e.preventDefault();
            var form = $(this);
            var url = form.attr('action') || window.location.pathname;
            var method = form.attr('method') || 'POST';
            
            // Check if it is a GET or POST
            var ajaxOptions = {
                url: url,
                type: method,
                success: function (data) {
                    $('#dynamic-content').html(data);
                },
                error: function (xhr) {
                    console.error("Form Submit Error:", xhr);
                    $('#dynamic-content').html(`
                        <div class="p-5">
                            <div class="alert alert-danger shadow-sm border-0" role="alert">
                                <h4 class="alert-heading"><i class="bi bi-exclamation-triangle-fill me-2"></i>Error al procesar formulario</h4>
                                <p>No se pudo procesar la solicitud para <code>${url}</code>.</p>
                            </div>
                        </div>
                    `);
                },
                complete: function () {
                    setTimeout(() => { $('#content-loader').fadeOut(200); }, 300);
                }
            };

            if (method.toUpperCase() === 'GET') {
                ajaxOptions.data = form.serialize();
            } else {
                ajaxOptions.data = form.serialize();
            }

            $('#content-loader').css('display', 'flex');
            $.ajax(ajaxOptions);
        });
    });
</script>
</body>
</html>



