@model SGE.ViewModels.ProveedorListViewModel
@{
    Layout = Context.Request.Headers["X-Requested-With"] == "XMLHttpRequest" ? null : "_Layout";
    ViewData["Title"] = "Gestión de Proveedores";
    ViewData["BodyContainerClass"] = "container-fluid px-4";
    ViewData["ProveedoresModuleActive"] = "Directorio";
    var desde = Model.TotalRegistros == 0 ? 0 : ((Model.Pagina - 1) * Model.RegistrosPorPagina) + 1;
    var hasta = Math.Min(Model.Pagina * Model.RegistrosPorPagina, Model.TotalRegistros);
}

<style>
    .proveedores-page {
        width: 100%;
        max-width: 100%;
        padding: 1.5rem;
        color: #0f172a;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .proveedores-page .proveedores-title {
        font-size: 1.85rem;
        font-weight: 750;
    }

    .proveedores-page .toolbar-actions .btn {
        min-height: 42px;
        font-weight: 650;
    }

    .proveedores-page .btn,
    .proveedores-page .form-control,
    .proveedores-page .form-select,
    .proveedores-page .page-link {
        border-radius: 2rem;
    }

    .proveedores-page .form-select {
        min-height: 42px;
        padding-top: .55rem;
        padding-bottom: .55rem;
        border-radius: 999px !important;
        appearance: none;
        -webkit-appearance: none;
        -moz-appearance: none;
        overflow: hidden;
        background-clip: padding-box;
    }

    .proveedores-page .form-select:focus {
        border-color: #86b7fe;
        box-shadow: 0 0 0 .25rem rgba(13, 110, 253, .16);
    }

    .proveedores-page .metric-card {
        position: relative;
        overflow: hidden;
        border: 0;
        border-radius: 1.25rem;
        background: linear-gradient(135deg, #ffffff 0%, #f8fafc 100%);
        box-shadow: 0 12px 30px rgba(15, 23, 42, .08);
        min-height: 152px;
    }

    .proveedores-page .metric-card::after {
        content: "";
        position: absolute;
        width: 86px;
        height: 86px;
        right: -26px;
        top: -26px;
        border-radius: 50%;
        background: rgba(13, 110, 253, .10);
    }

    .proveedores-page .metric-icon {
        position: relative;
        z-index: 1;
        width: 42px;
        height: 42px;
        border-radius: 1rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: #0d6efd;
        background: rgba(13, 110, 253, .10);
        margin-bottom: .75rem;
    }

    .proveedores-page .proveedor-kpis > div:nth-child(1) .metric-icon { color: #2563eb; background: rgba(37,99,235,.12); }
    .proveedores-page .proveedor-kpis > div:nth-child(2) .metric-icon { color: #16a34a; background: rgba(22,163,74,.12); }
    .proveedores-page .proveedor-kpis > div:nth-child(3) .metric-icon { color: #d97706; background: rgba(217,119,6,.14); }
    .proveedores-page .proveedor-kpis > div:nth-child(4) .metric-icon { color: #dc2626; background: rgba(220,38,38,.12); }

    .proveedores-page .metric-icon svg { width: 22px; height: 22px; }

    .proveedores-page .metric-label {
        color: #64748b;
        font-size: .78rem;
        font-weight: 600;
        text-transform: uppercase;
    }

    .proveedores-page .metric-value {
        color: #0f172a;
        font-size: 1.65rem;
        font-weight: 750;
    }

    .proveedores-page .filter-shell {
        border: 1px solid #e2e8f0;
        border-radius: 1rem;
        background: #ffffff;
        box-shadow: 0 8px 20px rgba(15, 23, 42, .04);
        padding: .55rem;
    }

    .proveedores-page .filter-bar {
        display: grid;
        grid-template-columns: minmax(260px, 1fr) 160px 160px auto;
        align-items: center;
        gap: .65rem;
    }

    .proveedores-page .filter-search-wrap {
        display: flex;
        align-items: center;
        gap: .55rem;
        border: 1px solid #e2e8f0;
        background: #fff;
        padding: 0 .95rem;
        min-height: 40px;
        border-radius: 999px;
    }

    .proveedores-page .filter-search-wrap:focus-within {
        border-color: #86b7fe;
        box-shadow: 0 0 0 .25rem rgba(13, 110, 253, .16);
    }

    .proveedores-page .filter-search-wrap i { color: #94a3b8; font-size: .92rem; }

    .proveedores-page .search-input {
        min-height: 36px;
        padding: 0;
        border: 0;
        border-radius: 0;
        box-shadow: none !important;
        font-size: .84rem;
    }

    .proveedores-page .erp-table-wrap {
        border-radius: 1.25rem;
        box-shadow: 0 12px 30px rgba(15, 23, 42, .07);
        border: 1px solid #e2e8f0;
        overflow: visible;
        position: relative;
    }

    .proveedores-page .table-responsive {
        overflow: visible;
    }

    .proveedores-page #proveedoresTable th {
        color: #475569;
        font-size: .76rem;
        font-weight: 750;
        text-transform: uppercase;
    }

    .proveedores-page .action-menu-btn {
        width: 34px;
        height: 34px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 999px;
        border: 1px solid #e2e8f0;
        background: #fff;
        color: #475569;
    }

    .proveedores-page .action-menu-btn:hover,
    .proveedores-page .action-menu-btn.show { background: #f8fafc; color: #0f172a; }
    .proveedores-page .action-menu-btn::after { display: none; }

    .proveedores-page .dropdown-menu {
        z-index: 2000;
        border: 0;
        border-radius: 1rem;
        padding: .45rem;
        box-shadow: 0 18px 45px rgba(15, 23, 42, .20);
    }

    .proveedores-page .dropdown-item { border-radius: .75rem; }

    .proveedores-page .delete-confirm-modal .modal-dialog { max-width: 380px; }

    .proveedores-page .delete-confirm-modal .modal-content {
        border: 0;
        border-radius: 1.25rem;
        box-shadow: 0 24px 70px rgba(15, 23, 42, .25);
    }

    @@media (max-width: 767.98px) {
        .proveedores-page { padding: 1rem; }
        .proveedores-page .proveedores-title { font-size: 1.45rem; }
        .proveedores-page .toolbar-actions { display: grid !important; grid-template-columns: 1fr; width: 100%; }
        .proveedores-page .filter-bar { grid-template-columns: 1fr; }
    }
</style>

<div class="proveedores-page">
    @await Html.PartialAsync("_ProveedoresModuleNav")
    <div class="d-flex flex-column flex-xl-row justify-content-between align-items-xl-center gap-3 mb-4">
        <div>
            <h1 class="proveedores-title mb-1">Gestión de Proveedores</h1>
            <p class="text-muted mb-0">Directorio empresarial de proveedores · Mostrando @desde–@hasta de @Model.TotalRegistros proveedores</p>
        </div>
        <div class="toolbar-actions d-flex flex-wrap gap-2">
            <a href="/Proveedores/Create" class="btn btn-success px-4" onclick="event.preventDefault(); spaNavigate('/Proveedores/Create')">
                <i class="bi bi-truck me-1"></i> Nuevo Proveedor
            </a>
            <div class="dropdown">
                <button type="button" class="btn btn-outline-dark dropdown-toggle px-4" data-bs-toggle="dropdown" data-bs-display="static">
                    Acciones
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li><button type="button" class="dropdown-item text-success"><i class="bi bi-file-earmark-excel me-2"></i>Exportar Excel</button></li>
                    <li><button type="button" class="dropdown-item text-danger"><i class="bi bi-file-earmark-pdf me-2"></i>Exportar PDF</button></li>
                </ul>
            </div>
        </div>
    </div>

    @if (TempData["Success"] is not null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-pill px-4" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] is not null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-pill px-4" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- KPIs -->
    <div class="row g-3 mb-4 proveedor-kpis">
        <div class="col-12 col-md-6 col-xl-3">
            <div class="metric-card p-3 h-100">
                <div class="metric-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                </div>
                <div class="metric-label">Total Proveedores</div>
                <div class="metric-value">@Model.Kpis.TotalProveedores</div>
                <div class="small text-success fw-semibold">+5% este mes</div>
            </div>
        </div>
        <div class="col-12 col-md-6 col-xl-3">
            <div class="metric-card p-3 h-100">
                <div class="metric-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                </div>
                <div class="metric-label">Proveedores Activos</div>
                <div class="metric-value">@Model.Kpis.ProveedoresActivos</div>
                <div class="small text-success fw-semibold">En operación</div>
            </div>
        </div>
        <div class="col-12 col-md-6 col-xl-3">
            <div class="metric-card p-3 h-100">
                <div class="metric-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                </div>
                <div class="metric-label">Contactos Registrados</div>
                <div class="metric-value">@Model.Kpis.TotalContactos</div>
                <div class="small text-warning fw-semibold">3 nuevos</div>
            </div>
        </div>
        <div class="col-12 col-md-6 col-xl-3">
            <div class="metric-card p-3 h-100">
                <div class="metric-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7H14a3.5 3.5 0 0 1 0 7H6"/></svg>
                </div>
                <div class="metric-label">Compras Totales</div>
                <div class="fs-5 fw-bold">S/ @((Model.Kpis.ComprasTotales / 1000).ToString("0"))K</div>
                <div class="small text-danger fw-semibold">Este año</div>
            </div>
        </div>
    </div>

    <!-- FILTROS -->
    <form asp-action="Index" method="get" id="filterForm" class="filter-shell mb-3">
        <input asp-for="Pagina" type="hidden" id="Pagina" value="1" />
        <div class="filter-bar">
            <div class="filter-search-wrap">
                <i class="bi bi-search"></i>
                <input asp-for="Busqueda" class="form-control search-input" autocomplete="off" placeholder="Buscar por razón social, documento, nombre comercial..." />
            </div>
            <select asp-for="FiltroEstado" class="form-select">
                <option value="">Estado</option>
                <option value="Activo">Activo</option>
                <option value="Inactivo">Inactivo</option>
            </select>
            <select asp-for="RegistrosPorPagina" class="form-select">
                <option value="10">10 por pág</option>
                <option value="25">25 por pág</option>
                <option value="50">50 por pág</option>
                <option value="100">100 por pág</option>
            </select>
            <button type="submit" class="btn btn-primary px-4">
                <i class="bi bi-search me-1"></i> Buscar
            </button>
        </div>
    </form>

    <div class="d-flex justify-content-end mb-3">
        <div class="text-muted small">Mostrando @desde–@hasta de @Model.TotalRegistros registros encontrados</div>
    </div>

    <!-- TABLA -->
    <div class="table-responsive erp-table-wrap bg-white">
        <table class="table table-hover align-middle mb-0" id="proveedoresTable">
            <thead class="table-light">
                <tr>
                    <th class="text-end pe-3" style="width:120px;">Acciones</th>
                    <th>Código</th>
                    <th>Empresa</th>
                    <th>Documento</th>
                    <th>Contacto</th>
                    <th>Teléfono</th>
                    <th>Email</th>
                    <th>Estado</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Proveedores.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted py-5">No se encontraron proveedores con los filtros seleccionados.</td>
                    </tr>
                }
                else
                {
                    @foreach (var proveedor in Model.Proveedores)
                    {
                        <tr>
                            <td class="text-end pe-3">
                                <div class="dropdown d-inline-block">
                    <button class="btn action-menu-btn dropdown-toggle" type="button" data-bs-toggle="dropdown" data-bs-display="static" data-bs-boundary="viewport" data-bs-offset="0,8">
                                        <i class="bi bi-three-dots-vertical"></i>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li><button class="dropdown-item" type="button">Ver detalle</button></li>
                                        <li><button class="dropdown-item" type="button">Editar</button></li>
                                        <li>
                                            <button type="button" class="dropdown-item text-danger"
                                                    data-delete-action="@Url.Action("Delete", new { id = proveedor.ProveedorId })"
                                                    data-delete-name="@proveedor.RazonSocial">
                                                Eliminar proveedor
                                            </button>
                                        </li>
                                    </ul>
                                </div>
                            </td>
                            <td><strong>PROV-@proveedor.ProveedorId.ToString("D3")</strong></td>
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    <div class="rounded-circle border bg-light d-flex align-items-center justify-content-center text-muted fw-semibold" style="width:44px;height:44px;flex-shrink:0;">
                                        @proveedor.RazonSocial[..1]
                                    </div>
                                    <div>
                                        <div class="fw-semibold">@proveedor.RazonSocial</div>
                                        <div class="text-muted small">@(proveedor.NombreComercial ?? "-")</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <small class="text-muted">@proveedor.TipoDocumento</small><br>
                                <strong>@proveedor.NumeroDocumento</strong>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(proveedor.NombreContacto))
                                {
                                    <div>@proveedor.NombreContacto</div>
                                    @if (!string.IsNullOrEmpty(proveedor.CargoContacto))
                                    {
                                        <small class="text-muted">@proveedor.CargoContacto</small>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td>@(proveedor.Telefono ?? "-")</td>
                            <td>@(proveedor.Email ?? "-")</td>
                            <td>
                                @if (proveedor.Activo)
                                {
                                    <span class="badge rounded-pill bg-success">Activo</span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill bg-secondary">Inactivo</span>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- TOKEN CSRF para operaciones POST -->
    <form id="_csrfForm">@Html.AntiForgeryToken()</form>

    <!-- MODAL ELIMINAR -->
    <div class="modal fade delete-confirm-modal" id="deleteProveedorModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold">Eliminar proveedor</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-1">Esta acción eliminará el proveedor.</p>
                    <p class="fw-semibold mb-0" data-delete-proveedor-name></p>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light px-3" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-danger px-3" data-confirm-delete-submit>Eliminar</button>
                </div>
            </div>
        </div>
    </div>

    <!-- PAGINACIÓN -->
    <nav class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mt-3">
        <div class="text-muted small">Página @Model.Pagina de @Model.TotalPaginas</div>
        <ul class="pagination mb-0">
            <li class="page-item @(Model.Pagina <= 1 ? "disabled" : "")">
                <a class="page-link" href="/Proveedores/Index?pagina=@(Model.Pagina - 1)&busqueda=@Model.Busqueda&filtroEstado=@Model.FiltroEstado"
                   onclick="event.preventDefault(); spaNavigate(this.href)">Anterior</a>
            </li>
            @for (var i = Math.Max(1, Model.Pagina - 2); i <= Math.Min(Model.TotalPaginas, Model.Pagina + 2); i++)
            {
                <li class="page-item @(i == Model.Pagina ? "active" : "")">
                    <a class="page-link" href="/Proveedores/Index?pagina=@i&busqueda=@Model.Busqueda&filtroEstado=@Model.FiltroEstado"
                       onclick="event.preventDefault(); spaNavigate(this.href)">@i</a>
                </li>
            }
            <li class="page-item @(Model.Pagina >= Model.TotalPaginas ? "disabled" : "")">
                <a class="page-link" href="/Proveedores/Index?pagina=@(Model.Pagina + 1)&busqueda=@Model.Busqueda&filtroEstado=@Model.FiltroEstado"
                   onclick="event.preventDefault(); spaNavigate(this.href)">Siguiente</a>
            </li>
        </ul>
    </nav>
</div>

<script>
    (() => {
        let pendingDeleteAction = '';

        document.getElementById('filterForm')?.addEventListener('submit', function (e) {
            e.preventDefault();
            const params = new URLSearchParams(new FormData(this));
            window.spaNavigate('/Proveedores/Index?' + params.toString());
        });

        document.querySelectorAll('[data-delete-action]').forEach(button => {
            button.addEventListener('click', function () {
                pendingDeleteAction = this.dataset.deleteAction || '';
                const modal = document.getElementById('deleteProveedorModal');
                const name = modal?.querySelector('[data-delete-proveedor-name]');
                if (name) name.textContent = this.dataset.deleteName || '';
                if (modal && window.bootstrap) bootstrap.Modal.getOrCreateInstance(modal).show();
            });
        });

        document.querySelector('[data-confirm-delete-submit]')?.addEventListener('click', async function () {
            if (!pendingDeleteAction) return;
            this.disabled = true;
            this.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Eliminando...';
            // Obtener token desde meta tag o cualquier form de la página
            const token = document.querySelector('meta[name="__RequestVerificationToken"]')?.content
                       || document.querySelector('input[name="__RequestVerificationToken"]')?.value
                       || '';
            const formData = new FormData();
            if (token) formData.append('__RequestVerificationToken', token);
            try {
                const response = await fetch(pendingDeleteAction, { method: 'POST', body: formData, headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                if (!response.ok) throw new Error();
                const dynamicContent = document.getElementById('dynamic-content');
                if (dynamicContent) {
                    dynamicContent.innerHTML = await response.text();
                } else {
                    window.location.reload();
                }
            } catch {
                window.location.reload();
            }
        });
    })();
</script>
