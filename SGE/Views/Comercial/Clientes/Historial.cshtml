<!-- MODAL DETALLE OPERACIÓN -->
<div class="modal fade detail-modal" id="modalDetalleOperacion" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0">
                <div>
                    <div class="badge rounded-pill bg-light text-dark border mb-2" id="detalle-doc"></div>
                    <h5 class="modal-title fw-bold" id="detalle-cliente"></h5>
                    <div class="text-muted small" id="detalle-tipo"></div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="row g-2">
                    <div class="col-6"><div class="detail-card"><div class="detail-label">Monto</div><div class="fw-bold fs-5" id="detalle-monto"></div></div></div>
                    <div class="col-6"><div class="detail-card"><div class="detail-label">Estado</div><div class="fw-semibold" id="detalle-estado"></div></div></div>
                    <div class="col-6"><div class="detail-card"><div class="detail-label">Fecha</div><div id="detalle-fecha"></div></div></div>
                    <div class="col-6"><div class="detail-card"><div class="detail-label">Responsable</div><div id="detalle-responsable"></div></div></div>
                </div>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-light px-4" data-bs-dismiss="modal">Cerrar</button>
                <button type="button" class="btn btn-primary px-4"><i class="bi bi-file-earmark-arrow-down me-2"></i>Descargar</button>
            </div>
        </div>
    </div>
</div>

<script>
    (() => {
        // Filtro búsqueda en tabla
        document.getElementById('btnBuscarHistorial')?.addEventListener('click', filtrarHistorial);
        document.getElementById('buscarHistorial')?.addEventListener('keydown', e => { if (e.key === 'Enter') filtrarHistorial(); });

        function filtrarHistorial() {
            const texto = document.getElementById('buscarHistorial').value.trim().toLowerCase();
            const filas = document.querySelectorAll('#historialBody tr');
            let visibles = 0;
            filas.forEach(fila => {
                const cliente = fila.dataset.cliente?.toLowerCase() || '';
                const doc = fila.dataset.doc?.toLowerCase() || '';
                const coincide = !texto || cliente.includes(texto) || doc.includes(texto);
                fila.style.display = coincide ? '' : 'none';
                if (coincide) visibles++;
            });
            const count = document.getElementById('historialCount');
            if (count) count.textContent = `Mostrando ${visibles} de 3 operaciones`;
        }

        // Modal ver detalle
        document.querySelectorAll('.btn-ver-detalle').forEach(btn => {
            btn.addEventListener('click', function () {
                document.getElementById('detalle-doc').textContent = this.dataset.doc;
                document.getElementById('detalle-cliente').textContent = this.dataset.cliente;
                document.getElementById('detalle-tipo').textContent = this.dataset.tipo;
                document.getElementById('detalle-monto').textContent = this.dataset.monto;
                document.getElementById('detalle-estado').textContent = this.dataset.estado;
                document.getElementById('detalle-fecha').textContent = this.dataset.fecha;
                document.getElementById('detalle-responsable').textContent = this.dataset.responsable;
                bootstrap.Modal.getOrCreateInstance(document.getElementById('modalDetalleOperacion')).show();
            });
        });

        // Exportar reporte (descarga CSV simple)
        document.getElementById('btnExportarReporte')?.addEventListener('click', () => {
            const filas = document.querySelectorAll('#historialBody tr');
            let csv = 'Fecha,Cliente,Documento,Monto,Estado,Responsable\n';
            filas.forEach(fila => {
                const celdas = fila.querySelectorAll('td');
                if (celdas.length && fila.style.display !== 'none') {
                    csv += `"${celdas[0].textContent.trim()}","${fila.dataset.cliente}","${fila.dataset.doc}","","",""\n`;
                }
            });
            const blob = new Blob([csv], { type: 'text/csv' });
            const a = document.createElement('a');
            a.href = URL.createObjectURL(blob);
            a.download = 'historial-comercial.csv';
            a.click();
        });
    })();
</script>
