@{
    Layout = Context.Request.Headers["X-Requested-With"] == "XMLHttpRequest" ? null : "_Layout";
    ViewData["Title"] = "Historial Comercial";
    ViewData["BodyContainerClass"] = "container-fluid px-4";
    ViewData["ClientesModuleActive"] = "Historial";
}

<style>
    .clientes-page {
        width: 100%;
        max-width: 100%;
        padding: 1.5rem;
        color: #0f172a;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .clientes-page .btn,
    .clientes-page .form-control,
    .clientes-page .form-select,
    .clientes-page .page-link { border-radius: 2rem; }

    .clientes-page .metric-card {
        position: relative; overflow: hidden; border: 0;
        border-radius: 1.25rem;
        background: linear-gradient(135deg, #ffffff 0%, #f8fafc 100%);
        box-shadow: 0 12px 30px rgba(15,23,42,.08); min-height: 152px;
    }
    .clientes-page .metric-card::after {
        content: ""; position: absolute; width: 86px; height: 86px;
        right: -26px; top: -26px; border-radius: 50%;
        background: rgba(13,110,253,.10);
    }
    .clientes-page .metric-icon {
        position: relative; z-index: 1; width: 42px; height: 42px;
        border-radius: 1rem; display: inline-flex; align-items: center;
        justify-content: center; margin-bottom: .75rem;
    }
    .clientes-page .historial-kpis > div:nth-child(1) .metric-icon { color: #2563eb; background: rgba(37,99,235,.12); }
    .clientes-page .historial-kpis > div:nth-child(2) .metric-icon { color: #16a34a; background: rgba(22,163,74,.12); }
    .clientes-page .historial-kpis > div:nth-child(3) .metric-icon { color: #d97706; background: rgba(217,119,6,.14); }
    .clientes-page .historial-kpis > div:nth-child(4) .metric-icon { color: #dc2626; background: rgba(220,38,38,.12); }
    .clientes-page .metric-icon svg { width: 22px; height: 22px; }
    .clientes-page .metric-label { color: #64748b; font-size: .78rem; font-weight: 600; text-transform: uppercase; }
    .clientes-page .metric-value { color: #0f172a; font-size: 1.65rem; font-weight: 750; }

    .clientes-page .filter-shell {
        border: 1px solid #e2e8f0; border-radius: 1rem;
        background: #fff; box-shadow: 0 8px 20px rgba(15,23,42,.04); padding: .75rem 1rem;
    }
    .clientes-page .filter-search-wrap {
        display: flex; align-items: center; gap: .55rem;
        border: 1px solid #e2e8f0; background: #fff;
        padding: 0 .95rem; min-height: 40px; border-radius: 999px;
    }
    .clientes-page .filter-search-wrap:focus-within { border-color: #86b7fe; box-shadow: 0 0 0 .25rem rgba(13,110,253,.16); }
    .clientes-page .filter-search-wrap i { color: #94a3b8; }
    .clientes-page .search-input { min-height: 36px; padding: 0; border: 0; border-radius: 0; box-shadow: none !important; font-size: .84rem; }

    .clientes-page .erp-table-wrap { border-radius: 1.25rem; box-shadow: 0 12px 30px rgba(15,23,42,.07); border: 1px solid #e2e8f0; }
    .clientes-page #historialTable th { color: #475569; font-size: .76rem; font-weight: 750; text-transform: uppercase; }

    .clientes-page #historialTable th:nth-child(3),
    .clientes-page #historialTable td:nth-child(3) {
        width: 2rem;
        min-width: 2rem;
        max-width: 2rem;
        white-space: nowrap;
    }

    .clientes-page #historialTable td:nth-child(3) .badge {
        max-width: 2rem;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .clientes-page .activity-item { display: flex; align-items: flex-start; gap: 1rem; padding: .75rem 0; border-bottom: 1px solid #f1f5f9; }
    .clientes-page .activity-item:last-child { border-bottom: 0; }
    .clientes-page .activity-dot { width: 10px; height: 10px; border-radius: 50%; margin-top: .35rem; flex-shrink: 0; }

    .clientes-page .detail-modal .modal-content { border: 0; border-radius: 1.75rem; box-shadow: 0 24px 70px rgba(15,23,42,.25); overflow: hidden; }
    .clientes-page .detail-modal .modal-dialog { max-width: 560px; }
    .clientes-page .detail-card { border: 1px solid #e2e8f0; border-radius: 1.25rem; padding: .9rem; background: #fff; }
    .clientes-page .detail-label { color: #64748b; font-size: .75rem; font-weight: 700; text-transform: uppercase; }

    @@media (max-width: 767.98px) {
        .clientes-page { padding: 1rem; }
    }
</style>

