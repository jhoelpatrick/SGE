@{
    var active = (ViewData["ClientesModuleActive"] as string) ?? "Directorio";
    var items = new[]
    {
        new { Text = "Directorio",    Action = "Index",     Icon = "bi-people" },
        new { Text = "Historial",     Action = "Historial", Icon = "bi-clock-history" },
        new { Text = "Contactos",     Action = "Contactos", Icon = "bi-person-lines-fill" },
        new { Text = "Nuevo Cliente", Action = "Create",    Icon = "bi-person-plus" }
    };
}

<style>
    .clientes-module-nav {
        display: flex;
        align-items: center;
        gap: 1rem;
        min-height: 52px;
        padding: .45rem 1.5rem;
        margin: -1.5rem -1.5rem 1.5rem;
        background: #fff;
        border-bottom: 1px solid #e5e7eb;
        overflow-x: auto;
    }

    .clientes-module-nav .module-label {
        flex: 0 0 auto;
        color: #1f2937;
        font-size: .95rem;
        font-weight: 750;
        white-space: nowrap;
    }

    .clientes-module-nav .module-tabs {
        display: flex;
        align-items: center;
        gap: .35rem;
        min-width: max-content;
    }

    .clientes-module-nav .module-tab {
        display: inline-flex;
        align-items: center;
        gap: .45rem;
        min-height: 34px;
        padding: .45rem .8rem;
        border-radius: 999px;
        color: #64748b;
        font-size: .86rem;
        font-weight: 650;
        text-decoration: none;
        white-space: nowrap;
        transition: background-color .18s ease, color .18s ease;
    }

    .clientes-module-nav .module-tab:hover { color: #0f172a; background: #f1f5f9; }

    .clientes-module-nav .module-tab.active {
        color: #0f172a;
        background: #e5e7eb;
        box-shadow: inset 0 0 0 1px rgba(15,23,42,.04);
    }

    .clientes-module-nav .module-tab i { color: #94a3b8; font-size: .98rem; }
    .clientes-module-nav .module-tab.active i { color: #334155; }

    @@media (max-width: 767.98px) {
        .clientes-module-nav {
            flex-direction: column;
            align-items: flex-start;
            gap: .55rem;
            padding: .75rem 1rem;
            margin: -1rem -1rem 1rem;
        }
    }
</style>

<nav class="clientes-module-nav" aria-label="Modulo de Clientes">
    <div class="module-label">Modulo de Clientes</div>
    <div class="module-tabs">
        @foreach (var item in items)
        {
            var isActive = string.Equals(active, item.Text, StringComparison.OrdinalIgnoreCase);
            <a class="module-tab @(isActive ? "active" : "")"
               href="/Clientes/@item.Action"
               data-spa-link="true">
                <i class="bi @item.Icon"></i>
                <span>@item.Text</span>
            </a>
        }
    </div>
</nav>

<script>
    (function () {
        // Función central de navegación SPA — usa loadContent del Dashboard si existe,
        // si no hace fetch directo en dynamic-content
        function spaNavigate(url) {
            const dynamicContent = document.getElementById('dynamic-content');
            if (!dynamicContent) { window.location.href = url; return; }

            const loader = document.getElementById('content-loader');
            if (loader) loader.style.display = 'flex';

            fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                .then(r => { if (!r.ok) throw new Error(); return r.text(); })
                .then(html => {
                    // Limpiar modales/dropdowns abiertos
                    document.querySelectorAll('.modal.show').forEach(m => {
                        bootstrap.Modal.getInstance(m)?.hide();
                    });
                    document.querySelectorAll('.modal-backdrop').forEach(b => b.remove());
                    document.body.classList.remove('modal-open');
                    document.body.style.removeProperty('overflow');
                    document.body.style.removeProperty('padding-right');

                    dynamicContent.innerHTML = html;

                    // Re-ejecutar scripts inline
                    dynamicContent.querySelectorAll('script').forEach(old => {
                        const s = document.createElement('script');
                        Array.from(old.attributes).forEach(a => s.setAttribute(a.name, a.value));
                        s.textContent = old.textContent;
                        old.replaceWith(s);
                    });
                })
                .catch(() => { window.location.href = url; })
                .finally(() => {
                    if (loader) setTimeout(() => { loader.style.display = 'none'; }, 200);
                });
        }

        // Exponer globalmente para que Create/Index puedan usarla
        window.spaNavigate = spaNavigate;

        // Interceptar tabs del nav
        if (!window.__clientesNavReady) {
            window.__clientesNavReady = true;

            document.addEventListener('click', function (e) {
                const link = e.target.closest('[data-spa-link="true"]');
                if (!link) return;
                e.preventDefault();
                spaNavigate(link.getAttribute('href'));
            });
        }
    })();
</script>
