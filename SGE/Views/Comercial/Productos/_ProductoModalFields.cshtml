@model SGE.Models.Producto
@* Campos para modal de Productos — columnas: Nombre, Descripcion, SKU, Categoria, Unidad, Precio Venta, Precio Costo, Imagen *@
@{
    var cats = (ViewBag.Categorias as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>) ?? Enumerable.Empty<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>();
}

<div class="col-12 col-md-4">
    <label class="form-label fw-semibold small">SKU <span class="text-danger">*</span></label>
    <input name="SKU" value="@Model.SKU" class="form-control" required maxlength="50" placeholder="Ej. PROD-001" />
</div>
<div class="col-12 col-md-8">
    <label class="form-label fw-semibold small">Nombre <span class="text-danger">*</span></label>
    <input name="Nombre" value="@Model.Nombre" class="form-control" required maxlength="150" placeholder="Nombre del producto" />
</div>
<div class="col-12">
    <label class="form-label fw-semibold small">Descripcion</label>
    <textarea name="Descripcion" class="form-control" rows="2" maxlength="500" placeholder="Descripcion breve del producto">@Model.Descripcion</textarea>
</div>
<div class="col-12 col-md-6">
    <label class="form-label fw-semibold small">Categoria <span class="text-danger">*</span></label>
    <select name="CategoriaId" class="form-select" required>
        <option value="">Selecciona una categoria</option>
        @foreach (var c in cats)
        {
            if (c.Value == Model.CategoriaId.ToString())
            {
                <option value="@c.Value" selected>@c.Text</option>
            }
            else
            {
                <option value="@c.Value">@c.Text</option>
            }
        }
    </select>
</div>
<div class="col-12 col-md-6">
    <label class="form-label fw-semibold small">Unidad de medida <span class="text-danger">*</span></label>
    <input name="UnidadDeMedida" value="@Model.UnidadDeMedida" class="form-control" required maxlength="50" placeholder="pieza, caja, kg, servicio" />
</div>
<div class="col-12 col-md-6">
    <label class="form-label fw-semibold small">Precio venta</label>
    <div class="input-group">
        <span class="input-group-text rounded-start-pill">S/</span>
        <input name="PrecioUnitario" type="number" step="0.01" min="0" value="@Model.PrecioUnitario" class="form-control rounded-end-pill" />
    </div>
</div>
<div class="col-12 col-md-6">
    <label class="form-label fw-semibold small">Precio costo</label>
    <div class="input-group">
        <span class="input-group-text rounded-start-pill">S/</span>
        <input name="CostoCompra" type="number" step="0.01" min="0" value="@Model.CostoCompra" class="form-control rounded-end-pill" />
    </div>
</div>
<div class="col-12 col-md-6">
    <label class="form-label fw-semibold small">Subir imagen</label>
    <input name="imagenArchivo" type="file" accept=".jpg,.jpeg,.png,.webp" class="form-control" />
</div>
<div class="col-12 col-md-6 d-flex align-items-end gap-4 pb-1">
    <input type="hidden" name="RequiereInventario" value="false" />
    <div class="form-check">
        <input name="RequiereInventario" value="true" class="form-check-input" type="checkbox" id="reqInv_@Model.ProductoId" @(Model.RequiereInventario ? "checked" : null) />
        <label class="form-check-label small" for="reqInv_@Model.ProductoId">Requiere inventario</label>
    </div>
    <input type="hidden" name="Activo" value="false" />
    <div class="form-check">
        <input name="Activo" value="true" class="form-check-input" type="checkbox" id="activo_@Model.ProductoId" @(Model.Activo ? "checked" : null) />
        <label class="form-check-label small" for="activo_@Model.ProductoId">Activo</label>
    </div>
</div>
