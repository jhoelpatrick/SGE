@model SGE.Models.Producto
@* Campos para modal de Insumos — columnas: Nombre, SKU, Categoria, Proveedor, Almacen, Stock actual, Stock min, Costo, Precio *@
@{
    var cats = (ViewBag.Categorias as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>) ?? Enumerable.Empty<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>();
}

<input type="hidden" name="RequiereInventario" value="true" />
<input type="hidden" name="Activo" value="@(Model.Activo ? "true" : "false")" />

<div class="col-12 col-md-8">
    <label class="form-label fw-semibold small">Nombre <span class="text-danger">*</span></label>
    <input name="Nombre" value="@Model.Nombre" class="form-control" required maxlength="150" placeholder="Nombre del insumo" />
</div>
<div class="col-12 col-md-4">
    <label class="form-label fw-semibold small">SKU <span class="text-danger">*</span></label>
    <input name="SKU" value="@Model.SKU" class="form-control" required maxlength="50" placeholder="Ej. INS-001" />
</div>
<div class="col-12 col-md-6">
    <label class="form-label fw-semibold small">Categoria <span class="text-danger">*</span></label>
    <select name="CategoriaId" class="form-select" required>
        <option value="">Selecciona una categoria</option>
        @foreach (var c in cats)
        {
            if (c.Value == Model.CategoriaId.ToString())
            {
                <option value="@c.Value" selected>@c.Text</option>
            }
            else
            {
                <option value="@c.Value">@c.Text</option>
            }
        }
    </select>
</div>
<div class="col-12 col-md-6">
    <label class="form-label fw-semibold small">Unidad de medida <span class="text-danger">*</span></label>
    <input name="UnidadDeMedida" value="@Model.UnidadDeMedida" class="form-control" required maxlength="50" placeholder="pieza, kg, caja..." />
</div>
<div class="col-12 col-md-6">
    <label class="form-label fw-semibold small">Proveedor</label>
    <input name="Proveedor" value="@Model.Proveedor" class="form-control" maxlength="150" placeholder="Nombre del proveedor" />
</div>
<div class="col-12 col-md-6">
    <label class="form-label fw-semibold small">Almacen</label>
    <input name="Almacen" value="@Model.Almacen" class="form-control" maxlength="120" placeholder="Ubicacion de almacen" />
</div>
<div class="col-12 col-md-3">
    <label class="form-label fw-semibold small">Stock actual</label>
    <input name="StockActual" type="number" min="0" value="@Model.StockActual" class="form-control" />
</div>
<div class="col-12 col-md-3">
    <label class="form-label fw-semibold small">Stock minimo</label>
    <input name="StockMinimo" type="number" min="0" value="@Model.StockMinimo" class="form-control" />
</div>
<div class="col-12 col-md-3">
    <label class="form-label fw-semibold small">Precio costo</label>
    <div class="input-group">
        <span class="input-group-text rounded-start-pill">S/</span>
        <input name="CostoCompra" type="number" step="0.01" min="0" value="@Model.CostoCompra" class="form-control rounded-end-pill" />
    </div>
</div>
<div class="col-12 col-md-3">
    <label class="form-label fw-semibold small">Precio venta</label>
    <div class="input-group">
        <span class="input-group-text rounded-start-pill">S/</span>
        <input name="PrecioUnitario" type="number" step="0.01" min="0" value="@Model.PrecioUnitario" class="form-control rounded-end-pill" />
    </div>
</div>
<div class="col-12 col-md-6">
    <label class="form-label fw-semibold small">Subir imagen</label>
    <input name="imagenArchivo" type="file" accept=".jpg,.jpeg,.png,.webp" class="form-control" />
</div>
<div class="col-12 col-md-6 d-flex align-items-end pb-1">
    <div class="form-check">
        <input name="Activo" value="true" class="form-check-input" type="checkbox" id="insumoActivo_@Model.ProductoId" @(Model.Activo ? "checked" : null) />
        <label class="form-check-label small" for="insumoActivo_@Model.ProductoId">Activo</label>
    </div>
</div>
