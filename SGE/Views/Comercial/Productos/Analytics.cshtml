@model SGE.ViewModels.ProductoKpiViewModel

@{
    Layout = Context.Request.Headers["X-Requested-With"] == "XMLHttpRequest" ? null : "_Layout";
    ViewData["Title"] = "Analytics";
    ViewData["BodyContainerClass"] = "container-fluid px-4";
    ViewData["ProductosModuleActive"] = "Analytics";
    var totalCatalogo = Model.TotalProductos + Model.TotalServicios;
    var totalEstados = Math.Max(1, Model.ProductosActivos + Model.ProductosInactivos);
    var pctActivos = (Model.ProductosActivos * 100) / totalEstados;
    var pctInactivos = 100 - pctActivos;
    var totalStock = Math.Max(1, Model.TotalProductos);
    var disponibles = Model.TotalProductos - Model.ProductosBajoStock - Model.ProductosAgotados;
    var pctDisponibles = (disponibles * 100) / totalStock;
    var pctBajoStock = (Model.ProductosBajoStock * 100) / totalStock;
    var pctAgotados = (Model.ProductosAgotados * 100) / totalStock;
}

<style>
    .analytics-page {
        width: 100%;
        padding: 1.5rem;
        color: #0f172a;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .analytics-page .page-title { font-size: 1.85rem; font-weight: 750; }

    .analytics-page .kpi-card {
        border: 1px solid #e2e8f0;
        border-radius: 1.25rem;
        background: #fff;
        box-shadow: 0 8px 24px rgba(15,23,42,.07);
        padding: 1.1rem 1.25rem;
    }

    .analytics-page .kpi-icon {
        width: 44px; height: 44px; border-radius: 1rem;
        display: inline-flex; align-items: center; justify-content: center;
        font-size: 1.3rem; margin-bottom: .6rem;
    }

    .analytics-page .kpi-label {
        color: #64748b; font-size: .76rem; font-weight: 700;
        text-transform: uppercase; letter-spacing: .04em;
    }

    .analytics-page .kpi-value { font-size: 1.7rem; font-weight: 750; color: #0f172a; }
    .analytics-page .kpi-sub { font-size: .78rem; color: #94a3b8; margin-top: .2rem; }

    .analytics-page .chart-card {
        border: 1px solid #e2e8f0;
        border-radius: 1.25rem;
        background: #fff;
        box-shadow: 0 8px 24px rgba(15,23,42,.06);
        padding: 1.25rem;
    }

    .analytics-page .chart-title {
        font-size: .78rem; font-weight: 700; color: #64748b;
        text-transform: uppercase; letter-spacing: .04em;
    }

    .analytics-page .chart-heading { font-size: 1.05rem; font-weight: 750; }

    .analytics-page .progress {
        height: .65rem; border-radius: 999px; background: #f1f5f9;
    }

    .analytics-page .legend-dot {
        width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0;
    }

    .analytics-page .stat-row {
        display: flex; align-items: center; justify-content: space-between;
        padding: .55rem 0; border-bottom: 1px solid #f1f5f9;
    }

    .analytics-page .stat-row:last-child { border-bottom: 0; }
</style>

<div class="analytics-page">
    @await Html.PartialAsync("_ProductosModuleNav")

    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">
        <div>
            <h1 class="page-title mb-1">Analytics</h1>
            <p class="text-muted mb-0">Indicadores principales del catalogo, inventario y disponibilidad.</p>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-6 col-md-4 col-xl-2">
            <div class="kpi-card h-100">
                <div class="kpi-icon bg-primary bg-opacity-10 text-primary"><i class="bi bi-grid"></i></div>
                <div class="kpi-label">Catalogo</div>
                <div class="kpi-value">@totalCatalogo</div>
                <div class="kpi-sub">Productos y servicios</div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-xl-2">
            <div class="kpi-card h-100">
                <div class="kpi-icon bg-success bg-opacity-10 text-success"><i class="bi bi-box-seam"></i></div>
                <div class="kpi-label">Productos</div>
                <div class="kpi-value">@Model.TotalProductos</div>
                <div class="kpi-sub">Con inventario</div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-xl-2">
            <div class="kpi-card h-100">
                <div class="kpi-icon bg-info bg-opacity-10 text-info"><i class="bi bi-file-earmark-text"></i></div>
                <div class="kpi-label">Servicios</div>
                <div class="kpi-value">@Model.TotalServicios</div>
                <div class="kpi-sub">Sin stock</div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-xl-2">
            <div class="kpi-card h-100">
                <div class="kpi-icon bg-warning bg-opacity-10 text-warning"><i class="bi bi-exclamation-triangle"></i></div>
                <div class="kpi-label">Bajo stock</div>
                <div class="kpi-value text-warning">@Model.ProductosBajoStock</div>
                <div class="kpi-sub">Requieren reposicion</div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-xl-2">
            <div class="kpi-card h-100">
                <div class="kpi-icon bg-danger bg-opacity-10 text-danger"><i class="bi bi-x-circle"></i></div>
                <div class="kpi-label">Agotados</div>
                <div class="kpi-value text-danger">@Model.ProductosAgotados</div>
                <div class="kpi-sub">Stock en cero</div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-xl-2">
            <div class="kpi-card h-100">
                <div class="kpi-icon bg-success bg-opacity-10 text-success"><i class="bi bi-currency-dollar"></i></div>
                <div class="kpi-label">Valor inventario</div>
                <div class="kpi-value" style="font-size:1.2rem;">@Model.ValorTotalInventario.ToString("C")</div>
                <div class="kpi-sub">Costo valorizado</div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-12 col-xl-4">
            <div class="chart-card h-100">
                <div class="chart-title mb-1">Estado comercial</div>
                <div class="chart-heading mb-3">Activos vs Inactivos</div>
                <div style="position:relative;height:160px;">
                    <canvas id="chartEstado"></canvas>
                </div>
                <div class="mt-3">
                    <div class="stat-row">
                        <div class="d-flex align-items-center gap-2">
                            <div class="legend-dot bg-success"></div>
                            <span class="small">Activos</span>
                        </div>
                        <span class="fw-bold">@Model.ProductosActivos <span class="text-muted fw-normal small">(@pctActivos%)</span></span>
                    </div>
                    <div class="stat-row">
                        <div class="d-flex align-items-center gap-2">
                            <div class="legend-dot bg-secondary"></div>
                            <span class="small">Inactivos</span>
                        </div>
                        <span class="fw-bold">@Model.ProductosInactivos <span class="text-muted fw-normal small">(@pctInactivos%)</span></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-xl-4">
            <div class="chart-card h-100">
                <div class="chart-title mb-1">Tipo de catalogo</div>
                <div class="chart-heading mb-3">Productos vs Servicios</div>
                <div style="position:relative;height:160px;">
                    <canvas id="chartTipo"></canvas>
                </div>
                <div class="mt-3">
                    <div class="stat-row">
                        <div class="d-flex align-items-center gap-2">
                            <div class="legend-dot" style="background:#2563eb;"></div>
                            <span class="small">Productos</span>
                        </div>
                        <span class="fw-bold">@Model.TotalProductos</span>
                    </div>
                    <div class="stat-row">
                        <div class="d-flex align-items-center gap-2">
                            <div class="legend-dot" style="background:#0891b2;"></div>
                            <span class="small">Servicios</span>
                        </div>
                        <span class="fw-bold">@Model.TotalServicios</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-xl-4">
            <div class="chart-card h-100">
                <div class="chart-title mb-1">Estado de stock</div>
                <div class="chart-heading mb-3">Disponibilidad de inventario</div>
                <div style="position:relative;height:160px;">
                    <canvas id="chartStock"></canvas>
                </div>
                <div class="mt-3">
                    <div class="stat-row">
                        <div class="d-flex align-items-center gap-2">
                            <div class="legend-dot bg-success"></div>
                            <span class="small">Disponibles</span>
                        </div>
                        <span class="fw-bold">@disponibles <span class="text-muted fw-normal small">(@pctDisponibles%)</span></span>
                    </div>
                    <div class="stat-row">
                        <div class="d-flex align-items-center gap-2">
                            <div class="legend-dot bg-warning"></div>
                            <span class="small">Bajo stock</span>
                        </div>
                        <span class="fw-bold">@Model.ProductosBajoStock <span class="text-muted fw-normal small">(@pctBajoStock%)</span></span>
                    </div>
                    <div class="stat-row">
                        <div class="d-flex align-items-center gap-2">
                            <div class="legend-dot bg-danger"></div>
                            <span class="small">Agotados</span>
                        </div>
                        <span class="fw-bold">@Model.ProductosAgotados <span class="text-muted fw-normal small">(@pctAgotados%)</span></span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-12 col-xl-6">
            <div class="chart-card">
                <div class="chart-title mb-1">Resumen financiero</div>
                <div class="chart-heading mb-3">Valor del inventario</div>
                <div class="d-flex align-items-end gap-4 mb-3">
                    <div>
                        <div class="kpi-label">Valor total</div>
                        <div style="font-size:2rem;font-weight:750;">@Model.ValorTotalInventario.ToString("C")</div>
                    </div>
                </div>
                <div class="progress mb-2">
                    <div class="progress-bar bg-success" style="width:@pctActivos%"></div>
                </div>
                <div class="small text-muted">@pctActivos% del catalogo esta activo y disponible para venta.</div>
            </div>
        </div>
        <div class="col-12 col-xl-6">
            <div class="chart-card">
                <div class="chart-title mb-1">Alertas de inventario</div>
                <div class="chart-heading mb-3">Productos que requieren atencion</div>
                @if (Model.ProductosAgotados == 0 && Model.ProductosBajoStock == 0)
                {
                    <div class="d-flex align-items-center gap-2 text-success">
                        <i class="bi bi-check-circle-fill fs-4"></i>
                        <span class="fw-semibold">Todo el inventario esta en niveles optimos.</span>
                    </div>
                }
                else
                {
                    if (Model.ProductosAgotados > 0)
                    {
                        <div class="d-flex align-items-center justify-content-between p-3 rounded-3 bg-danger bg-opacity-10 mb-2">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-x-circle-fill text-danger fs-5"></i>
                                <span class="fw-semibold">Productos agotados</span>
                            </div>
                            <span class="badge bg-danger rounded-pill fs-6">@Model.ProductosAgotados</span>
                        </div>
                    }
                    if (Model.ProductosBajoStock > 0)
                    {
                        <div class="d-flex align-items-center justify-content-between p-3 rounded-3 bg-warning bg-opacity-10 mb-2">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-exclamation-triangle-fill text-warning fs-5"></i>
                                <span class="fw-semibold">Bajo stock</span>
                            </div>
                            <span class="badge bg-warning text-dark rounded-pill fs-6">@Model.ProductosBajoStock</span>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
    (() => {
        const defaults = {
            plugins: { legend: { display: false } },
            cutout: '72%',
            maintainAspectRatio: false,
            animation: { duration: 600 }
        };

        new Chart(document.getElementById('chartEstado'), {
            type: 'doughnut',
            data: {
                labels: ['Activos', 'Inactivos'],
                datasets: [{ data: [@Model.ProductosActivos, @Model.ProductosInactivos], backgroundColor: ['#16a34a','#94a3b8'], borderWidth: 0 }]
            },
            options: defaults
        });

        new Chart(document.getElementById('chartTipo'), {
            type: 'doughnut',
            data: {
                labels: ['Productos', 'Servicios'],
                datasets: [{ data: [@Model.TotalProductos, @Model.TotalServicios], backgroundColor: ['#2563eb','#0891b2'], borderWidth: 0 }]
            },
            options: defaults
        });

        new Chart(document.getElementById('chartStock'), {
            type: 'doughnut',
            data: {
                labels: ['Disponibles', 'Bajo stock', 'Agotados'],
                datasets: [{ data: [@disponibles, @Model.ProductosBajoStock, @Model.ProductosAgotados], backgroundColor: ['#16a34a','#d97706','#dc2626'], borderWidth: 0 }]
            },
            options: defaults
        });
    })();
</script>
