                <div class="modal-body">
                    <input type="hidden" name="ProductoId" value="@producto.ProductoId" />
                    <div class="row g-3">
                        @await Html.PartialAsync("_ProductoModalFields", producto)
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary px-4" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary px-4">Guardar cambios</button>
                </div>
            </form>
        </div>
    </div>

        <div class="modal fade" id="stockModal@producto.ProductoId" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <form asp-action="AdjustStock" asp-route-id="@producto.ProductoId" method="post" class="modal-content rounded-4">
                    @Html.AntiForgeryToken()
                    <div class="modal-header">
                        <h5 class="modal-title">Ajustar stock</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>
                    <div class="modal-body">
                        <label class="form-label">Nuevo stock para @producto.SKU</label>
                        <input name="nuevoStock" type="number" min="0" value="@producto.StockActual" class="form-control" @(producto.RequiereInventario ? null : "disabled") />
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary px-4" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary px-4" @(producto.RequiereInventario ? null : "disabled")>Guardar</button>
                    </div>
            </form>
        </div>
    </div>
    }

    <nav class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mt-3" aria-label="Paginacion">
        <div class="text-muted small">Pagina @Model.Pagina de @Model.TotalPaginas</div>
        <ul class="pagination mb-0">
            <li class="page-item @(Model.Pagina <= 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-pagina="@(Model.Pagina - 1)" asp-route-registrosPorPagina="@Model.RegistrosPorPagina" asp-route-busqueda="@Model.Busqueda" asp-route-filtroRapido="@Model.FiltroRapido" asp-route-categoriaId="@Model.CategoriaId" asp-route-proveedor="@Model.Proveedor" asp-route-almacen="@Model.Almacen">Anterior</a>
            </li>
            @for (var i = Math.Max(1, Model.Pagina - 2); i <= Math.Min(Model.TotalPaginas, Model.Pagina + 2); i++)
            {
                <li class="page-item @(i == Model.Pagina ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-pagina="@i" asp-route-registrosPorPagina="@Model.RegistrosPorPagina" asp-route-busqueda="@Model.Busqueda" asp-route-filtroRapido="@Model.FiltroRapido" asp-route-categoriaId="@Model.CategoriaId" asp-route-proveedor="@Model.Proveedor" asp-route-almacen="@Model.Almacen">@i</a>
                </li>
            }
            <li class="page-item @(Model.Pagina >= Model.TotalPaginas ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-pagina="@(Model.Pagina + 1)" asp-route-registrosPorPagina="@Model.RegistrosPorPagina" asp-route-busqueda="@Model.Busqueda" asp-route-filtroRapido="@Model.FiltroRapido" asp-route-categoriaId="@Model.CategoriaId" asp-route-proveedor="@Model.Proveedor" asp-route-almacen="@Model.Almacen">Siguiente</a>
            </li>
        </ul>
    </nav>

    <div class="modal fade product-form-modal" id="createProductModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <form asp-action="Create" method="post" enctype="multipart/form-data" class="modal-content">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title">Nuevo producto</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        @await Html.PartialAsync("_ProductoModalFields", productoNuevo)
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary px-4" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary px-4">Guardar</button>
                </div>
