</div>

<script>
    (() => {
        const filterForm = document.getElementById('filterForm');
        const pageInput = document.getElementById('Pagina');
        const dynamicContent = document.getElementById('dynamic-content');
        const contentLoader = document.getElementById('content-loader');
        const mainContent = document.querySelector('main[role="main"]');
        let pendingDeleteAction = '';

        function cleanupBootstrapState() {
            if (!window.bootstrap) return;

            document.querySelectorAll('.modal.show').forEach(modalElement => {
                bootstrap.Modal.getInstance(modalElement)?.hide();
            });

            document.querySelectorAll('.dropdown-toggle.show').forEach(toggle => {
                bootstrap.Dropdown.getInstance(toggle)?.hide();
            });

            document.querySelectorAll('.modal-backdrop').forEach(backdrop => backdrop.remove());
            document.body.classList.remove('modal-open');
            document.body.style.removeProperty('overflow');
            document.body.style.removeProperty('padding-right');
        }

        function executeInlineScripts(container) {
            container.querySelectorAll('script').forEach(script => {
                const executableScript = document.createElement('script');

                Array.from(script.attributes).forEach(attribute => {
                    executableScript.setAttribute(attribute.name, attribute.value);
                });

                executableScript.textContent = script.textContent;
                script.replaceWith(executableScript);
            });
        }

        function initializeBootstrapControls(scope = document) {
            if (!window.bootstrap) return;

            scope.querySelectorAll('[data-bs-toggle="dropdown"]').forEach(toggle => {
                bootstrap.Dropdown.getOrCreateInstance(toggle, {
                    boundary: toggle.dataset.bsBoundary || 'clippingParents',
                    display: toggle.dataset.bsDisplay || 'dynamic'
                });
            });

            scope.querySelectorAll('.modal').forEach(modalElement => {
                bootstrap.Modal.getOrCreateInstance(modalElement);
            });
        }

        window.openProductModal = function (targetSelector, tabSelector, trigger) {
            if (!window.bootstrap) {
                console.warn('Bootstrap not loaded');
                return false;
            }

            let target = document.querySelector(targetSelector);
            if (!target) {
                console.warn(`Modal not found: ${targetSelector}`);
                const id = targetSelector.replace('#', '');
                target = document.getElementById(id);
                if (!target) {
                    return false;
                }
            }

            const dropdownToggle = trigger?.closest('.dropdown')?.querySelector('[data-bs-toggle="dropdown"]');
            if (dropdownToggle) {
                try {
                    bootstrap.Dropdown.getInstance(dropdownToggle)?.hide();
                } catch (e) {
                    console.warn('Error hiding dropdown:', e);
                }
            }

            if (tabSelector) {
                const handleShown = function () {
                    target.removeEventListener('shown.bs.modal', handleShown);
                    const tabButton = target.querySelector(`[data-bs-target="${tabSelector}"]`);
                    if (tabButton) {
                        try {
                            bootstrap.Tab.getOrCreateInstance(tabButton).show();
                        } catch (e) {
                            console.warn('Error activating tab:', e);
                        }
                    }
                };
                target.addEventListener('shown.bs.modal', handleShown);
            }

            try {
                const modalInstance = bootstrap.Modal.getOrCreateInstance(target);
                modalInstance.show();
            } catch (e) {
                console.error('Error showing modal:', e);
                return false;
            }
            
            return false;
        };

        function renderProductsPartial(html, fallbackUrl) {
            cleanupBootstrapState();

            if (dynamicContent) {
                dynamicContent.innerHTML = html;
                executeInlineScripts(dynamicContent);
                return;
            }

            if (!mainContent) {
                window.location.href = fallbackUrl;
                return;
            }

            mainContent.innerHTML = html;
            executeInlineScripts(mainContent);
        }

        async function loadProductsPartial(url, showLoader = false) {
            if (!dynamicContent && !mainContent) {
                window.location.href = url;
                return;
            }

            if (showLoader && contentLoader) contentLoader.style.display = 'flex';

            try {
                const response = await fetch(url, {
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });

                if (!response.ok) throw new Error('No se pudo cargar productos.');

                renderProductsPartial(await response.text(), url);
            } catch (error) {
                console.error(error);
                window.location.href = url;
            } finally {
                if (showLoader && contentLoader) {
                    setTimeout(() => { contentLoader.style.display = 'none'; }, 200);
                }
            }
        }

        filterForm?.addEventListener('submit', function (event) {
            if (!dynamicContent && !mainContent) return;

            event.preventDefault();
            const formData = new FormData(filterForm);
            const params = new URLSearchParams(formData);
            const action = filterForm.getAttribute('action') || '/Productos/Index';
            loadProductsPartial(`${action}?${params.toString()}`);
        });

        function submitFilters() {
            if (!filterForm) return;
            if (pageInput) pageInput.value = '1';
            filterForm.requestSubmit();
        }

        document.querySelectorAll('[data-filter-value]').forEach(option => {
            option.addEventListener('click', function () {
                const input = document.getElementById('FiltroRapido');
                const label = document.querySelector('[data-filter-label]');

                if (input) input.value = this.dataset.filterValue || '';
                if (label) label.textContent = this.dataset.filterText || 'Todos';

                document.querySelectorAll('[data-filter-value]').forEach(item => item.classList.remove('active'));
                this.classList.add('active');
                submitFilters();
            });
        });

        document.querySelectorAll('[data-search-field]').forEach(option => {
            option.addEventListener('click', function () {
                const label = document.querySelector('[data-search-field-label]');

                if (label) label.textContent = this.dataset.searchField || this.textContent.trim();

                document.querySelectorAll('[data-search-field]').forEach(item => item.classList.remove('active'));
                this.classList.add('active');
            });
        });

        document.querySelectorAll('[data-select-target]').forEach(option => {
            option.addEventListener('click', function () {
                const targetId = this.dataset.selectTarget;
                const input = document.getElementById(targetId);
                const label = document.querySelector(`[data-select-label="${targetId}"]`);
                const menu = this.closest('.dropdown-menu');

                if (input) input.value = this.dataset.selectValue || '';
                if (label) label.textContent = this.dataset.selectText || this.textContent.trim();

                menu?.querySelectorAll('[data-select-target]').forEach(item => item.classList.remove('active'));
                this.classList.add('active');

                if (this.closest('#filterForm')) {
                    submitFilters();
                }
            });
        });

        document.querySelectorAll('[data-form-select-name]').forEach(option => {
            option.addEventListener('click', function () {
                const wrapper = this.closest('.product-form-select');
                const form = this.closest('form');
                const input = form?.querySelector(`input[name="${this.dataset.formSelectName}"]`);
                const label = wrapper?.querySelector('[data-form-select-label]');
                const menu = this.closest('.dropdown-menu');

                if (input) input.value = this.dataset.formSelectValue || '';
                if (label) label.textContent = this.dataset.formSelectText || this.textContent.trim();

                menu?.querySelectorAll('[data-form-select-name]').forEach(item => item.classList.remove('active'));
                this.classList.add('active');
            });
        });

        document.querySelectorAll('[data-edit-modal-target]').forEach(button => {
            button.addEventListener('click', function () {
                if (!window.bootstrap) return;

                const dropdownToggle = this.closest('.dropdown')?.querySelector('[data-bs-toggle="dropdown"]');
                if (dropdownToggle) {
                    bootstrap.Dropdown.getInstance(dropdownToggle)?.hide();
                }

                const modal = document.getElementById(this.dataset.editModalTarget);
                if (!modal) {
                    console.warn(`Modal not found: ${this.dataset.editModalTarget}`);
                    return;
                }

                bootstrap.Modal.getOrCreateInstance(modal).show();
            });
        });

        document.querySelector('[data-live-search="true"]')?.addEventListener('input', function () {
            clearTimeout(this._liveTimer);
            this._liveTimer = setTimeout(() => submitFilters(), 350);
        });

        document.querySelector('[data-live-search="true"]')?.addEventListener('keydown', function (event) {
            if (event.key !== 'Enter') return;
            event.preventDefault();
            clearTimeout(this._liveTimer);
            submitFilters();
        });

        document.querySelectorAll('.auto-submit').forEach(element => {
            element.addEventListener('change', submitFilters);
        });

        document.querySelectorAll('.auto-submit-on-blur').forEach(element => {
            element.addEventListener('change', submitFilters);
        });

        document.getElementById('bulkForm')?.addEventListener('submit', async function (event) {
            if (!dynamicContent) return;

            event.preventDefault();
            const submitter = event.submitter;
            const action = submitter?.formAction || this.action;
            const method = submitter?.formMethod || this.method || 'post';
            const isBulkApply = !submitter?.hasAttribute('formaction');

            if (isBulkApply && !this.querySelector('.row-check:checked')) {
                alert('Selecciona al menos un producto.');
                return;
            }

            if (contentLoader) contentLoader.style.display = 'flex';

            try {
                const response = await fetch(action, {
                    method: method.toUpperCase(),
                    body: new FormData(this),
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });

                if (!response.ok) throw new Error('No se pudo aplicar la accion.');

                cleanupBootstrapState();
                dynamicContent.innerHTML = await response.text();
                executeInlineScripts(dynamicContent);
            } catch (error) {
                console.error(error);
                window.location.href = action;
            } finally {
                if (contentLoader) {
                    setTimeout(() => { contentLoader.style.display = 'none'; }, 200);
                }
            }
        });

        if (window.__productosModalSubmitHandler) {
            document.removeEventListener('submit', window.__productosModalSubmitHandler);
        }

        window.__productosModalSubmitHandler = async function (event) {
            const form = event.target.closest('form');
            if (!form) return;
            
            const modal = form.closest('.modal');
            if (!modal) return;

            event.preventDefault();

            if (form.dataset.submitting === 'true') return;
            form.dataset.submitting = 'true';

            const action = form.action;
            const method = form.method || 'post';
            
            // Show loading state in modal
            const originalSubmitButton = form.querySelector('button[type="submit"]');
            let originalText = '';
            let originalInnerHTML = '';
            if (originalSubmitButton) {
                originalText = originalSubmitButton.textContent;
                originalInnerHTML = originalSubmitButton.innerHTML;
                originalSubmitButton.disabled = true;
                originalSubmitButton.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Guardando...';
            }

            try {
                const response = await fetch(action, {
                    method: method.toUpperCase(),
                    body: new FormData(form),
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });

                const contentType = response.headers.get('content-type') || '';

                if (!response.ok) {
                    if (contentType.includes('application/json') || contentType.includes('text/json')) {
                        const result = await response.json();
                        throw new Error(result.message || 'Error al guardar el producto');
                    } else if (contentType.includes('text/html')) {
                        const html = await response.text();
                        const tempDiv = document.createElement('div');
                        tempDiv.innerHTML = html;
                        
                        const newForm = tempDiv.querySelector('form');
                        if (newForm) {
                            newForm.action = form.action;
                            newForm.method = form.method;
                            
                            form.innerHTML = newForm.innerHTML;
                            
                            executeInlineScripts(form);
                            initializeBootstrapControls(form);
                        } else {
                            const modalBody = modal.querySelector('.modal-body');
                            if (modalBody) {
                                modalBody.innerHTML = tempDiv.querySelector('.modal-body')?.innerHTML || html;
                                executeInlineScripts(modalBody);
                                initializeBootstrapControls(modalBody);
                            } else {
                                throw new Error('Error al guardar el producto');
                            }
                        }
                    } else {
                        throw new Error('Error al guardar el producto');
                    }
                } else {
                    if (contentType.includes('application/json') || contentType.includes('text/json')) {
                        const result = await response.json();
                        if (result.success) {
                            if (modal && window.bootstrap) {
                                try {
                                    bootstrap.Modal.getInstance(modal).hide();
                                } catch (e) {
                                    console.warn('Error hiding modal:', e);
                                    const backdrops = document.querySelectorAll('.modal-backdrop');
                                    backdrops.forEach(b => b.remove());
                                    document.body.classList.remove('modal-open');
                                    document.body.style.removeProperty('padding-right');
                                }
                            }
                            submitFilters();
                        } else {
                            throw new Error(result.message || 'Error al guardar el producto');
                        }
                    } else {
                        if (modal && window.bootstrap) {
                            try {
                                bootstrap.Modal.getInstance(modal).hide();
                            } catch (e) {
                                console.warn('Error hiding modal:', e);
                                const backdrops = document.querySelectorAll('.modal-backdrop');
                                backdrops.forEach(b => b.remove());
                                document.body.classList.remove('modal-open');
                                document.body.style.removeProperty('padding-right');
                            }
                        }
                        submitFilters();
                    }
                }
            } catch (error) {
                console.error(error);
                alert(error.message || 'Error al guardar el producto');
                if (originalSubmitButton) {
                    originalSubmitButton.disabled = false;
                    originalSubmitButton.textContent = originalText;
                    originalSubmitButton.innerHTML = originalInnerHTML;
                }
            } finally {
                delete form.dataset.submitting;
                if (originalSubmitButton && !originalSubmitButton.disabled) {
                    originalSubmitButton.disabled = false;
                    originalSubmitButton.textContent = originalText;
                    originalSubmitButton.innerHTML = originalInnerHTML;
                }
            }
        };

        document.addEventListener('submit', window.__productosModalSubmitHandler);

        document.querySelectorAll('.productos-page .pagination a.page-link').forEach(link => {
            link.addEventListener('click', function (event) {
                if ((!dynamicContent && !mainContent) || this.closest('.page-item')?.classList.contains('disabled')) return;
                event.preventDefault();
                loadProductsPartial(this.href, true);
            });
        });

        async function executeProductPost(action) {
            const token = document.querySelector('#bulkForm input[name="__RequestVerificationToken"]')?.value;
            const formData = new FormData();
            if (token) formData.append('__RequestVerificationToken', token);

            if (contentLoader) contentLoader.style.display = 'flex';

            try {
                const response = await fetch(action, {
                    method: 'POST',
                    body: formData,
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });

                if (!response.ok) throw new Error('No se pudo ejecutar la accion.');

                cleanupBootstrapState();
                if (dynamicContent) {
                    dynamicContent.innerHTML = await response.text();
                    executeInlineScripts(dynamicContent);
                } else {
                    window.location.href = action;
                }
            } catch (error) {
                console.error(error);
                window.location.href = action;
            } finally {
                if (contentLoader) {
                    setTimeout(() => { contentLoader.style.display = 'none'; }, 200);
                }
            }
        }

        document.querySelectorAll('[data-delete-action]').forEach(button => {
            button.addEventListener('click', function () {
                pendingDeleteAction = this.dataset.deleteAction || '';

                const dropdownToggle = this.closest('.dropdown')?.querySelector('[data-bs-toggle="dropdown"]');
                if (dropdownToggle && window.bootstrap) bootstrap.Dropdown.getInstance(dropdownToggle)?.hide();

                const modal = document.getElementById('deleteProductModal');
                const name = modal?.querySelector('[data-delete-product-name]');
                if (name) name.textContent = this.dataset.deleteName || '';

                if (modal && window.bootstrap) {
                    bootstrap.Modal.getOrCreateInstance(modal).show();
                }
            });
        });

        document.querySelector('[data-confirm-delete-submit]')?.addEventListener('click', async function () {
            if (!pendingDeleteAction) return;
            this.disabled = true;
            this.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Eliminando...';
            await executeProductPost(pendingDeleteAction);
        });

        document.querySelectorAll('[data-row-action]').forEach(button => {
            button.addEventListener('click', async function () {
                if (!dynamicContent) {
                    window.location.href = this.dataset.rowAction;
                    return;
                }

                const dropdownToggle = this.closest('.dropdown')?.querySelector('[data-bs-toggle="dropdown"]');
                if (dropdownToggle && window.bootstrap) bootstrap.Dropdown.getInstance(dropdownToggle)?.hide();

                await executeProductPost(this.dataset.rowAction);
            });
        });

        document.getElementById('checkAll')?.addEventListener('change', function () {
            document.querySelectorAll('.row-check').forEach(check => check.checked = this.checked);
        });

        const productosTable = document.getElementById('productosTable');
        let draggedHeaderIndex = null;

        function moveColumn(table, fromIndex, toIndex) {
            if (fromIndex === toIndex || fromIndex === null || toIndex === null) return;

            table.querySelectorAll('tr').forEach(row => {
                const cells = Array.from(row.children);
                const fromCell = cells[fromIndex];
                const toCell = cells[toIndex];
                if (!fromCell || !toCell) return;

                if (fromIndex < toIndex) {
                    row.insertBefore(fromCell, toCell.nextSibling);
                } else {
                    row.insertBefore(fromCell, toCell);
                }
            });
        }

        productosTable?.querySelectorAll('th[data-draggable-column="true"]').forEach(header => {
            header.setAttribute('draggable', 'true');

            header.addEventListener('dragstart', function () {
                draggedHeaderIndex = Array.from(this.parentElement.children).indexOf(this);
                this.classList.add('dragging-column');
            });

            header.addEventListener('dragover', function (event) {
                event.preventDefault();
                this.classList.add('drag-over-column');
            });

            header.addEventListener('dragleave', function () {
                this.classList.remove('drag-over-column');
            });

            header.addEventListener('drop', function (event) {
                event.preventDefault();
                const targetIndex = Array.from(this.parentElement.children).indexOf(this);
                moveColumn(productosTable, draggedHeaderIndex, targetIndex);
                productosTable.querySelectorAll('.dragging-column, .drag-over-column').forEach(element => {
                    element.classList.remove('dragging-column', 'drag-over-column');
                });
                draggedHeaderIndex = null;
            });

            header.addEventListener('dragend', function () {
                productosTable.querySelectorAll('.dragging-column, .drag-over-column').forEach(element => {
                    element.classList.remove('dragging-column', 'drag-over-column');
                });
                draggedHeaderIndex = null;
            });
        });

        initializeBootstrapControls(document);
    })();
</script>
