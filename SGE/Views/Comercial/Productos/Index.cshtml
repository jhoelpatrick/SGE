    <div class="modal fade" id="importExcelModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <form asp-action="ImportExcel" method="post" enctype="multipart/form-data" class="modal-content rounded-4">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title">Importar Excel</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <label class="form-label">Archivo .xlsx</label>
                    <input type="file" name="archivoExcel" accept=".xlsx" class="form-control" required />
                    <div class="form-text">Columnas esperadas: SKU, Nombre, Descripcion, Categoria, Marca, Proveedor, Almacen, Unidad, Costo, Precio, Stock, Stock Minimo, Tipo.</div>
                </div>
