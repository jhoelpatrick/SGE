@model SGE.Models.Producto

@{
    ViewData["Title"] = "Editar Producto";
}

<h1 class="h3 mb-4">Editar Producto</h1>

<form asp-action="Edit" asp-route-id="@Model.ProductoId" method="post" class="row g-3">
    <input type="hidden" asp-for="ProductoId" />
    @await Html.PartialAsync("_Form", Model)
    <div class="col-12 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Guardar cambios</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
