@model IEnumerable<SGE.Models.Categoria>

@{
    Layout = Context.Request.Headers["X-Requested-With"] == "XMLHttpRequest" ? null : "_Layout";
    ViewData["Title"] = "Categorias";
    ViewData["BodyContainerClass"] = "container-fluid px-4";
    ViewData["ProductosModuleActive"] = "Categorias";
    var totalCategorias = Model.Count();
    var activas = Model.Count(c => c.Activo);
    var inactivas = totalCategorias - activas;
    var totalProductos = 0;
}

<style>
    .categorias-page {
        width: 100%;
        padding: 1.5rem;
        color: #0f172a;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .categorias-page .page-title { font-size: 1.85rem; font-weight: 750; }

    .categorias-page .kpi-card {
        border: 1px solid #e2e8f0;
        border-radius: 1.25rem;
        background: #fff;
        box-shadow: 0 8px 24px rgba(15,23,42,.07);
        padding: 1.1rem 1.25rem;
    }

    .categorias-page .kpi-icon {
        width: 44px; height: 44px; border-radius: 1rem;
        display: inline-flex; align-items: center; justify-content: center;
        font-size: 1.3rem; margin-bottom: .6rem;
    }

    .categorias-page .kpi-label {
        color: #64748b; font-size: .76rem; font-weight: 700;
        text-transform: uppercase; letter-spacing: .04em;
    }

    .categorias-page .kpi-value { font-size: 1.7rem; font-weight: 750; color: #0f172a; }

    .categorias-page .table-shell {
        border: 1px solid #e2e8f0;
        border-radius: 1.25rem;
        background: #fff;
        box-shadow: 0 8px 24px rgba(15,23,42,.06);
        overflow: hidden;
    }

    .categorias-page .table-shell thead th {
        color: #475569; font-size: .74rem; font-weight: 750;
        text-transform: uppercase; letter-spacing: .04em;
        background: #f8fafc; border-bottom: 1px solid #e2e8f0;
        padding: .75rem 1rem;
    }

    .categorias-page .table-shell tbody td {
        padding: .75rem 1rem; vertical-align: middle;
        border-bottom: 1px solid #f1f5f9;
    }

    .categorias-page .table-shell tbody tr:last-child td { border-bottom: 0; }

    .categorias-page .btn { border-radius: 999px; }

    .categorias-page .action-btn {
        width: 32px; height: 32px;
        display: inline-flex; align-items: center; justify-content: center;
        border-radius: 999px; border: 1px solid #e2e8f0;
        background: #fff; color: #475569;
    }

    .categorias-page .action-btn:hover { background: #f1f5f9; color: #0f172a; }
    .categorias-page .action-btn::after { display: none; }

    .categorias-page .dropdown-menu {
        border: 0; border-radius: 1rem; padding: .4rem;
        box-shadow: 0 16px 40px rgba(15,23,42,.18);
    }

    .categorias-page .dropdown-item { border-radius: .75rem; font-size: .85rem; }

    .categorias-page .cat-avatar {
        width: 38px; height: 38px; border-radius: .75rem;
        display: inline-flex; align-items: center; justify-content: center;
        font-weight: 750; font-size: .9rem; color: #fff; flex-shrink: 0;
    }

    /* Modales pill */
    .cat-modal .modal-content {
        border: 0;
        border-radius: 1.5rem;
        overflow: hidden;
        box-shadow: 0 24px 70px rgba(15,23,42,.22);
    }

    .cat-modal .form-control {
        border-radius: 2rem !important;
        min-height: 42px;
    }

    .cat-modal .modal-footer .btn {
        border-radius: 2rem !important;
        min-width: 110px;
    }
</style>

<div class="categorias-page">
    @await Html.PartialAsync("_ProductosModuleNav")

    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">
        <div>
            <h1 class="page-title mb-1">Categorias</h1>
            <p class="text-muted mb-0">Agrupacion comercial y operativa del catalogo de productos.</p>
        </div>
        <button type="button" class="btn btn-primary px-4" data-open-cat-modal="createCatModal">
            <i class="bi bi-plus-lg me-1"></i> Nueva categoria
        </button>
    </div>

    <div id="catAlerts"></div>

    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="kpi-card h-100">
                <div class="kpi-icon bg-primary bg-opacity-10 text-primary"><i class="bi bi-tags"></i></div>
                <div class="kpi-label">Total</div>
                <div class="kpi-value">@totalCategorias</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="kpi-card h-100">
                <div class="kpi-icon bg-success bg-opacity-10 text-success"><i class="bi bi-check-circle"></i></div>
                <div class="kpi-label">Activas</div>
                <div class="kpi-value text-success">@activas</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="kpi-card h-100">
                <div class="kpi-icon bg-secondary bg-opacity-10 text-secondary"><i class="bi bi-dash-circle"></i></div>
                <div class="kpi-label">Inactivas</div>
                <div class="kpi-value text-secondary">@inactivas</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="kpi-card h-100">
                <div class="kpi-icon bg-info bg-opacity-10 text-info"><i class="bi bi-box-seam"></i></div>
                <div class="kpi-label">Productos asignados</div>
                <div class="kpi-value">@totalProductos</div>
            </div>
        </div>
    </div>

    <div class="table-shell">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Categoria</th>
                        <th class="text-center">Productos</th>
                        <th class="text-center">Estado</th>
                        <th class="text-center" style="width:60px;">Acc.</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var colors = new[] { "#2563eb","#0891b2","#16a34a","#d97706","#dc2626","#7c3aed","#db2777","#0d9488" };
                        var idx = 0;
                    }
                    @foreach (var cat in Model)
                    {
                        var color = colors[idx % colors.Length];
                        idx++;
                        var productosCount = 0;
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="cat-avatar" style="background:@color;">@cat.Nombre[..1].ToUpper()</div>
                                    <span class="fw-semibold">@cat.Nombre</span>
                                </div>
                            </td>
                            <td class="text-center">
                                <span class="badge rounded-pill bg-light text-dark border">@productosCount</span>
                            </td>
                            <td class="text-center">
                                <span class="badge rounded-pill @(cat.Activo ? "text-bg-success" : "text-bg-secondary")">
                                    @(cat.Activo ? "Activa" : "Inactiva")
                                </span>
                            </td>
                            <td class="text-center">
                                <div class="dropdown">
                                    <button class="action-btn dropdown-toggle" type="button" data-bs-toggle="dropdown" data-bs-boundary="viewport">
                                        <i class="bi bi-three-dots-vertical"></i>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li><button class="dropdown-item" type="button" data-open-cat-modal="editCatModal@cat.CategoriaId">Editar</button></li>
                                        <li>
                                            <button class="dropdown-item text-danger" type="button"
                                                    data-delete-cat-action="@Url.Action("DeleteCategoria", new { id = cat.CategoriaId })"
                                                    data-delete-cat-name="@cat.Nombre"
                                                    @(productosCount > 0 ? "disabled" : "")>
                                                Eliminar
                                            </button>
                                        </li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr><td colspan="4" class="text-center text-muted py-5">No hay categorias registradas.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@* Modal crear *@
<div class="modal fade cat-modal" id="createCatModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width:420px;">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">Nueva categoria</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <label class="form-label fw-semibold small">Nombre</label>
                <input id="createCatNombre" class="form-control" placeholder="Ej. Materias primas" required maxlength="100" />
                <div class="form-check mt-3">
                    <input class="form-check-input" type="checkbox" id="createCatActivo" checked />
                    <label class="form-check-label" for="createCatActivo">Activa</label>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-outline-secondary px-4" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary px-4" id="createCatSubmit">Guardar</button>
            </div>
        </div>
    </div>
</div>

@* Modales editar por fila *@
@foreach (var cat in Model)
{
    <div class="modal fade cat-modal" id="editCatModal@cat.CategoriaId" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" style="max-width:420px;">
            <div class="modal-content">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold">Editar categoria</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <label class="form-label fw-semibold small">Nombre</label>
                    <input class="form-control edit-cat-nombre" value="@cat.Nombre" required maxlength="100" />
                    <div class="form-check mt-3">
                        <input class="form-check-input edit-cat-activo" type="checkbox" id="editCatActivo@cat.CategoriaId" @(cat.Activo ? "checked" : "") />
                        <label class="form-check-label" for="editCatActivo@cat.CategoriaId">Activa</label>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-outline-secondary px-4" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-primary px-4 edit-cat-submit"
                            data-cat-id="@cat.CategoriaId"
                            data-action="@Url.Action("EditCategoria", new { id = cat.CategoriaId })">
                        Guardar cambios
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* Modal confirmar eliminacion *@
<div class="modal fade cat-modal" id="deleteCatModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width:380px;">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">Eliminar categoria</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="mb-1">Esta accion eliminara la categoria:</p>
                <p class="fw-semibold mb-0" data-delete-cat-name-display></p>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-light px-4" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-danger px-4" data-confirm-delete-cat>Eliminar</button>
            </div>
        </div>
    </div>
</div>

@* Token CSRF para fetch *@
<form id="_catCsrfForm" style="display:none;">
    @Html.AntiForgeryToken()
</form>

<script>
    (() => {
        const token = () => document.querySelector('input[name="__RequestVerificationToken"]')?.value;

        function recargarCategorias() {
            const url = '/Productos/Categorias';
            const dc = document.getElementById('dynamic-content');
            if (dc) {
                fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                    .then(r => r.text()).then(html => {
                        dc.innerHTML = html;
                        dc.querySelectorAll('script').forEach(s => {
                            const ns = document.createElement('script');
                            Array.from(s.attributes).forEach(a => ns.setAttribute(a.name, a.value));
                            ns.textContent = s.textContent;
                            s.replaceWith(ns);
                        });
                    }).catch(() => window.location.href = url);
            } else {
                window.location.href = url;
            }
        }

        function showAlert(msg, type) {
            const el = document.getElementById('catAlerts');
            if (!el) return;
            el.innerHTML = `<div class="alert alert-${type} alert-dismissible fade show rounded-pill px-4" role="alert">
                ${msg}<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>`;
        }

        async function postCategoria(url, nombre, activo) {
            const fd = new FormData();
            // El token debe estar en el DOM — lo inyectamos con un form oculto
            const tok = document.querySelector('#_catCsrfForm input[name="__RequestVerificationToken"]')?.value || '';
            fd.append('__RequestVerificationToken', tok);
            fd.append('Nombre', nombre);
            // ASP.NET model binding de bool desde form: enviar 'true' o no enviar nada
            if (activo) fd.append('Activo', 'true');
            const res = await fetch(url, { method: 'POST', body: fd });
            return res;
        }

        // Abrir modales via delegacion (evita conflicto con dropdown)
        document.addEventListener('click', function (e) {
            const btn = e.target.closest('[data-open-cat-modal]');
            if (!btn) return;
            e.stopPropagation();
            const id = btn.dataset.openCatModal;
            const dd = btn.closest('.dropdown');
            if (dd && window.bootstrap) {
                const toggle = dd.querySelector('[data-bs-toggle="dropdown"]');
                if (toggle) bootstrap.Dropdown.getInstance(toggle)?.hide();
            }
            const modal = document.getElementById(id);
            if (modal && window.bootstrap) {
                setTimeout(() => bootstrap.Modal.getOrCreateInstance(modal).show(), 80);
            }
        }, true);

        // Crear categoria
        document.getElementById('createCatSubmit')?.addEventListener('click', async function () {
            const nombre = document.getElementById('createCatNombre')?.value.trim();
            const activo = document.getElementById('createCatActivo')?.checked;
            if (!nombre) { showAlert('El nombre es obligatorio.', 'danger'); return; }
            this.disabled = true;
            this.textContent = 'Guardando...';
            try {
                const res = await postCategoria('/Productos/CreateCategoria', nombre, activo);
                bootstrap.Modal.getInstance(document.getElementById('createCatModal'))?.hide();
                if (res.ok) { recargarCategorias(); }
                else { showAlert('Error al guardar la categoria.', 'danger'); }
            } catch { showAlert('Error al guardar la categoria.', 'danger'); }
            finally { this.disabled = false; this.textContent = 'Guardar'; }
        });

        // Editar categoria via delegacion
        document.addEventListener('click', async function (e) {
            const btn = e.target.closest('.edit-cat-submit');
            if (!btn) return;
            const modal = btn.closest('.modal');
            const nombre = modal?.querySelector('.edit-cat-nombre')?.value.trim();
            const activo = modal?.querySelector('.edit-cat-activo')?.checked;
            const action = btn.dataset.action;
            if (!nombre) { showAlert('El nombre es obligatorio.', 'danger'); return; }
            btn.disabled = true;
            btn.textContent = 'Guardando...';
            try {
                const res = await postCategoria(action, nombre, activo);
                bootstrap.Modal.getInstance(modal)?.hide();
                if (res.ok) { recargarCategorias(); }
                else { showAlert('Error al actualizar la categoria.', 'danger'); }
            } catch { showAlert('Error al actualizar la categoria.', 'danger'); }
            finally { btn.disabled = false; btn.textContent = 'Guardar cambios'; }
        });

        // Eliminar
        let pendingDeleteCatAction = '';
        document.addEventListener('click', function (e) {
            const btn = e.target.closest('[data-delete-cat-action]');
            if (!btn || btn.disabled) return;
            pendingDeleteCatAction = btn.dataset.deleteCatAction;
            const modal = document.getElementById('deleteCatModal');
            const nameEl = modal?.querySelector('[data-delete-cat-name-display]');
            if (nameEl) nameEl.textContent = btn.dataset.deleteCatName || '';
            bootstrap.Modal.getOrCreateInstance(modal).show();
        });

        document.querySelector('[data-confirm-delete-cat]')?.addEventListener('click', async function () {
            if (!pendingDeleteCatAction) return;
            this.disabled = true;
            try {
                const res = await postCategoria(pendingDeleteCatAction, '', false);
                bootstrap.Modal.getInstance(document.getElementById('deleteCatModal'))?.hide();
                if (res.ok) { recargarCategorias(); }
                else { showAlert('No se pudo eliminar la categoria.', 'danger'); }
            } catch { showAlert('Error al eliminar.', 'danger'); }
            finally { this.disabled = false; }
        });
    })();
</script>
