@model Reportes.Models.ReportesIndexViewModel
@using System.Text.Json

@{
    Layout = null;
}

<style>
    /* Premium ERP Styling */
    .rep-page {
        padding: 24px;
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        color: #1f2937;
    }
    
    .rep-breadcrumb {
        font-size: 0.8rem;
        color: #6b7280;
        margin-bottom: 8px;
    }
    
    .rep-title {
        font-size: 1.6rem;
        font-weight: 700;
        letter-spacing: -0.025em;
        color: #111827;
        margin-bottom: 24px;
    }
    
    /* KPI Cards */
    .rep-kpis {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 20px;
        margin-bottom: 28px;
    }
    
    .rep-kpi-card {
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 16px;
        padding: 20px;
        box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.05), 0 1px 2px 0 rgba(0, 0, 0, 0.06);
        display: flex;
        align-items: center;
        gap: 16px;
        transition: transform 0.2s, box-shadow 0.2s;
    }
    
    .rep-kpi-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
    }
    
    .rep-kpi-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        flex-shrink: 0;
    }
    
    .rep-kpi-icon.blue { background: #eff6ff; color: #2563eb; }
    .rep-kpi-icon.green { background: #f0fdf4; color: #16a34a; }
    .rep-kpi-icon.purple { background: #faf5ff; color: #9333ea; }
    .rep-kpi-icon.orange { background: #fff7ed; color: #ea580c; }
    
    .rep-kpi-label {
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: #6b7280;
        margin-bottom: 4px;
    }
    
    .rep-kpi-val {
        font-size: 1.5rem;
        font-weight: 700;
        color: #111827;
        line-height: 1.2;
    }
    
    /* Filters Card */
    .rep-filter-card {
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 16px;
        padding: 20px;
        box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.05);
        margin-bottom: 28px;
    }
    
    .rep-form-label {
        font-size: 0.8rem;
        font-weight: 600;
        color: #4b5563;
        margin-bottom: 6px;
        display: block;
    }
    
    .rep-form-select, .rep-form-input {
        width: 100%;
        border: 1px solid #d1d5db;
        border-radius: 10px;
        padding: 9px 14px;
        font-size: 0.875rem;
        color: #111827;
        background-color: #f9fafb;
        outline: none;
        transition: border-color 0.15s, box-shadow 0.15s;
    }
    
    .rep-form-select:focus, .rep-form-input:focus {
        border-color: #2563eb;
        box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);
        background-color: #ffffff;
    }
    
    .rep-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 10px 18px;
        border-radius: 10px;
        font-size: 0.875rem;
        font-weight: 600;
        transition: all 0.15s;
        border: 1px solid transparent;
        cursor: pointer;
    }
    
    .rep-btn-primary { background: #2563eb; color: #ffffff; }
    .rep-btn-primary:hover { background: #1d4ed8; }
    .rep-btn-secondary { background: #ffffff; color: #374151; border-color: #d1d5db; }
    .rep-btn-secondary:hover { background: #f3f4f6; }
    .rep-btn-danger-outline { background: #ffffff; color: #dc2626; border-color: #fca5a5; }
    .rep-btn-danger-outline:hover { background: #fef2f2; }
    .rep-btn-success-outline { background: #ffffff; color: #16a34a; border-color: #bbf7d0; }
    .rep-btn-success-outline:hover { background: #f0fdf4; }
    
    /* Charts Grid */
    .rep-charts-grid {
        display: grid;
        grid-template-columns: 1.2fr 0.8fr;
        gap: 24px;
        margin-bottom: 28px;
    }
    
    @@media (max-width: 991px) {
        .rep-charts-grid { grid-template-columns: 1fr; }
    }
    
    .rep-chart-card {
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 16px;
        padding: 24px;
        box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.05);
    }
    
    .rep-card-title {
        font-size: 0.95rem;
        font-weight: 700;
        color: #111827;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    
    .rep-chart-container {
        position: relative;
        height: 240px;
        width: 100%;
    }
    
    /* Table Panel */
    .rep-panel {
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 16px;
        box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.05);
        overflow: hidden;
    }
    
    .rep-panel-header {
        padding: 20px 24px;
        border-bottom: 1px solid #e5e7eb;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
    }
    
    .rep-panel-title {
        font-size: 1rem;
        font-weight: 700;
        color: #111827;
        margin: 0;
    }
    
    .rep-panel-subtitle {
        font-size: 0.8rem;
        color: #6b7280;
        margin-top: 2px;
    }
    
    .rep-table-wrap {
        overflow-x: auto;
    }
    
    .rep-table {
        width: 100%;
        border-collapse: collapse;
        text-align: left;
    }
    
    .rep-table th {
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: #4b5563;
        padding: 14px 20px;
        background: #f9fafb;
        border-bottom: 1px solid #e5e7eb;
    }
    
    .rep-table td {
        padding: 16px 20px;
        border-bottom: 1px solid #f3f4f6;
        font-size: 0.875rem;
        color: #374151;
        vertical-align: middle;
    }
    
    .rep-table tr:last-child td {
        border-bottom: none;
    }
    
    .rep-table tr:hover td {
        background-color: #f9fafb;
    }
    
    .rep-badge {
        display: inline-flex;
        align-items: center;
        padding: 3px 10px;
        border-radius: 9999px;
        font-size: 0.75rem;
        font-weight: 600;
    }
    
    .rep-badge-blue { background: #eff6ff; color: #2563eb; }
    .rep-badge-gray { background: #f3f4f6; color: #4b5563; }
    .rep-badge-green { background: #f0fdf4; color: #16a34a; }
    .rep-badge-red { background: #fef2f2; color: #dc2626; }
    
    .rep-code {
        font-family: SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        font-size: 0.8rem;
        font-weight: 600;
        color: #0f172a;
    }
    
    /* Modals styling matching modern glassmorphism */
    .enterprise-modal .modal-content {
        border-radius: 20px;
        border: 1px solid rgba(255, 255, 255, 0.2);
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
    }
    
    .enterprise-modal .modal-header {
        border-bottom: 1px solid #e5e7eb;
        padding: 20px 24px;
    }
    
    .detail-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 16px;
    }
    
    .detail-item {
        background: #f9fafb;
        padding: 12px 16px;
        border-radius: 12px;
        border: 1px solid #e5e7eb;
    }
    
    .detail-label {
        font-size: 0.75rem;
        font-weight: 600;
        color: #6b7280;
        text-transform: uppercase;
        margin-bottom: 4px;
    }
    
    .detail-value {
        font-size: 0.9rem;
        font-weight: 700;
        color: #111827;
    }
    
    .detail-description-box {
        background: #f9fafb;
        padding: 16px;
        border-radius: 12px;
        border: 1px solid #e5e7eb;
        font-size: 0.875rem;
        color: #374151;
        line-height: 1.5;
    }
</style>

<div class="rep-page">
    <div class="rep-breadcrumb">Inicio / Sistema / <strong>Reportes</strong></div>
    <div class="rep-title">Módulo de Reportes</div>

    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="alert alert-danger rounded-4 mb-4 border-0 shadow-sm">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @Model.Error
        </div>
    }

    <!-- KPI Summary Grid -->
    <div class="rep-kpis">
        <div class="rep-kpi-card">
            <div class="rep-kpi-icon blue"><i class="bi bi-file-earmark-bar-graph"></i></div>
            <div>
                <div class="rep-kpi-label">Reportes Totales</div>
                <div class="rep-kpi-val">@Model.TotalReportes</div>
            </div>
        </div>
        
        <div class="rep-kpi-card">
            <div class="rep-kpi-icon green"><i class="bi bi-check-circle"></i></div>
            <div>
                <div class="rep-kpi-label">Reportes Activos</div>
                <div class="rep-kpi-val">@Model.ReportesActivos</div>
            </div>
        </div>
        
        <div class="rep-kpi-card">
            <div class="rep-kpi-icon purple"><i class="bi bi-database"></i></div>
            <div>
                <div class="rep-kpi-label">Filas Analizadas</div>
                <div class="rep-kpi-val">@Model.TotalRegistrosAnalizados.ToString("N0")</div>
            </div>
        </div>
        
        <div class="rep-kpi-card">
            <div class="rep-kpi-icon orange"><i class="bi bi-diagram-3"></i></div>
            <div>
                <div class="rep-kpi-label">Módulos Cubiertos</div>
                <div class="rep-kpi-val">@Model.TotalModulos</div>
            </div>
        </div>
    </div>

    <!-- Filters Section -->
    <div class="rep-filter-card">
        <form method="get" action="/Sistema/Reportes" class="row g-3 align-items-end">
            <div class="col-md-4 col-sm-6">
                <label class="rep-form-label"><i class="bi bi-filter-square me-1"></i>Módulo Origen</label>
                <select name="moduloFiltro" class="rep-form-select">
                    <option value="">Todos los módulos</option>
                    @foreach (var modulo in Model.Modulos)
                    {
                        if (Model.ModuloFiltro == modulo)
                        {
                            <option value="@modulo" selected>@modulo</option>
                        }
                        else
                        {
                            <option value="@modulo">@modulo</option>
                        }
                    }
                </select>
            </div>
            
            <div class="col-md-4 col-sm-6">
                <label class="rep-form-label"><i class="bi bi-toggle-on me-1"></i>Estado de Disponibilidad</label>
                <select name="estadoFiltro" class="rep-form-select">
                    <option value="">Todos los estados</option>
                    @if (Model.EstadoFiltro == "true")
                    {
                        <option value="true" selected>Disponibles (Activos)</option>
                    }
                    else
                    {
                        <option value="true">Disponibles (Activos)</option>
                    }
                    @if (Model.EstadoFiltro == "false")
                    {
                        <option value="false" selected>No disponibles (Inactivos)</option>
                    }
                    else
                    {
                        <option value="false">No disponibles (Inactivos)</option>
                    }
                </select>
            </div>

            <div class="col-md-4 col-sm-12 d-flex gap-2 justify-content-md-end">
                <button type="submit" class="rep-btn rep-btn-primary flex-grow-1"><i class="bi bi-search"></i> Filtrar</button>
                <a href="/Sistema/Reportes" class="rep-btn rep-btn-secondary"><i class="bi bi-arrow-clockwise"></i> Limpiar</a>
            </div>
        </form>
    </div>

    <!-- Charts Section -->
    <div class="rep-charts-grid">
        <div class="rep-chart-card">
            <div class="rep-card-title"><i class="bi bi-bar-chart-fill text-primary"></i> Distribución de Reportes por Módulo</div>
            <div class="rep-chart-container">
                <canvas id="chartModulo"></canvas>
            </div>
        </div>

        <div class="rep-chart-card">
            <div class="rep-card-title"><i class="bi bi-pie-chart-fill text-success"></i> Top Reportes Más Generados</div>
            <div class="rep-chart-container">
                <canvas id="chartTopReportes"></canvas>
            </div>
        </div>
    </div>

    <!-- Data Panel -->
    <div class="rep-panel">
        <div class="rep-panel-header">
            <div>
                <h3 class="rep-panel-title">Catálogo Oficial de Reportes</h3>
                <div class="rep-panel-subtitle">Lista de reportes configurados en la tabla <code>sistema.reportes_config</code></div>
            </div>
            
            <div class="d-flex gap-2">
                <a href="@Url.Action("Pdf", "Reportes", new { moduloFiltro = Model.ModuloFiltro, estadoFiltro = Model.EstadoFiltro })" class="rep-btn rep-btn-danger-outline py-2 px-3">
                    <i class="bi bi-file-earmark-pdf"></i> PDF
                </a>
                <a href="@Url.Action("Excel", "Reportes", new { moduloFiltro = Model.ModuloFiltro, estadoFiltro = Model.EstadoFiltro })" class="rep-btn rep-btn-success-outline py-2 px-3">
                    <i class="bi bi-file-earmark-excel"></i> Excel
                </a>
            </div>
        </div>

        <div class="rep-table-wrap">
            <table class="rep-table">
                <thead>
                    <tr>
                        <th style="width: 120px;">Código</th>
                        <th>Nombre del Reporte</th>
                        <th style="width: 150px;">Módulo Origen</th>
                        <th style="width: 120px;">Filas</th>
                        <th style="width: 120px;">Estado</th>
                        <th>Procedimiento en BD</th>
                        <th style="text-align: right; width: 100px;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Reportes.Any())
                    {
                        foreach (var item in Model.Reportes)
                        {
                            var modalId = $"modalReporte_{item.ReporteId}";

                            <tr>
                                <td><span class="rep-badge rep-badge-blue rep-code">@item.Codigo</span></td>
                                <td>
                                    <div class="fw-bold text-dark">@item.Nombre</div>
                                    <div class="text-muted small text-truncate" style="max-width: 320px;">@item.Descripcion</div>
                                </td>
                                <td><span class="rep-badge rep-badge-gray">@item.ModuloOrigen</span></td>
                                <td><strong class="text-dark">@item.TotalRegistros.ToString("N0")</strong></td>
                                <td>
                                    @if (item.EstaActivo)
                                    {
                                        <span class="rep-badge rep-badge-green"><i class="bi bi-circle-fill me-1" style="font-size: 0.4rem;"></i> Activo</span>
                                    }
                                    else
                                    {
                                        <span class="rep-badge rep-badge-red"><i class="bi bi-circle-fill me-1" style="font-size: 0.4rem;"></i> Inactivo</span>
                                    }
                                </td>
                                <td><code class="text-secondary">@item.ProcedimientoNombre</code></td>
                                <td style="text-align: right;">
                                    <button type="button" class="rep-btn rep-btn-secondary py-1 px-3" data-bs-toggle="modal" data-bs-target="#@modalId">
                                        <i class="bi bi-eye"></i> Ver
                                    </button>
                                </td>
                            </tr>

                            <!-- Details Modal -->
                            <div class="modal fade enterprise-modal" id="@modalId" tabindex="-1" aria-hidden="true">
                                <div class="modal-dialog modal-dialog-centered modal-lg">
                                    <div class="modal-content">
                                        <div class="modal-header">
                                            <div>
                                                <h5 class="modal-title fw-bold text-dark mb-1"><i class="bi bi-file-text text-primary me-2"></i>@item.Nombre</h5>
                                                <div class="text-muted small">Detalle completo de la configuración del reporte</div>
                                            </div>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                        </div>
                                        <div class="modal-body p-4">
                                            <div class="detail-grid mb-4">
                                                <div class="detail-item">
                                                    <div class="detail-label">Código Único</div>
                                                    <div class="detail-value text-primary font-monospace">@item.Codigo</div>
                                                </div>
                                                <div class="detail-item">
                                                    <div class="detail-label">Módulo Funcional</div>
                                                    <div class="detail-value">@item.ModuloOrigen</div>
                                                </div>
                                                <div class="detail-item">
                                                    <div class="detail-label">Registros Procesados</div>
                                                    <div class="detail-value">@item.TotalRegistros.ToString("N0")</div>
                                                </div>
                                                <div class="detail-item">
                                                    <div class="detail-label">Estado</div>
                                                    <div class="detail-value">
                                                        <span class="rep-badge @(item.EstaActivo ? "rep-badge-green" : "rep-badge-red")">
                                                            @(item.EstaActivo ? "Activo" : "Inactivo")
                                                        </span>
                                                    </div>
                                                </div>
                                                <div class="detail-item col-span-2" style="grid-column: span 2;">
                                                    <div class="detail-label">Procedimiento Almacenado SQL</div>
                                                    <div class="detail-value font-monospace text-secondary">@item.ProcedimientoNombre</div>
                                                </div>
                                            </div>

                                            <div class="detail-label mb-2">Descripción Funcional</div>
                                            <div class="detail-description-box mb-4">
                                                @(string.IsNullOrWhiteSpace(item.Descripcion) ? "Sin descripción detallada registrada." : item.Descripcion)
                                            </div>

                                            <div class="d-flex justify-content-end gap-2">
                                                <button type="button" class="rep-btn rep-btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-file-earmark-x" style="font-size: 2.5rem; display: block; margin-bottom: 12px; color: #d1d5db;"></i>
                                No se encontraron reportes configurados con los filtros aplicados.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Inline execution of scripts because partial view scripts are not processed by layout sections -->
<script>
    (function() {
        const labelsModulo = @Html.Raw(JsonSerializer.Serialize(Model.ChartModuloLabels));
        const valuesModulo = @Html.Raw(JsonSerializer.Serialize(Model.ChartModuloValues));
        const labelsTop = @Html.Raw(JsonSerializer.Serialize(Model.ChartTopLabels));
        const valuesTop = @Html.Raw(JsonSerializer.Serialize(Model.ChartTopValues));

        const chartModuloEl = document.getElementById('chartModulo');
        const chartTopEl = document.getElementById('chartTopReportes');

        // Dynamically load Chart.js if not present
        function initCharts() {
            if (chartModuloEl && labelsModulo.length > 0) {
                new Chart(chartModuloEl, {
                    type: 'bar',
                    data: {
                        labels: labelsModulo,
                        datasets: [{
                            data: valuesModulo,
                            backgroundColor: '#2563eb',
                            borderRadius: 6
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: {
                            y: { beginAtZero: true, grid: { color: '#f3f4f6' }, ticks: { stepSize: 1 } },
                            x: { grid: { display: false } }
                        }
                    }
                });
            }

            if (chartTopEl && labelsTop.length > 0) {
                new Chart(chartTopEl, {
                    type: 'doughnut',
                    data: {
                        labels: labelsTop,
                        datasets: [{
                            data: valuesTop,
                            backgroundColor: ['#2563eb', '#16a34a', '#d97706', '#0891b2', '#7c3aed', '#dc2626'],
                            borderWidth: 2,
                            borderColor: '#ffffff'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { position: 'bottom', labels: { boxWidth: 12, font: { size: 10 } } } },
                        cutout: '60%'
                    }
                });
            }
        }

        if (typeof Chart === 'undefined') {
            const script = document.createElement('script');
            script.src = 'https://cdn.jsdelivr.net/npm/chart.js';
            script.onload = initCharts;
            document.head.appendChild(script);
        } else {
            initCharts();
        }
    })();
</script>