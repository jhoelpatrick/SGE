@model Reportes.Models.AuditoriaViewModel
@using System.Text.Json

@{
    Layout = null;
}

<style>
    /* Premium ERP Styling for Auditoria */
    .aud-page {
        padding: 24px;
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        color: #1f2937;
    }
    
    .aud-breadcrumb {
        font-size: 0.8rem;
        color: #6b7280;
        margin-bottom: 8px;
    }
    
    .aud-title {
        font-size: 1.6rem;
        font-weight: 700;
        letter-spacing: -0.025em;
        color: #111827;
        margin-bottom: 24px;
    }
    
    /* KPI Cards */
    .aud-kpis {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 16px;
        margin-bottom: 28px;
    }
    
    .aud-kpi-card {
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 16px;
        padding: 20px;
        box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.05);
        transition: transform 0.2s;
    }
    
    .aud-kpi-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    }
    
    .aud-kpi-label {
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        color: #6b7280;
        margin-bottom: 4px;
    }
    
    .aud-kpi-val {
        font-size: 1.6rem;
        font-weight: 800;
        color: #111827;
        margin-bottom: 4px;
    }
    
    .aud-kpi-status {
        font-size: 0.75rem;
        font-weight: 500;
        color: #9ca3af;
        display: flex;
        align-items: center;
        gap: 4px;
    }
    
    .status-ok { color: #16a34a; }
    .status-warning { color: #d97706; }
    .status-danger { color: #dc2626; }
    
    /* Filters Card */
    .aud-filter-card {
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 16px;
        padding: 20px;
        box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.05);
        margin-bottom: 28px;
    }
    
    .aud-form-label {
        font-size: 0.8rem;
        font-weight: 600;
        color: #4b5563;
        margin-bottom: 6px;
        display: block;
    }
    
    .aud-form-input, .aud-form-select {
        width: 100%;
        border: 1px solid #d1d5db;
        border-radius: 10px;
        padding: 9px 14px;
        font-size: 0.875rem;
        color: #111827;
        background-color: #f9fafb;
        outline: none;
        transition: border-color 0.15s, box-shadow 0.15s;
    }
    
    .aud-form-input:focus, .aud-form-select:focus {
        border-color: #2563eb;
        box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);
        background-color: #ffffff;
    }
    
    .aud-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 10px 18px;
        border-radius: 10px;
        font-size: 0.875rem;
        font-weight: 600;
        transition: all 0.15s;
        border: 1px solid transparent;
        cursor: pointer;
    }
    
    .aud-btn-primary { background: #2563eb; color: #ffffff; }
    .aud-btn-primary:hover { background: #1d4ed8; }
    .aud-btn-secondary { background: #ffffff; color: #374151; border-color: #d1d5db; }
    .aud-btn-secondary:hover { background: #f3f4f6; }
    .aud-btn-danger-outline { background: #ffffff; color: #dc2626; border-color: #fca5a5; }
    .aud-btn-danger-outline:hover { background: #fef2f2; }
    .aud-btn-success-outline { background: #ffffff; color: #16a34a; border-color: #bbf7d0; }
    .aud-btn-success-outline:hover { background: #f0fdf4; }
    
    /* Layout grid for metrics/charts */
    .aud-layout-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 24px;
        margin-bottom: 28px;
    }
    
    @@media (max-width: 1024px) {
        .aud-layout-grid { grid-template-columns: 1fr; }
    }
    
    .aud-panel-card {
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 16px;
        padding: 20px;
        box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.05);
        display: flex;
        flex-direction: column;
        height: 100%;
    }
    
    .aud-panel-title {
        font-size: 0.95rem;
        font-weight: 700;
        color: #111827;
        margin-bottom: 16px;
        display: flex;
        align-items: center;
        gap: 8px;
        border-bottom: 1px solid #f3f4f6;
        padding-bottom: 10px;
    }
    
    /* Activity Feed */
    .activity-feed {
        display: flex;
        flex-direction: column;
        gap: 16px;
        max-height: 250px;
        overflow-y: auto;
    }
    
    .activity-item {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        font-size: 0.85rem;
    }
    
    .activity-icon {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.85rem;
        flex-shrink: 0;
    }
    
    .activity-icon.insert { background: #ecfdf5; color: #059669; }
    .activity-icon.update { background: #fffbeb; color: #d97706; }
    .activity-icon.delete { background: #fef2f2; color: #dc2626; }
    
    .activity-time {
        font-size: 0.75rem;
        color: #9ca3af;
        margin-left: auto;
        white-space: nowrap;
    }
    
    /* Alertas */
    .alert-feed {
        display: flex;
        flex-direction: column;
        gap: 12px;
        max-height: 250px;
        overflow-y: auto;
    }
    
    .alert-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: #fdf2f8;
        border: 1px solid #fbcfe8;
        border-radius: 10px;
        padding: 10px 14px;
        font-size: 0.82rem;
    }
    
    .alert-item.warning {
        background: #fffbeb;
        border-color: #fde68a;
    }
    
    .alert-badge {
        padding: 2px 8px;
        border-radius: 9999px;
        font-size: 0.7rem;
        font-weight: 700;
    }
    
    .alert-badge.red { background: #fca5a5; color: #7f1d1d; }
    .alert-badge.yellow { background: #fde68a; color: #78350f; }
    
    /* Table styling */
    .aud-table-panel {
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 16px;
        box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.05);
        overflow: hidden;
    }
    
    .aud-table-header {
        padding: 20px 24px;
        border-bottom: 1px solid #e5e7eb;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
    }
    
    .aud-table-wrap {
        overflow-x: auto;
    }
    
    .aud-table {
        width: 100%;
        border-collapse: collapse;
        text-align: left;
    }
    
    .aud-table th {
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: #4b5563;
        padding: 14px 20px;
        background: #f9fafb;
        border-bottom: 1px solid #e5e7eb;
    }
    
    .aud-table td {
        padding: 14px 20px;
        border-bottom: 1px solid #f3f4f6;
        font-size: 0.85rem;
        color: #374151;
        vertical-align: middle;
    }
    
    .aud-table tr:hover td {
        background-color: #f9fafb;
    }
    
    .aud-badge {
        display: inline-flex;
        align-items: center;
        padding: 3px 8px;
        border-radius: 9999px;
        font-size: 0.75rem;
        font-weight: 600;
    }
    
    .aud-badge-green { background: #dcfce7; color: #166534; }
    .aud-badge-yellow { background: #fef9c3; color: #854d0e; }
    .aud-badge-red { background: #fee2e2; color: #991b1b; }
    
    .aud-code-box {
        font-family: SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        font-size: 0.78rem;
        max-width: 180px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        color: #4b5563;
    }
    
    /* Pagination */
    .aud-pagination {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 16px 24px;
        background: #fafafa;
        border-top: 1px solid #e5e7eb;
    }
    
    .page-link-btn {
        padding: 6px 14px;
        border-radius: 8px;
        border: 1px solid #d1d5db;
        background: #ffffff;
        font-size: 0.8rem;
        color: #374151;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.15s;
    }
    
    .page-link-btn:hover:not(.disabled) {
        background: #f3f4f6;
        border-color: #9ca3af;
    }
    
    .page-link-btn.disabled {
        color: #9ca3af;
        background: #f9fafb;
        border-color: #e5e7eb;
        pointer-events: none;
        cursor: not-allowed;
    }
</style>

<div class="aud-page">
    <div class="aud-breadcrumb">Inicio / Sistema / <strong>Auditoría</strong></div>
    <div class="aud-title">Registro de Auditoría y Bitácora</div>

    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="alert alert-danger rounded-4 mb-4 border-0 shadow-sm">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @Model.Error
        </div>
    }

    <!-- KPIs Grid -->
    <div class="aud-kpis">
        <div class="aud-kpi-card">
            <div class="aud-kpi-label">Eventos Totales</div>
            <div class="aud-kpi-val">@Model.TotalEventos.ToString("N0")</div>
            <div class="aud-kpi-status status-ok"><i class="bi bi-shield-fill-check"></i> Activo</div>
        </div>
        
        <div class="aud-kpi-card">
            <div class="aud-kpi-label">Usuarios con Actividad</div>
            <div class="aud-kpi-val">@Model.UsuariosUnicos</div>
            <div class="aud-kpi-status"><i class="bi bi-people-fill"></i> Colaboradores</div>
        </div>
        
        <div class="aud-kpi-card">
            <div class="aud-kpi-label">Cambios Críticos</div>
            <div class="aud-kpi-val text-warning">@Model.CambiosCriticos</div>
            <div class="aud-kpi-status status-warning"><i class="bi bi-exclamation-circle-fill"></i> Modificaciones</div>
        </div>
        
        <div class="aud-kpi-card">
            <div class="aud-kpi-label">Eventos del Día</div>
            <div class="aud-kpi-val text-success">@Model.EventosHoy</div>
            <div class="aud-kpi-status status-ok"><i class="bi bi-calendar-check-fill"></i> Hoy</div>
        </div>
        
        <div class="aud-kpi-card">
            <div class="aud-kpi-label">Riesgo Global</div>
            <div class="aud-kpi-val @(Model.NivelRiesgo == "Alto" ? "text-danger" : "text-success")">@Model.NivelRiesgo</div>
            <div class="aud-kpi-status"><i class="bi bi-activity"></i> Monitoreo Activo</div>
        </div>
    </div>

    <!-- Filters Section -->
    <div class="aud-filter-card">
        <form method="get" action="/Sistema/Auditoria" class="row g-3 align-items-end">
            <div class="col-lg-2 col-md-4 col-sm-6">
                <label class="aud-form-label"><i class="bi bi-calendar-event me-1"></i>Fecha Inicio</label>
                <input type="date" name="fechaInicio" class="aud-form-input" value="@(Model.FechaInicio?.ToString("yyyy-MM-dd"))" />
            </div>
            
            <div class="col-lg-2 col-md-4 col-sm-6">
                <label class="aud-form-label"><i class="bi bi-calendar-event me-1"></i>Fecha Fin</label>
                <input type="date" name="fechaFin" class="aud-form-input" value="@(Model.FechaFin?.ToString("yyyy-MM-dd"))" />
            </div>

            <div class="col-lg-2 col-md-4 col-sm-6">
                <label class="aud-form-label"><i class="bi bi-person me-1"></i>Usuario</label>
                <select name="usuarioFiltro" class="aud-form-select">
                    <option value="">Todos</option>
                    @foreach (var user in Model.Usuarios)
                    {
                        if (Model.UsuarioFiltro == user)
                        {
                            <option value="@user" selected>@user</option>
                        }
                        else
                        {
                            <option value="@user">@user</option>
                        }
                    }
                </select>
            </div>

            <div class="col-lg-3 col-md-6 col-sm-6">
                <label class="aud-form-label"><i class="bi bi-table me-1"></i>Tabla Afectada</label>
                <select name="tablaAfectada" class="aud-form-select">
                    <option value="">Todas</option>
                    @foreach (var table in Model.Tablas)
                    {
                        if (Model.TablaAfectada == table)
                        {
                            <option value="@table" selected>@table</option>
                        }
                        else
                        {
                            <option value="@table">@table</option>
                        }
                    }
                </select>
            </div>

            <div class="col-lg-2 col-md-3 col-sm-6">
                <label class="aud-form-label"><i class="bi bi-activity me-1"></i>Acción</label>
                <select name="accion" class="aud-form-select">
                    <option value="">Todas</option>
                    <option value="insert" selected="@(Model.Accion == "insert")">INSERT (Crear)</option>
                    <option value="update" selected="@(Model.Accion == "update")">UPDATE (Modificar)</option>
                    <option value="delete" selected="@(Model.Accion == "delete")">DELETE (Eliminar)</option>
                </select>
            </div>

            <div class="col-lg-1 col-md-3 col-sm-6 d-grid">
                <button type="submit" class="aud-btn aud-btn-primary"><i class="bi bi-search"></i> Buscar</button>
            </div>
        </form>
        
        <div class="d-flex justify-content-end gap-2 mt-3 flex-wrap">
            <a href="/Sistema/Auditoria" class="aud-btn aud-btn-secondary"><i class="bi bi-arrow-clockwise"></i> Limpiar Filtros</a>
            <a href="@Url.Action("Pdf", "Auditoria", new { tablaAfectada = Model.TablaAfectada, accion = Model.Accion, usuarioFiltro = Model.UsuarioFiltro, fechaInicio = Model.FechaInicio?.ToString("yyyy-MM-dd"), fechaFin = Model.FechaFin?.ToString("yyyy-MM-dd") })" class="aud-btn aud-btn-danger-outline"><i class="bi bi-file-earmark-pdf"></i> Exportar PDF</a>
            <a href="@Url.Action("Excel", "Auditoria", new { tablaAfectada = Model.TablaAfectada, accion = Model.Accion, usuarioFiltro = Model.UsuarioFiltro, fechaInicio = Model.FechaInicio?.ToString("yyyy-MM-dd"), fechaFin = Model.FechaFin?.ToString("yyyy-MM-dd") })" class="aud-btn aud-btn-success-outline"><i class="bi bi-file-earmark-excel"></i> Exportar Excel</a>
        </div>
    </div>

    <!-- Layout Grid -->
    <div class="aud-layout-grid">
        <div class="aud-panel-card">
            <div class="aud-panel-title"><i class="bi bi-clock-history text-primary"></i> Actividad Reciente</div>
            <div class="activity-feed">
                @if (Model.Recientes.Any())
                {
                    foreach (var activity in Model.Recientes)
                    {
                        var actClass = activity.Accion.ToLower();
                        <div class="activity-item">
                            <div class="activity-icon @actClass">
                                <i class="bi @(activity.Accion == "insert" ? "bi-plus-lg" : activity.Accion == "update" ? "bi-pencil-fill" : "bi-trash-fill")"></i>
                            </div>
                            <div>
                                <div class="fw-bold text-dark" style="text-transform: capitalize;">@activity.Accion</div>
                                <div class="text-muted small">@activity.TablaAfectada (ID: @activity.IdRegistroAfectado)</div>
                                <div class="text-secondary small">Realizado por <strong>@activity.Usuario</strong></div>
                            </div>
                            <span class="activity-time">@activity.FechaRegistro.ToString("dd/MM HH:mm")</span>
                        </div>
                    }
                }
                else
                {
                    <div class="text-muted text-center py-4">No hay actividad registrada.</div>
                }
            </div>
        </div>

        <div class="aud-panel-card">
            <div class="aud-panel-title"><i class="bi bi-pie-chart-fill text-success"></i> Acciones Auditadas</div>
            <div style="position:relative; height:200px; width:100%;">
                <canvas id="chartAcciones"></canvas>
            </div>
        </div>

        <div class="aud-panel-card">
            <div class="aud-panel-title"><i class="bi bi-shield-fill-exclamation text-danger"></i> Alertas y Riesgo Contable</div>
            <div class="alert-feed">
                @if (Model.Alertas.Any())
                {
                    foreach (var alert in Model.Alertas)
                    {
                        var isCrit = alert.Nivel == "Crítico";
                        <div class="alert-item @(isCrit ? "" : "warning")">
                            <div>
                                <div class="fw-bold text-dark">@alert.Titulo</div>
                                <div class="text-secondary" style="font-size: 0.78rem;">@alert.Descripcion</div>
                            </div>
                            <span class="alert-badge @(isCrit ? "red" : "yellow")">@alert.Nivel</span>
                        </div>
                    }
                }
                else
                {
                    <div class="text-muted text-center py-4">
                        <i class="bi bi-shield-fill-check text-success fs-3 d-block mb-2"></i>
                        Sin alertas críticas recientes en el sistema.
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Main Audit Log Table -->
    <div class="aud-table-panel">
        <div class="aud-table-header">
            <div>
                <h3 class="rep-panel-title">Bitácora Oficial de Cambios</h3>
                <div class="rep-panel-subtitle">Lista de auditoría transaccional de la tabla <code>sistema.logs_auditoria_datos</code></div>
            </div>
            <small class="text-muted">Mostrando <strong>@Model.Registros.Count</strong> de @Model.TotalRegistros registros</small>
        </div>

        <div class="aud-table-wrap">
            <table class="aud-table">
                <thead>
                    <tr>
                        <th style="width: 140px;">Fecha / Hora</th>
                        <th style="width: 130px;">Usuario</th>
                        <th>Tabla Afectada</th>
                        <th style="width: 100px;">Acción</th>
                        <th style="width: 100px;">ID Registro</th>
                        <th>Valor Anterior</th>
                        <th>Valor Nuevo</th>
                        <th style="text-align: right; width: 100px;">Detalle</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Registros.Any())
                    {
                        foreach (var row in Model.Registros)
                        {
                            var modalId = $"modalAudit_{row.LogId}";
                            var actClass = row.Accion switch {
                                "insert" => "aud-badge-green",
                                "update" => "aud-badge-yellow",
                                "delete" => "aud-badge-red",
                                _ => "aud-badge-gray"
                            };

                            <tr>
                                <td>
                                    <div class="fw-bold text-dark">@row.FechaRegistro.ToString("dd/MM/yyyy")</div>
                                    <div class="text-muted small">@row.FechaRegistro.ToString("HH:mm:ss")</div>
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark">@row.Usuario</div>
                                    <div class="text-muted small">System Client</div>
                                </td>
                                <td><code class="text-dark">@row.TablaAfectada</code></td>
                                <td><span class="aud-badge @actClass" style="text-transform:uppercase;">@row.Accion</span></td>
                                <td><span class="fw-bold">@row.IdRegistroAfectado</span></td>
                                <td><div class="aud-code-box">@(string.IsNullOrWhiteSpace(row.ValorAnterior) ? "-" : row.ValorAnterior)</div></td>
                                <td><div class="aud-code-box">@(string.IsNullOrWhiteSpace(row.ValorNuevo) ? "-" : row.ValorNuevo)</div></td>
                                <td style="text-align: right;">
                                    <button class="rep-btn rep-btn-secondary py-1 px-3" data-bs-toggle="modal" data-bs-target="#@modalId">
                                        <i class="bi bi-eye"></i> Ver
                                    </button>
                                </td>
                            </tr>

                            <!-- Detail Modal -->
                            <div class="modal fade enterprise-modal" id="@modalId" tabindex="-1" aria-hidden="true">
                                <div class="modal-dialog modal-dialog-centered modal-lg">
                                    <div class="modal-content">
                                        <div class="modal-header">
                                            <div>
                                                <h5 class="modal-title fw-bold text-dark mb-1"><i class="bi bi-shield-fill-check text-primary me-2"></i>Detalle de Transacción Auditada</h5>
                                                <div class="text-muted small">Registro del log transaccional de auditoría</div>
                                            </div>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                        </div>
                                        <div class="modal-body p-4">
                                            <div class="detail-grid mb-4">
                                                <div class="detail-item">
                                                    <div class="detail-label">Log ID</div>
                                                    <div class="detail-value text-primary font-monospace">#@row.LogId</div>
                                                </div>
                                                <div class="detail-item">
                                                    <div class="detail-label">Fecha y Hora</div>
                                                    <div class="detail-value">@row.FechaRegistro.ToString("dd/MM/yyyy HH:mm:ss")</div>
                                                </div>
                                                <div class="detail-item">
                                                    <div class="detail-label">Usuario Sistema</div>
                                                    <div class="detail-value">@row.Usuario</div>
                                                </div>
                                                <div class="detail-item">
                                                    <div class="detail-label">Acción Ejecutada</div>
                                                    <div class="detail-value" style="text-transform: uppercase;">
                                                        <span class="aud-badge @actClass">@row.Accion</span>
                                                    </div>
                                                </div>
                                                <div class="detail-item">
                                                    <div class="detail-label">Tabla Afectada</div>
                                                    <div class="detail-value font-monospace">@row.TablaAfectada</div>
                                                </div>
                                                <div class="detail-item">
                                                    <div class="detail-label">ID Registro Afectado</div>
                                                    <div class="detail-value fw-bold">@row.IdRegistroAfectado</div>
                                                </div>
                                            </div>

                                            <div class="row g-3">
                                                <div class="col-md-6">
                                                    <div class="detail-label mb-2">Valor Anterior en Base de Datos</div>
                                                    <pre class="detail-description-box" style="white-space: pre-wrap; font-size: 0.8rem; overflow: auto; max-height: 180px;">@(string.IsNullOrWhiteSpace(row.ValorAnterior) ? "Sin datos anteriores." : row.ValorAnterior)</pre>
                                                </div>
                                                <div class="col-md-6">
                                                    <div class="detail-label mb-2">Valor Nuevo en Base de Datos</div>
                                                    <pre class="detail-description-box" style="white-space: pre-wrap; font-size: 0.8rem; overflow: auto; max-height: 180px;">@(string.IsNullOrWhiteSpace(row.ValorNuevo) ? "Sin datos nuevos." : row.ValorNuevo)</pre>
                                                </div>
                                            </div>

                                            <div class="d-flex justify-content-end mt-4">
                                                <button type="button" class="rep-btn rep-btn-secondary" data-bs-dismiss="modal">Cerrar Detalle</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="bi bi-shield-slash" style="font-size: 2.5rem; display: block; margin-bottom: 12px; color: #d1d5db;"></i>
                                No se encontraron registros de auditoría que coincidan con la búsqueda.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPaginas > 1)
        {
            <div class="aud-pagination">
                <span class="text-muted small">Página <strong>@Model.PaginaActual</strong> de <strong>@Model.TotalPaginas</strong></span>
                <div class="d-flex gap-2">
                    @{
                        var prevPage = Model.PaginaActual - 1;
                        var nextPage = Model.PaginaActual + 1;
                    }
                    
                    <a class="page-link-btn @(Model.PaginaActual <= 1 ? "disabled" : "")" 
                       href="/Sistema/Auditoria?tablaAfectada=@Model.TablaAfectada&accion=@Model.Accion&usuarioFiltro=@Model.UsuarioFiltro&fechaInicio=@(Model.FechaInicio?.ToString("yyyy-MM-dd"))&fechaFin=@(Model.FechaFin?.ToString("yyyy-MM-dd"))&pagina=@prevPage">
                        <i class="bi bi-chevron-left"></i> Anterior
                    </a>
                    
                    <a class="page-link-btn @(Model.PaginaActual >= Model.TotalPaginas ? "disabled" : "")" 
                       href="/Sistema/Auditoria?tablaAfectada=@Model.TablaAfectada&accion=@Model.Accion&usuarioFiltro=@Model.UsuarioFiltro&fechaInicio=@(Model.FechaInicio?.ToString("yyyy-MM-dd"))&fechaFin=@(Model.FechaFin?.ToString("yyyy-MM-dd"))&pagina=@nextPage">
                        Siguiente <i class="bi bi-chevron-right"></i>
                    </a>
                </div>
            </div>
        }
    </div>
</div>

<script>
    (function() {
        const labelsAccion = @Html.Raw(JsonSerializer.Serialize(Model.ChartAccionLabels));
        const valuesAccion = @Html.Raw(JsonSerializer.Serialize(Model.ChartAccionValues));
        const canvasEl = document.getElementById('chartAcciones');

        function initChart() {
            if (canvasEl && labelsAccion.length > 0) {
                new Chart(canvasEl, {
                    type: 'doughnut',
                    data: {
                        labels: labelsAccion,
                        datasets: [{
                            data: valuesAccion,
                            backgroundColor: ['#2563eb', '#16a34a', '#dc2626', '#d97706', '#6b7280'],
                            borderWidth: 2,
                            borderColor: '#ffffff'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                position: 'bottom',
                                labels: { boxWidth: 12, font: { size: 10 } }
                            }
                        },
                        cutout: '60%'
                    }
                });
            }
        }

        if (typeof Chart === 'undefined') {
            const script = document.createElement('script');
            script.src = 'https://cdn.jsdelivr.net/npm/chart.js';
            script.onload = initChart;
            document.head.appendChild(script);
        } else {
            initChart();
        }
    })();
</script>