@{
    ViewData["Title"] = "Dashboard";
}

<div class="px-4 py-3" style="font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;">
    <!-- Top Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 mt-2">
        <div>
            <h2 class="fw-bold mb-1" style="letter-spacing: -0.5px;">Dashboard</h2>
            <p class="text-secondary small mb-0">Resumen general del sistema. Selecciona un módulo para comenzar.</p>
        </div>
        <div>
            <button onclick="if(window.loadContent) window.loadContent('/Sistema/Reportes');" class="btn btn-light bg-white border text-secondary me-2 px-3 fw-bold rounded-3 shadow-sm">
                <i class="bi bi-bar-chart me-1"></i> Reportes
            </button>
            <button onclick="if(window.loadContent) window.loadContent('/Sistema/Configuracion');" class="btn px-3 fw-bold rounded-3 shadow-sm text-white" style="background-color: #10b981; border-color: #10b981;">
                <i class="bi bi-gear me-1"></i> Configurar
            </button>
        </div>
    </div>

    <!-- KPIs -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body d-flex align-items-center p-3">
                    <div class="rounded-3 d-flex align-items-center justify-content-center me-3" style="width: 48px; height: 48px; background-color: rgba(16, 185, 129, 0.1); color: #10b981;">
                        <i class="bi bi-people-fill fs-5"></i>
                    </div>
                    <div>
                        <div class="text-secondary small fw-semibold mb-1" style="font-size: 0.75rem;">Usuarios Activos</div>
                        <h4 class="fw-bold mb-0 lh-1">@ViewBag.UsuariosActivos</h4>
                        <small class="text-success fw-bold" style="font-size: 0.7rem;"><i class="bi bi-arrow-up-short"></i>100%</small>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body d-flex align-items-center p-3">
                    <div class="rounded-3 d-flex align-items-center justify-content-center me-3" style="width: 48px; height: 48px; background-color: rgba(16, 185, 129, 0.1); color: #10b981;">
                        <i class="bi bi-cart-fill fs-5"></i>
                    </div>
                    <div>
                        <div class="text-secondary small fw-semibold mb-1" style="font-size: 0.75rem;">Ventas del Mes</div>
                        <h4 class="fw-bold mb-0 lh-1">@ViewBag.VentasMes</h4>
                        <small class="text-success fw-bold" style="font-size: 0.7rem;"><i class="bi bi-arrow-up-short"></i>0.0%</small>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body d-flex align-items-center p-3">
                    <div class="rounded-3 d-flex align-items-center justify-content-center me-3" style="width: 48px; height: 48px; background-color: rgba(245, 158, 11, 0.1); color: #f59e0b;">
                        <i class="bi bi-file-earmark-text-fill fs-5"></i>
                    </div>
                    <div>
                        <div class="text-secondary small fw-semibold mb-1" style="font-size: 0.75rem;">Facturas Emitidas</div>
                        <h4 class="fw-bold mb-0 lh-1">@ViewBag.FacturasEmitidas</h4>
                        <small class="text-success fw-bold" style="font-size: 0.7rem;"><i class="bi bi-arrow-up-short"></i>0.0%</small>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body d-flex align-items-center p-3">
                    <div class="rounded-3 d-flex align-items-center justify-content-center me-3" style="width: 48px; height: 48px; background-color: rgba(239, 68, 68, 0.1); color: #ef4444;">
                        <i class="bi bi-currency-dollar fs-5"></i>
                    </div>
                    <div>
                        <div class="text-secondary small fw-semibold mb-1" style="font-size: 0.75rem;">Ingresos Totales</div>
                        <h4 class="fw-bold mb-0 lh-1">S/. @(((decimal)ViewBag.IngresosTotales).ToString("N2"))</h4>
                        <small class="text-success fw-bold" style="font-size: 0.7rem;"><i class="bi bi-arrow-up-short"></i>0.0%</small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Toolbar -->
    <div class="d-flex justify-content-between align-items-center bg-white p-2 rounded-4 shadow-sm mb-4">
        <div class="ms-3">
            <span class="text-secondary small">Inicio / </span><span class="fw-bold text-dark small">Dashboard</span>
        </div>
        <div class="d-flex align-items-center">
            <div class="input-group me-4" style="width: 250px;">
                <span class="input-group-text bg-light border-0 rounded-start-pill py-1"><i class="bi bi-search text-secondary" style="font-size: 0.85rem;"></i></span>
                <input type="text" class="form-control bg-light border-0 rounded-end-pill py-1 text-secondary" style="font-size: 0.85rem;" placeholder="Buscar módulos...">
            </div>
            <div class="dropdown me-4">
                <div class="position-relative" style="cursor: pointer;" id="notificationBell" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="bi bi-bell text-secondary fs-5"></i>
                    <span class="position-absolute top-0 start-100 translate-middle p-1 bg-danger border border-white rounded-circle" style="width: 8px; height: 8px; margin-top: 4px; margin-left: -2px;">
                        <span class="visually-hidden">New alerts</span>
                    </span>
                </div>
                <ul class="dropdown-menu dropdown-menu-end shadow border-0 p-0 rounded-4 mt-2" aria-labelledby="notificationBell" style="width: 320px; font-size: 0.85rem; max-height: 400px; overflow-y: auto; z-index: 1050;">
                    <li class="p-3 border-bottom bg-light rounded-top-4" style="list-style: none;">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="fw-bold text-dark"><i class="bi bi-bell me-2 text-primary"></i>Notificaciones</span>
                            <span class="badge bg-primary rounded-pill">5 recientes</span>
                        </div>
                    </li>
                    <div id="notifications-list" style="max-height: 280px; overflow-y: auto;">
                        <div class="text-center py-4 text-secondary">
                            <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
                            Cargando...
                        </div>
                    </div>
                    <li class="p-2 border-top text-center rounded-bottom-4 bg-light" style="list-style: none;">
                        <a href="javascript:void(0)" onclick="if(window.loadContent) window.loadContent('/Sistema/Auditoria');" class="text-primary fw-bold text-decoration-none small">Ver bitácora completa</a>
                    </li>
                </ul>
            </div>
            <div class="d-flex align-items-center border-start ps-4 me-3">
                <div class="rounded-circle text-white d-flex align-items-center justify-content-center me-2 fw-bold" style="width: 32px; height: 32px; font-size: 0.8rem; background-color: #10b981;">AD</div>
                <div class="lh-1 text-start">
                    <div class="fw-bold text-dark" style="font-size: 0.85rem;">Administrador</div>
                    <small class="text-secondary" style="font-size: 0.65rem;">Super Admin</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Modules Grid -->
    <style>
        .module-card { transition: all 0.2s ease-in-out; cursor: pointer; }
        .module-card:hover { transform: translateY(-3px); box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1), 0 4px 6px -2px rgba(0,0,0,0.05) !important; }
        .module-icon { font-size: 1.4rem; }
    </style>
    <div class="row g-3">
        <!-- 1: Dashboard -->
        <div class="col-md-4 col-lg-3">
            <div class="card h-100 border-0 shadow-sm rounded-4 module-card">
                <div class="card-body d-flex flex-column p-4">
                    <div class="mb-3"><i class="bi bi-layout-text-window-reverse module-icon" style="color: #10b981;"></i></div>
                    <h6 class="fw-bold text-dark mb-1">Dashboard</h6>
                    <p class="text-secondary lh-sm mb-4 flex-grow-1" style="font-size: 0.8rem;">Panel principal con indicadores y resumen general.</p>
                    <div class="d-flex justify-content-between align-items-center mt-auto">
                        <span class="badge bg-light text-secondary rounded-pill px-3 py-2 fw-normal border" style="font-size: 0.65rem;">Resumen</span>
                        <i class="bi bi-arrow-right text-secondary" style="font-size: 0.8rem;"></i>
                    </div>
                </div>
            </div>
        </div>
        <!-- 2: Usuarios -->
        <div class="col-md-4 col-lg-3">
            <div class="card h-100 border-0 shadow-sm rounded-4 module-card">
                <div class="card-body d-flex flex-column p-4">
                    <div class="mb-3"><i class="bi bi-people module-icon" style="color: #10b981;"></i></div>
                    <h6 class="fw-bold text-dark mb-1">Usuarios</h6>
                    <p class="text-secondary lh-sm mb-4 flex-grow-1" style="font-size: 0.8rem;">Gestión de usuarios del sistema, altas, bajas y modificaciones.</p>
                    <div class="d-flex justify-content-between align-items-center mt-auto">
                        <span class="badge bg-light text-secondary rounded-pill px-3 py-2 fw-normal border" style="font-size: 0.65rem;">@ViewBag.UsuariosActivos @(ViewBag.UsuariosActivos == 1 ? "registro" : "registros")</span>
                        <i class="bi bi-arrow-right text-secondary" style="font-size: 0.8rem;"></i>
                    </div>
                </div>
            </div>
        </div>
        <!-- 3: Roles y Permisos -->
        <div class="col-md-4 col-lg-3">
            <div class="card h-100 border-0 shadow-sm rounded-4 module-card">
                <div class="card-body d-flex flex-column p-4">
                    <div class="mb-3"><i class="bi bi-shield-check module-icon" style="color: #10b981;"></i></div>
                    <h6 class="fw-bold text-dark mb-1">Roles y Permisos</h6>
                    <p class="text-secondary lh-sm mb-4 flex-grow-1" style="font-size: 0.8rem;">Administración de roles, permisos y niveles de acceso.</p>
                    <div class="d-flex justify-content-between align-items-center mt-auto">
                        <span class="badge bg-light text-secondary rounded-pill px-3 py-2 fw-normal border" style="font-size: 0.65rem;">@ViewBag.RolesCount @(ViewBag.RolesCount == 1 ? "rol" : "roles")</span>
                        <i class="bi bi-arrow-right text-secondary" style="font-size: 0.8rem;"></i>
                    </div>
                </div>
            </div>
        </div>
        <!-- 4: Clientes -->
        <div class="col-md-4 col-lg-3">
            <div class="card h-100 border-0 shadow-sm rounded-4 module-card">
                <div class="card-body d-flex flex-column p-4">
                    <div class="mb-3"><i class="bi bi-building module-icon text-primary"></i></div>
                    <h6 class="fw-bold text-dark mb-1">Clientes</h6>
                    <p class="text-secondary lh-sm mb-4 flex-grow-1" style="font-size: 0.8rem;">Directorio de clientes, historial comercial y contactos.</p>
                    <div class="d-flex justify-content-between align-items-center mt-auto">
                        <span class="badge bg-light text-secondary rounded-pill px-3 py-2 fw-normal border" style="font-size: 0.65rem;">@ViewBag.ClientesCount @(ViewBag.ClientesCount == 1 ? "cliente" : "clientes")</span>
                        <i class="bi bi-arrow-right text-secondary" style="font-size: 0.8rem;"></i>
                    </div>
                </div>
            </div>
        </div>
        <!-- 5: Proveedores -->
        <div class="col-md-4 col-lg-3">
            <div class="card h-100 border-0 shadow-sm rounded-4 module-card">
                <div class="card-body d-flex flex-column p-4">
                    <div class="mb-3"><i class="bi bi-truck module-icon text-primary"></i></div>
                    <h6 class="fw-bold text-dark mb-1">Proveedores</h6>
                    <p class="text-secondary lh-sm mb-4 flex-grow-1" style="font-size: 0.8rem;">Gestión de proveedores, catálogos and evaluaciones.</p>
                    <div class="d-flex justify-content-between align-items-center mt-auto">
                        <span class="badge bg-light text-secondary rounded-pill px-3 py-2 fw-normal border" style="font-size: 0.65rem;">@ViewBag.ProveedoresCount @(ViewBag.ProveedoresCount == 1 ? "proveedor" : "proveedores")</span>
                        <i class="bi bi-arrow-right text-secondary" style="font-size: 0.8rem;"></i>
                    </div>
                </div>
            </div>
        </div>
        <!-- 6: Productos -->
        <div class="col-md-4 col-lg-3">
            <div class="card h-100 border-0 shadow-sm rounded-4 module-card">
                <div class="card-body d-flex flex-column p-4">
                    <div class="mb-3"><i class="bi bi-box-seam module-icon text-warning"></i></div>
                    <h6 class="fw-bold text-dark mb-1">Productos</h6>
                    <p class="text-secondary lh-sm mb-4 flex-grow-1" style="font-size: 0.8rem;">Catálogo de productos y servicios, precios y categorías.</p>
                    <div class="d-flex justify-content-between align-items-center mt-auto">
                        <span class="badge bg-light text-secondary rounded-pill px-3 py-2 fw-normal border" style="font-size: 0.65rem;">@ViewBag.ProductosCount @(ViewBag.ProductosCount == 1 ? "ítem" : "ítems")</span>
                        <i class="bi bi-arrow-right text-secondary" style="font-size: 0.8rem;"></i>
                    </div>
                </div>
            </div>
        </div>
        <!-- 7: Ventas -->
        <div class="col-md-4 col-lg-3">
            <div class="card h-100 border-0 shadow-sm rounded-4 module-card">
                <div class="card-body d-flex flex-column p-4">
                    <div class="mb-3"><i class="bi bi-cart3 module-icon text-success"></i></div>
                    <h6 class="fw-bold text-dark mb-1">Ventas</h6>
                    <p class="text-secondary lh-sm mb-4 flex-grow-1" style="font-size: 0.8rem;">Órdenes de venta, cotizaciones y seguimiento de pedidos.</p>
                    <div class="d-flex justify-content-between align-items-center mt-auto">
                        <span class="badge bg-light text-secondary rounded-pill px-3 py-2 fw-normal border" style="font-size: 0.65rem;">@ViewBag.VentasMes @(ViewBag.VentasMes == 1 ? "orden" : "órdenes")</span>
                        <i class="bi bi-arrow-right text-secondary" style="font-size: 0.8rem;"></i>
                    </div>
                </div>
            </div>
        </div>
        <!-- 8: Compras -->
        <div class="col-md-4 col-lg-3">
            <div class="card h-100 border-0 shadow-sm rounded-4 module-card">
                <div class="card-body d-flex flex-column p-4">
                    <div class="mb-3"><i class="bi bi-bag module-icon text-success"></i></div>
                    <h6 class="fw-bold text-dark mb-1">Compras</h6>
                    <p class="text-secondary lh-sm mb-4 flex-grow-1" style="font-size: 0.8rem;">Órdenes de compra, recepciones y autorizaciones.</p>
                    <div class="d-flex justify-content-between align-items-center mt-auto">
                        <span class="badge bg-light text-secondary rounded-pill px-3 py-2 fw-normal border" style="font-size: 0.65rem;">@ViewBag.ComprasCount @(ViewBag.ComprasCount == 1 ? "orden" : "órdenes")</span>
                        <i class="bi bi-arrow-right text-secondary" style="font-size: 0.8rem;"></i>
                    </div>
                </div>
            </div>
        </div>
        <!-- 9: Facturación -->
        <div class="col-md-4 col-lg-3">
            <div class="card h-100 border-0 shadow-sm rounded-4 module-card">
                <div class="card-body d-flex flex-column p-4">
                    <div class="mb-3"><i class="bi bi-receipt module-icon text-danger"></i></div>
                    <h6 class="fw-bold text-dark mb-1">Facturación</h6>
                    <p class="text-secondary lh-sm mb-4 flex-grow-1" style="font-size: 0.8rem;">Emisión de facturas, notas de crédito y cobranza.</p>
                    <div class="d-flex justify-content-between align-items-center mt-auto">
                        <span class="badge bg-light text-secondary rounded-pill px-3 py-2 fw-normal border" style="font-size: 0.65rem;">@ViewBag.FacturasEmitidas @(ViewBag.FacturasEmitidas == 1 ? "factura" : "facturas")</span>
                        <i class="bi bi-arrow-right text-secondary" style="font-size: 0.8rem;"></i>
                    </div>
                </div>
            </div>
        </div>
        <!-- 10: Impuestos -->
        <div class="col-md-4 col-lg-3">
            <div class="card h-100 border-0 shadow-sm rounded-4 module-card">
                <div class="card-body d-flex flex-column p-4">
                    <div class="mb-3"><i class="bi bi-file-earmark-text module-icon text-warning"></i></div>
                    <h6 class="fw-bold text-dark mb-1">Impuestos</h6>
                    <p class="text-secondary lh-sm mb-4 flex-grow-1" style="font-size: 0.8rem;">Configuración tributaria, declaraciones y retenciones.</p>
                    <div class="d-flex justify-content-between align-items-center mt-auto">
                        <span class="badge bg-light text-secondary rounded-pill px-3 py-2 fw-normal border" style="font-size: 0.65rem;">@ViewBag.ImpuestosCount @(ViewBag.ImpuestosCount == 1 ? "tipo" : "tipos") configurados</span>
                        <i class="bi bi-arrow-right text-secondary" style="font-size: 0.8rem;"></i>
                    </div>
                </div>
            </div>
        </div>
        <!-- 11: Contabilidad -->
        <div class="col-md-4 col-lg-3">
            <div class="card h-100 border-0 shadow-sm rounded-4 module-card">
                <div class="card-body d-flex flex-column p-4">
                    <div class="mb-3"><i class="bi bi-calculator module-icon text-warning"></i></div>
                    <h6 class="fw-bold text-dark mb-1">Contabilidad</h6>
                    <p class="text-secondary lh-sm mb-4 flex-grow-1" style="font-size: 0.8rem;">Libros contables, asientos, plan de cuentas y cierres.</p>
                    <div class="d-flex justify-content-between align-items-center mt-auto">
                        <span class="badge bg-light text-secondary rounded-pill px-3 py-2 fw-normal border" style="font-size: 0.65rem;">Período activo</span>
                        <i class="bi bi-arrow-right text-secondary" style="font-size: 0.8rem;"></i>
                    </div>
                </div>
            </div>
        </div>
        <!-- 12: Caja y Bancos -->
        <div class="col-md-4 col-lg-3">
            <div class="card h-100 border-0 shadow-sm rounded-4 module-card">
                <div class="card-body d-flex flex-column p-4">
                    <div class="mb-3"><i class="bi bi-bank module-icon" style="color: #10b981;"></i></div>
                    <h6 class="fw-bold text-dark mb-1">Caja y Bancos</h6>
                    <p class="text-secondary lh-sm mb-4 flex-grow-1" style="font-size: 0.8rem;">Cuentas bancarias, conciliaciones y movimientos de caja.</p>
                    <div class="d-flex justify-content-between align-items-center mt-auto">
                        <span class="badge bg-light text-secondary rounded-pill px-3 py-2 fw-normal border" style="font-size: 0.65rem;">@ViewBag.CuentasBancariasCount @(ViewBag.CuentasBancariasCount == 1 ? "cuenta" : "cuentas")</span>
                        <i class="bi bi-arrow-right text-secondary" style="font-size: 0.8rem;"></i>
                    </div>
                </div>
            </div>
        </div>
        <!-- 13: Inventario -->
        <div class="col-md-4 col-lg-3">
            <div class="card h-100 border-0 shadow-sm rounded-4 module-card">
                <div class="card-body d-flex flex-column p-4">
                    <div class="mb-3"><i class="bi bi-archive module-icon text-warning"></i></div>
                    <h6 class="fw-bold text-dark mb-1">Inventario</h6>
                    <p class="text-secondary lh-sm mb-4 flex-grow-1" style="font-size: 0.8rem;">Stock, almacenes, entradas, salidas y ajustes.</p>
                    <div class="d-flex justify-content-between align-items-center mt-auto">
                        <span class="badge bg-light text-secondary rounded-pill px-3 py-2 fw-normal border" style="font-size: 0.65rem;">@ViewBag.AlmacenesCount @(ViewBag.AlmacenesCount == 1 ? "almacén" : "almacenes")</span>
                        <i class="bi bi-arrow-right text-secondary" style="font-size: 0.8rem;"></i>
                    </div>
                </div>
            </div>
        </div>
        <!-- 14: Recursos Humanos -->
        <div class="col-md-4 col-lg-3">
            <div class="card h-100 border-0 shadow-sm rounded-4 module-card">
                <div class="card-body d-flex flex-column p-4">
                    <div class="mb-3"><i class="bi bi-person-badge module-icon text-primary"></i></div>
                    <h6 class="fw-bold text-dark mb-1">Recursos Humanos</h6>
                    <p class="text-secondary lh-sm mb-4 flex-grow-1" style="font-size: 0.8rem;">Empleados, contratos, asistencias y evaluaciones.</p>
                    <div class="d-flex justify-content-between align-items-center mt-auto">
                        <span class="badge bg-light text-secondary rounded-pill px-3 py-2 fw-normal border" style="font-size: 0.65rem;">@ViewBag.EmpleadosCount @(ViewBag.EmpleadosCount == 1 ? "empleado" : "empleados")</span>
                        <i class="bi bi-arrow-right text-secondary" style="font-size: 0.8rem;"></i>
                    </div>
                </div>
            </div>
        </div>
        <!-- 15: Nómina -->
        <div class="col-md-4 col-lg-3">
            <div class="card h-100 border-0 shadow-sm rounded-4 module-card">
                <div class="card-body d-flex flex-column p-4">
                    <div class="mb-3"><i class="bi bi-cash-coin module-icon text-primary"></i></div>
                    <h6 class="fw-bold text-dark mb-1">Nómina</h6>
                    <p class="text-secondary lh-sm mb-4 flex-grow-1" style="font-size: 0.8rem;">Cálculo de salarios, deducciones, prestaciones y pagos.</p>
                    <div class="d-flex justify-content-between align-items-center mt-auto">
                        <span class="badge bg-light text-secondary rounded-pill px-3 py-2 fw-normal border" style="font-size: 0.65rem;">Mayo 2026</span>
                        <i class="bi bi-arrow-right text-secondary" style="font-size: 0.8rem;"></i>
                    </div>
                </div>
            </div>
        </div>
        <!-- 16: Proyectos -->
        <div class="col-md-4 col-lg-3">
            <div class="card h-100 border-0 shadow-sm rounded-4 module-card">
                <div class="card-body d-flex flex-column p-4">
                    <div class="mb-3"><i class="bi bi-kanban module-icon text-primary"></i></div>
                    <h6 class="fw-bold text-dark mb-1">Proyectos</h6>
                    <p class="text-secondary lh-sm mb-4 flex-grow-1" style="font-size: 0.8rem;">Gestión de proyectos, tareas, avances y recursos asignados.</p>
                    <div class="d-flex justify-content-between align-items-center mt-auto">
                        <span class="badge bg-light text-secondary rounded-pill px-3 py-2 fw-normal border" style="font-size: 0.65rem;">@ViewBag.ProyectosCount @(ViewBag.ProyectosCount == 1 ? "proyecto" : "proyectos")</span>
                        <i class="bi bi-arrow-right text-secondary" style="font-size: 0.8rem;"></i>
                    </div>
                </div>
            </div>
        </div>
        <!-- 17: Activos Fijos -->
        <div class="col-md-4 col-lg-3">
            <div class="card h-100 border-0 shadow-sm rounded-4 module-card">
                <div class="card-body d-flex flex-column p-4">
                    <div class="mb-3"><i class="bi bi-layers module-icon text-secondary"></i></div>
                    <h6 class="fw-bold text-dark mb-1">Activos Fijos</h6>
                    <p class="text-secondary lh-sm mb-4 flex-grow-1" style="font-size: 0.8rem;">Registro, depreciación y control de activos de la empresa.</p>
                    <div class="d-flex justify-content-between align-items-center mt-auto">
                        <span class="badge bg-light text-secondary rounded-pill px-3 py-2 fw-normal border" style="font-size: 0.65rem;">@ViewBag.ActivosFijosCount @(ViewBag.ActivosFijosCount == 1 ? "activo" : "activos")</span>
                        <i class="bi bi-arrow-right text-secondary" style="font-size: 0.8rem;"></i>
                    </div>
                </div>
            </div>
        </div>
        <!-- 18: Reportes -->
        <div class="col-md-4 col-lg-3">
            <div class="card h-100 border-0 shadow-sm rounded-4 module-card">
                <div class="card-body d-flex flex-column p-4">
                    <div class="mb-3"><i class="bi bi-bar-chart module-icon" style="color: #6366f1;"></i></div>
                    <h6 class="fw-bold text-dark mb-1">Reportes</h6>
                    <p class="text-secondary lh-sm mb-4 flex-grow-1" style="font-size: 0.8rem;">Generación de reportes, estadísticas y exportación de datos.</p>
                    <div class="d-flex justify-content-between align-items-center mt-auto">
                        <span class="badge bg-light text-secondary rounded-pill px-3 py-2 fw-normal border" style="font-size: 0.65rem;">Disponible</span>
                        <i class="bi bi-arrow-right text-secondary" style="font-size: 0.8rem;"></i>
                    </div>
                </div>
            </div>
        </div>
        <!-- 19: Auditoría -->
        <div class="col-md-4 col-lg-3">
            <div class="card h-100 border-0 shadow-sm rounded-4 module-card">
                <div class="card-body d-flex flex-column p-4">
                    <div class="mb-3"><i class="bi bi-journal-check module-icon" style="color: #6366f1;"></i></div>
                    <h6 class="fw-bold text-dark mb-1">Auditoría</h6>
                    <p class="text-secondary lh-sm mb-4 flex-grow-1" style="font-size: 0.8rem;">Registro de actividad del sistema, trazabilidad y logs.</p>
                    <div class="d-flex justify-content-between align-items-center mt-auto">
                        <span class="badge bg-light text-secondary rounded-pill px-3 py-2 fw-normal border" style="font-size: 0.65rem;">Sistema activo</span>
                        <i class="bi bi-arrow-right text-secondary" style="font-size: 0.8rem;"></i>
                    </div>
                </div>
            </div>
        </div>
        <!-- 20: Configuración -->
        <div class="col-md-4 col-lg-3">
            <div class="card h-100 border-0 shadow-sm rounded-4 module-card">
                <div class="card-body d-flex flex-column p-4">
                    <div class="mb-3"><i class="bi bi-gear module-icon" style="color: #6366f1;"></i></div>
                    <h6 class="fw-bold text-dark mb-1">Configuración</h6>
                    <p class="text-secondary lh-sm mb-4 flex-grow-1" style="font-size: 0.8rem;">Parámetros generales del sistema, empresa y preferencias.</p>
                    <div class="d-flex justify-content-between align-items-center mt-auto">
                        <span class="badge bg-light text-secondary rounded-pill px-3 py-2 fw-normal border" style="font-size: 0.65rem;">Sistema activo</span>
                        <i class="bi bi-arrow-right text-secondary" style="font-size: 0.8rem;"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        const urlMap = {
            'dashboard': '/Principal/Index',
            'usuarios': '/Gestion/Index',
            'roles y permisos': '/Gestion/RolesPermisos',
            'clientes': '/Comercial/Clientes',
            'proveedores': '/Comercial/Proveedores',
            'productos': '/Comercial/Productos',
            'ventas': '/Operaciones/Ventas',
            'compras': '/Operaciones/Compras',
            'facturación': '/Operaciones/Facturacion',
            'impuestos': '/Finanzas/Impuestos',
            'contabilidad': '/Finanzas/Contabilidad',
            'caja y bancos': '/Finanzas/Caja_y_Bancos',
            'inventario': '/Operaciones/Inventario',
            'recursos humanos': '/RRHH/Recursos',
            'nómina': '/Nomina',
            'proyectos': '/Operaciones/Proyectos',
            'activos fijos': '/Finanzas/ActivosFijos',
            'reportes': '/Sistema/Reportes',
            'auditoría': '/Sistema/Auditoria',
            'configuración': '/Sistema/Configuracion'
        };

        $('.module-card').on('click', function () {
            const title = $(this).find('h6').text().trim().toLowerCase();
            const url = urlMap[title];
            if (url && window.loadContent) {
                window.loadContent(url);
            }
        });

        // Initialize notification dropdown toggle and load dynamic contents
        var bellEl = document.getElementById('notificationBell');
        if (bellEl) {
            bellEl.addEventListener('click', function (e) {
                cargarNotificaciones();
            });
        }

        function cargarNotificaciones() {
            $('#notifications-list').html(`
                <div class="text-center py-4 text-secondary">
                    <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
                    Cargando...
                </div>
            `);
            $.ajax({
                url: '/Principal/GetNotifications',
                type: 'GET',
                success: function (data) {
                    let html = '';
                    if (!data || data.length === 0) {
                        html = '<div class="text-center py-4 text-secondary small">No hay notificaciones recientes.</div>';
                    } else {
                        data.forEach(item => {
                            let actionBadge = '';
                            if (item.accion === 'insert') actionBadge = '<span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill" style="font-size: 0.65rem;">Creado</span>';
                            else if (item.accion === 'update') actionBadge = '<span class="badge bg-warning-subtle text-warning border border-warning-subtle rounded-pill" style="font-size: 0.65rem;">Modificado</span>';
                            else if (item.accion === 'delete') actionBadge = '<span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill" style="font-size: 0.65rem;">Eliminado</span>';
                            else actionBadge = `<span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill" style="font-size: 0.65rem;">${item.accion}</span>`;

                            html += `
                                <li class="p-3 border-bottom border-light" style="list-style: none;">
                                    <div class="d-flex justify-content-between align-items-start mb-1">
                                        <span class="fw-semibold text-dark small" style="font-size: 0.8rem;">${item.usuario}</span>
                                        ${actionBadge}
                                    </div>
                                    <div class="text-secondary small mb-1" style="font-size: 0.75rem; white-space: normal;">
                                        Cambio en tabla <strong>${item.tablaAfectada}</strong>
                                    </div>
                                    <div class="text-muted" style="font-size: 0.65rem;">
                                        <i class="bi bi-clock me-1"></i>${item.fechaRegistro}
                                    </div>
                                </li>
                            `;
                        });
                    }
                    $('#notifications-list').html(html);
                },
                error: function (xhr) {
                    console.error("Error loading notifications:", xhr);
                    $('#notifications-list').html('<div class="text-center py-4 text-danger small"><i class="bi bi-exclamation-circle me-1"></i>Error al cargar.</div>');
                }
            });
        }
    });
</script>
