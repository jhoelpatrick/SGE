@Html.AntiForgeryToken()
@{
    ViewData["Title"] = "Gestión de Ventas";
}

<!-- Cargar Chart.js para el gráfico de tendencia -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<style>
    .font-system {
        font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }
    .kpi-card {
        transition: transform 0.2s, box-shadow 0.2s;
        border: 1px solid #e2e8f0;
    }
    .kpi-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.05) !important;
    }
    .tab-btn {
        transition: all 0.2s;
        border-radius: 8px !important;
        border: none;
        color: #64748b;
    }
    .tab-btn.active {
        background-color: #0f766e !important;
        color: white !important;
    }
    .btn-teal {
        background-color: #0d9488;
        color: white;
        border: none;
    }
    .btn-teal:hover {
        background-color: #0f766e;
        color: white;
    }
    .btn-outline-teal {
        color: #0d9488;
        border: 1px solid #0d9488;
        background: transparent;
    }
    .btn-outline-teal:hover {
        background-color: #0d9488;
        color: white;
    }
    .badge-aprobado { background-color: #e0f2fe; color: #0369a1; }
    .badge-cancelado { background-color: #fee2e2; color: #b91c1c; }
    .badge-pendiente { background-color: #fef3c7; color: #d97706; }
    .badge-despachado { background-color: #dcfce7; color: #15803d; }
    .badge-facturado { background-color: #faf5ff; color: #6b21a8; }
</style>

<div class="px-4 py-3 font-system">
    
    <!-- CABECERA -->
    <div class="d-flex justify-content-between align-items-center mb-4 mt-2">
        <div>
            <h2 class="fw-bold mb-1" style="color: #0c675e;"><i class="bi bi-cart3 me-2"></i>Módulo de Ventas</h2>
            <p class="text-secondary small mb-0">Gestión de pedidos y transacciones comerciales · Límite de crédito · Reglas de descuentos</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-sm btn-outline-secondary px-3 py-1.5 rounded-3 fw-semibold bg-white" onclick="window.loadContent('/Principal/Index')">
                <i class="bi bi-arrow-left"></i> Dashboard
            </button>
            <button class="btn btn-sm btn-teal px-3 py-1.5 rounded-3 fw-semibold" onclick="VentasView.switchTab('new-order')">
                <i class="bi bi-plus-lg"></i> Registrar Pedido
            </button>
        </div>
    </div>

    <!-- Pestañas de Navegación -->
    <ul class="nav nav-pills gap-2 mb-4 p-1 bg-white rounded-3 shadow-sm d-none" style="max-width: fit-content;">
        <li class="nav-item">
            <button class="btn btn-sm px-4 py-2 fw-semibold active tab-btn" id="orders-tab" onclick="VentasView.switchTab('orders')">Bandeja</button>
        </li>
        <li class="nav-item">
            <button class="btn btn-sm px-4 py-2 fw-semibold tab-btn" id="new-order-tab" onclick="VentasView.switchTab('new-order')">Nuevo</button>
        </li>
    </ul>

    <!-- BANDEJA DE PEDIDOS -->
    <div id="view-orders">
        <!-- KPIs Row -->
        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <div class="card border-0 shadow-sm rounded-4 h-100 kpi-card">
                    <div class="card-body d-flex align-items-center p-3">
                        <div class="rounded-3 d-flex align-items-center justify-content-center me-3" style="width: 48px; height: 48px; background-color: rgba(13, 148, 136, 0.1); color: #0d9488;">
                            <i class="bi bi-cash-stack fs-4"></i>
                        </div>
                        <div>
                            <div class="text-secondary small fw-semibold mb-1" style="font-size: 0.7rem;">TOTAL DEL MES</div>
                            <h4 class="fw-bold mb-0 lh-1" id="sales-kpi-total">S/. 0.00</h4>
                            <small class="text-success fw-bold" style="font-size: 0.65rem;">+12.4%</small>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm rounded-4 h-100 kpi-card">
                    <div class="card-body d-flex align-items-center p-3">
                        <div class="rounded-3 d-flex align-items-center justify-content-center me-3" style="width: 48px; height: 48px; background-color: rgba(245, 158, 11, 0.1); color: #f59e0b;">
                            <i class="bi bi-hourglass-split fs-4"></i>
                        </div>
                        <div>
                            <div class="text-secondary small fw-semibold mb-1" style="font-size: 0.7rem;">PEDIDOS PENDIENTES</div>
                            <h4 class="fw-bold mb-0 lh-1" id="sales-kpi-pending">0</h4>
                            <small class="text-warning fw-semibold" style="font-size: 0.65rem;">Requieren atención</small>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm rounded-4 h-100 kpi-card">
                    <div class="card-body d-flex align-items-center p-3">
                        <div class="rounded-3 d-flex align-items-center justify-content-center me-3" style="width: 48px; height: 48px; background-color: rgba(16, 185, 129, 0.1); color: #10b981;">
                            <i class="bi bi-check-circle fs-4"></i>
                        </div>
                        <div>
                            <div class="text-secondary small fw-semibold mb-1" style="font-size: 0.7rem;">PEDIDOS APROBADOS</div>
                            <h4 class="fw-bold mb-0 lh-1" id="sales-kpi-dispatched">0</h4>
                            <small class="text-success fw-semibold" style="font-size: 0.65rem;">Este mes</small>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm rounded-4 h-100 kpi-card">
                    <div class="card-body d-flex align-items-center p-3">
                        <div class="rounded-3 d-flex align-items-center justify-content-center me-3" style="width: 48px; height: 48px; background-color: rgba(59, 130, 246, 0.1); color: #3b82f6;">
                            <i class="bi bi-graph-up fs-4"></i>
                        </div>
                        <div>
                            <div class="text-secondary small fw-semibold mb-1" style="font-size: 0.7rem;">VARIACIÓN</div>
                            <h4 class="fw-bold mb-0 lh-1" id="sales-kpi-ticket">0%</h4>
                            <small class="text-secondary" style="font-size: 0.65rem;">vs mes anterior</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 2-Column Layout (Chart & Sidebar) -->
        <div class="row g-4 mb-4">
            <!-- Chart Container -->
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white" style="border: 1px solid #e2e8f0; height: 100%;">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <h5 class="fw-bold mb-1" style="color: #0f172a;">Tendencia de ingresos</h5>
                            <p class="text-secondary small mb-0">Evolución de ventas en el período seleccionado</p>
                        </div>
                        <div class="btn-group" role="group">
                            <button type="button" class="btn btn-sm btn-outline-secondary px-3 active" id="btn-chart-semanal" style="font-size: 0.75rem;">Semanal</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary px-3" id="btn-chart-mensual" style="font-size: 0.75rem;">Mensual</button>
                        </div>
                    </div>
                    <div class="flex-grow-1" style="position: relative; min-height: 220px;">
                        <canvas id="salesTrendChart"></canvas>
                    </div>
                </div>
            </div>

            <!-- Credit Limit / Rules Sidebar -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white d-flex flex-column justify-content-between" style="border: 1px solid #e2e8f0; height: 100%;">
                    <div>
                        <h5 class="fw-bold mb-1" style="color: #0f172a;"><i class="bi bi-shield-check me-1.5 text-teal"></i>Línea de Crédito & Reglas</h5>
                        <p class="text-secondary small mb-3">Comprobación de solvencia de clientes top en tiempo real.</p>
                        
                        <!-- Client Credit 1 -->
                        <div class="mb-3">
                            <div class="d-flex justify-content-between mb-1" style="font-size: 0.8rem;">
                                <span class="fw-semibold text-slate">Distribuidora Norte SAC</span>
                                <span class="text-danger fw-bold">Disponible: S/. 2,500</span>
                            </div>
                            <div class="progress" style="height: 6px;">
                                <div class="progress-bar bg-danger" role="progressbar" style="width: 85%"></div>
                            </div>
                        </div>

                        <!-- Client Credit 2 -->
                        <div class="mb-3">
                            <div class="d-flex justify-content-between mb-1" style="font-size: 0.8rem;">
                                <span class="fw-semibold text-slate">Megacom Distribuciones</span>
                                <span class="text-success fw-bold">Disponible: S/. 65,000</span>
                            </div>
                            <div class="progress" style="height: 6px;">
                                <div class="progress-bar bg-success" role="progressbar" style="width: 30%"></div>
                            </div>
                        </div>
                    </div>

                    <!-- Discount rules box -->
                    <div class="rounded-3 p-3 mt-2" style="background-color: #f0fdf4; border: 1px solid #bbf7d0;">
                        <div class="small fw-bold text-success mb-1.5"><i class="bi bi-tag-fill me-1"></i> Descuentos Corporativos:</div>
                        <ul class="mb-0 ps-3 text-success" style="font-size: 0.75rem; line-height: 1.4;">
                            <li>Automático del 10% por volumen (monto >= S/. 8,000).</li>
                            <li>Cupón nacional del 15% de descuento especial.</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <!-- CRUD Grid / Table Card -->
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white" style="border: 1px solid #e2e8f0;">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h5 class="fw-bold mb-1" style="color: #0f172a;">Gestión de Pedidos</h5>
                    <p class="text-secondary small mb-0">CRUD visual — Registro, descuento automatizado y conciliación de pagos</p>
                </div>
                <div class="d-flex gap-2">
                    <input type="text" class="form-control form-control-sm rounded-3 bg-light border-0 px-3" id="search-order" placeholder="Buscar por número o cliente..." style="width: 250px;">
                    <select class="form-select form-select-sm rounded-3 bg-light border-0" id="filter-state" style="width: 150px;">
                        <option value="todos">Todos los Estados</option>
                        <option value="pendiente">Pendiente</option>
                        <option value="aprobado">Aprobado</option>
                        <option value="despachado">Despachado</option>
                        <option value="cancelado">Cancelado</option>
                    </select>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-secondary small text-uppercase" style="background-color: #f8fafc;">
                        <tr>
                            <th class="border-0 px-3">Nº Pedido</th>
                            <th class="border-0">Cliente</th>
                            <th class="border-0">Fecha</th>
                            <th class="border-0">Moneda</th>
                            <th class="border-0 text-end">Subtotal</th>
                            <th class="border-0 text-end">Descuento</th>
                            <th class="border-0 text-end">Total Neto</th>
                            <th class="border-0">Método Pago</th>
                            <th class="border-0 text-center">Estado</th>
                            <th class="border-0 text-end px-3">Acciones</th>
                        </tr>
                    </thead>
                    <tbody id="orders-table-body" class="small">
                        <!-- Pedidos dinámicos -->
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- REGISTRAR PEDIDO -->
    <div id="view-new-order" class="d-none">
        <div class="row g-4">
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white" style="border: 1px solid #e2e8f0;">
                    <h5 class="fw-bold mb-4 text-slate"><i class="bi bi-clipboard2-data me-2 text-teal"></i>Datos Generales de la Operación</h5>
                    
                    <form id="new-order-form">
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold text-secondary">Cliente</label>
                                <select class="form-select rounded-3" id="ord-client" required></select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold text-secondary">Proyecto Vinculado (Opcional)</label>
                                <select class="form-select rounded-3" id="ord-project">
                                    <option value="">-- Sin Proyecto Asociado --</option>
                                </select>
                            </div>
                        </div>

                        <div class="row mb-4">
                            <div class="col-md-4">
                                <label class="form-label small fw-semibold text-secondary">Moneda</label>
                                <select class="form-select rounded-3" id="ord-currency" onchange="VentasView.updateExchangeRate()">
                                    <option value="PEN">Soles (PEN)</option>
                                    <option value="USD">Dólares (USD)</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-semibold text-secondary">Tipo Cambio</label>
                                <input type="number" step="0.0001" class="form-control rounded-3 bg-light" id="ord-tc" value="1.0000" readonly>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-semibold text-secondary">Método de Pago</label>
                                <select class="form-select rounded-3" id="ord-payment">
                                    <option value="credito">Crédito a 30 días</option>
                                    <option value="transferencia">Transferencia Bancaria</option>
                                    <option value="visa">Tarjeta VISA / MC</option>
                                    <option value="efectivo">Efectivo</option>
                                </select>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-3 pt-3 border-top">
                            <h6 class="fw-bold text-slate mb-0"><i class="bi bi-box-seam me-2 text-teal"></i>Detalle de Artículos y Servicios</h6>
                            <button type="button" class="btn btn-sm btn-outline-teal d-flex align-items-center gap-1 px-3 py-1.5 rounded-3 fw-semibold" onclick="VentasView.addOrderItemRow()">
                                <i class="bi bi-plus-lg"></i> Agregar Fila
                            </button>
                        </div>

                        <div class="table-responsive">
                            <table class="table align-middle">
                                <thead class="small text-secondary text-uppercase bg-light">
                                    <tr>
                                        <th class="border-0 px-2" style="width: 45%;">Producto / Servicio</th>
                                        <th class="border-0 text-center" style="width: 10%;">U.M.</th>
                                        <th class="border-0 text-center" style="width: 15%;">Cantidad</th>
                                        <th class="border-0 text-end" style="width: 15%;">P. Unit. (con IGV)</th>
                                        <th class="border-0 text-end" style="width: 10%;">Dcto. (S/)</th>
                                        <th class="border-0 text-end px-2" style="width: 5%;"></th>
                                    </tr>
                                </thead>
                                <tbody id="order-items-tbody"></tbody>
                            </table>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Importes Panel -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 p-4 text-slate h-100 bg-white d-flex flex-column justify-content-between" style="border: 1px solid #e2e8f0;">
                    <div>
                        <h5 class="fw-bold mb-4"><i class="bi bi-calculator-fill me-2 text-teal"></i>Resumen de Importes</h5>
                        
                        <div class="d-flex justify-content-between small text-secondary mb-2">
                            <span>Subtotal (Sin IGV)</span>
                            <span id="sum-subtotal">S/ 0.00</span>
                        </div>
                        <div class="d-flex justify-content-between small text-secondary mb-2">
                            <span>Descuentos Totales</span>
                            <span id="sum-discount" class="text-danger">- S/ 0.00</span>
                        </div>
                        <div class="d-flex justify-content-between small text-secondary mb-2">
                            <span>Impuesto IGV (18%)</span>
                            <span id="sum-igv">S/ 0.00</span>
                        </div>
                        <hr class="my-3">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <span class="fw-bold">TOTAL NETO</span>
                            <span class="fs-4 fw-bold text-teal" id="sum-total">S/ 0.00</span>
                        </div>

                        <div id="stock-warning-box" class="alert alert-warning border-0 rounded-3 small d-none">
                            <i class="bi bi-exclamation-triangle-fill me-1"></i> Uno o más productos seleccionados tienen stock insuficiente. Se comprometerá stock negativo temporal.
                        </div>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="button" class="btn btn-teal py-2.5 fw-bold rounded-3 shadow-sm text-white" onclick="VentasView.submitOrder()">
                            <i class="bi bi-check-circle-fill me-1.5"></i> Registrar Orden de Venta
                        </button>
                        <button type="button" class="btn btn-light py-2 rounded-3 border fw-semibold text-secondary" onclick="VentasView.switchTab('orders')">
                            Cancelar
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- MODAL: DETALLE DEL PEDIDO -->
<div class="modal fade" id="orderDetailModal" tabindex="-1" aria-labelledby="orderDetailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-bottom-0 pb-0">
                <div>
                    <h5 class="modal-title fw-bold text-slate mb-1" id="orderDetailModalLabel">Pedido: PED-2026-000</h5>
                    <span class="badge text-uppercase fw-semibold" id="detail-order-status">Pendiente</span>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body pt-3">
                <div class="d-flex justify-content-between align-items-center mb-4 px-4 py-2.5 bg-light rounded-3 text-center timeline-container" style="border: 1px solid #e2e8f0;">
                    <div class="timeline-step active" id="step-registrado">
                        <div class="step-icon"><i class="bi bi-file-earmark-plus"></i></div>
                        <div class="step-label">Registrado</div>
                    </div>
                    <div class="timeline-connector" id="conn-1"></div>
                    <div class="timeline-step" id="step-aprobado">
                        <div class="step-icon"><i class="bi bi-check-circle"></i></div>
                        <div class="step-label">Aprobado</div>
                    </div>
                    <div class="timeline-connector" id="conn-2"></div>
                    <div class="timeline-step" id="step-despachado">
                        <div class="step-icon"><i class="bi bi-truck"></i></div>
                        <div class="step-label">Despachado</div>
                    </div>
                    <div class="timeline-connector" id="conn-3"></div>
                    <div class="timeline-step" id="step-facturado">
                        <div class="step-icon"><i class="bi bi-receipt"></i></div>
                        <div class="step-label">Facturado</div>
                    </div>
                </div>

                <div class="row g-3 mb-4 small">
                    <div class="col-md-6 border-end">
                        <div class="text-secondary fw-semibold">Información del Cliente</div>
                        <div class="fw-bold text-dark mt-1" id="detail-client-name">-</div>
                        <div class="text-secondary" id="detail-client-doc">-</div>
                        <div class="text-secondary" id="detail-client-email">-</div>
                    </div>
                    <div class="col-md-6 ps-md-4">
                        <div class="text-secondary fw-semibold">Detalles del Documento</div>
                        <div class="mt-1">Moneda: <strong id="detail-order-currency" class="text-dark">-</strong></div>
                        <div>Método Pago: <strong id="detail-order-payment" class="text-dark">-</strong></div>
                        <div>Proyecto: <strong id="detail-order-project" class="text-teal">-</strong></div>
                    </div>
                </div>

                <div class="table-responsive mb-3">
                    <table class="table table-sm align-middle">
                        <thead class="bg-light small text-secondary">
                            <tr>
                                <th class="border-0 px-2">SKU / Descripción</th>
                                <th class="border-0 text-center" style="width: 10%;">Cant.</th>
                                <th class="border-0 text-end" style="width: 20%;">P. Unit. (c/ IGV)</th>
                                <th class="border-0 text-end" style="width: 15%;">Dcto.</th>
                                <th class="border-0 text-end px-2" style="width: 25%;">Total</th>
                            </tr>
                        </thead>
                        <tbody id="detail-order-items-tbody" class="small"></tbody>
                    </table>
                </div>

                <div class="row pt-2 border-top">
                    <div class="col-md-6">
                        <div class="alert alert-info py-2 px-3 border-0 rounded-3 small d-none" id="detail-dispatch-info"></div>
                    </div>
                    <div class="col-md-6 text-end">
                        <div class="small text-secondary mb-1">Subtotal: <span class="text-dark" id="detail-sum-subtotal">S/ 0.00</span></div>
                        <div class="small text-secondary mb-1">IGV (18%): <span class="text-dark" id="detail-sum-igv">S/ 0.00</span></div>
                        <div class="fw-bold">Total Neto: <span class="text-teal fs-5" id="detail-sum-total">S/ 0.00</span></div>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-top-0 pt-0">
                <button type="button" class="btn btn-light rounded-3 fw-semibold px-4" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<!-- MODAL: DESPACHAR PEDIDO -->
<div class="modal fade" id="dispatchOrderModal" tabindex="-1" aria-labelledby="dispatchOrderModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title fw-bold text-slate" id="dispatchOrderModalLabel">Despachar Pedido</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body pt-3">
                <form id="dispatch-form">
                    <input type="hidden" id="dispatch-pedido-id">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Pedido Seleccionado</label>
                        <input type="text" class="form-control rounded-3 bg-light" id="dispatch-pedido-num" readonly>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Vehículo del Proveedor (Transporte)</label>
                        <select class="form-select rounded-3" id="dispatch-vehicle" required></select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Conductor Asignado</label>
                        <select class="form-select rounded-3" id="dispatch-driver" required></select>
                    </div>
                    <div class="row mb-3">
                        <div class="col">
                            <label class="form-label small fw-semibold text-secondary">Serie Guía Remisión</label>
                            <input type="text" class="form-control rounded-3" id="dispatch-guia-serie" value="T001" maxlength="4" required>
                        </div>
                        <div class="col">
                            <label class="form-label small fw-semibold text-secondary">Correlativo Guía</label>
                            <input type="text" class="form-control rounded-3" id="dispatch-guia-correlativo" placeholder="Ej. 00000053" required>
                        </div>
                    </div>
                    <div class="text-end pt-2 border-top">
                        <button type="button" class="btn btn-light rounded-3 fw-semibold px-4 me-2" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-teal rounded-3 fw-semibold px-4 text-white">Confirmar Despacho</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    /* Timeline styling */
    .timeline-step {
        flex: 1;
        position: relative;
    }
    .step-icon {
        width: 36px;
        height: 36px;
        background-color: #e2e8f0;
        color: #64748b;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 5px auto;
        font-size: 1.1rem;
        transition: all 0.3s;
    }
    .step-label {
        font-size: 0.65rem;
        font-weight: 600;
        color: #64748b;
    }
    .timeline-connector {
        flex-grow: 1;
        height: 3px;
        background-color: #e2e8f0;
        margin-top: -16px;
    }
    .timeline-step.active .step-icon {
        background-color: #0d9488;
        color: white;
    }
    .timeline-step.active .step-label {
        color: #0d9488;
    }
    .timeline-connector.completed {
        background-color: #0d9488;
    }
</style>

<script>
(function() {

    const _rvt = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
    let _ventas = [];
    let _clientes = [];
    let _proyectos = [];
    let _productos = [];
    let trendChart = null;

    async function apiGet(url) {
        const res = await fetch(url);
        return res.json();
    }

    async function apiPost(url, body) {
        const res = await fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': _rvt },
            body: JSON.stringify(body)
        });
        return res.json();
    }

    function showAlert(msg, type = 'success') {
        const el = $(`<div class="alert alert-${type} alert-dismissible fade show position-fixed bottom-0 end-0 m-3 shadow" role="alert" style="z-index:9999;min-width:280px;">${msg}<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>`);
        $('body').append(el);
        setTimeout(() => el.alert('close'), 4000);
    }

    $(document).ready(function () {
        initPage();

        $('#search-order, #filter-state').on('change keyup', function () {
            renderOrdersTable();
        });

        $('#btn-chart-semanal').on('click', function() {
            $('.btn-group button').removeClass('active');
            $(this).addClass('active');
            updateChartData('semanal');
        });

        $('#btn-chart-mensual').on('click', function() {
            $('.btn-group button').removeClass('active');
            $(this).addClass('active');
            updateChartData('mensual');
        });

        $('#dispatch-form').on('submit', async function (e) {
            e.preventDefault();
            const payload = {
                pedId: parseInt($('#dispatch-pedido-id').val()),
                vehId: parseInt($('#dispatch-vehicle').val()),
                condId: parseInt($('#dispatch-driver').val()),
                serie: $('#dispatch-guia-serie').val(),
                correlativo: $('#dispatch-guia-correlativo').val()
            };
            try {
                const res = await apiPost('/Operaciones/DispatchPedido', payload);
                if (res.ok) {
                    $('#dispatchOrderModal').modal('hide');
                    showAlert('Despacho registrado exitosamente.');
                    await loadData();
                } else {
                    showAlert(res.error || 'Error al despachar.', 'danger');
                }
            } catch (err) {
                showAlert('Error de conexión.', 'danger');
            }
        });
    });

    async function initPage() {
        try {
            const resC = await apiGet('/Comercial/GetClientesJson');
            if (resC.ok) {
                _clientes = resC.data;
                const ordClient = $('#ord-client').empty();
                _clientes.forEach(c => {
                    ordClient.append(`<option value="${c.clienteId}">${c.razonSocial}</option>`);
                });
            }
        } catch (e) { showAlert('No se pudieron cargar los clientes.', 'warning'); }

        try {
            const resP = await apiGet('/Operaciones/GetProyectosJson');
            if (resP.ok) {
                _proyectos = resP.data;
                const ordProj = $('#ord-project').empty().append('<option value="">-- Sin Proyecto Asociado --</option>');
                _proyectos.forEach(p => ordProj.append(`<option value="${p.proyectoId}">${p.nombreProyecto}</option>`));
            }
        } catch (e) { showAlert('No se pudieron cargar los proyectos.', 'warning'); }

        try {
            const resProd = await apiGet('/Comercial/GetProductosJson');
            if (resProd.ok) _productos = resProd.data;
        } catch (e) { showAlert('No se pudieron cargar los productos.', 'warning'); }

        try {
            const resV = await apiGet('/Operaciones/GetVehiculosJson');
            if (resV.ok) {
                const vSelect = $('#dispatch-vehicle').empty();
                resV.data.forEach(v => vSelect.append(`<option value="${v.vehiculoId}">${v.placa} - ${v.marca} (${v.proveedorNombre})</option>`));
            }
            const resD = await apiGet('/Operaciones/GetConductoresJson');
            if (resD.ok) {
                const dSelect = $('#dispatch-driver').empty();
                resD.data.forEach(d => dSelect.append(`<option value="${d.conductorId}">${d.nombre} (DNI ${d.numeroDocumento})</option>`));
            }
        } catch (e) { showAlert('No se pudieron cargar vehículos/conductores.', 'warning'); }

        $('#dispatch-guia-correlativo').val('00000001');
        $('#order-items-tbody').empty();
        addOrderItemRow();

        await loadData();
        initChart();
    }

    async function loadData() {
        try {
            const res = await apiGet('/Operaciones/GetVentasJson');
            if (res.ok) _ventas = res.data;
            else showAlert(res.error, 'danger');
        } catch (e) { showAlert('Error al cargar ventas.', 'danger'); }
        renderDashboard();
    }

    function renderDashboard() {
        const totalBilled = _ventas
            .filter(v => v.estado === 'aprobado' || v.estado === 'despachado' || v.estado === 'facturado')
            .reduce((acc, curr) => acc + parseFloat(curr.totalNeto || 0), 0);
        
        $('#sales-kpi-total').text('S/. ' + totalBilled.toLocaleString('es-PE', { minimumFractionDigits: 2 }));

        const pendingCount = _ventas.filter(v => v.estado === 'pendiente').length;
        $('#sales-kpi-pending').text(pendingCount);

        const approvedCount = _ventas.filter(v => v.estado === 'aprobado' || v.estado === 'despachado').length;
        $('#sales-kpi-dispatched').text(approvedCount);

        renderOrdersTable();
    }

    function renderOrdersTable() {
        const search = $('#search-order').val().toLowerCase();
        const fState = $('#filter-state').val();
        const tbody = $('#orders-table-body').empty();

        const filtered = _ventas.filter(v => {
            const cod = (v.numeroPedido || '').toLowerCase();
            const nombre = (v.clienteNombre || '').toLowerCase();
            const ruc = (v.clienteDocumento || '').toLowerCase();

            const matchesSearch = cod.includes(search) || nombre.includes(search) || ruc.includes(search);
            const matchesState = fState === 'todos' || v.estado === fState;

            return matchesSearch && matchesState;
        });

        if (filtered.length === 0) {
            tbody.append(`<tr><td colspan="10" class="text-center py-4 text-secondary">No se encontraron pedidos de venta.</td></tr>`);
            return;
        }

        filtered.forEach(v => {
            const fechaStr = v.fechaEmision ? new Date(v.fechaEmision).toLocaleDateString('es-PE') : '-';
            let statusBadge = 'badge-pendiente';
            if (v.estado === 'aprobado') statusBadge = 'badge-aprobado';
            if (v.estado === 'despachado') statusBadge = 'badge-despachado';
            if (v.estado === 'cancelado') statusBadge = 'badge-cancelado';
            if (v.estado === 'facturado') statusBadge = 'badge-facturado';

            tbody.append(`
                <tr>
                    <td class="px-3 fw-bold text-slate">${v.numeroPedido}</td>
                    <td>
                        <div class="fw-semibold text-dark">${v.clienteNombre || 'Desconocido'}</div>
                        <small class="text-secondary">${v.clienteDocumento || ''}</small>
                    </td>
                    <td>${fechaStr}</td>
                    <td><span class="badge bg-light text-dark border">${v.moneda}</span></td>
                    <td class="text-end">S/. ${(v.totalNeto / 1.18).toFixed(2)}</td>
                    <td class="text-end text-danger">S/. 0.00</td>
                    <td class="text-end fw-bold text-slate">S/. ${parseFloat(v.totalNeto || 0).toLocaleString('es-PE', { minimumFractionDigits: 2 })}</td>
                    <td class="text-capitalize">${v.metodoPago || ''}</td>
                    <td class="text-center">
                        <span class="badge ${statusBadge} px-2.5 py-1 text-uppercase fw-semibold" style="font-size: 0.65rem;">${v.estado}</span>
                    </td>
                    <td class="text-end px-3">
                        <div class="d-flex justify-content-end gap-1">
                            <button class="btn btn-sm btn-light border py-1" onclick="VentasView.viewOrderDetail(${v.pedidoId})" title="Ver Detalle"><i class="bi bi-eye"></i></button>
                            ${v.estado === 'pendiente' ? `
                                <button class="btn btn-sm btn-outline-success py-1" onclick="VentasView.approveOrder(${v.pedidoId})" title="Aprobar Pedido"><i class="bi bi-check-lg"></i></button>
                                <button class="btn btn-sm btn-outline-danger py-1" onclick="VentasView.cancelOrder(${v.pedidoId})" title="Cancelar Pedido"><i class="bi bi-x-lg"></i></button>
                            ` : ''}
                            ${v.estado === 'aprobado' ? `
                                <button class="btn btn-sm btn-outline-primary py-1 d-flex align-items-center gap-1 fw-semibold" onclick="VentasView.openDispatchModal(${v.pedidoId}, '${v.numeroPedido}')" title="Despachar mercadería"><i class="bi bi-truck"></i> Despachar</button>
                            ` : ''}
                            ${v.estado === 'despachado' ? `
                                <button class="btn btn-sm btn-success text-white py-1 d-flex align-items-center gap-1 fw-semibold" onclick="VentasView.billOrder(${v.pedidoId})" title="Facturar" style="background-color: #0f766e; border-color: #0f766e;"><i class="bi bi-receipt"></i> Facturar</button>
                            ` : ''}
                        </div>
                    </td>
                </tr>
            `);
        });
    }

    function switchTab(tab) {
        if (tab === 'orders') {
            $('#view-orders').removeClass('d-none');
            $('#view-new-order').addClass('d-none');
        } else {
            $('#view-orders').addClass('d-none');
            $('#view-new-order').removeClass('d-none');
            resetNewOrderForm();
        }
    }

    async function viewOrderDetail(id) {
        const v = _ventas.find(x => x.pedidoId === id);
        if (!v) return;

        $('#orderDetailModalLabel').text(`Pedido: ${v.numeroPedido}`);
        let statusBadge = 'badge-pendiente';
        if (v.estado === 'aprobado') statusBadge = 'badge-aprobado';
        if (v.estado === 'despachado') statusBadge = 'badge-despachado';
        if (v.estado === 'cancelado') statusBadge = 'badge-cancelado';
        $('#detail-order-status').attr('class', `badge ${statusBadge} text-uppercase fw-semibold`).text(v.estado);

        $('#detail-client-name').text(v.clienteNombre || 'Desconocido');
        $('#detail-client-doc').text(`RUC/DNI: ${v.clienteDocumento || '-'}`);
        $('#detail-client-email').text(`Email: ${v.clienteEmail || '-'}`);

        $('#detail-order-currency').text(v.moneda);
        $('#detail-order-payment').text(v.metodoPago);
        $('#detail-order-project').text(v.proyectoNombre || 'Sin Proyecto');

        const total = parseFloat(v.totalNeto || 0);
        $('#detail-sum-subtotal').text('S/ ' + (total / 1.18).toLocaleString('es-PE', { minimumFractionDigits: 2 }));
        $('#detail-sum-igv').text('S/ ' + (total - total / 1.18).toLocaleString('es-PE', { minimumFractionDigits: 2 }));
        $('#detail-sum-total').text((v.moneda === 'USD' ? '$ ' : 'S/ ') + total.toLocaleString('es-PE', { minimumFractionDigits: 2 }));

        const dBody = $('#detail-order-items-tbody').empty().append('<tr><td colspan="5" class="text-center py-2 text-secondary"><i class="bi bi-hourglass-split"></i> Cargando...</td></tr>');
        try {
            const resD = await apiGet(`/Operaciones/GetVentaDetalleJson?id=${id}`);
            dBody.empty();
            if (resD.ok && resD.data.length) {
                resD.data.forEach(d => {
                    dBody.append(`
                        <tr>
                            <td class="px-2">
                                <div class="fw-semibold text-dark">${d.productoDescripcion || 'Producto'}</div>
                                <small class="text-secondary">SKU: ${d.productoCodigo || ''}</small>
                            </td>
                            <td class="text-center">${d.cantidad}</td>
                            <td class="text-end">S/ ${parseFloat(d.precioUnitarioConIgv || 0).toFixed(2)}</td>
                            <td class="text-end text-danger">-S/ ${parseFloat(d.descuento || 0).toFixed(2)}</td>
                            <td class="text-end fw-bold px-2">S/ ${parseFloat(d.totalFila || 0).toFixed(2)}</td>
                        </tr>
                    `);
                });
            } else {
                dBody.append('<tr><td colspan="5" class="text-center py-3 text-secondary">Sin detalle de ítems.</td></tr>');
            }
        } catch (e) {
            dBody.empty().append('<tr><td colspan="5" class="text-center py-3 text-danger">Error al cargar ítems.</td></tr>');
        }

        $('.timeline-step').removeClass('active');
        $('.timeline-connector').removeClass('completed');
        $('#step-registrado').addClass('active');
        if (['aprobado', 'despachado'].includes(v.estado)) { $('#step-aprobado').addClass('active'); $('#conn-1').addClass('completed'); }
        if (v.estado === 'despachado') { $('#step-despachado').addClass('active'); $('#conn-2').addClass('completed'); }

        $('#orderDetailModal').modal('show');
    }

    async function approveOrder(id) {
        if (!confirm('¿Aprobar este pedido? Se descontará el stock de almacén.')) return;
        try {
            const res = await apiPost('/Operaciones/ApprovePedido', id);
            if (res.ok) { showAlert('Pedido aprobado exitosamente.'); await loadData(); }
            else showAlert(res.error || 'Error al aprobar.', 'danger');
        } catch (e) { showAlert('Error de conexión.', 'danger'); }
    }

    async function cancelOrder(id) {
        if (!confirm('¿Cancelar este pedido de venta?')) return;
        try {
            const res = await apiPost('/Operaciones/CancelPedido', id);
            if (res.ok) { showAlert('Pedido cancelado.'); await loadData(); }
            else showAlert(res.error || 'Error al cancelar.', 'danger');
        } catch (e) { showAlert('Error de conexión.', 'danger'); }
    }

    function openDispatchModal(id, num) {
        $('#dispatch-pedido-id').val(id);
        $('#dispatch-pedido-num').val(num);
        const nextNum = String(Math.floor(Math.random() * 9000) + 1000).padStart(8, '0');
        $('#dispatch-guia-correlativo').val(nextNum);
        $('#dispatchOrderModal').modal('show');
    }

    async function billOrder(id) {
        if (!confirm('Se generará la factura electrónica para este pedido. ¿Continuar?')) return;
        try {
            const res = await apiPost('/Operaciones/EmitirFactura', { pedidoId: id, tipoComprobante: '01', serie: 'F001' });
            if (res.ok) { showAlert('Factura emitida con éxito. Revisa el módulo de Facturación.'); await loadData(); }
            else showAlert(res.error || 'Error al facturar.', 'danger');
        } catch (e) { showAlert('Error de conexión.', 'danger'); }
    }

    function resetNewOrderForm() {
        $('#ord-project').val('');
        $('#ord-currency').val('PEN');
        $('#ord-tc').val('1.0000');
        $('#ord-payment').val('credito');
        $('#order-items-tbody').empty();
        addOrderItemRow();
        recalcOrderTotals();
    }

    function updateExchangeRate() {
        const curr = $('#ord-currency').val();
        $('#ord-tc').val(curr === 'USD' ? '3.7500' : '1.0000');
        recalcOrderTotals();
    }

    function addOrderItemRow() {
        const tbody = $('#order-items-tbody');
        let prodOptions = '<option value="">-- Seleccionar --</option>';
        _productos.forEach(p => {
            prodOptions += `<option value="${p.productoId}" data-um="${p.unidadMedida}" data-price="${p.precioVentaSugerido}">${p.descripcion} (${p.codigoSku})</option>`;
        });

        tbody.append(`
            <tr class="item-row">
                <td class="px-2">
                    <select class="form-select form-select-sm rounded-3 select-product" onchange="VentasView.onSelectProduct(this)">
                        ${prodOptions}
                    </select>
                </td>
                <td class="text-center">
                    <span class="badge bg-light text-secondary rounded-2 px-2 py-1.5 label-um">-</span>
                </td>
                <td class="px-2">
                    <input type="number" step="0.01" class="form-control form-control-sm rounded-3 text-center input-qty" value="1.00" onkeyup="VentasView.recalcOrderTotals()" onchange="VentasView.recalcOrderTotals()">
                </td>
                <td class="px-2">
                    <input type="number" step="0.01" class="form-control form-control-sm rounded-3 text-end input-price" value="0.00" onkeyup="VentasView.recalcOrderTotals()" onchange="VentasView.recalcOrderTotals()">
                </td>
                <td class="px-2">
                    <input type="number" step="0.01" class="form-control form-control-sm rounded-3 text-end input-discount" value="0.00" onkeyup="VentasView.recalcOrderTotals()" onchange="VentasView.recalcOrderTotals()">
                </td>
                <td class="text-end px-2">
                    <button type="button" class="btn btn-sm btn-link text-danger p-0" onclick="VentasView.removeOrderItemRow(this)"><i class="bi bi-trash3-fill"></i></button>
                </td>
            </tr>
        `);
        recalcOrderTotals();
    }

    function removeOrderItemRow(btn) {
        const tbody = $('#order-items-tbody');
        if (tbody.children().length > 1) {
            $(btn).closest('tr').remove();
            recalcOrderTotals();
        } else {
            alert('El pedido debe contener al menos un artículo.');
        }
    }

    function onSelectProduct(select) {
        const opt = $(select).find('option:selected');
        const row = $(select).closest('tr');
        if (opt.val()) {
            row.find('.label-um').text(opt.data('um'));
            row.find('.input-price').val(parseFloat(opt.data('price')).toFixed(2));
        } else {
            row.find('.label-um').text('-');
            row.find('.input-price').val('0.00');
        }
        recalcOrderTotals();
    }

    function recalcOrderTotals() {
        let total = 0;
        let totalDiscount = 0;

        $('.item-row').each(function () {
            const pId = $(this).find('.select-product').val();
            const qty = parseFloat($(this).find('.input-qty').val()) || 0;
            const price = parseFloat($(this).find('.input-price').val()) || 0;
            const discount = parseFloat($(this).find('.input-discount').val()) || 0;

            if (pId) {
                total += (price * qty) - discount;
                totalDiscount += discount;
            }
        });

        const subtotal = total / 1.18;
        const igv = total - subtotal;
        const currency = $('#ord-currency').val();
        const curSymbol = currency === 'USD' ? '$' : 'S/';

        $('#sum-subtotal').text(`${curSymbol} ${subtotal.toLocaleString('es-PE', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`);
        $('#sum-discount').text(`- ${curSymbol} ${totalDiscount.toLocaleString('es-PE', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`);
        $('#sum-igv').text(`${curSymbol} ${igv.toLocaleString('es-PE', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`);
        $('#sum-total').text(`${curSymbol} ${total.toLocaleString('es-PE', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`);
        $('#stock-warning-box').addClass('d-none');
    }

    async function submitOrder() {
        const clienteId = parseInt($('#ord-client').val());
        const proyectoId = $('#ord-project').val() ? parseInt($('#ord-project').val()) : null;
        const moneda = $('#ord-currency').val();
        const tipoCambio = parseFloat($('#ord-tc').val()) || 1;
        const metodoPago = $('#ord-payment').val();

        const detalles = [];
        let valid = true;

        $('.item-row').each(function () {
            const productoId = parseInt($(this).find('.select-product').val());
            const cantidad = parseFloat($(this).find('.input-qty').val());
            const precio = parseFloat($(this).find('.input-price').val());
            const descuento = parseFloat($(this).find('.input-discount').val()) || 0;

            if (!productoId) { valid = false; return false; }
            detalles.push({ productoId, cantidad, precioUnitarioConIgv: precio, descuento });
        });

        if (!valid || !detalles.length) {
            showAlert('Por favor complete todos los productos del detalle de venta.', 'warning');
            return;
        }

        let totalNeto = 0;
        detalles.forEach(d => { totalNeto += (d.precioUnitarioConIgv * d.cantidad) - d.descuento; });
        const payload = { clienteId, proyectoId, moneda, tipoCambio, metodoPago, totalNeto, detalles };

        try {
            const res = await apiPost('/Operaciones/CreatePedido', payload);
            if (res.ok) {
                showAlert('Pedido registrado con éxito.');
                switchTab('orders');
            } else {
                showAlert(res.error || 'Error al registrar pedido.', 'danger');
            }
        } catch (e) {
            showAlert('Error de conexión.', 'danger');
        }
    }

    // Chart.js initialization
    function initChart() {
        const ctx = document.getElementById('salesTrendChart').getContext('2d');
        const purpleGrad = ctx.createLinearGradient(0, 0, 0, 200);
        purpleGrad.addColorStop(0, 'rgba(139, 92, 246, 0.4)');
        purpleGrad.addColorStop(1, 'rgba(139, 92, 246, 0.0)');

        trendChart = new Chart(ctx, {
            type: 'line',
            data: {
                labels: ['Lun', 'Mar', 'Mié', 'Jue', 'Vie', 'Sáb', 'Dom'],
                datasets: [{
                    label: 'Ingresos esta semana (S/.)',
                    data: [8000, 11000, 9500, 14000, 18000, 17500, 15000],
                    borderColor: '#8b5cf6',
                    borderWidth: 3,
                    pointBackgroundColor: '#8b5cf6',
                    pointHoverRadius: 6,
                    fill: true,
                    backgroundColor: purpleGrad,
                    tension: 0.4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false }
                },
                scales: {
                    x: { grid: { display: false } },
                    y: { 
                        grid: { color: '#f1f5f9' },
                        ticks: {
                            callback: function(val) {
                                return 'S/. ' + val.toLocaleString();
                            }
                        }
                    }
                }
            }
        });
    }

    function updateChartData(type) {
        if (!trendChart) return;
        if (type === 'semanal') {
            trendChart.data.labels = ['Lun', 'Mar', 'Mié', 'Jue', 'Vie', 'Sáb', 'Dom'];
            trendChart.data.datasets[0].data = [8000, 11000, 9500, 14000, 18000, 17500, 15000];
            trendChart.data.datasets[0].label = 'Ingresos esta semana (S/.)';
        } else {
            trendChart.data.labels = ['Ene', 'Feb', 'Mar', 'Abr', 'May', 'Jun'];
            trendChart.data.datasets[0].data = [35000, 42000, 39000, 48000, 53840, 51000];
            trendChart.data.datasets[0].label = 'Ingresos mensuales (S/.)';
        }
        trendChart.update();
    }


    window.VentasView = {
        switchTab,
        updateExchangeRate,
        addOrderItemRow,
        removeOrderItemRow,
        onSelectProduct,
        recalcOrderTotals,
        submitOrder,
        viewOrderDetail,
        approveOrder,
        cancelOrder,
        openDispatchModal,
        billOrder
    };
        
})();
</script>
