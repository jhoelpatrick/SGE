<script>
    const _rvt = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
    let _ordenes = [];
    let _proveedores = [];
    let _proyectos = [];
    let _productos = [];

    async function apiGet(url) {
        const res = await fetch(url);
        return res.json();
    }

    async function apiPost(url, body) {
        const res = await fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': _rvt },
            body: JSON.stringify(body)
        });
        return res.json();
    }

    function showAlert(msg, type = 'success') {
        const el = $(`<div class="alert alert-${type} alert-dismissible fade show position-fixed bottom-0 end-0 m-3 shadow" role="alert" style="z-index:9999;min-width:280px;">${msg}<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>`);
        $('body').append(el);
        setTimeout(() => el.alert('close'), 4000);
    }

    /* â”€â”€â”€â”€â”€ INIT â”€â”€â”€â”€â”€ */
    $(document).ready(function () {
        initPage();
        $('#search-purchase, #filter-pur-state, #filter-provider').on('change keyup', renderPurchasesTable);
    });

    async function initPage() {
        try {
            const resP = await apiGet('/Comercial/GetProveedoresJson');
            if (resP.ok) {
                _proveedores = resP.data;
                const fp = $('#filter-provider').empty().append('<option value="todos">Todos los Proveedores</option>');
                const sp = $('#pur-provider').empty();
                _proveedores.forEach(p => {
                    fp.append(`<option value="${p.proveedorId}">${p.razonSocial}</option>`);
                    sp.append(`<option value="${p.proveedorId}">${p.razonSocial}</option>`);
                });
            }
        } catch (e) { showAlert('No se pudieron cargar los proveedores.', 'warning'); }

        try {
            const resProy = await apiGet('/Operaciones/GetProyectosJson');
            if (resProy.ok) {
                _proyectos = resProy.data;
                const spr = $('#pur-project').empty().append('<option value="">-- Seleccionar Proyecto --</option>');
                _proyectos.forEach(p => spr.append(`<option value="${p.proyectoId}">${p.nombreProyecto}</option>`));
            }
        } catch (e) { showAlert('No se pudieron cargar los proyectos.', 'warning'); }

        try {
            const resProd = await apiGet('/Comercial/GetProductosJson');
            if (resProd.ok) _productos = resProd.data;
        } catch (e) { showAlert('No se pudieron cargar los productos.', 'warning'); }

        addPurchaseItemRow();
        await loadData();
    }

    async function loadData() {
        try {
            const res = await apiGet('/Operaciones/GetComprasJson');
            if (res.ok) _ordenes = res.data;
            else showAlert(res.error, 'danger');
        } catch (e) { showAlert('Error al cargar las Ã³rdenes de compra.', 'danger'); }
        renderDashboard();
    }

    /* â”€â”€ KPIs â”€â”€ */
    function renderDashboard() {
        const approved = _ordenes.filter(o => o.estado === 'aprobado');
        const totalAp = approved.reduce((a, o) => a + parseFloat(o.montoTotal || 0), 0);
        $('#pur-kpi-total').text('S/ ' + fmt(totalAp));
        $('#pur-kpi-pending').text(_ordenes.filter(o => o.estado === 'pendiente').length);
        $('#pur-kpi-rejected').text(_ordenes.filter(o => o.estado === 'rechazado').length);

        /* CategorÃ­as */
        const cats = { materiales: 0, servicios: 0, equipos: 0, logistica: 0 };
        approved.forEach(o => { if (cats[o.categoriaGasto] !== undefined) cats[o.categoriaGasto] += parseFloat(o.montoTotal || 0); });
        const catTotal = Object.values(cats).reduce((a, b) => a + b, 0) || 1;
        const catColors = { materiales: '#0d9488', servicios: '#3b82f6', equipos: '#f59e0b', logistica: '#ef4444' };
        const catNames  = { materiales: 'Materiales', servicios: 'Servicios', equipos: 'Equipos', logistica: 'LogÃ­stica' };
        const catBox = $('#pur-kpi-categories').empty();
        Object.keys(cats).forEach(c => {
            const pct = Math.round((cats[c] / catTotal) * 100);
            catBox.append(`
                <div class="mb-2">
                    <div class="d-flex justify-content-between" style="font-size:.7rem">
                        <span class="fw-semibold" style="color:${catColors[c]}">${catNames[c]}</span>
                        <span class="text-secondary">S/ ${Math.round(cats[c]).toLocaleString('es-PE')}</span>
                    </div>
                    <div class="budget-bar-wrap">
                        <div class="budget-bar-fill" style="width:${pct}%;background:${catColors[c]}"></div>
                    </div>
                </div>`);
        });

        renderPurchasesTable();
    }

    /* â”€â”€ TABLA â”€â”€ */
    function renderPurchasesTable() {
        const q  = $('#search-purchase').val().toLowerCase();
        const fs = $('#filter-pur-state').val();
        const fp = $('#filter-provider').val();

        const tbody = $('#purchases-table-body').empty();
        const list  = _ordenes.filter(o => {
            const ok1  = ((o.numeroOrden || '') + (o.proveedorNombre || '')).toLowerCase().includes(q);
            const ok2  = fs === 'todos' || o.estado === fs;
            const ok3  = fp === 'todos' || String(o.proveedorId) === fp;
            return ok1 && ok2 && ok3;
        });

        if (!list.length) {
            tbody.append(`<tr><td colspan="8" class="text-center py-5 text-secondary">
                <i class="bi bi-inbox fs-1 d-block mb-2"></i>No se encontraron Ã³rdenes de compra.</td></tr>`);
            return;
        }

        const catIcon = { materiales:'ðŸ§±', servicios:'ðŸ”§', equipos:'âš™ï¸', logistica:'ðŸš›' };
        list.forEach(o => {
            const fecha = o.fechaEmision ? new Date(o.fechaEmision).toLocaleDateString('es-PE') : '-';
            const stBg  = { pendiente:'bg-warning text-dark', aprobado:'bg-success', rechazado:'bg-danger' }[o.estado] || 'bg-secondary';

            tbody.append(`<tr>
                <td class="px-3 fw-bold">${o.numeroOrden}</td>
                <td>
                    <div class="fw-semibold text-dark">${o.proveedorNombre || '-'}</div>
                    <small class="text-secondary">RUC ${o.proveedorDocumento || ''}</small>
                </td>
                <td class="teal-text fw-medium small">${o.proyectoNombre ? o.proyectoNombre : '<span class="text-secondary">â€”</span>'}</td>
                <td class="small">${o.solicitante || ''}</td>
                <td class="text-center">
                    <span class="badge bg-light text-dark border small px-2">${catIcon[o.categoriaGasto] || ''} ${o.categoriaGasto || ''}</span>
                </td>
                <td class="text-end fw-bold">S/ ${fmt(o.montoTotal)}</td>
                <td class="text-center">
                    <span class="badge ${stBg} status-badge px-2 py-1">${o.estado}</span>
                </td>
                <td class="text-end px-3">
                    <div class="d-flex justify-content-end gap-1">
                        <button class="btn btn-sm btn-light border py-1" onclick="viewPurchaseDetail(${o.ordenId})" title="Ver detalle">
                            <i class="bi bi-eye"></i>
                        </button>
                        ${o.estado === 'pendiente' ? `
                        <button class="btn btn-sm btn-outline-success py-1 fw-semibold" onclick="approvePurchase(${o.ordenId})">
                            <i class="bi bi-check-lg"></i> Aprobar
                        </button>
                        <button class="btn btn-sm btn-outline-danger py-1" onclick="rejectPurchase(${o.ordenId})" title="Rechazar">
                            <i class="bi bi-x-lg"></i>
                        </button>` : ''}
                    </div>
                </td>
            </tr>`);
        });
    }

    /* â”€â”€ TABS â”€â”€ */
    function switchTab(tab) {
        $('.tab-btn').removeClass('active');
        $(`#${tab}-tab`).addClass('active');
        if (tab === 'purchases') {
            $('#view-purchases').removeClass('d-none');
            $('#view-new-purchase').addClass('d-none');
            renderDashboard();
        } else {
            $('#view-purchases').addClass('d-none');
            $('#view-new-purchase').removeClass('d-none');
            resetNewPurchaseForm();
        }
    }

    function clearPurFilters() {
        $('#search-purchase').val('');
        $('#filter-pur-state').val('todos');
        $('#filter-provider').val('todos');
        renderPurchasesTable();
    }

    /* â”€â”€ MODAL DETALLE â”€â”€ */
    async function viewPurchaseDetail(id) {
        const o = _ordenes.find(x => x.ordenId === id);
        if (!o) return;

        $('#pdm-title').text(o.numeroOrden);
        const stBg = { pendiente:'bg-warning text-dark', aprobado:'bg-success', rechazado:'bg-danger' }[o.estado] || 'bg-secondary';
        $('#pdm-status').attr('class', `badge ${stBg} status-badge px-2`).text(o.estado);

        $('#pdm-prov-name').text(o.proveedorNombre || '-');
        $('#pdm-prov-ruc').text(`RUC: ${o.proveedorDocumento || '-'}`);
        $('#pdm-prov-email').text(o.proveedorEmail || '-');
        $('#pdm-prov-tel').text(o.proveedorTelefono || '-');

        $('#pdm-proj').text(o.proyectoNombre || 'Sin Proyecto');
        $('#pdm-cat').text(o.categoriaGasto || '');
        $('#pdm-req').text(o.solicitante || '');
        $('#pdm-date').text(o.fechaEmision ? new Date(o.fechaEmision).toLocaleDateString('es-PE') : '-');

        const total = parseFloat(o.montoTotal || 0);
        const neto  = total / 1.18;
        const igv   = total - neto;
        $('#pdm-net').text('S/ ' + fmt(neto));
        $('#pdm-igv').text('S/ ' + fmt(igv));
        $('#pdm-total').text('TOTAL: S/ ' + fmt(total));

        // Cargar detalle de Ã­tems
        const tbody = $('#pdm-items-tbody').empty().append('<tr><td colspan="4" class="text-center py-2 text-secondary"><i class="bi bi-hourglass-split"></i> Cargando...</td></tr>');
        try {
            const resD = await apiGet(`/Operaciones/GetCompraDetalleJson?id=${id}`);
            tbody.empty();
            if (resD.ok && resD.data.length) {
                resD.data.forEach(d => {
                    tbody.append(`<tr>
                        <td class="px-2">
                            <div class="fw-semibold text-dark">${d.productoDescripcion || '-'}</div>
                            <small class="text-secondary">SKU: ${d.productoCodigo || ''}</small>
                        </td>
                        <td class="text-center">${d.cantidad}</td>
                        <td class="text-end">S/ ${parseFloat(d.costoUnitarioConIgv || 0).toFixed(2)}</td>
                        <td class="text-end fw-bold px-2">S/ ${parseFloat(d.totalFila || 0).toFixed(2)}</td>
                    </tr>`);
                });
            } else {
                tbody.append('<tr><td colspan="4" class="text-center py-3 text-secondary">Sin detalle.</td></tr>');
            }
        } catch (e) {
            tbody.empty().append('<tr><td colspan="4" class="text-center py-3 text-danger">Error al cargar detalle.</td></tr>');
        }

        $('#purchaseDetailModal').modal('show');
    }

    /* â”€â”€ ACCIONES â”€â”€ */
    async function approvePurchase(id) {
        if (!confirm('Â¿Aprobar esta orden? Se registrarÃ¡ el ingreso al almacÃ©n y se cargarÃ¡ al costo del proyecto.')) return;
        try {
            const r = await apiPost('/Operaciones/ApproveCompra', id);
            if (r.ok) { showAlert('Orden aprobada. Stock actualizado.'); await loadData(); }
            else showAlert(r.error || 'Error al aprobar.', 'danger');
        } catch (e) { showAlert('Error de conexiÃ³n.', 'danger'); }
    }

    async function rejectPurchase(id) {
        if (!confirm('Â¿Rechazar esta orden de compra?')) return;
        try {
            const r = await apiPost('/Operaciones/RejectCompra', id);
            if (r.ok) { showAlert('Orden rechazada.'); await loadData(); }
            else showAlert(r.error || 'Error al rechazar.', 'danger');
        } catch (e) { showAlert('Error de conexiÃ³n.', 'danger'); }
    }

    /* â”€â”€ FORM NUEVA OC â”€â”€ */
    function resetNewPurchaseForm() {
        $('#pur-project').val('');
        $('#pur-requester').val('');
        $('#pur-category').val('materiales');
        $('#purchase-items-tbody').empty();
        addPurchaseItemRow();
        onSelectProject();
    }

    function onSelectProject() {
        const projId = $('#pur-project').val();
        if (!projId) {
            $('#box-proj-name').text('Selecciona un proyecto...');
            ['#box-proj-limit','#box-proj-cost','#box-proj-available'].forEach(id => $(id).text('S/ 0.00'));
            $('#box-proj-bar').css('width', '0%');
            $('#budget-alert-box').addClass('d-none');
            return;
        }
        const p = _proyectos.find(x => x.proyectoId === parseInt(projId));
        if (!p) return;
        const lim  = parseFloat(p.presupuestoTotal || 0);
        const cost = parseFloat(p.costoRealLogrado || 0);
        const avl  = lim - cost;
        const pct  = lim > 0 ? Math.min((cost / lim) * 100, 100) : 0;

        $('#box-proj-name').text(p.nombreProyecto);
        $('#box-proj-limit').text('S/ ' + fmt(lim));
        $('#box-proj-cost').text('S/ ' + fmt(cost));
        $('#box-proj-available').text('S/ ' + fmt(avl)).css('color', avl < 0 ? '#ef4444' : '#0d9488');
        $('#box-proj-bar').css({ width: pct + '%', background: pct > 90 ? '#ef4444' : '#0d9488' });
        recalcPurchaseTotals();
    }

    function addPurchaseItemRow() {
        let opts = '<option value="">-- Seleccionar producto --</option>';
        _productos.forEach(p => opts += `<option value="${p.productoId}" data-cost="${p.costoPromedio}">${p.descripcion} (${p.codigoSku})</option>`);

        $('#purchase-items-tbody').append(`
            <tr class="item-row">
                <td class="px-2">
                    <select class="form-select form-select-sm rounded-3 select-product" onchange="onPurProductChange(this)">${opts}</select>
                </td>
                <td class="px-2">
                    <input type="number" step="0.01" min="0.01" class="form-control form-control-sm rounded-3 text-center input-qty"
                           value="1" onchange="recalcPurchaseTotals()" onkeyup="recalcPurchaseTotals()">
                </td>
                <td class="px-2">
                    <input type="number" step="0.01" min="0" class="form-control form-control-sm rounded-3 text-end input-cost"
                           value="0.00" onchange="recalcPurchaseTotals()" onkeyup="recalcPurchaseTotals()">
                </td>
                <td class="text-center">
                    <button type="button" class="btn btn-sm btn-link text-danger p-0" onclick="removePurRow(this)">
                        <i class="bi bi-trash3-fill"></i>
                    </button>
                </td>
            </tr>`);
        recalcPurchaseTotals();
    }

    function removePurRow(btn) {
        if ($('#purchase-items-tbody .item-row').length > 1) $(btn).closest('tr').remove();
        else alert('La orden debe tener al menos un artÃ­culo.');
        recalcPurchaseTotals();
    }

    function onPurProductChange(sel) {
        const opt = $(sel).find('option:selected');
        const row = $(sel).closest('tr');
        if (opt.val()) row.find('.input-cost').val((parseFloat(opt.data('cost')) * 1.18).toFixed(2));
        else row.find('.input-cost').val('0.00');
        recalcPurchaseTotals();
    }

    function recalcPurchaseTotals() {
        let total = 0;
        $('.item-row').each(function () {
            const pid = $(this).find('.select-product').val();
            if (pid) total += (parseFloat($(this).find('.input-qty').val()) || 0) * (parseFloat($(this).find('.input-cost').val()) || 0);
        });
        $('#sum-pur-base').text('S/ ' + fmt(total / 1.18));
        $('#sum-pur-igv').text('S/ ' + fmt(total - total / 1.18));
        $('#sum-pur-total').text('S/ ' + fmt(total));

        const projId = $('#pur-project').val();
        if (projId) {
            const p   = _proyectos.find(x => x.proyectoId === parseInt(projId));
            const avl = p ? parseFloat(p.presupuestoTotal || 0) - parseFloat(p.costoRealLogrado || 0) : Infinity;
            total > avl ? $('#budget-alert-box').removeClass('d-none') : $('#budget-alert-box').addClass('d-none');
        }
    }

    async function submitPurchase() {
        const proveedorId  = parseInt($('#pur-provider').val());
        const proyectoId   = $('#pur-project').val() ? parseInt($('#pur-project').val()) : null;
        const solicitante  = $('#pur-requester').val().trim();
        const categoriaGasto = $('#pur-category').val();
        if (!proyectoId) { showAlert('Debe seleccionar un proyecto de vinculaciÃ³n.', 'warning'); return; }
        if (!solicitante) { showAlert('Ingrese el nombre del solicitante responsable.', 'warning'); return; }

        const detalles = [];
        let valid = true;
        $('.item-row').each(function () {
            const productoId = parseInt($(this).find('.select-product').val());
            if (!productoId) { valid = false; return false; }
            detalles.push({
                productoId,
                cantidad: parseFloat($(this).find('.input-qty').val()),
                costoUnitarioConIgv: parseFloat($(this).find('.input-cost').val())
            });
        });
        if (!valid || !detalles.length) { showAlert('Complete todos los artÃ­culos del detalle.', 'warning'); return; }

        let montoTotal = 0;
        detalles.forEach(d => { montoTotal += d.cantidad * d.costoUnitarioConIgv; });

        const payload = { proveedorId, proyectoId, categoriaGasto, solicitante, montoTotal, detalles };

        try {
            const r = await apiPost('/Operaciones/CreateCompra', payload);
            if (r.ok) {
                showAlert(`Orden de compra enviada a aprobaciÃ³n con Ã©xito.`);
                switchTab('purchases');
            } else {
                showAlert(r.error || 'Error al registrar orden.', 'danger');
            }
        } catch (e) { showAlert('Error de conexiÃ³n.', 'danger'); }
    }

    /* â”€â”€ HELPER â”€â”€ */
    function fmt(n) { return parseFloat(n || 0).toLocaleString('es-PE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }
</script>
