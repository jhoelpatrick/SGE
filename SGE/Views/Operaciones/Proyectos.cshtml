@{
    var random = new Random();
    var estados = new[] { "Planificación", "En Progreso", "En Pausa", "Completado" };
    
    var proyectos = Enumerable.Range(1, 8).Select(i => {
        var progreso = random.Next(10, 100);
        var estado = progreso == 100 ? "Completado" : estados[random.Next(0, 3)];
        return new {
            Nombre = $"Proyecto Implementación ERP {i}",
            Cliente = $"Cliente {random.Next(1, 10)} S.A.",
            FechaFin = DateTime.Now.AddDays(random.Next(15, 120)).ToString("dd/MM/yyyy"),
            Progreso = progreso,
            Estado = estado
        };
    }).ToList();
}

<div class="mb-6 flex justify-between items-center">
    <div>
        <h2 class="text-2xl font-bold text-slate-800">Proyectos</h2>
        <p class="text-sm text-slate-500">Gestión y seguimiento de proyectos activos.</p>
    </div>
    <button class="bg-primary hover:bg-emerald-700 text-white px-4 py-2 rounded-lg text-sm font-medium shadow-sm">
        Nuevo Proyecto
    </button>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    @foreach (var p in proyectos)
    {
        <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-6 hover:shadow-md transition-shadow">
            <div class="flex justify-between items-start mb-4">
                <h3 class="text-lg font-bold text-slate-800 line-clamp-1" title="@p.Nombre">@p.Nombre</h3>
                <span class="p-1.5 rounded-lg bg-slate-100 text-slate-600">
                    <i data-lucide="briefcase" class="w-4 h-4"></i>
                </span>
            </div>
            
            <p class="text-sm text-slate-500 mb-6 flex items-center">
                <i data-lucide="user" class="w-4 h-4 mr-2"></i> @p.Cliente
            </p>
            
            <div class="mb-4">
                <div class="flex justify-between text-xs mb-1">
                    <span class="font-medium text-slate-700">Progreso</span>
                    <span class="font-medium @(p.Progreso == 100 ? "text-emerald-600" : "text-primary")">@p.Progreso%</span>
                </div>
                <div class="w-full bg-slate-200 rounded-full h-2">
                    <div class="bg-primary h-2 rounded-full @(p.Progreso == 100 ? "bg-emerald-500" : "")" style="width: @p.Progreso%"></div>
                </div>
            </div>
            
            <div class="flex justify-between items-center pt-4 border-t border-slate-100">
                <div class="flex items-center text-xs text-slate-500">
                    <i data-lucide="calendar" class="w-3 h-3 mr-1"></i>
                    Entrega: @p.FechaFin
                </div>
                <span class="text-xs font-semibold px-2 py-1 rounded-full 
                    @(p.Estado == "Completado" ? "bg-emerald-100 text-emerald-700" : 
                      p.Estado == "En Progreso" ? "bg-blue-100 text-blue-700" : 
                      p.Estado == "En Pausa" ? "bg-amber-100 text-amber-700" : "bg-slate-100 text-slate-700")">
                    @p.Estado
                </span>
            </div>
        </div>
    }
</div>
