@{
    var random = new Random();
    var estados = new[] { "Pagada", "Pendiente", "Vencida" };
    
    var facturas = Enumerable.Range(1, 20).Select(i => {
        var subtotal = random.NextDouble() * (4000 - 100) + 100;
        var estado = estados[random.Next(estados.Length)];
        return new {
            Numero = $"FAC-{i.ToString("D5")}",
            Cliente = $"Cliente {random.Next(1, 10)}",
            Emision = DateTime.Now.AddDays(-random.Next(1, 60)).ToString("dd/MM/yyyy"),
            Vencimiento = estado == "Vencida" ? DateTime.Now.AddDays(-random.Next(1, 30)).ToString("dd/MM/yyyy") : DateTime.Now.AddDays(random.Next(1, 30)).ToString("dd/MM/yyyy"),
            Total = (subtotal * 1.16).ToString("C"),
            Estado = estado
        };
    }).ToList();
}

<div class="mb-6 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
    <div>
        <h2 class="text-2xl font-bold text-slate-800">Facturación</h2>
        <p class="text-sm text-slate-500">Emisión de facturas y control de pagos.</p>
    </div>
    <button class="bg-primary hover:bg-emerald-700 text-white px-4 py-2 rounded-lg text-sm font-medium transition-colors shadow-sm">
        Nueva Factura
    </button>
</div>

<div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-8">
    <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm border-l-4 border-l-emerald-500">
        <p class="text-xs font-semibold text-slate-500 uppercase">Cobrado Mensual</p>
        <p class="text-2xl font-bold text-slate-800 mt-2">$32,150.00</p>
    </div>
    <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm border-l-4 border-l-amber-500">
        <p class="text-xs font-semibold text-slate-500 uppercase">Pendiente Cobro</p>
        <p class="text-2xl font-bold text-slate-800 mt-2">$14,200.00</p>
    </div>
    <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm border-l-4 border-l-red-500">
        <p class="text-xs font-semibold text-slate-500 uppercase">Vencido</p>
        <p class="text-2xl font-bold text-slate-800 mt-2">$5,300.00</p>
    </div>
    <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm border-l-4 border-l-blue-500">
        <p class="text-xs font-semibold text-slate-500 uppercase">Facturas Emitidas</p>
        <p class="text-2xl font-bold text-slate-800 mt-2">142</p>
    </div>
</div>

<div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
    <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-slate-200">
            <thead class="bg-slate-50">
                <tr>
                    <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase">Factura</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase">Cliente</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase">Emisión</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase">Vencimiento</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase">Estado</th>
                    <th class="px-6 py-3 text-right text-xs font-medium text-slate-500 uppercase">Total</th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-slate-200">
                @foreach (var fac in facturas)
                {
                    <tr class="hover:bg-slate-50">
                        <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-blue-600 cursor-pointer">@fac.Numero</td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-500">@fac.Cliente</td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-500">@fac.Emision</td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-500">@fac.Vencimiento</td>
                        <td class="px-6 py-4 whitespace-nowrap">
                            @if (fac.Estado == "Pagada") { <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-emerald-100 text-emerald-800">Pagada</span> }
                            else if (fac.Estado == "Pendiente") { <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-amber-100 text-amber-800">Pendiente</span> }
                            else { <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-red-100 text-red-800">Vencida</span> }
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-900 text-right font-medium">@fac.Total</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
