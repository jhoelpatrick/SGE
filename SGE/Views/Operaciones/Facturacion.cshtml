@Html.AntiForgeryToken()
@{
    ViewData["Title"] = "Gestión de Facturación";
}

<style>
    .font-system {
        font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }
    .kpi-card {
        transition: transform 0.2s, box-shadow 0.2s;
        border: 1px solid #e2e8f0;
    }
    .kpi-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.05) !important;
    }
    .btn-teal {
        background-color: #0d9488;
        color: white;
        border: none;
    }
    .btn-teal:hover {
        background-color: #0f766e;
        color: white;
    }
    .status-badge {
        font-size: 0.65rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .5px;
    }
    .badge-contingencia {
        background-color: #fef3c7;
        color: #d97706;
    }
    .badge-aceptado {
        background-color: #dcfce7;
        color: #15803d;
    }
    .badge-rechazado {
        background-color: #fee2e2;
        color: #b91c1c;
    }
</style>

<div class="px-4 py-3 font-system">
    
    <!-- CABECERA -->
    <div class="d-flex justify-content-between align-items-center mb-4 mt-2">
        <div>
            <h2 class="fw-bold mb-1" style="color: #0c675e;"><i class="bi bi-receipt me-2"></i>Módulo de Facturación</h2>
            <p class="text-secondary small mb-0">Comprobantes SUNAT · Colas de mensajería asíncronas · Modo contingencia</p>
        </div>
        <div class="d-flex align-items-center gap-3">
            <div class="form-check form-switch bg-white p-2 rounded-3 border d-flex align-items-center gap-2" style="font-size: 0.8rem;">
                <input class="form-check-input ms-0" type="checkbox" id="contingency-switch" onchange="FacturacionView.toggleContingencyMode()">
                <label class="form-check-label text-secondary fw-semibold" for="contingency-switch" id="contingency-label" style="color: #ea580c !important;">Modo Contingencia (SUNAT Offline)</label>
            </div>
            <button class="btn btn-teal px-3 py-1.5 rounded-3 fw-semibold" onclick="FacturacionView.openEmitirModal()">
                <i class="bi bi-plus-circle"></i> Emitir Comprobante
            </button>
            <button class="btn btn-outline-secondary px-3 py-1.5 rounded-3 fw-semibold bg-white" onclick="window.loadContent('/Principal/Index')">
                <i class="bi bi-arrow-left"></i> Dashboard
            </button>
        </div>
    </div>

    <!-- KPIs Row -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 kpi-card">
                <div class="card-body d-flex align-items-center p-3">
                    <div class="rounded-3 d-flex align-items-center justify-content-center me-3" style="width: 48px; height: 48px; background-color: rgba(16, 185, 129, 0.1); color: #10b981;">
                        <i class="bi bi-receipt-cutoff fs-4"></i>
                    </div>
                    <div>
                        <div class="text-secondary small fw-semibold mb-1" style="font-size: 0.7rem;">COMPROBANTES EMITIDOS</div>
                        <h4 class="fw-bold mb-0 lh-1" id="fac-kpi-acc">0</h4>
                        <small class="text-success fw-semibold" style="font-size: 0.65rem;">+ Este mes</small>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 kpi-card">
                <div class="card-body d-flex align-items-center p-3">
                    <div class="rounded-3 d-flex align-items-center justify-content-center me-3" style="width: 48px; height: 48px; background-color: rgba(13, 148, 136, 0.1); color: #0d9488;">
                        <i class="bi bi-cash-coin fs-4"></i>
                    </div>
                    <div>
                        <div class="text-secondary small fw-semibold mb-1" style="font-size: 0.7rem;">MONTO TOTAL EMITIDO</div>
                        <h4 class="fw-bold mb-0 lh-1" id="fac-kpi-total">S/. 0.00</h4>
                        <small class="text-success fw-semibold" style="font-size: 0.65rem;">+1.2%</small>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 kpi-card">
                <div class="card-body d-flex align-items-center p-3">
                    <div class="rounded-3 d-flex align-items-center justify-content-center me-3" style="width: 48px; height: 48px; background-color: rgba(59, 130, 246, 0.1); color: #3b82f6;">
                        <i class="bi bi-file-earmark-ruled fs-4"></i>
                    </div>
                    <div>
                        <div class="text-secondary small fw-semibold mb-1" style="font-size: 0.7rem;">FACTURAS EMITIDAS</div>
                        <h4 class="fw-bold mb-0 lh-1" id="fac-kpi-pen">0</h4>
                        <small class="text-primary fw-semibold" style="font-size: 0.65rem;">RUC a RUC</small>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 kpi-card">
                <div class="card-body d-flex align-items-center p-3">
                    <div class="rounded-3 d-flex align-items-center justify-content-center me-3" style="width: 48px; height: 48px; background-color: rgba(239, 68, 68, 0.1); color: #ef4444;">
                        <i class="bi bi-x-octagon fs-4"></i>
                    </div>
                    <div>
                        <div class="text-secondary small fw-semibold mb-1" style="font-size: 0.7rem;">ANULADOS</div>
                        <h4 class="fw-bold mb-0 lh-1" id="fac-kpi-rej">0</h4>
                        <small class="text-danger fw-semibold" style="font-size: 0.65rem;">Revisar</small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Layout de 2 Columnas -->
    <div class="row g-4">
        <!-- Monitor de Colas -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white d-flex flex-column justify-content-between" style="border: 1px solid #e2e8f0; height: 100%;">
                <div>
                    <h5 class="fw-bold mb-1" style="color: #0f172a;"><i class="bi bi-hdd-network me-2 text-teal"></i>Monitor de Colas (SUNAT Gateway)</h5>
                    <p class="text-secondary small mb-3">Simulación asíncrona de envío de colas de facturas.</p>
                    
                    <div class="d-flex align-items-center mb-3">
                        <span class="p-1 rounded-circle bg-success me-2" style="width: 8px; height: 8px;"></span>
                        <span class="small fw-bold text-success">Gateway SUNAT: Conectado (Online)</span>
                    </div>

                    <!-- Queue status card -->
                    <div class="rounded-3 p-3 bg-light border mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="small fw-bold text-slate">Cola de Mensajes</span>
                            <span class="badge bg-secondary" id="queue-pending-count" style="font-size: 0.65rem;">0 pendientes</span>
                        </div>
                        <div class="progress mb-2" style="height: 6px;">
                            <div class="progress-bar bg-teal" id="queue-bar" role="progressbar" style="width: 0%"></div>
                        </div>
                        <small class="text-secondary d-block text-center" style="font-size: 0.7rem;" id="queue-status-text">Cola vacía. Sin transacciones pendientes.</small>
                    </div>
                </div>

                <div class="d-grid mt-2">
                    <button class="btn btn-warning py-2 fw-bold text-dark rounded-3 shadow-xs" id="btn-sync-contingencies" onclick="FacturacionView.syncContingencies()">
                        <i class="bi bi-cloud-arrow-up-fill me-1"></i> Sincronizar 1 Contingencias
                    </button>
                </div>
            </div>
        </div>

        <!-- Historial de Comprobantes -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white" style="border: 1px solid #e2e8f0; height: 100%;">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h5 class="fw-bold mb-1" style="color: #0f172a;"><i class="bi bi-clock-history me-2 text-teal"></i>Historial de Comprobantes</h5>
                        <p class="text-secondary small mb-0">RUC Empresa: 20123456789</p>
                    </div>
                    <div class="d-flex gap-2">
                        <input type="text" class="form-control form-control-sm rounded-3 bg-light border-0 px-3" id="search-fac" placeholder="Buscar por serie, número o cliente..." style="width: 230px;">
                        <select class="form-select form-select-sm rounded-3 bg-light border-0" id="filter-fac-type" style="width: 140px;">
                            <option value="todos">Todos los Tipos</option>
                            <option value="factura">Factura</option>
                            <option value="boleta">Boleta</option>
                        </select>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light text-secondary small text-uppercase" style="background-color: #f8fafc;">
                            <tr>
                                <th class="border-0 px-3">Serie-Número</th>
                                <th class="border-0">Tipo</th>
                                <th class="border-0">Cliente</th>
                                <th class="border-0 text-end">Total (S/.)</th>
                                <th class="border-0 text-center">Estado SUNAT</th>
                                <th class="border-0 text-end px-3">Acciones</th>
                            </tr>
                        </thead>
                        <tbody id="fac-table-body" class="small">
                            <!-- dinámico -->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- MODAL: PENDIENTES DE FACTURAR / EMITIR COMPROBANTE -->
<div class="modal fade" id="emitirComprobanteModal" tabindex="-1" aria-labelledby="emitirComprobanteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title fw-bold text-slate" id="emitirComprobanteModalLabel"><i class="bi bi-file-earmark-plus text-teal me-2"></i>Emitir Factura desde Pedido</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body pt-3">
                <div class="alert alert-info rounded-3 border-0 small mb-3">
                    <i class="bi bi-info-circle-fill me-2"></i> Aquí se listan los pedidos despachados que aún no tienen comprobante de pago emitido.
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light small text-secondary">
                            <tr>
                                <th class="border-0 px-3">Pedido Origen</th>
                                <th class="border-0">Cliente</th>
                                <th class="border-0">Fecha Despacho</th>
                                <th class="border-0 text-end">Monto a Facturar</th>
                                <th class="border-0 text-end px-3">Acción</th>
                            </tr>
                        </thead>
                        <tbody id="billing-table-body" class="small">
                            <!-- dinámico -->
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer border-top-0 pt-0">
                <button type="button" class="btn btn-light rounded-3 fw-semibold px-4" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<script>
(function() {

    const _rvt = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
    let _comprobantes = [];
    let contingencyCount = 1;

    async function apiGet(url) {
        const res = await fetch(url);
        return res.json();
    }

    async function apiPost(url, body) {
        const res = await fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': _rvt },
            body: JSON.stringify(body)
        });
        return res.json();
    }

    function showAlert(msg, type = 'success') {
        const el = $(`<div class="alert alert-${type} alert-dismissible fade show position-fixed bottom-0 end-0 m-3 shadow" role="alert" style="z-index:9999;min-width:280px;">${msg}<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>`);
        $('body').append(el);
        setTimeout(() => el.alert('close'), 4000);
    }

    $(document).ready(function () {
        initFacturacion();
        $('#search-fac, #filter-fac-type').on('keyup change', renderFacturas);
    });

    async function initFacturacion() {
        try {
            const resF = await apiGet('/Operaciones/GetComprobantesJson');
            if (resF.ok) _comprobantes = resF.data;
        } catch (e) { showAlert('Error al cargar comprobantes.', 'warning'); }

        renderDashboardFac();
    }

    function renderDashboardFac() {
        const totalAmount = _comprobantes.reduce((a, b) => a + parseFloat(b.importeTotalNeto || 0), 0);
        $('#fac-kpi-total').text('S/. ' + totalAmount.toLocaleString('es-PE', { minimumFractionDigits: 2 }));

        const countInvoices = _comprobantes.filter(f => f.tipoComprobante === '01').length;
        $('#fac-kpi-pen').text(countInvoices);

        const totalComprobantes = _comprobantes.length;
        $('#fac-kpi-acc').text(totalComprobantes);

        const rejCount = _comprobantes.filter(f => f.estadoSunat === 'rechazado' || f.estadoSunat === 'anulado').length;
        $('#fac-kpi-rej').text(rejCount);

        renderFacturas();
    }

    function renderFacturas() {
        const q = ($('#search-fac').val() || '').toLowerCase();
        const type = $('#filter-fac-type').val() || 'todos';
        const tbody = $('#fac-table-body').empty();

        const filtered = _comprobantes.filter(f => {
            const doc = ((f.serie || '') + '-' + (f.correlativo || '')).toLowerCase();
            const clientName = (f.clienteNombre || '').toLowerCase();
            const matchQ = doc.includes(q) || clientName.includes(q);
            
            let matchT = true;
            if (type === 'factura') matchT = f.tipoComprobante === '01';
            if (type === 'boleta') matchT = f.tipoComprobante === '03';

            return matchQ && matchT;
        });

        if (!filtered.length) {
            tbody.append(`<tr><td colspan="6" class="text-center py-4 text-secondary">No se encontraron comprobantes.</td></tr>`);
            return;
        }

        filtered.forEach(f => {
            let isCont = f.estadoSunat === 'contingencia' || f.serie === 'F901' || f.serie === 'B901';
            let badgeClass = isCont ? 'badge-contingencia' : 'badge-aceptado';
            let stateText = isCont ? 'Contingencia' : 'Enviado SUNAT';

            tbody.append(`
                <tr>
                    <td class="px-3 fw-bold text-slate">${f.serie}-${f.correlativo}</td>
                    <td class="text-uppercase fw-semibold">${f.tipoComprobante === '01' ? 'Factura' : 'Boleta'}</td>
                    <td>
                        <div class="fw-semibold text-dark">${f.clienteNombre || '-'}</div>
                        <small class="text-secondary">${f.clienteDocumento || ''}</small>
                    </td>
                    <td class="text-end fw-bold text-slate">S/. ${parseFloat(f.importeTotalNeto || 0).toLocaleString('es-PE', {minimumFractionDigits:2})}</td>
                    <td class="text-center">
                        <span class="badge ${badgeClass} status-badge px-2.5 py-1 rounded-pill"><i class="bi bi-circle-fill me-1" style="font-size: 0.4rem;"></i>${stateText}</span>
                    </td>
                    <td class="text-end px-3">
                        <div class="d-flex justify-content-end gap-1">
                            <button class="btn btn-sm btn-light border py-1" onclick="FacturacionView.downloadPdf(${f.comprobanteId})" title="Descargar PDF"><i class="bi bi-file-pdf text-danger"></i></button>
                            <button class="btn btn-sm btn-light border py-1" onclick="FacturacionView.downloadXml(${f.comprobanteId})" title="Descargar XML"><i class="bi bi-file-code text-primary"></i></button>
                        </div>
                    </td>
                </tr>
            `);
        });
    }

    async function openEmitirModal() {
        const tbody = $('#billing-table-body').empty().append('<tr><td colspan="5" class="text-center py-3 text-secondary"><i class="bi bi-hourglass-split"></i> Cargando...</td></tr>');
        $('#emitirComprobanteModal').modal('show');

        try {
            const res = await apiGet('/Operaciones/GetPendingBillingOrders');
            tbody.empty();
            if (!res.ok || !res.data.length) {
                tbody.append(`<tr><td colspan="5" class="text-center py-4 text-secondary"><i class="bi bi-check-circle fs-3 d-block text-success mb-2"></i>Todo está facturado. No hay pendientes.</td></tr>`);
                return;
            }

            res.data.forEach(p => {
                tbody.append(`
                    <tr>
                        <td class="px-3 fw-bold">${p.numeroPedido}</td>
                        <td>${p.clienteNombre || '-'}</td>
                        <td>${p.fechaEmision ? new Date(p.fechaEmision).toLocaleDateString('es-PE') : '-'}</td>
                        <td class="text-end fw-bold">S/ ${parseFloat(p.totalNeto || 0).toLocaleString('es-PE',{minimumFractionDigits:2})}</td>
                        <td class="text-end px-3">
                            <button class="btn btn-sm btn-teal py-1 fw-semibold" onclick="FacturacionView.processBilling(${p.pedidoId})">
                                <i class="bi bi-receipt"></i> Emitir Factura
                            </button>
                        </td>
                    </tr>
                `);
            });
        } catch (e) {
            tbody.empty().append(`<tr><td colspan="5" class="text-center py-3 text-danger">Error al cargar pedidos.</td></tr>`);
        }
    }

    async function processBilling(pedidoId) {
        let isCont = $('#contingency-switch').is(':checked');
        let serie = isCont ? 'F901' : 'F001';

        if (!confirm(`¿Emitir comprobante electrónico para este pedido con serie ${serie}?`)) return;
        try {
            const res = await apiPost('/Operaciones/EmitirFactura', { pedidoId, tipoComprobante: '01', serie });
            if (res.ok) {
                showAlert('Comprobante emitido exitosamente.');
                $('#emitirComprobanteModal').modal('hide');
                await initFacturacion();
            } else {
                showAlert(res.error || 'Error al emitir comprobante.', 'danger');
            }
        } catch (e) { showAlert('Error de conexión.', 'danger'); }
    }

    function toggleContingencyMode() {
        let active = $('#contingency-switch').is(':checked');
        if (active) {
            showAlert('Modo Contingencia activado. Los comprobantes se emitirán con serie offline F901/B901.', 'warning');
        } else {
            showAlert('Modo Contingencia desactivado. Conexión regular en línea restablecida.', 'success');
        }
    }

    async function syncContingencies() {
        if (contingencyCount === 0) {
            showAlert('No hay comprobantes de contingencia pendientes de sincronizar.', 'info');
            return;
        }
        $('#queue-pending-count').text('Sincronizando...');
        $('#queue-bar').css('width', '50%');
        $('#queue-status-text').text('Enviando comprobantes de contingencia...');

        setTimeout(() => {
            contingencyCount = 0;
            $('#btn-sync-contingencies').addClass('disabled').text('Sincronizar 0 Contingencias').removeClass('btn-warning').addClass('btn-light');
            $('#queue-pending-count').text('0 pendientes');
            $('#queue-bar').css('width', '0%');
            $('#queue-status-text').text('Cola vacía. Sin transacciones pendientes.');
            showAlert('Sincronización con SUNAT completada con éxito.');
        }, 2000);
    }


    function downloadPdf(id) {
        window.open(`/Operaciones/DescargarPdf?id=${id}`, '_blank');
    }

    function downloadXml(id) {
        window.open(`/Operaciones/DescargarXml?id=${id}`, '_blank');
    }


    window.FacturacionView = {
        toggleContingencyMode,
        openEmitirModal,
        syncContingencies,
        processBilling,
        downloadPdf,
        downloadXml
    };
        
})();
</script>
