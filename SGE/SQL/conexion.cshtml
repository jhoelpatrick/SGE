using System;
using Npgsql; // Make sure to install this NuGet package

class Program
{
    static void Main()
    {
        // 1. Define your connection string
        string connectionString = "Host=db.YOUR_SUPABASE_PROJECT.supabase.co;Database=postgres;Username=postgres;Password=YOUR_PASSWORD;Port=5432;SSL Mode=Require;Trust Server Certificate=true";

        // 2. Use the 'using' statement to ensure the connection closes automatically
        using (NpgsqlConnection connection = new NpgsqlConnection(connectionString))
        {
            try
            {
                // 3. Open the connection
                connection.Open();
                Console.WriteLine("Connection successful! 'sge_crm' is ready for action.");
                
                // Your database queries go here
            }
            catch (PostgresException ex)
            {
                Console.WriteLine($"Database connection error: {ex.Message}");
            }
            catch (Exception ex)
            {
                Console.WriteLine($"An unexpected error occurred: {ex.Message}");
            }
        }
    }
}