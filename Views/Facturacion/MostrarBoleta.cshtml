@model SyS_ERP.Models.ViewModels.Comprobante
@{
    ViewData["Title"] = "Boleta/Factura";
    Layout = null; // Vista de impresión sin layout
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>@(Model.Tipo == "01" ? "Factura" : "Boleta") @Model.Serie-@Model.Numero</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Courier New', monospace; font-size: 12px; background: #fff; color: #000; padding: 20px; max-width: 380px; margin: 0 auto; }
        .header { text-align: center; border-bottom: 2px dashed #000; padding-bottom: 10px; margin-bottom: 10px; }
        .empresa { font-size: 16px; font-weight: bold; }
        .ruc { font-size: 11px; color: #333; }
        .tipo-doc { font-size: 14px; font-weight: bold; border: 1px solid #000; padding: 4px 12px; display: inline-block; margin: 6px 0; }
        .section { margin: 8px 0; }
        .section-label { font-weight: bold; font-size: 11px; border-bottom: 1px dashed #999; margin-bottom: 4px; }
        .row-info { display: flex; justify-content: space-between; margin: 2px 0; }
        .row-info span:first-child { color: #555; }
        .totales { border-top: 2px solid #000; padding-top: 8px; margin-top: 8px; }
        .total-final { font-size: 15px; font-weight: bold; }
        .qr-section { text-align: center; margin-top: 12px; border-top: 1px dashed #999; padding-top: 10px; }
        .qr-cadena { font-size: 9px; word-break: break-all; color: #333; margin-top: 6px; }
        .footer { text-align: center; margin-top: 12px; font-size: 10px; color: #666; border-top: 1px dashed #999; padding-top: 8px; }
        @@media print { body { padding: 5px; } .no-print { display: none; } }
    </style>
</head>
<body>
    <!-- Botón imprimir -->
    <div class="no-print" style="text-align:center;margin-bottom:15px;">
        <button onclick="window.print()" style="background:#7c3aed;color:#fff;border:none;padding:8px 20px;border-radius:6px;cursor:pointer;font-size:13px;">
            🖨️ Imprimir / Guardar PDF
        </button>
    </div>

    <!-- Cabecera -->
    <div class="header">
        <div class="empresa">BUSINESSMANAGER CORP SAC</div>
        <div class="ruc">RUC: 20123456789</div>
        <div style="font-size:11px;">Jr. Los Álamos 123 — Lima, Perú</div>
        <div style="font-size:11px;">Tel: (01) 234-5678</div>
        <div class="tipo-doc">@(Model.Tipo == "01" ? "FACTURA ELECTRÓNICA" : "BOLETA DE VENTA")</div>
        <div style="font-weight:bold;">@Model.Serie — @Model.Numero</div>
    </div>

    <!-- Datos del cliente -->
    <div class="section">
        <div class="section-label">CLIENTE</div>
        <div class="row-info"><span>Nombre/Razón:</span><span>@Model.Cliente</span></div>
        <div class="row-info"><span>Tipo Doc.:</span><span>@(Model.TipoDocCliente == "6" ? "RUC" : "DNI")</span></div>
        <div class="row-info"><span>N° Documento:</span><span>@Model.NumDocCliente</span></div>
        <div class="row-info"><span>Fecha Emisión:</span><span>@Model.FechaEmision</span></div>
    </div>

    <!-- Detalle (simulado) -->
    <div class="section">
        <div class="section-label">DETALLE</div>
        <div style="display:flex;justify-content:space-between;font-weight:bold;font-size:11px;border-bottom:1px solid #000;padding-bottom:3px;">
            <span style="flex:2">DESCRIPCIÓN</span>
            <span>CANT.</span>
            <span>P.U.</span>
            <span>TOTAL</span>
        </div>
        <div style="display:flex;justify-content:space-between;font-size:11px;padding-top:3px;">
            <span style="flex:2">Servicio / Producto</span>
            <span>1</span>
            <span>@Model.SubTotal.ToString("N2")</span>
            <span>@Model.SubTotal.ToString("N2")</span>
        </div>
    </div>

    <!-- Totales -->
    <div class="totales">
        <div class="row-info"><span>Subtotal:</span><span>S/. @Model.SubTotal.ToString("N2")</span></div>
        <div class="row-info"><span>IGV (18%):</span><span>S/. @Model.IGV.ToString("N2")</span></div>
        <div class="row-info total-final"><span>TOTAL:</span><span>S/. @Model.Total.ToString("N2")</span></div>
    </div>

    <!-- QR Fiscal -->
    <div class="qr-section">
        <div style="font-weight:bold;font-size:11px;margin-bottom:6px;">CÓDIGO QR — SUNAT</div>
        <img src="https://api.qrserver.com/v1/create-qr-code/?size=110x110&data=@(Uri.EscapeDataString(Model.CadenaQR))" alt="QR Fiscal" style="display:block;margin:0 auto;width:110px;height:110px;" />
        <div class="qr-cadena" style="margin-top:6px;font-size:8px;">@Model.CadenaQR</div>
        <div style="font-size:9px;color:#888;margin-top:4px;">
            Representación impresa del comprobante electrónico.
            Verifique en: <strong>sunat.gob.pe</strong>
        </div>
    </div>

    <!-- Footer -->
    <div class="footer">
        <p>¡Gracias por su compra!</p>
        <p>Documento válido para efectos tributarios</p>
    </div>
</body>
</html>
