    function eliminarFilaGrid(index) {
        const tr = document.getElementById(`fila_${index}`);
        if (tr) {
            tr.remove();
            calcularTotalesGenerales();
        }
    }

    function recalcularFila(index) {
        const cant = parseFloat(document.getElementById(`cant_${index}`).value) || 0;
        const precio = parseFloat(document.getElementById(`precio_${index}`).value) || 0;
        const desc = parseFloat(document.getElementById(`desc_${index}`).value) || 0;
        const afectacion = document.getElementById(`afectacion_${index}`).value;

        let valUnit = 0;
        let igv = 0;
        let total = 0;

        if (afectacion === '10') {
            // Gravada: Precio incluye IGV, por lo tanto calculamos el valor unitario restándolo
            valUnit = precio / 1.18;
            igv = (valUnit * 0.18) * cant - desc;
            total = (precio * cant) - desc;
        } else {
            // Exonerado o Inafecto: No aplica tasa del 18%
            valUnit = precio;
            igv = 0;
            total = (precio * cant) - desc;
        }

        if (total < 0) total = 0;
        if (igv < 0) igv = 0;

        document.getElementById(`valUnit_${index}`).value = valUnit.toFixed(2);
        document.getElementById(`lblIgv_${index}`).textContent = igv.toFixed(2);
        document.getElementById(`lblTotal_${index}`).textContent = total.toFixed(2);

        calcularTotalesGenerales();
    }

    // ── Totales Generales e Impuestos ───────────────────────────────────────
    function calcularTotalesGenerales() {
        let gravadas = 0;
        let exoneradas = 0;
        let inafectas = 0;
        let igvTotal = 0;

        // Iterar sobre todas las filas cargadas en el DOM
        const rows = document.querySelectorAll('#gridBody tr');
        rows.forEach(r => {
            const idx = r.id.split('_')[1];
            const afectacion = document.getElementById(`afectacion_${idx}`).value;
            const cant = parseFloat(document.getElementById(`cant_${idx}`).value) || 0;
            const valUnit = parseFloat(document.getElementById(`valUnit_${idx}`).value) || 0;
            const desc = parseFloat(document.getElementById(`desc_${idx}`).value) || 0;
            const igv = parseFloat(document.getElementById(`lblIgv_${idx}`).textContent) || 0;

            const base = (valUnit * cant) - desc;

            if (afectacion === '10') {
                gravadas += base;
                igvTotal += igv;
            } else if (afectacion === '20') {
                exoneradas += base;
            } else if (afectacion === '30') {
                inafectas += base;
            }
        });

        const descGlobal = parseFloat(document.getElementById('descuentoGlobal').value) || 0;
        const totalNeto = (gravadas + exoneradas + inafectas + igvTotal) - descGlobal;

        document.getElementById('totGravada').textContent = `S/. ${gravadas.toFixed(2)}`;
        document.getElementById('totExonerada').textContent = `S/. ${exoneradas.toFixed(2)}`;
        document.getElementById('totInafecta').textContent = `S/. ${inafectas.toFixed(2)}`;
        document.getElementById('totIgv').textContent = `S/. ${igvTotal.toFixed(2)}`;

        // Cálculos Especiales (Detracción, Retención)
        const especial = document.getElementById('impuestoEspecial').value;
        const divEsp = document.getElementById('divDetalleEspecial');
        const lblEspValor = document.getElementById('lblEspecialValor');
        const lblEspLabel = document.getElementById('lblEspecialLabel');

        if (especial === 'NINGUNO') {
            divEsp.classList.add('d-none');
        } else {
            divEsp.classList.remove('d-none');
            if (especial === 'DETRACCION_4') {
                lblEspLabel.textContent = 'Detracción (4% - Fondos Cuenta Nación):';
                lblEspValor.textContent = `S/. ${(totalNeto * 0.04).toFixed(2)}`;
            } else if (especial === 'DETRACCION_10') {
                lblEspLabel.textContent = 'Detracción (10% - Fondos Cuenta Nación):';
                lblEspValor.textContent = `S/. ${(totalNeto * 0.10).toFixed(2)}`;
            } else if (especial === 'RETENCION_3') {
                lblEspLabel.textContent = 'Retención del IGV (3%):';
                lblEspValor.textContent = `S/. ${(totalNeto * 0.03).toFixed(2)}`;
            } else if (especial === 'PERCEPCION_2') {
                lblEspLabel.textContent = 'Percepción del IGV (2%):';
                lblEspValor.textContent = `S/. ${(totalNeto * 0.02).toFixed(2)}`;
            }
        }

        const moneda = document.getElementById('comprobanteMoneda').value;
        const prefijo = moneda === 'USD' ? '$' : 'S/.';
        document.getElementById('valTotalFinal').textContent = `${prefijo} ${totalNeto.toFixed(2)}`;

        // Actualizar Monto en Letras
        document.getElementById('montoLetras').textContent = numeroALetras(totalNeto);

        // Actualizar datos de cuotas si es Crédito
        actualizarMontosCuotasCrédito();
    }

    // ── Condición de Pago y Generación de Cuotas ───────────────────────────
    function toggleCondicionPago() {
        const cond = document.getElementById('condicionPago').value;
        const bContado = document.getElementById('bloqueContado');
        const bCredito = document.getElementById('bloqueCredito');

        if (cond === 'Contado') {
            bContado.classList.remove('d-none');
            bCredito.classList.add('d-none');
        } else {
            bContado.classList.add('d-none');
            bCredito.classList.remove('d-none');
            // Inicializar al menos una cuota
            document.getElementById('cuotasBody').innerHTML = '';
            cuotaIndex = 0;
            agregarFilaCuota();
        }
    }

    function agregarFilaCuota() {
        const body = document.getElementById('cuotasBody');
        const tr = document.createElement('tr');
        tr.id = `cuota_${cuotaIndex}`;

        // Obtener fecha del vencimiento propuesta (+30 días por cuota)
        const baseDate = new Date();
        baseDate.setDate(baseDate.getDate() + (30 * (cuotaIndex + 1)));
        const dateStr = baseDate.toISOString().split('T')[0];

        tr.innerHTML = `
            <td><strong class="mono-text">Cuota ${cuotaIndex + 1}</strong></td>
            <td><input type="date" class="erp-input w-100 text-center" id="cuotaVenc_${cuotaIndex}" value="${dateStr}" onchange="actualizarMontosCuotasCrédito()"></td>
            <td><input type="number" class="erp-input w-100 text-end font-weight-bold" id="cuotaMonto_${cuotaIndex}" value="0.00" step="0.01" oninput="actualizarMontosCuotasCrédito()"></td>
            <td>
                <button type="button" class="action-btn action-btn-del" onclick="eliminarFilaCuota(${cuotaIndex})" title="Eliminar"><i class="bi bi-trash-fill"></i></button>
            </td>
        `;
        body.appendChild(tr);
        cuotaIndex++;
        actualizarMontosCuotasCrédito();
    }

    function eliminarFilaCuota(idx) {
        const tr = document.getElementById(`cuota_${idx}`);
        if (tr) {
            tr.remove();
            actualizarMontosCuotasCrédito();
        }
    }

    function actualizarMontosCuotasCrédito() {
        const cond = document.getElementById('condicionPago').value;
        if (cond !== 'Credito') return;

        let totalSuma = 0;
        const rows = document.querySelectorAll('#cuotasBody tr');
        
        // Sumar todas las cuotas
        rows.forEach(r => {
            const idx = r.id.split('_')[1];
            const m = parseFloat(document.getElementById(`cuotaMonto_${idx}`).value) || 0;
            totalSuma += m;
        });

        // Obtener total final neto de la factura
        const totalNetoStr = document.getElementById('valTotalFinal').textContent.replace('S/. ', '').replace('$', '');
        const totalNeto = parseFloat(totalNetoStr) || 0;

        const alerta = document.getElementById('alertaCuotasTotal');
        const lblSuma = document.getElementById('valSumaCuotas');
        const lblNeto = document.getElementById('valTotalNetoCuotas');

        lblSuma.textContent = `S/. ${totalSuma.toFixed(2)}`;
        lblNeto.textContent = `S/. ${totalNeto.toFixed(2)}`;

        // Validar si coinciden los montos
        if (Math.abs(totalSuma - totalNeto) > 0.01) {
            alerta.classList.remove('d-none');
        } else {
            alerta.classList.add('d-none');
        }
    }

    // ── Enviar y Firmar CPE a SUNAT (Simulación Asíncrona OSE) ────────────────
    async function enviarFacturaSUNATFinal() {
        const cliente = document.getElementById('clienteNombre').value;
        const ruc = document.getElementById('clienteNumero').value;

        if (!cliente || !ruc) {
            Swal.fire({ text: 'Debes ingresar los datos del cliente en la Pestaña 1.', icon: 'warning', confirmButtonColor: '#7c3aed', background: '#1e1b2e', color: '#e2e8f0' });
            irATab('cabecera-tab');
            return;
        }

        // Armar el array de productos del grid dinámico
        const items = [];
        const rows = document.querySelectorAll('#gridBody tr');
        
        if (rows.length === 0) {
            Swal.fire({ text: 'Debes agregar al menos un producto en la Pestaña 2.', icon: 'warning', confirmButtonColor: '#7c3aed', background: '#1e1b2e', color: '#e2e8f0' });
            irATab('detalle-tab');
            return;
        }

        rows.forEach(r => {
            const idx = r.id.split('_')[1];
            items.push({
                producto: document.getElementById(`prod_${idx}`).value,
                sku: document.getElementById(`sku_${idx}`).value,
                codigoSunat: document.getElementById(`sunat_${idx}`).value,
                unidadMedida: document.getElementById(`um_${idx}`).value,
                cantidad: parseFloat(document.getElementById(`cant_${idx}`).value) || 0,
                precioUnitario: parseFloat(document.getElementById(`precio_${idx}`).value) || 0,
                valorUnitario: parseFloat(document.getElementById(`valUnit_${idx}`).value) || 0,
                descuento: parseFloat(document.getElementById(`desc_${idx}`).value) || 0,
                afectacionIgv: document.getElementById(`afectacion_${idx}`).value,
                igv: parseFloat(document.getElementById(`lblIgv_${idx}`).textContent) || 0,
                total: parseFloat(document.getElementById(`lblTotal_${idx}`).textContent) || 0
            });
        });

        // Obtener montos agregados
        const totalNetoStr = document.getElementById('valTotalFinal').textContent.replace('S/. ', '').replace('$', '');
        const totalNeto = parseFloat(totalNetoStr) || 0;
        const totalIgv = parseFloat(document.getElementById('totIgv').textContent.replace('S/. ', '')) || 0;
        const totalGravada = parseFloat(document.getElementById('totGravada').textContent.replace('S/. ', '')) || 0;
        const totalExonerada = parseFloat(document.getElementById('totExonerada').textContent.replace('S/. ', '')) || 0;
        const totalInafecta = parseFloat(document.getElementById('totInafecta').textContent.replace('S/. ', '')) || 0;

        // Validar cuotas si es crédito
        const cond = document.getElementById('condicionPago').value;
        const cuotas = [];
        if (cond === 'Credito') {
            const cRows = document.querySelectorAll('#cuotasBody tr');
            let sumCuotas = 0;
            cRows.forEach(r => {
                const idx = r.id.split('_')[1];
                const m = parseFloat(document.getElementById(`cuotaMonto_${idx}`).value) || 0;
                sumCuotas += m;
                cuotas.push({
                    numero: parseInt(idx) + 1,
                    fechaVencimiento: document.getElementById(`cuotaVenc_${idx}`).value,
                    monto: m
                });
            });

            if (Math.abs(sumCuotas - totalNeto) > 0.01) {
                Swal.fire({ text: 'La suma de las cuotas de crédito debe ser exactamente igual al total neto.', icon: 'error', confirmButtonColor: '#e85d9c', background: '#1e1b2e', color: '#e2e8f0' });
                irATab('pagos-tab');
                return;
            }
        }

        const payload = {
            tipoComprobante: document.getElementById('tipoComprobante').value,
            serie: document.getElementById('comprobanteSerie').value,
            numero: document.getElementById('comprobanteNumero').value,
            fechaEmision: document.getElementById('comprobanteFecha').value,
            moneda: document.getElementById('comprobanteMoneda').value,
            tipoCambio: parseFloat(document.getElementById('tipoCambio').value) || 1.00,
            tipoOperacion: document.getElementById('tipoOperacion').value,
            referenciaDoc: document.getElementById('referenciaDoc').value,
            
            clienteTipoDoc: document.getElementById('clienteTipoDoc').value,
            clienteNumero: ruc,
            clienteNombre: cliente,
            clienteDireccion: document.getElementById('clienteDireccion').value,
            clienteUbigeo: document.getElementById('clienteUbigeo').value,
            clienteEmail: document.getElementById('clienteEmail').value,

            totalGravada: totalGravada,
            totalExonerada: totalExonerada,
            totalInafecta: totalInafecta,
            totalIgv: totalIgv,
            totalNeto: totalNeto,
            montoLetras: document.getElementById('montoLetras').textContent,

            condicionPago: cond,
            metodoPago: document.getElementById('pagoMetodo').value,
            banco: document.getElementById('pagoBanco').value,
            cuentaBancaria: document.getElementById('pagoCuenta').value,
            numeroOperacion: document.getElementById('pagoOperacion').value,
            cuotas: cuotas,
            
            items: items
        };

        // Animación OSE Timeline en Tab 5
        irATab('auditoria-tab');
        document.getElementById('btnEnviarSUNAT').disabled = true;

        // 1. Borrador -> Firmado (1s)
        document.getElementById('timelineProgress').style.width = '25%';
        document.getElementById('dotBorrador').classList.add('bg-success');

        setTimeout(() => {
            // 2. Firmado -> En Cola (1s)
            document.getElementById('timelineProgress').style.width = '50%';
            document.getElementById('dotFirmado').classList.add('bg-success');

            setTimeout(() => {
                // 3. En Cola -> Enviado (1s)
                document.getElementById('timelineProgress').style.width = '75%';
                document.getElementById('dotEnCola').classList.add('bg-success');

                setTimeout(async () => {
                    // 4. Enviar datos reales y completar aceptado
                    try {
                        const res = await fetch('/Facturacion/Emitir', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(payload)
                        });
                        const data = await res.json();

                        if (data.success) {
                            document.getElementById('timelineProgress').style.width = '100%';
                            document.getElementById('dotEnviado').classList.add('bg-success');
                            document.getElementById('dotAceptado').classList.add('bg-success');

                            // Rellenar metadatos devueltos
                            document.getElementById('auditUuid').value = data.uuid;
                            document.getElementById('auditHash').value = data.hash;

                            // Habilitar descargas XML/CDR
                            document.getElementById('divSunatArchivos').style.display = 'block';

                            Swal.fire({
                                title: '¡Comprobante Aceptado!',
                                html: `<p>${data.message}</p><small style="color:var(--accent-cyan)">Código Hash: ${data.hash}</small>`,
                                icon: 'success',
                                confirmButtonColor: '#10b981',
                                background: '#1e1b2e',
                                color: '#e2e8f0'
                            });
                        } else {
                            Swal.fire({ text: data.message, icon: 'error', confirmButtonColor: '#ef4444', background: '#1e1b2e', color: '#e2e8f0' });
                            resetTimeline();
                        }
                    } catch(e) {
                        Swal.fire({ text: 'Error al conectar con la OSE.', icon: 'error', confirmButtonColor: '#ef4444', background: '#1e1b2e', color: '#e2e8f0' });
                        resetTimeline();
                    }
                }, 1000);
            }, 1000);
        }, 1000);
    }

    function resetTimeline() {
        document.getElementById('btnEnviarSUNAT').disabled = false;
        document.getElementById('timelineProgress').style.width = '0%';
        document.getElementById('dotFirmado').classList.remove('bg-success');
        document.getElementById('dotEnCola').classList.remove('bg-success');
        document.getElementById('dotEnviado').classList.remove('bg-success');
        document.getElementById('dotAceptado').classList.remove('bg-success');
    }

    function descargarXMLSimulado() {
        Swal.fire({ text: 'Descargando XML estructurado bajo esquema UBL 2.1...', icon: 'info', timer: 1500, showConfirmButton: false, background: '#1e1b2e', color: '#e2e8f0' });
    }

    function descargarCDRSSimulado() {
        Swal.fire({ text: 'Descargando Constancia de Recepción SUNAT (CDR)...', icon: 'success', timer: 1500, showConfirmButton: false, background: '#1e1b2e', color: '#e2e8f0' });
    }
</script>
}
