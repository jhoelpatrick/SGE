@{
    ViewData["Title"] = "Emitir Factura SUNAT";
}

<div class="dash-header">
    <div>
        <h1><i class="bi bi-file-earmark-plus-fill me-2 text-accent-cyan"></i><span class="gradient-text">Emisión Facturación SUNAT</span></h1>
        <p class="dash-subtitle">Comprobante de Pago Electrónico (UBL 2.1) · Homologación OSE/SUNAT Perú</p>
    </div>
    <a asp-controller="Facturacion" asp-action="Index" class="btn-back">
        <i class="bi bi-arrow-left me-1"></i> Comprobantes
    </a>
</div>

<!-- FORMULARIO TABS ENTERPRISE -->
<div class="chart-card">
    <!-- Pestañas (Tabs) -->
    <ul class="nav nav-tabs module-tabs mb-4" id="facturaTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="cabecera-tab" data-bs-toggle="tab" data-bs-target="#cabecera" type="button" role="tab">
                🏛️ Comprobante & Cliente
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="detalle-tab" data-bs-toggle="tab" data-bs-target="#detalle" type="button" role="tab">
                📦 Detalle de Ítems
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="totales-tab" data-bs-toggle="tab" data-bs-target="#totales" type="button" role="tab">
                💰 Impuestos & Totales
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="pagos-tab" data-bs-toggle="tab" data-bs-target="#pagos" type="button" role="tab">
                💳 Condición de Pago
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="auditoria-tab" data-bs-toggle="tab" data-bs-target="#auditoria" type="button" role="tab">
                🔒 Auditoría & SUNAT
            </button>
        </li>
    </ul>

    <div class="tab-content" id="facturaTabsContent">
        
        <!-- TAB 1: DATOS COMPROBANTE Y CLIENTE -->
        <div class="tab-pane fade show active" id="cabecera" role="tabpanel">
            <div class="row g-4">
                <!-- Datos del Comprobante -->
                <div class="col-12 col-lg-6">
                    <div class="p-3 rounded border border-color h-100" style="background: rgba(255,255,255,0.01);">
                        <h6 class="text-accent-cyan mb-3"><i class="bi bi-file-earmark-text-fill me-1"></i>Datos del Comprobante</h6>
                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <label class="form-label-erp">Tipo Comprobante</label>
                                <select class="erp-select w-100" id="tipoComprobante" onchange="actualizarSerieCorrelativo()">
                                    <option value="01">Factura Electrónica (F001)</option>
                                    <option value="03">Boleta de Venta (B001)</option>
                                    <option value="07">Nota de Crédito (FC01)</option>
                                    <option value="08">Nota de Débito (FD01)</option>
                                </select>
                            </div>
                            <div class="col-3">
                                <label class="form-label-erp">Serie</label>
                                <input type="text" class="erp-input w-100 text-center mono-text" id="comprobanteSerie" value="F001" readonly style="opacity: 0.8;">
                            </div>
                            <div class="col-3">
                                <label class="form-label-erp">Correlativo</label>
                                <input type="text" class="erp-input w-100 text-center mono-text" id="comprobanteNumero" value="00000126">
                            </div>
                        </div>

                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <label class="form-label-erp">Fecha y Hora de Emisión</label>
                                <input type="datetime-local" class="erp-input w-100" id="comprobanteFecha" required>
                            </div>
                            <div class="col-6">
                                <label class="form-label-erp">Tipo de Operación SUNAT</label>
                                <select class="erp-select w-100" id="tipoOperacion">
                                    <option value="0101">Venta Interna</option>
                                    <option value="0102">Exportación de Bienes</option>
                                    <option value="0103">No Domiciliados</option>
                                    <option value="0200">Venta Interna - Anticipo</option>
                                </select>
                            </div>
                        </div>

                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <label class="form-label-erp">Moneda</label>
                                <select class="erp-select w-100" id="comprobanteMoneda" onchange="toggleTipoCambio()">
                                    <option value="PEN">Soles (S/.)</option>
                                    <option value="USD">Dólares ($)</option>
                                </select>
                            </div>
                            <div class="col-6" id="divTipoCambio" style="display:none;">
                                <label class="form-label-erp">Tipo de Cambio</label>
                                <input type="number" class="erp-input w-100" id="tipoCambio" value="3.75" step="0.001">
                            </div>
                        </div>

                        <!-- Referencia Doc (se activa si es Nota de Crédito/Débito) -->
                        <div class="mb-2" id="divReferencia" style="display:none;">
                            <label class="form-label-erp">Documento de Referencia / Motivo</label>
                            <input type="text" class="erp-input w-100" id="referenciaDoc" placeholder="Ej: F001-00000120 | Anulación de la operación">
                        </div>
                    </div>
                </div>

                <!-- Datos del Cliente -->
                <div class="col-12 col-lg-6">
                    <div class="p-3 rounded border border-color h-100" style="background: rgba(255,255,255,0.01);">
                        <h6 class="text-accent-purple mb-3"><i class="bi bi-person-fill-check me-1"></i>Datos del Cliente</h6>
                        
                        <div class="row g-2 mb-3 align-items-end">
                            <div class="col-4">
                                <label class="form-label-erp">Tipo Doc.</label>
                                <select class="erp-select w-100" id="clienteTipoDoc" onchange="ajustarMascaraDocumento()">
                                    <option value="6">RUC</option>
                                    <option value="1">DNI</option>
                                </select>
                            </div>
                            <div class="col-5">
                                <label class="form-label-erp">Número de Documento</label>
                                <input type="text" class="erp-input w-100 mono-text" id="clienteNumero" placeholder="Ingresa RUC" value="20456789001">
                            </div>
                            <div class="col-3">
                                <button type="button" class="btn btn-period w-100 py-2" id="btnBuscarCliente" onclick="simularBuscarSUNAT()">
                                    <i class="bi bi-search me-1"></i> Buscar
                                </button>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label-erp">Razón Social / Nombre Completo</label>
                            <input type="text" class="erp-input w-100" id="clienteNombre" placeholder="Razón social del cliente">
                        </div>

                        <div class="mb-3">
                            <label class="form-label-erp">Dirección Fiscal</label>
                            <input type="text" class="erp-input w-100" id="clienteDireccion" placeholder="Dirección del cliente">
                        </div>

                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <label class="form-label-erp">Ubigeo (Distrito / Prov / Dep)</label>
                                <input type="text" class="erp-input w-100" id="clienteUbigeo" placeholder="Lima - Lima - San Isidro">
                            </div>
                            <div class="col-6">
                                <label class="form-label-erp">Correo de Envío (XML/PDF)</label>
                                <input type="email" class="erp-input w-100" id="clienteEmail" placeholder="cliente@correo.com">
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center bg-surface p-2 rounded border border-color">
                            <span style="font-size:0.75rem; color:var(--text-secondary);">Estado Contribuyente:</span>
                            <span class="badge bg-success" id="lblEstadoContribuyente">ACTIVO / HABIDO</span>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="text-end mt-4">
                <button class="btn btn-secondary-erp me-2" onclick="irATab('detalle-tab')">Siguiente: Ítems <i class="bi bi-arrow-right-short"></i></button>
            </div>
        </div>

        <!-- TAB 2: DETALLE DE PRODUCTOS (GRID DINÁMICO) -->
        <div class="tab-pane fade" id="detalle" role="tabpanel">
            <div class="p-3 rounded border border-color" style="background: rgba(255,255,255,0.01);">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="text-accent-cyan m-0"><i class="bi bi-box-seam-fill me-1"></i>Detalle de Productos / Servicios</h6>
                    <button type="button" class="btn btn-period active" onclick="agregarFilaGrid()" style="background-color: var(--accent-purple); border-color: var(--accent-purple);">
                        <i class="bi bi-plus-circle me-1"></i> Añadir Fila
                    </button>
                </div>

                <div class="table-responsive">
                    <table class="erp-table align-middle" id="gridDetalle" style="font-size:0.78rem;">
                        <thead>
                            <tr>
                                <th style="width:20%;">Producto / Servicio</th>
                                <th style="width:10%;">SKU</th>
                                <th style="width:10%;">Cod. SUNAT</th>
                                <th style="width:10%;">U.M.</th>
                                <th style="width:7%;">Cant.</th>
                                <th style="width:9%;">P. Unit (con IGV)</th>
                                <th style="width:9%;">V. Unit (sin IGV)</th>
                                <th style="width:7%;">Desc.</th>
                                <th style="width:12%;">Afectación IGV</th>
                                <th style="width:8%;">IGV</th>
                                <th style="width:10%;">Total</th>
                                <th style="width:5%;">Acción</th>
                            </tr>
                        </thead>
                        <tbody id="gridBody">
                            <!-- Filas dinámicas -->
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="text-end mt-4">
                <button class="btn btn-back me-2" onclick="irATab('cabecera-tab')"><i class="bi bi-arrow-left-short"></i> Anterior</button>
                <button class="btn btn-secondary-erp" onclick="irATab('totales-tab')">Siguiente: Totales <i class="bi bi-arrow-right-short"></i></button>
            </div>
        </div>

        <!-- TAB 3: IMPUESTOS AVANZADOS Y TOTALES -->
        <div class="tab-pane fade" id="totales" role="tabpanel">
            <div class="row g-4">
                <div class="col-12 col-md-6">
                    <div class="p-3 rounded border border-color h-100" style="background: rgba(255,255,255,0.01);">
                        <h6 class="text-accent-cyan mb-3"><i class="bi bi-calculator-fill me-1"></i>Totales de la Operación</h6>
                        
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted" style="font-size:0.8rem;">Op. Gravada:</span>
                            <span id="totGravada" style="font-weight:600;">S/. 0.00</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted" style="font-size:0.8rem;">Op. Exonerada:</span>
                            <span id="totExonerada" style="font-weight:600;">S/. 0.00</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted" style="font-size:0.8rem;">Op. Inafecta:</span>
                            <span id="totInafecta" style="font-weight:600;">S/. 0.00</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted" style="font-size:0.8rem;">Op. Gratuita (Referencial):</span>
                            <span id="totGratuita" style="font-weight:600; color:var(--accent-green);">S/. 0.00</span>
                        </div>
                        
                        <hr class="border-color my-2">
                        
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted" style="font-size:0.8rem;">IGV Total (18%):</span>
                            <span id="totIgv" style="font-weight:600;">S/. 0.00</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted" style="font-size:0.8rem;">ISC / ICBPER (Bolsas):</span>
                            <span id="totIscIcbper" style="font-weight:600;">S/. 0.00</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted" style="font-size:0.8rem;">Descuento Global:</span>
                            <input type="number" class="erp-input text-end" id="descuentoGlobal" value="0.00" style="width:100px; height:26px; padding:2px 6px;" oninput="calcularTotalesGenerales()">
                        </div>

                        <hr class="border-color my-2">

                        <div class="d-flex justify-content-between align-items-center">
                            <span style="font-weight:700; font-size:1.05rem;">Importe Total Neto:</span>
                            <span class="gradient-text" style="font-weight:800; font-size:1.3rem;" id="valTotalFinal">S/. 0.00</span>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-md-6">
                    <div class="p-3 rounded border border-color h-100 d-flex flex-column justify-content-between" style="background: rgba(255,255,255,0.01);">
                        <div>
                            <h6 class="text-accent-purple mb-3"><i class="bi bi-bank2 me-1"></i>Retenciones, Detracciones & Percepciones</h6>
                            
                            <div class="mb-3">
                                <label class="form-label-erp">Tipo de Impuesto Especial Aplicable</label>
                                <select class="erp-select w-100" id="impuestoEspecial" onchange="calcularTotalesGenerales()">
                                    <option value="NINGUNO">Ninguno</option>
                                    <option value="DETRACCION_4">Detracción (4% - Servicios Generales)</option>
                                    <option value="DETRACCION_10">Detracción (10% - Asesorías y Consultorías)</option>
                                    <option value="RETENCION_3">Retención del IGV (3%)</option>
                                    <option value="PERCEPCION_2">Percepción del IGV (2%)</option>
                                </select>
                            </div>

                            <div class="bg-surface p-2 rounded mb-3 border border-color d-none" id="divDetalleEspecial">
                                <div class="d-flex justify-content-between style-text" style="font-size:0.78rem;">
                                    <span id="lblEspecialLabel">Detracción Calculada:</span>
                                    <strong class="text-warning" id="lblEspecialValor">S/. 0.00</strong>
                                </div>
                            </div>
                        </div>

                        <div class="bg-purple-soft p-3 rounded border border-color">
                            <label class="form-label-erp" style="font-weight:600;"><i class="bi bi-chat-left-quote me-1"></i>Importe en Letras (SUNAT Obligatorio)</label>
                            <div id="montoLetras" style="font-family:monospace; font-size:0.76rem; color:var(--text-primary); word-break:break-word;">
                                SON: CERO CON 00/100 SOLES
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="text-end mt-4">
                <button class="btn btn-back me-2" onclick="irATab('detalle-tab')"><i class="bi bi-arrow-left-short"></i> Anterior</button>
                <button class="btn btn-secondary-erp" onclick="irATab('pagos-tab')">Siguiente: Pagos <i class="bi bi-arrow-right-short"></i></button>
            </div>
        </div>

        <!-- TAB 4: GESTIÓN DE PAGOS Y CRÉDITOS -->
        <div class="tab-pane fade" id="pagos" role="tabpanel">
            <div class="p-3 rounded border border-color" style="background: rgba(255,255,255,0.01);">
                <h6 class="text-accent-cyan mb-3"><i class="bi bi-cash-coin me-1"></i>Condición de Pago</h6>
                
                <div class="mb-3" style="max-width: 300px;">
                    <label class="form-label-erp">Condición</label>
                    <select class="erp-select w-100" id="condicionPago" onchange="toggleCondicionPago()">
                        <option value="Contado">Pago al Contado</option>
                        <option value="Credito">Venta al Crédito</option>
                    </select>
                </div>

                <!-- Bloque Contado -->
                <div id="bloqueContado" class="row g-2 mb-3">
                    <div class="col-md-6 col-lg-3">
                        <label class="form-label-erp">Método de Pago</label>
                        <select class="erp-select w-100" id="pagoMetodo">
                            <option value="Efectivo">Efectivo</option>
                            <option value="Transferencia">Transferencia Bancaria</option>
                            <option value="Tarjeta">Tarjeta Débito/Crédito</option>
                            <option value="Yape">Yape / Plin</option>
                        </select>
                    </div>
                    <div class="col-md-6 col-lg-3">
                        <label class="form-label-erp">Banco</label>
                        <select class="erp-select w-100" id="pagoBanco">
                            <option value="BCP">Banco de Crédito del Perú (BCP)</option>
                            <option value="Interbank">Interbank</option>
                            <option value="BBVA">BBVA Continental</option>
                            <option value="Scotiabank">Scotiabank</option>
                        </select>
                    </div>
                    <div class="col-md-6 col-lg-3">
                        <label class="form-label-erp">Cuenta Bancaria</label>
                        <input type="text" class="erp-input w-100 mono-text" id="pagoCuenta" value="191-99882211-0-24">
                    </div>
                    <div class="col-md-6 col-lg-3">
                        <label class="form-label-erp">Número de Operación</label>
                        <input type="text" class="erp-input w-100 mono-text" id="pagoOperacion" placeholder="Nro de Operación">
                    </div>
                </div>

                <!-- Bloque Crédito (Generador de Cuotas) -->
                <div id="bloqueCredito" class="mb-3 d-none">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="text-warning" style="font-size:0.82rem;"><i class="bi bi-calendar-range-fill me-1"></i>Cronograma de Cuotas de Pago</span>
                        <button type="button" class="btn btn-period active" onclick="agregarFilaCuota()" style="font-size:0.75rem; background-color:var(--accent-cyan); border-color:var(--accent-cyan);">
                            <i class="bi bi-plus-circle me-1"></i> Añadir Cuota
                        </button>
                    </div>
                    
                    <div class="table-responsive" style="max-width:600px;">
                        <table class="erp-table text-center align-middle" id="tablaCuotas">
                            <thead>
                                <tr>
                                    <th style="width: 20%;">N° Cuota</th>
                                    <th style="width: 50%;">Fecha de Vencimiento</th>
                                    <th style="width: 25%;">Monto a Pagar (S/.)</th>
                                    <th style="width: 5%;"></th>
                                </tr>
                            </thead>
                            <tbody id="cuotasBody">
                                <!-- Cuotas generadas -->
                            </tbody>
                        </table>
                    </div>

                    <div id="alertaCuotasTotal" class="alert alert-danger py-2 px-3 mt-2 d-none" style="max-width: 600px; font-size:0.76rem;">
                        <i class="bi bi-x-circle me-1"></i> La suma de las cuotas (<strong id="valSumaCuotas">S/. 0.00</strong>) no coincide con el total neto (<strong id="valTotalNetoCuotas">S/. 0.00</strong>).
                    </div>
                </div>
            </div>

            <div class="text-end mt-4">
                <button class="btn btn-back me-2" onclick="irATab('totales-tab')"><i class="bi bi-arrow-left-short"></i> Anterior</button>
                <button class="btn btn-secondary-erp" onclick="irATab('auditoria-tab')">Siguiente: SUNAT <i class="bi bi-arrow-right-short"></i></button>
            </div>
        </div>

        <!-- TAB 5: AUDITORÍA Y COLAS SUNAT -->
        <div class="tab-pane fade" id="auditoria" role="tabpanel">
            <div class="row g-4">
                <!-- Estado SUNAT / OSE Timeline -->
                <div class="col-12 col-lg-7">
                    <div class="p-3 rounded border border-color h-100 d-flex flex-column justify-content-between" style="background: rgba(255,255,255,0.01);">
                        <div>
                            <h6 class="text-accent-cyan mb-3"><i class="bi bi-send-check-fill me-1"></i>Estado de Envío OSE / SUNAT</h6>
                            <p class="text-muted" style="font-size:0.76rem;">Timeline asíncrono de procesamiento y homologación XML.</p>

                            <!-- Timeline Visual -->
                            <div class="d-flex justify-content-between align-items-center my-4 position-relative px-3" style="min-height: 80px;">
                                <!-- Línea de progreso de fondo -->
                                <div style="position:absolute; top:35%; left:6%; right:6%; height:4px; background:#2a2640; z-index:1; transform:translateY(-50%);">
                                    <div id="timelineProgress" style="width: 0%; height: 100%; background: var(--accent-green); transition: width 1s ease;"></div>
                                </div>

                                <div class="text-center position-relative" style="z-index:2; width:16%;">
                                    <div class="timeline-dot bg-success" id="dotBorrador"><i class="bi bi-pencil-fill"></i></div>
                                    <div class="timeline-lbl mt-2">Borrador</div>
                                </div>
                                <div class="text-center position-relative" style="z-index:2; width:16%;">
                                    <div class="timeline-dot" id="dotFirmado"><i class="bi bi-pen-fill"></i></div>
                                    <div class="timeline-lbl mt-2">Firmado</div>
                                </div>
                                <div class="text-center position-relative" style="z-index:2; width:16%;">
                                    <div class="timeline-dot" id="dotEnCola"><i class="bi bi-clock-fill"></i></div>
                                    <div class="timeline-lbl mt-2">En Cola</div>
                                </div>
                                <div class="text-center position-relative" style="z-index:2; width:16%;">
                                    <div class="timeline-dot" id="dotEnviado"><i class="bi bi-send-fill"></i></div>
                                    <div class="timeline-lbl mt-2">Enviado</div>
                                </div>
                                <div class="text-center position-relative" style="z-index:2; width:16%;">
                                    <div class="timeline-dot" id="dotAceptado"><i class="bi bi-check-all"></i></div>
                                    <div class="timeline-lbl mt-2">Aceptado</div>
                                </div>
                            </div>

                            <div class="bg-surface p-3 rounded border border-color" id="divSunatArchivos" style="display:none;">
                                <div class="d-flex flex-wrap gap-2 justify-content-center">
                                    <button class="btn btn-period active" style="font-size:0.7rem; background:#10b981;" onclick="descargarXMLSimulado()"><i class="bi bi-file-earmark-code-fill me-1"></i> XML Generado</button>
                                    <button class="btn btn-period active" style="font-size:0.7rem; background:#7c3aed;" onclick="descargarXMLSimulado()"><i class="bi bi-file-earmark-lock2-fill me-1"></i> XML Firmado</button>
                                    <button class="btn btn-period active" style="font-size:0.7rem; background:#06b6d4;" onclick="descargarCDRSSimulado()"><i class="bi bi-file-zip-fill me-1"></i> Constancia CDR</button>
                                </div>
                            </div>
                        </div>

                        <!-- Botón de Acción Principal -->
                        <div class="mt-4 pt-3 border-top border-color text-center">
                            <button type="button" class="btn-primary-erp py-2 px-5" style="font-size:1rem;" onclick="enviarFacturaSUNATFinal()" id="btnEnviarSUNAT">
                                <i class="bi bi-cloud-upload-fill me-1"></i> Firmar y Emitir CPE
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Auditoría e IDs Relacionales ERP -->
                <div class="col-12 col-lg-5">
                    <div class="p-3 rounded border border-color h-100" style="background: rgba(255,255,255,0.01);">
                        <h6 class="text-accent-purple mb-3"><i class="bi bi-shield-lock-fill me-1"></i>Auditoría & Metadatos ERP</h6>
                        
                        <div class="mb-3">
                            <label class="form-label-erp">UUID de Transacción</label>
