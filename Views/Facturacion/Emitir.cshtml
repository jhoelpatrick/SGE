    // ── Simular Búsqueda RUC/DNI (SUNAT/RENIEC) ─────────────────────────────
    function simularBuscarSUNAT() {
        const docNum = document.getElementById('clienteNumero').value;
        const btn = document.getElementById('btnBuscarCliente');
        const tipoDoc = document.getElementById('clienteTipoDoc').value;

        if (!docNum) {
            Swal.fire({ text: 'Ingresa un número de documento.', icon: 'warning', confirmButtonColor: '#7c3aed', background: '#1e1b2e', color: '#e2e8f0' });
            return;
        }

        // Validación estricta de RUC (11 dígitos) y DNI (8 dígitos)
        const cleanDoc = docNum.trim();
        const isDigits = /^\d+$/.test(cleanDoc);

        if (tipoDoc === '6') { // RUC
            if (cleanDoc.length !== 11 || !isDigits) {
                Swal.fire({ text: 'El RUC debe constar de exactamente 11 dígitos numéricos.', icon: 'error', confirmButtonColor: '#ef4444', background: '#1e1b2e', color: '#e2e8f0' });
                return;
            }
        } else if (tipoDoc === '1') { // DNI
            if (cleanDoc.length !== 8 || !isDigits) {
                Swal.fire({ text: 'El DNI debe constar de exactamente 8 dígitos numéricos.', icon: 'error', confirmButtonColor: '#ef4444', background: '#1e1b2e', color: '#e2e8f0' });
                return;
            }
        }

        btn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status"></span>...';
        btn.disabled = true;

        setTimeout(() => {
            btn.innerHTML = '<i class="bi bi-search me-1"></i> Buscar';
            btn.disabled = false;

            if (tipoDoc === '6') { // RUC
                document.getElementById('clienteNombre').value = "BUSINESS SOLUTIONS PERU S.A.C.";
                document.getElementById('clienteDireccion').value = "Av. Javier Prado Este 1024, San Isidro, Lima";
                document.getElementById('clienteUbigeo').value = "Lima - Lima - San Isidro";
                document.getElementById('clienteEmail').value = "facturacion@businesperu.pe";
                const badge = document.getElementById('lblEstadoContribuyente');
                badge.className = 'badge bg-success';
                badge.textContent = 'ACTIVO / HABIDO';
            } else { // DNI
                document.getElementById('clienteNombre').value = "LORENA BUSTAMANTE QUISPE";
                document.getElementById('clienteDireccion').value = "Jr. Las Gardenias 452, Lince, Lima";
                document.getElementById('clienteUbigeo').value = "Lima - Lima - Lince";
                document.getElementById('clienteEmail').value = "l.bustamante@gmail.com";
                const badge = document.getElementById('lblEstadoContribuyente');
                badge.className = 'badge bg-success';
                badge.textContent = 'ACTIVO / HABIDO';
            }

            Swal.fire({ text: 'Cliente hallado en la base de datos de SUNAT/RENIEC.', icon: 'success', confirmButtonColor: '#10b981', background: '#1e1b2e', color: '#e2e8f0' });
        }, 1200);
    }

