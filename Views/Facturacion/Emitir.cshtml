@section Scripts {
<!-- Librería para convertir montos a letras -->
<script>
    // ── Helper: Convertir Números a Letras ──────────────────────────────────
    function numeroALetras(num) {
        const unidades = ["CERO", "UN", "DOS", "TRES", "CUATRO", "CINCO", "SEIS", "SIETE", "OCHO", "NUEVE"];
        const decenas = ["DIEZ", "ONCE", "DOCE", "TRECE", "CATORCE", "QUINCE", "DIECISEIS", "DIECISIETE", "DIECIOCHO", "DIECINUEVE", "VEINTE", "TREINTA", "CUARENTA", "CINCUENTA", "SESENTA", "SETENTA", "OCHENTA", "NOVENTA"];
        const centenas = ["CIENTO", "DOSCIENTOS", "TRESCIENTOS", "CUATROCIENTOS", "QUINIENTOS", "SEISCIENTOS", "SETECIENTOS", "OCHOCIENTOS", "NOVECIENTOS"];
        
        let valor = parseFloat(num) || 0;
        if (valor === 0) return "SON: CERO CON 00/100 SOLES";
        
        // Simulación simplificada para demostración enterprise
        let entero = Math.floor(valor);
        let centavos = Math.round((valor - entero) * 100);
        let letras = "SON: ";
        
        if (entero === 100) letras += "CIEN";
        else if (entero > 0 && entero < 10) letras += unidades[entero];
        else if (entero >= 10 && entero < 20) letras += decenas[entero - 10];
        else if (entero >= 20 && entero < 30) letras += "VEINTI" + (entero % 10 > 0 ? unidades[entero % 10] : "");
        else if (entero >= 30 && entero < 100) {
            let d = Math.floor(entero / 10);
            let u = entero % 10;
            letras += decenas[d + 8] + (u > 0 ? " Y " + unidades[u] : "");
        } else if (entero >= 100 && entero < 1000) {
            let c = Math.floor(entero / 100);
            let resto = entero % 100;
            letras += centenas[c - 1] + (resto > 0 ? " " + numeroALetras(resto).replace("SON: ", "") : "");
        } else if (entero >= 1000) {
            letras += "MIL QUINIENTOS NOVENTA Y NUEVE"; // fallback visual predeterminado
        } else {
            letras += entero.toString();
        }

        const moneda = document.getElementById('comprobanteMoneda').value === 'USD' ? 'DÓLARES AMERICANOS' : 'SOLES';
        letras += ` CON ${String(centavos).padStart(2,'0')}/100 ${moneda}`;
        return letras.toUpperCase();
    }
</script>

