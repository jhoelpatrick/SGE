<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="SyS_ERP — Sistema de Gestión Empresarial Modular" />
    <title>@ViewData["Title"] — SyS ERP</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- SweetAlert2 -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" />
    <!-- Estilos personalizados -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

<div class="erp-wrapper">

    <!-- ══════════════════ SIDEBAR ══════════════════ -->
    <nav id="erpSidebar" class="erp-sidebar" aria-label="Navegación principal">

        <!-- Brand -->
        <a class="sidebar-brand" asp-controller="Home" asp-action="Index">
            <div class="brand-icon"><i class="bi bi-grid-3x3-gap-fill"></i></div>
            <span class="brand-text">SyS<span class="brand-accent">ERP</span></span>
        </a>

        <div class="sidebar-scroll">

            <!-- ── SECCIÓN: PRINCIPAL ─────────────────────── -->
            <div class="nav-category">
                <div class="nav-category-label">
                    <i class="bi bi-house-fill me-1"></i> Principal
                </div>
                <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")"
                   asp-controller="Home" asp-action="Index" id="nav-dashboard">
                    <i class="bi bi-speedometer2"></i>
                    <span>Dashboard</span>
                    <span class="nav-badge nav-badge-purple">Principal</span>
                </a>
            </div>

            <!-- ── SECCIÓN: GESTIÓN ───────────────────────── -->
            <div class="nav-category">
                <div class="nav-category-label" data-bs-toggle="collapse" data-bs-target="#cat-gestion" role="button">
                    <i class="bi bi-shield-check me-1"></i> Gestión
                    <i class="bi bi-chevron-down nav-cat-arrow ms-auto" id="arrow-gestion"></i>
                </div>
                <div class="collapse show" id="cat-gestion">
                    <a class="nav-item nav-item-dev" href="#" onclick="modEnDesarrollo('Usuarios');return false;">
                        <i class="bi bi-people-fill"></i><span>Usuarios</span>
                    </a>
                    <a class="nav-item nav-item-dev" href="#" onclick="modEnDesarrollo('Configuración');return false;">
                        <i class="bi bi-gear-fill"></i><span>Configuración</span>
                    </a>
                    <a class="nav-item nav-item-dev" href="#" onclick="modEnDesarrollo('Auditoría');return false;">
                        <i class="bi bi-journal-check"></i><span>Auditoría</span>
                    </a>
                </div>
            </div>

            <!-- ── SECCIÓN: COMERCIAL ─────────────────────── -->
            <div class="nav-category">
                <div class="nav-category-label" data-bs-toggle="collapse" data-bs-target="#cat-comercial" role="button">
                    <i class="bi bi-shop me-1"></i> Comercial
                    <i class="bi bi-chevron-down nav-cat-arrow ms-auto" id="arrow-comercial"></i>
                </div>
                <div class="collapse show" id="cat-comercial">
                    <a class="nav-item nav-item-dev" href="#" onclick="modEnDesarrollo('Clientes');return false;">
                        <i class="bi bi-person-lines-fill"></i><span>Clientes</span>
                    </a>
                    <a class="nav-item nav-item-dev" href="#" onclick="modEnDesarrollo('Proveedores');return false;">
                        <i class="bi bi-truck"></i><span>Proveedores</span>
                    </a>
                    <a class="nav-item nav-item-dev" href="#" onclick="modEnDesarrollo('Productos');return false;">
                        <i class="bi bi-box-seam-fill"></i><span>Productos</span>
                    </a>
                    <a class="nav-item nav-item-dev" href="#" onclick="modEnDesarrollo('CRM');return false;">
                        <i class="bi bi-diagram-3-fill"></i><span>CRM</span>
                    </a>
                </div>
            </div>

            <!-- ── SECCIÓN: OPERACIONES ───────────────────── -->
            <div class="nav-category">
                <div class="nav-category-label nav-category-label--ops" data-bs-toggle="collapse" data-bs-target="#cat-operaciones" role="button">
                    <i class="bi bi-lightning-charge-fill me-1"></i> Operaciones
                    <i class="bi bi-chevron-down nav-cat-arrow ms-auto" id="arrow-ops"></i>
                </div>
                <div class="collapse show" id="cat-operaciones">
                    <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Ventas" ? "active" : "")"
                       asp-controller="Ventas" asp-action="Index" id="nav-ventas">
                        <i class="bi bi-cart-check-fill"></i><span>Ventas</span>
                        <span class="nav-badge nav-badge-green">Live</span>
                    </a>
                    <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Compras" ? "active" : "")"
                       asp-controller="Compras" asp-action="Index" id="nav-compras">
                        <i class="bi bi-bag-plus-fill"></i><span>Compras</span>
                        <span class="nav-badge nav-badge-green">Live</span>
                    </a>
                    <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Facturacion" ? "active" : "")"
                       asp-controller="Facturacion" asp-action="Index" id="nav-facturacion">
                        <i class="bi bi-receipt-cutoff"></i><span>Facturación</span>
                        <span class="nav-badge nav-badge-green">Live</span>
                    </a>
                    <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Inventario" ? "active" : "")"
                       asp-controller="Inventario" asp-action="Index" id="nav-inventario">
                        <i class="bi bi-archive-fill"></i><span>Inventario</span>
                        <span class="nav-badge nav-badge-green">Live</span>
                    </a>
                    <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Proyectos" ? "active" : "")"
                       asp-controller="Proyectos" asp-action="Index" id="nav-proyectos">
                        <i class="bi bi-kanban-fill"></i><span>Proyectos</span>
                        <span class="nav-badge nav-badge-green">Live</span>
                    </a>
                </div>
            </div>

            <!-- ── SECCIÓN: FINANZAS ──────────────────────── -->
            <div class="nav-category">
                <div class="nav-category-label" data-bs-toggle="collapse" data-bs-target="#cat-finanzas" role="button">
                    <i class="bi bi-bank me-1"></i> Finanzas
                    <i class="bi bi-chevron-down nav-cat-arrow ms-auto" id="arrow-finanzas"></i>
                </div>
                <div class="collapse show" id="cat-finanzas">
                    <a class="nav-item nav-item-dev" href="#" onclick="modEnDesarrollo('Contabilidad');return false;">
                        <i class="bi bi-calculator-fill"></i><span>Contabilidad</span>
                    </a>
                    <a class="nav-item nav-item-dev" href="#" onclick="modEnDesarrollo('Tesorería');return false;">
                        <i class="bi bi-safe2-fill"></i><span>Tesorería</span>
                    </a>
                    <a class="nav-item nav-item-dev" href="#" onclick="modEnDesarrollo('Presupuesto');return false;">
                        <i class="bi bi-pie-chart-fill"></i><span>Presupuesto</span>
                    </a>
                </div>
            </div>

            <!-- ── SECCIÓN: RRHH ──────────────────────────── -->
            <div class="nav-category">
                <div class="nav-category-label" data-bs-toggle="collapse" data-bs-target="#cat-rrhh" role="button">
                    <i class="bi bi-person-badge me-1"></i> RRHH
                    <i class="bi bi-chevron-down nav-cat-arrow ms-auto" id="arrow-rrhh"></i>
                </div>
                <div class="collapse show" id="cat-rrhh">
                    <a class="nav-item nav-item-dev" href="#" onclick="modEnDesarrollo('Nómina');return false;">
                        <i class="bi bi-cash-coin"></i><span>Nómina</span>
                    </a>
                    <a class="nav-item nav-item-dev" href="#" onclick="modEnDesarrollo('Empleados');return false;">
                        <i class="bi bi-person-vcard-fill"></i><span>Empleados</span>
                    </a>
                    <a class="nav-item nav-item-dev" href="#" onclick="modEnDesarrollo('Asistencia');return false;">
                        <i class="bi bi-clock-history"></i><span>Asistencia</span>
                    </a>
                    <a class="nav-item nav-item-dev" href="#" onclick="modEnDesarrollo('Evaluaciones');return false;">
                        <i class="bi bi-star-half"></i><span>Evaluaciones</span>
                    </a>
                </div>
            </div>

        </div><!-- /sidebar-scroll -->

        <!-- Footer del sidebar -->
        <div class="sidebar-footer">
            <div class="sf-avatar"><i class="bi bi-person-fill"></i></div>
            <div class="sf-info">
                <div class="sf-name">Administrador</div>
                <div class="sf-role">SyS ERP © @DateTime.Now.Year</div>
            </div>
        </div>
    </nav>
    <!-- ══════════════════ /SIDEBAR ══════════════════ -->

    <!-- ══════════════════ ÁREA DE CONTENIDO ══════════════════ -->
    <div class="erp-content" id="erpContent">

        <!-- Topbar -->
        <header class="erp-topbar">
            <div class="d-flex align-items-center gap-3">
                <button id="sidebarToggle" class="topbar-toggle" aria-label="Abrir menú"
                        onclick="document.getElementById('erpSidebar').classList.toggle('sidebar-collapsed');document.getElementById('erpContent').classList.toggle('content-expanded')">
                    <i class="bi bi-list fs-5"></i>
                </button>
                <div class="topbar-breadcrumb">
                    <i class="bi bi-grid-3x3-gap-fill text-accent-purple me-1"></i>
                    <span class="topbar-title">@ViewData["Title"]</span>
                </div>
            </div>
            <div class="topbar-right">
                <span class="topbar-stat"><i class="bi bi-circle-fill me-1" style="color:#10b981;font-size:.5rem;"></i>Sistema activo</span>
                <button class="topbar-icon-btn" title="Notificaciones">
                    <i class="bi bi-bell-fill"></i>
                    <span class="notif-dot"></span>
                </button>
                <div class="topbar-user">
                    <div class="user-avatar">MV</div>
                </div>
            </div>
        </header>

        <!-- Contenido de la página -->
        <main class="erp-main" role="main">
            @RenderBody()
        </main>

        <!-- Footer -->
        <footer class="erp-footer">
            <span><i class="bi bi-code-slash me-1"></i> SyS_ERP — Panel Administrativo v1.0</span>
            <span>@DateTime.Now.ToString("dddd, dd MMM yyyy", new System.Globalization.CultureInfo("es-PE"))</span>
        </footer>

    </div>
    <!-- ══════════════════ /ÁREA DE CONTENIDO ══════════════════ -->

</div>

<!-- Overlay para móvil -->
<div id="sidebarOverlay" class="sidebar-overlay" onclick="closeSidebar()"></div>

<!-- Bootstrap 5 JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<!-- SweetAlert2 -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<!-- Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
<!-- Site JS -->
<script src="~/js/site.js" asp-append-version="true"></script>

<script>
    // ── Módulo en Desarrollo — SweetAlert2 ────────────────────────────────────
    function modEnDesarrollo(nombre) {
        Swal.fire({
            title: `<span style="color:#7c3aed">${nombre}</span>`,
            html: `<div style="text-align:center;">
                     <i class="bi bi-tools" style="font-size:2.5rem;color:#7c3aed;display:block;margin-bottom:12px;"></i>
                     <p style="color:#cbd5e1;margin:0;">Este módulo está actualmente <strong style="color:#f59e0b">en desarrollo</strong>.<br>
                     Estará disponible próximamente.</p>
                   </div>`,
            icon: undefined,
            showConfirmButton: true,
            confirmButtonText: 'Entendido',
            confirmButtonColor: '#7c3aed',
            background: '#1e1b2e',
            color: '#e2e8f0',
            customClass: { popup: 'swal-erp' }
        });
    }

    // ── Colapso del sidebar en mobile ─────────────────────────────────────────
    function closeSidebar() {
        document.getElementById('erpSidebar').classList.remove('sidebar-open');
        document.getElementById('sidebarOverlay').classList.remove('active');
    }

    // ── Ajustar flechas de categorías ─────────────────────────────────────────
    document.querySelectorAll('[data-bs-toggle="collapse"]').forEach(btn => {
        btn.addEventListener('click', function () {
            const arrow = this.querySelector('.nav-cat-arrow');
            if (arrow) arrow.classList.toggle('rotated');
        });
    });
</script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
